  <!-- Jolt itself. The GPU compute back-ends (DX12 / Vulkan / Metal / CPU emulation, used by
       hair simulation) are left out; nothing here uses them. ObjectStream stays: its
       SerializableObject is part of the core, and the rest compiles to nothing without
       JPH_OBJECT_STREAM. Every Jolt source file name is unique, so the objects can share
       one folder. -->
  <ItemGroup>
    <ClCompile Include="$(JoltRoot)Jolt\**\*.cpp" Exclude="$(JoltRoot)Jolt\Compute\CPU\**;$(JoltRoot)Jolt\Compute\DX12\**;$(JoltRoot)Jolt\Compute\VK\**;$(JoltRoot)Jolt\Compute\MTL\**;$(JoltRoot)Jolt\Shaders\**">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <SDLCheck>false</SDLCheck>
      <WarningLevel>Level1</WarningLevel>
      <ObjectFileName>$(IntDir)Jolt\</ObjectFileName>
    </ClCompile>
  </ItemGroup>
