                ImGui::DragFloat("Temperature (K)", &pl.TemperatureKelvin, 100.0f, 1000.0f, 20000.0f);
        }
    }

    if (selectedEntity->Mesh.has_value())
    {
        if (ImGui::CollapsingHeader("Mesh", ImGuiTreeNodeFlags_DefaultOpen))
        {
            ImGui::TextDisabled("Mesh path:     %s", selectedEntity->Mesh->MeshPath.empty()     ? "(none)" : selectedEntity->Mesh->MeshPath.c_str());
            ImGui::TextDisabled("Material path: %s", selectedEntity->Mesh->MaterialPath.empty() ? "(none)" : selectedEntity->Mesh->MaterialPath.c_str());
        }
