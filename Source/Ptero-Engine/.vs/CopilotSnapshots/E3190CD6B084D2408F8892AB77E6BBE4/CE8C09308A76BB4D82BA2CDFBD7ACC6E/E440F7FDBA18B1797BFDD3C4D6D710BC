// ---------------------------------------------------------------------------
// DrawViewport
// ---------------------------------------------------------------------------

void Editor::DrawViewport(
    D3D12_GPU_DESCRIPTOR_HANDLE sceneTextureHandle,
    const EditorCamera& camera,
    Entity* selectedEntity)
{
    ImGuiViewport* mainViewport = ImGui::GetMainViewport();
    const ImVec2 workPos = mainViewport->WorkPos;
    const ImVec2 workSize = mainViewport->WorkSize;
    const ImVec2 viewportPos = workPos;
    const ImVec2 viewportWindowSize = workSize;

    ImGui::SetNextWindowPos(viewportPos, ImGuiCond_Always);
    ImGui::SetNextWindowSize(viewportWindowSize, ImGuiCond_Always);
    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0, 0));
    ImGui::Begin("Viewport", nullptr,
        ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse |
        ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoCollapse |
        ImGuiWindowFlags_NoBringToFrontOnFocus | ImGuiWindowFlags_MenuBar);

    if (ImGui::BeginMenuBar())
    {
        if (ImGui::BeginMenu("Viewport"))
        {
            if (ImGui::MenuItem("Resolution..."))
                mShowViewportResolutionDialog = true;
            if (ImGui::MenuItem("Screenshot..."))
                mShowScreenshotDialog = true;
            ImGui::EndMenu();
        }

        if (ImGui::BeginMenu("Options"))
        {
            ImGui::MenuItem("Renderer Statistics", nullptr, &mShowViewportStatistics);
            ImGui::MenuItem("Placement Icons", nullptr, &mShowViewportPlacementIcons);
            ImGui::EndMenu();
        }

        ImGui::EndMenuBar();
    }

    const ImVec2 viewportOrigin = ImGui::GetCursorScreenPos();
    const ImVec2 viewportSize   = ImGui::GetContentRegionAvail();
    mLastViewportContentOrigin = viewportOrigin;
    mLastViewportContentSize = viewportSize;

    if (viewportSize.x > 1.0f && viewportSize.y > 1.0f && sceneTextureHandle.ptr != 0)
        ImGui::Image(TextureIdFromHandle(sceneTextureHandle), viewportSize);

    DrawViewportPlacementIcons(viewportOrigin, viewportSize, camera);

    const bool viewportHovered = ImGui::IsWindowHovered();

    // ImGuizmo gizmo for the selected entity
    if (selectedEntity && !mGeometryPrototypeSelected && !mPointLightPrototypeSelected && !mAudioEmitterPrototypeSelected)
    {
        ImGuizmo::BeginFrame();
        ImGuizmo::SetOrthographic(false);
        ImGuizmo::SetDrawlist();
        ImGuizmo::SetRect(viewportOrigin.x, viewportOrigin.y, viewportSize.x, viewportSize.y);

        using namespace DirectX;

        XMFLOAT4X4 view4x4, proj4x4;
        XMStoreFloat4x4(&view4x4, XMMatrixTranspose(camera.GetViewMatrix()));
        XMStoreFloat4x4(&proj4x4, XMMatrixTranspose(camera.GetProjectionMatrix()));

        XMMATRIX entityMatrix = selectedEntity->Transform.GetTransform();
        XMFLOAT4X4 entityFloat;
        XMStoreFloat4x4(&entityFloat, XMMatrixTranspose(entityMatrix));

        if (mActiveGizmo != GizmoType::None)
        {
            ImGuizmo::OPERATION op = ImGuizmo::TRANSLATE;
            if (mActiveGizmo == GizmoType::Rotate) op = ImGuizmo::ROTATE;
            if (mActiveGizmo == GizmoType::Scale)  op = ImGuizmo::SCALE;

            float delta[16];
            if (ImGuizmo::Manipulate(&view4x4.m[0][0], &proj4x4.m[0][0],
                                      op, ImGuizmo::WORLD, &entityFloat.m[0][0], delta))
            {
                XMMATRIX updated = XMMatrixTranspose(XMLoadFloat4x4(&entityFloat));
                XMVECTOR scale, rot, trans;
                XMMatrixDecompose(&scale, &rot, &trans, updated);

                XMStoreFloat3(&selectedEntity->Transform.Position, trans);

                XMFLOAT4 rotQ;
                XMStoreFloat4(&rotQ, rot);
                // Convert quaternion to Euler (approximate)
                float sinr = 2.0f * (rotQ.w * rotQ.x + rotQ.y * rotQ.z);
                float cosr = 1.0f - 2.0f * (rotQ.x * rotQ.x + rotQ.y * rotQ.y);
                selectedEntity->Transform.Rotation.x = std::atan2(sinr, cosr);

                float sinp = 2.0f * (rotQ.w * rotQ.y - rotQ.z * rotQ.x);
                selectedEntity->Transform.Rotation.y = std::abs(sinp) >= 1.0f ? std::copysign(DirectX::XM_PIDIV2, sinp) : std::asin(sinp);

                float siny = 2.0f * (rotQ.w * rotQ.z + rotQ.x * rotQ.y);
                float cosy = 1.0f - 2.0f * (rotQ.y * rotQ.y + rotQ.z * rotQ.z);
                selectedEntity->Transform.Rotation.z = std::atan2(siny, cosy);

                XMFLOAT3 sc;
                XMStoreFloat3(&sc, scale);
                // Undo the MeshWorldScale
                constexpr float invMeshScale = 1.0f / TransformComponent::MeshWorldScale;
                selectedEntity->Transform.Scale = { sc.x * invMeshScale, sc.y * invMeshScale, sc.z * invMeshScale };
            }
        }
    }

    DrawManualGizmoPivot(viewportOrigin, viewportSize, camera, selectedEntity);
    HandleViewportInteraction(viewportOrigin, viewportSize, camera, viewportHovered);

    ImGui::End();
    ImGui::PopStyleVar();
}

