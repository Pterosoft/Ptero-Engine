            ImGui::Checkbox("Cast Shadows##pl",          &pl.CastShadows);
            ImGui::Checkbox("Affect Volumetric Fog##pl", &pl.AffectVolumetricFog);
            ImGui::DragFloat("Falloff Exponent", &pl.FalloffExponent, 0.01f, 0.1f, 10.0f);
            ImGui::DragFloat("Source Radius",    &pl.SourceRadius,    0.001f, 0.0f, 1.0f);
