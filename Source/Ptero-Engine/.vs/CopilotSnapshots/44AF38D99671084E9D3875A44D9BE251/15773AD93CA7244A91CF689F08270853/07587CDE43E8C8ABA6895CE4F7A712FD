    template <typename LayerElementType>
    int ResolveLayerElementIndex(const LayerElementType* layerElement, const int elementIndex)
    {
        if (layerElement == nullptr || elementIndex < 0)
        {
            return -1;
        }

        switch (layerElement->GetReferenceMode())
        {
        case FbxLayerElement::eDirect:
            return elementIndex;
        case FbxLayerElement::eIndex:
        case FbxLayerElement::eIndexToDirect:
            return (elementIndex < layerElement->GetIndexArray().GetCount())
                ? layerElement->GetIndexArray().GetAt(elementIndex)
                : -1;
        default:
            return -1;
        }
    }

    DirectX::XMFLOAT3 ConvertPositionToLeftHanded(const FbxVector4& position)
    {
        return DirectX::XMFLOAT3(
            static_cast<float>(position[0]),
            static_cast<float>(position[1]),
            static_cast<float>(-position[2]));
    }

    DirectX::XMFLOAT3 ConvertNormalToLeftHanded(const FbxVector4& normal)
    {
        return DirectX::XMFLOAT3(
            static_cast<float>(normal[0]),
            static_cast<float>(normal[1]),
            static_cast<float>(-normal[2]));
    }

    DirectX::XMFLOAT3 ReadNormal(const FbxMesh* mesh, const int controlPointIndex, const int polygonVertexIndex)
    {
        const FbxGeometryElementNormal* normalElement = mesh ? mesh->GetElementNormal(0) : nullptr;
        if (normalElement == nullptr)
        {
            return DirectX::XMFLOAT3(0.0f, 1.0f, 0.0f);
        }

        int resolvedIndex = -1;
        switch (normalElement->GetMappingMode())
        {
        case FbxLayerElement::eByControlPoint:
            resolvedIndex = ResolveLayerElementIndex(normalElement, controlPointIndex);
            break;
        case FbxLayerElement::eByPolygonVertex:
            resolvedIndex = ResolveLayerElementIndex(normalElement, polygonVertexIndex);
            break;
        default:
            return DirectX::XMFLOAT3(0.0f, 1.0f, 0.0f);
        }

        if (resolvedIndex < 0 || resolvedIndex >= normalElement->GetDirectArray().GetCount())
        {
            return DirectX::XMFLOAT3(0.0f, 1.0f, 0.0f);
        }

        return ConvertNormalToLeftHanded(normalElement->GetDirectArray().GetAt(resolvedIndex));
    }

    DirectX::XMFLOAT2 ReadUv(FbxMesh* mesh, const int controlPointIndex, const int polygonIndex, const int polygonVertexInPolygon)
    {
        const FbxGeometryElementUV* uvElement = mesh ? mesh->GetElementUV(0) : nullptr;
        if (uvElement == nullptr)
        {
            return DirectX::XMFLOAT2(0.0f, 0.0f);
        }

        if (uvElement->GetMappingMode() == FbxLayerElement::eByControlPoint)
        {
            const int resolvedIndex = ResolveLayerElementIndex(uvElement, controlPointIndex);
            if (resolvedIndex >= 0 && resolvedIndex < uvElement->GetDirectArray().GetCount())
            {
                const FbxVector2 uv = uvElement->GetDirectArray().GetAt(resolvedIndex);
                return DirectX::XMFLOAT2(static_cast<float>(uv[0]), 1.0f - static_cast<float>(uv[1]));
            }

            return DirectX::XMFLOAT2(0.0f, 0.0f);
        }

        if (uvElement->GetMappingMode() == FbxLayerElement::eByPolygonVertex)
        {
            const int uvIndex = mesh->GetTextureUVIndex(polygonIndex, polygonVertexInPolygon);
            if (uvIndex >= 0 && uvIndex < uvElement->GetDirectArray().GetCount())
            {
                const FbxVector2 uv = uvElement->GetDirectArray().GetAt(uvIndex);
                return DirectX::XMFLOAT2(static_cast<float>(uv[0]), 1.0f - static_cast<float>(uv[1]));
            }
        }

        return DirectX::XMFLOAT2(0.0f, 0.0f);
    }

    // Reads FBX material slots in scene order and writes a multi-material JSON
    // to outJsonPath.  Each sub-material entry corresponds to the FBX material
    // index and contains the material name and diffuse/base-color texture path
    // (relative to the FBX source directory).
    // Returns the set of texture paths that were referenced so the caller can copy them.
    std::vector<std::string> WriteFbxMultiMaterialJson(
        FbxScene* scene,
        const std::filesystem::path& fbxSourcePath,
        const std::filesystem::path& outJsonPath)
    {
        std::vector<std::string> referencedTextures;
        if (scene == nullptr) return referencedTextures;

        const int matCount = scene->GetMaterialCount();
        if (matCount == 0) return referencedTextures;

        // The JSON we'll write mirrors the MultiMaterialDefinition format used by MaterialEditor.
        nlohmann::json subMaterialsJson = nlohmann::json::array();

        for (int i = 0; i < matCount; ++i)
        {
            FbxSurfaceMaterial* mat = scene->GetMaterial(i);
            if (mat == nullptr) continue;

            const std::string matName = mat->GetName() ? mat->GetName() : ("Material_" + std::to_string(i));

            // Try to find the diffuse texture.  FBX materials use the "Diffuse" property
            // for PBR-style base color (DiffuseFactor / DiffuseColor) or "Maya|baseColor".
            std::string diffuseRelPath;

            // Lambda: given an FbxProperty, return the first connected file texture path.
            auto getFileTexturePath = [&](FbxProperty& prop) -> std::string
            {
                if (!prop.IsValid()) return {};
                const int srcCount = prop.GetSrcObjectCount<FbxFileTexture>();
                for (int t = 0; t < srcCount; ++t)
                {
                    FbxFileTexture* tex = prop.GetSrcObject<FbxFileTexture>(t);
                    if (tex == nullptr) continue;
                    // GetRelativeFileName() returns the path relative to the FBX file.
                    const char* relFileName = tex->GetRelativeFileName();
                    if (relFileName && relFileName[0] != '\0')
                        return std::string(relFileName);
                    const char* absFileName = tex->GetFileName();
                    if (absFileName && absFileName[0] != '\0')
                        return std::string(absFileName);
                }
                return {};
            };

            // Check the standard Diffuse property.
            {
                FbxProperty diffuseProp = mat->FindProperty(FbxSurfaceMaterial::sDiffuse);
                diffuseRelPath = getFileTexturePath(diffuseProp);
            }

            // Also try Maya PBR base color if diffuse wasn't found.
            if (diffuseRelPath.empty())
            {
                FbxProperty baseProp = mat->FindProperty("Maya|baseColor");
                diffuseRelPath = getFileTexturePath(baseProp);
            }

            // Normalise path separators and record it so the importer can copy the texture.
            std::string dataRelativeTexturePath;
            if (!diffuseRelPath.empty())
            {
                // Replace back-slashes from FBX with forward slashes for JSON portability.
                for (char& c : diffuseRelPath) { if (c == '\\') c = '/'; }
                referencedTextures.push_back(diffuseRelPath);
                // The texture will be imported into Data/Textures/; store a Data-relative path.
                dataRelativeTexturePath = "Textures/" + std::filesystem::path(diffuseRelPath).filename().replace_extension(".dds").string();
            }

            nlohmann::json subMat{
                { "name",          matName },
                { "baseColorTint", nlohmann::json::array({ 1.0f, 1.0f, 1.0f, 1.0f }) },
                { "emissiveColor", nlohmann::json::array({ 0.0f, 0.0f, 0.0f }) },
                { "metallicFactor",   1.0f },
                { "roughnessFactor",  1.0f },
                { "normalScale",      1.0f },
                { "ambientOcclusionStrength", 1.0f },
                { "heightScale",     0.05f },
                { "opacity",         1.0f },
                { "alphaCutoff",     0.5f },
                { "doubleSided",     false },
                { "alphaCutout",     false },
                { "transparentBlend", false },
                { "textures", {
                    { "baseColor",        dataRelativeTexturePath },
                    { "normal",           "" },
                    { "metallic",         "" },
                    { "roughness",        "" },
                    { "metallicRoughness", "" },
                    { "ambientOcclusion", "" },
                    { "emissive",         "" },
                    { "height",           "" },
                    { "opacity",          "" }
                } }
            };
            subMaterialsJson.push_back(std::move(subMat));
        }

        // Derive multi-material name from the FBX file stem.
        const std::string multiMatName = fbxSourcePath.stem().string();

        nlohmann::json multiMatJson{
            { "name",         multiMatName },
            { "type",         "MultiMaterial" },
            { "subMaterials", subMaterialsJson }
        };

        // Ensure the output directory exists.
        if (outJsonPath.has_parent_path())
        {
            std::filesystem::create_directories(outJsonPath.parent_path());
        }

        std::ofstream jsonOut(outJsonPath);
        if (jsonOut)
        {
            jsonOut << multiMatJson.dump(4);
        }

        return referencedTextures;
    }

    void CollectMeshNodesRecursive(FbxNode* node, std::vector<FbxMesh*>& meshes)
    {
        if (node == nullptr)
        {
            return;
        }

        if (FbxMesh* mesh = node->GetMesh(); mesh != nullptr)
        {
            meshes.push_back(mesh);
        }

        const int childCount = node->GetChildCount();
        for (int childIndex = 0; childIndex < childCount; ++childIndex)
        {
            CollectMeshNodesRecursive(node->GetChild(childIndex), meshes);
        }
    }

    bool TriangulateAndCollectMeshes(FbxScene* scene, std::vector<FbxMesh*>& meshes)
    {
        if (scene == nullptr)
        {
            return false;
        }

        FbxGeometryConverter geometryConverter(scene->GetFbxManager());
        if (!geometryConverter.Triangulate(scene, true))
        {
            return false;
        }

        CollectMeshNodesRecursive(scene->GetRootNode(), meshes);
        return !meshes.empty();
    }

    void ProcessMesh(FbxMesh* mesh, std::vector<Vertex>& vertices, std::vector<std::uint32_t>& indices, std::vector<PteroSubMeshEntry>& subMeshEntries)
    {
        if (mesh == nullptr || mesh->GetControlPoints() == nullptr)
        {
            return;
        }

        // Read the per-polygon material element so each triangle can be bucketed by FBX material slot.
        const FbxGeometryElementMaterial* materialElement = mesh->GetElementMaterialCount() > 0
            ? mesh->GetElementMaterial(0)
            : nullptr;

        const FbxVector4* controlPoints = mesh->GetControlPoints();
        const int polygonCount = mesh->GetPolygonCount();

        // Group polygon indices by material id first, then emit them in order so the shared index buffer
        // contains one contiguous run per material.  This mirrors how CryEngine/Unreal store sub-objects.
        // key = materialId, value = list of triangle vertex triplets (controlPointIndex, polygonVertexIndex, ...)
        struct TriVert
        {
            int controlPointIndex;
            int polygonVertexIndex;
            int polygonIndex;
            int localVertex;
        };
        std::unordered_map<int, std::vector<TriVert>> perMaterialTris;

        int polygonVertexIndex = 0;
        for (int polygonIndex = 0; polygonIndex < polygonCount; ++polygonIndex)
        {
            const int polygonSize = mesh->GetPolygonSize(polygonIndex);
            if (polygonSize != 3)
            {
                polygonVertexIndex += polygonSize;
                continue;
            }

            // Resolve which material this triangle belongs to.
            int materialId = 0;
            if (materialElement != nullptr)
            {
                if (materialElement->GetMappingMode() == FbxLayerElement::eAllSame)
                {
                    // Every polygon uses the same material slot; resolve once.
                    materialId = ResolveLayerElementIndex(materialElement, 0);
                }
                else
                {
                    // eByPolygon – each polygon stores its own index.
                    materialId = ResolveLayerElementIndex(materialElement, polygonIndex);
                }
                if (materialId < 0) materialId = 0;
            }

            for (int polygonVertex = 0; polygonVertex < polygonSize; ++polygonVertex)
            {
                perMaterialTris[materialId].push_back({
                    mesh->GetPolygonVertex(polygonIndex, polygonVertex),
                    polygonVertexIndex + polygonVertex,
                    polygonIndex,
                    polygonVertex
                });
            }
            polygonVertexIndex += polygonSize;
        }

        // Emit vertices/indices grouped by materialId in sorted order so material 0 comes first, etc.
        std::vector<int> sortedMaterialIds;
        sortedMaterialIds.reserve(perMaterialTris.size());
        for (const auto& [id, _] : perMaterialTris)
        {
            sortedMaterialIds.push_back(id);
        }
        std::sort(sortedMaterialIds.begin(), sortedMaterialIds.end());

        const std::uint32_t baseGlobalIndex = static_cast<std::uint32_t>(indices.size());

        for (const int materialId : sortedMaterialIds)
        {
            const std::vector<TriVert>& triVerts = perMaterialTris.at(materialId);
            // triVerts is already in triples of 3 vertices per triangle.
            const std::uint32_t subMeshIndexStart = static_cast<std::uint32_t>(indices.size());

            for (std::size_t i = 0; i + 2 < triVerts.size(); i += 3)
            {
                const std::uint32_t base = static_cast<std::uint32_t>(vertices.size());

                for (int v = 0; v < 3; ++v)
                {
                    const TriVert& tv = triVerts[i + v];
                    Vertex vertex{};
                    if (tv.controlPointIndex >= 0 && tv.controlPointIndex < mesh->GetControlPointsCount())
                    {
                        vertex.Position = ConvertPositionToLeftHanded(controlPoints[tv.controlPointIndex]);
                        vertex.Normal = ReadNormal(mesh, tv.controlPointIndex, tv.polygonVertexIndex);
                        vertex.TexCoord = ReadUv(mesh, tv.controlPointIndex, tv.polygonIndex, tv.localVertex);
                    }
                    vertex.Color = DirectX::XMFLOAT4(1.0f, 1.0f, 1.0f, 1.0f);
                    vertices.push_back(vertex);
                }

                // Flipping winding keeps front faces correct after the handedness flip (Z negation).
                indices.push_back(base + 0);
                indices.push_back(base + 2);
                indices.push_back(base + 1);
            }

            PteroSubMeshEntry entry{};
            entry.materialId = static_cast<std::uint32_t>(materialId);
            entry.indexStart = subMeshIndexStart;
            entry.indexCount = static_cast<std::uint32_t>(indices.size()) - subMeshIndexStart;
            subMeshEntries.push_back(entry);
        }
    }
