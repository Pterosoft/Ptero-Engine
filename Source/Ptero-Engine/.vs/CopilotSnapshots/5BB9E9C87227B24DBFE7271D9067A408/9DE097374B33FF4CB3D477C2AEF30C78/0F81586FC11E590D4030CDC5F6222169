bool PointLightRenderer::Initialize(
    ID3D12GraphicsCommandList* commandList,
    DXGI_FORMAT                colorFormat,
    DXGI_FORMAT                depthFormat)
{
    if (!CreateSphereMesh(commandList))
        return false;
    if (!CreatePipeline(colorFormat, depthFormat))
        return false;
    return true;
}

void PointLightRenderer::Render(
    ID3D12GraphicsCommandList* commandList,
    const std::vector<Entity>& entities,
    const XMMATRIX&            viewProjection)
{
    if (!mPipelineReady || mIndexCount == 0 || !mConstantBuffer)
        return;

    // Count how many point lights are in the scene this frame.
    std::size_t lightCount = 0;
    for (const Entity& e : entities)
    {
        if (e.HasPointLightComponent())
            ++lightCount;
    }

    if (lightCount == 0)
        return;

    if (!EnsureConstantBuffer(lightCount))
        return;

    commandList->SetGraphicsRootSignature(mRootSignature.Get());
    commandList->SetPipelineState(mPipelineState.Get());
    commandList->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_LINELIST);
    commandList->IASetVertexBuffers(0, 1, &mVBView);
    commandList->IASetIndexBuffer(&mIBView);

    std::size_t slot = 0;
    for (const Entity& e : entities)
    {
        if (!e.HasPointLightComponent())
            continue;

        const PointLightComponent& pl = *e.PointLight;

        // Scale the unit sphere to the light's influence radius and translate to its world position.
        const XMMATRIX model = XMMatrixScaling(pl.Radius, pl.Radius, pl.Radius)
                             * XMMatrixTranslation(
                                   e.Transform.Position.x,
                                   e.Transform.Position.y,
                                   e.Transform.Position.z);
        const XMMATRIX mvp = XMMatrixTranspose(model * viewProjection);

        GizmoConstants& cb = mMappedCB[slot];
        XMStoreFloat4x4(&cb.MVP, mvp);
        cb.Color = { pl.ColorR, pl.ColorG, pl.ColorB, 1.0f };

        const UINT64 cbOffset = static_cast<UINT64>(slot) * sizeof(GizmoConstants);
        commandList->SetGraphicsRootConstantBufferView(0, mConstantBuffer->GetGPUVirtualAddress() + cbOffset);
        commandList->DrawIndexedInstanced(mIndexCount, 1, 0, 0, 0);

        ++slot;
    }
}

void PointLightRenderer::Shutdown()
{
    if (mConstantBuffer && mMappedCB)
    {
        mConstantBuffer->Unmap(0, nullptr);
        mMappedCB = nullptr;
    }
    mConstantBuffer.Reset();
    mCBCapacity = 0;

    mVertexBuffer.Reset();
    mVertexUpload.Reset();
    mIndexBuffer.Reset();
    mIndexUpload.Reset();

    mRootSignature.Reset();
    mPipelineState.Reset();
    mVertexShader = DX12Shader{};
    mPixelShader  = DX12Shader{};
    mPipelineReady = false;
}

