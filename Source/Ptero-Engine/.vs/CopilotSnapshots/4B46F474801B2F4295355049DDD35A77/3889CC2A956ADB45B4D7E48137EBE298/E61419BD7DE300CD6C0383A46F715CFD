bool RtGlobalIllumination::AllocateSrv(
    D3D12_CPU_DESCRIPTOR_HANDLE* cpu, D3D12_GPU_DESCRIPTOR_HANDLE* gpu)
{
    return DX12Context_AllocateSrvDescriptor(cpu, gpu);
}

bool RtGlobalIllumination::CheckDxrSupport()
{
    ID3D12Device* device = DX12Context_GetDevice();
    if (!device) { mLastError = "RtGI: DX12 device not available."; return false; }

    if (FAILED(device->QueryInterface(IID_PPV_ARGS(&mDevice5))))
    {
        mLastError = "RtGI: ID3D12Device5 not supported (need a DXR-capable GPU on Windows 10 RS5+).";
        return false;
    }

    D3D12_FEATURE_DATA_D3D12_OPTIONS5 opts5{};
    if (FAILED(device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS5, &opts5, sizeof(opts5))) ||
        opts5.RaytracingTier == D3D12_RAYTRACING_TIER_NOT_SUPPORTED)
    {
        mLastError = "RtGI: DXR Tier 1.0 not supported on this GPU.";
        mDevice5.Reset();
        return false;
    }
    return true;
}

bool RtGlobalIllumination::CreateOutputTextures(UINT width, UINT height)
{
    mWidth = width; mHeight = height;
    ID3D12Device* dev = mDevice5.Get();

    // Raw noisy output written by RayGen, starts as non-pixel SRV.
    mRawOutput.Reset();
    if (!CreateRgba16Tex(dev, width, height,
        D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, mRawOutput))
    { mLastError = "RtGI: failed to create raw output texture."; return false; }

    // Temporally accumulated output, read by DeferredLighting as a pixel SRV.
    mAccumOutput.Reset();
    if (!CreateRgba16Tex(dev, width, height,
        D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
        D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, mAccumOutput))
    { mLastError = "RtGI: failed to create accum output texture."; return false; }

    // History texture for temporal blending (non-pixel SRV / copy dest).
    mHistoryOutput.Reset();
    if (!CreateRgba16Tex(dev, width, height,
        D3D12_RESOURCE_FLAG_NONE,
        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, mHistoryOutput))
    { mLastError = "RtGI: failed to create history texture."; return false; }

    // Allocate descriptors from the shared SRV/UAV heap.
    if (!AllocateSrv(&mRawUavCpu,    &mRawUavGpu))    { mLastError = "RtGI: out of descriptors (raw UAV).";   return false; }
    if (!AllocateSrv(&mAccumUavCpu,  &mAccumUavGpu))  { mLastError = "RtGI: out of descriptors (accum UAV)."; return false; }
    if (!AllocateSrv(&mAccumSrvCpu,  &mAccumSrvGpu))  { mLastError = "RtGI: out of descriptors (accum SRV)."; return false; }
    if (!AllocateSrv(&mHistorySrvCpu,&mHistorySrvGpu)){ mLastError = "RtGI: out of descriptors (hist SRV).";  return false; }

    D3D12_UNORDERED_ACCESS_VIEW_DESC uavDesc{};
    uavDesc.Format        = DXGI_FORMAT_R16G16B16A16_FLOAT;
    uavDesc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
    dev->CreateUnorderedAccessView(mRawOutput.Get(),   nullptr, &uavDesc, mRawUavCpu);
    dev->CreateUnorderedAccessView(mAccumOutput.Get(), nullptr, &uavDesc, mAccumUavCpu);

    D3D12_SHADER_RESOURCE_VIEW_DESC srvDesc{};
    srvDesc.Format                  = DXGI_FORMAT_R16G16B16A16_FLOAT;
    srvDesc.ViewDimension           = D3D12_SRV_DIMENSION_TEXTURE2D;
    srvDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
    srvDesc.Texture2D.MipLevels     = 1;
    dev->CreateShaderResourceView(mAccumOutput.Get(),   &srvDesc, mAccumSrvCpu);
    dev->CreateShaderResourceView(mHistoryOutput.Get(), &srvDesc, mHistorySrvCpu);
    return true;
}

bool RtGlobalIllumination::CreateTlasBuffers(UINT maxInstances)
{
    mTlasMaxInstances = maxInstances;
    mInstanceDescBuffer.Reset();
    if (!CreateUploadBuf(mDevice5.Get(),
        maxInstances * sizeof(D3D12_RAYTRACING_INSTANCE_DESC), mInstanceDescBuffer))
    { mLastError = "RtGI: failed to allocate TLAS instance buffer."; return false; }
    return true;
}

bool RtGlobalIllumination::CreateDxrPipeline()
{
    ID3D12Device* device = mDevice5.Get();

    // Global root signature (version 1.0 for broadest SDK compatibility).
    {
        // Descriptor range descriptors for each table slot.
        D3D12_DESCRIPTOR_RANGE dtNorm{};
        dtNorm.RangeType          = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
        dtNorm.NumDescriptors     = 1;
        dtNorm.BaseShaderRegister = 0; // t0 normal G-buffer

        D3D12_DESCRIPTOR_RANGE dtDepth{};
        dtDepth.RangeType          = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
        dtDepth.NumDescriptors     = 1;
        dtDepth.BaseShaderRegister = 1; // t1 depth

        D3D12_DESCRIPTOR_RANGE dtHist{};
        dtHist.RangeType          = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
        dtHist.NumDescriptors     = 1;
        dtHist.BaseShaderRegister = 2; // t2 history accumulation

        D3D12_DESCRIPTOR_RANGE dtRaw{};
        dtRaw.RangeType          = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
        dtRaw.NumDescriptors     = 1;
        dtRaw.BaseShaderRegister = 0; // u0 raw output this frame

        D3D12_DESCRIPTOR_RANGE dtAccum{};
        dtAccum.RangeType          = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
        dtAccum.NumDescriptors     = 1;
        dtAccum.BaseShaderRegister = 1; // u1 accumulated output

        D3D12_DESCRIPTOR_RANGE dtInstGeom{};
        dtInstGeom.RangeType          = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
        dtInstGeom.NumDescriptors     = 1;
        dtInstGeom.BaseShaderRegister = 4; // t4 per-instance geometry table

        D3D12_ROOT_PARAMETER p[9]{};
        // b0 – GiConstants CBV
        p[0].ParameterType             = D3D12_ROOT_PARAMETER_TYPE_CBV;
        p[0].Descriptor.ShaderRegister = 0;
        p[0].ShaderVisibility          = D3D12_SHADER_VISIBILITY_ALL;
        // t0 – normal G-buffer SRV table
        p[1].ParameterType                       = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
        p[1].DescriptorTable.NumDescriptorRanges = 1;
        p[1].DescriptorTable.pDescriptorRanges   = &dtNorm;
        p[1].ShaderVisibility                    = D3D12_SHADER_VISIBILITY_ALL;
        // t1 – depth SRV table
        p[2].ParameterType                       = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
        p[2].DescriptorTable.NumDescriptorRanges = 1;
        p[2].DescriptorTable.pDescriptorRanges   = &dtDepth;
        p[2].ShaderVisibility                    = D3D12_SHADER_VISIBILITY_ALL;
        // t2 – history SRV table
        p[3].ParameterType                       = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
        p[3].DescriptorTable.NumDescriptorRanges = 1;
        p[3].DescriptorTable.pDescriptorRanges   = &dtHist;
        p[3].ShaderVisibility                    = D3D12_SHADER_VISIBILITY_ALL;
        // t3 – TLAS inline SRV (raw GPU VA)
        p[4].ParameterType             = D3D12_ROOT_PARAMETER_TYPE_SRV;
        p[4].Descriptor.ShaderRegister = 3;
        p[4].ShaderVisibility          = D3D12_SHADER_VISIBILITY_ALL;
        // t4 – per-instance geometry table SRV
        p[5].ParameterType                       = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
        p[5].DescriptorTable.NumDescriptorRanges = 1;
        p[5].DescriptorTable.pDescriptorRanges   = &dtInstGeom;
        p[5].ShaderVisibility                    = D3D12_SHADER_VISIBILITY_ALL;
        // u0 – raw output UAV table
        p[6].ParameterType                       = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
        p[6].DescriptorTable.NumDescriptorRanges = 1;
        p[6].DescriptorTable.pDescriptorRanges   = &dtRaw;
        p[6].ShaderVisibility                    = D3D12_SHADER_VISIBILITY_ALL;
        // u1 – accumulated output UAV table
        p[7].ParameterType                       = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
        p[7].DescriptorTable.NumDescriptorRanges = 1;
        p[7].DescriptorTable.pDescriptorRanges   = &dtAccum;
        p[7].ShaderVisibility                    = D3D12_SHADER_VISIBILITY_ALL;
        // b1 – unused padding slot (reserved for future use)
        p[8].ParameterType             = D3D12_ROOT_PARAMETER_TYPE_CBV;
        p[8].Descriptor.ShaderRegister = 1;
        p[8].ShaderVisibility          = D3D12_SHADER_VISIBILITY_ALL;

        D3D12_ROOT_SIGNATURE_DESC rsDesc{};
        rsDesc.NumParameters = 8; // p[0..7]; p[8] reserved, not included
        rsDesc.pParameters   = p;
        rsDesc.Flags         = D3D12_ROOT_SIGNATURE_FLAG_NONE;

        ComPtr<ID3DBlob> blob, err;
        if (FAILED(D3D12SerializeRootSignature(
            &rsDesc, D3D_ROOT_SIGNATURE_VERSION_1, &blob, &err)))
        {
            mLastError = "RtGI: root signature serialization failed.";
            if (err) OutputDebugStringA(static_cast<const char*>(err->GetBufferPointer()));
            return false;
        }
        if (FAILED(device->CreateRootSignature(0,
            blob->GetBufferPointer(), blob->GetBufferSize(), IID_PPV_ARGS(&mGlobalRS))))
        { mLastError = "RtGI: CreateRootSignature failed."; return false; }
    }

    // Compile the shader library (lib_6_3).
    std::vector<uint8_t> dxil;
    try { dxil = CompileRtLibrary(FindRtGiShaderPath()); }
    catch (const std::exception& ex)
    { mLastError = std::string("RtGI: shader compile failed: ") + ex.what(); return false; }

    const D3D12_SHADER_BYTECODE libBC{ dxil.data(), dxil.size() };

    D3D12_EXPORT_DESC exports[3] =
    {
        { kRayGenName,     nullptr, D3D12_EXPORT_FLAG_NONE },
        { kClosestHitName, nullptr, D3D12_EXPORT_FLAG_NONE },
        { kMissName,       nullptr, D3D12_EXPORT_FLAG_NONE },
    };
    D3D12_DXIL_LIBRARY_DESC lib{ libBC, 3, exports };

    D3D12_HIT_GROUP_DESC hg{};
    hg.HitGroupExport         = kHitGroupName;
    hg.Type                   = D3D12_HIT_GROUP_TYPE_TRIANGLES;
    hg.ClosestHitShaderImport = kClosestHitName;

    // Payload: 3x float3 (Radiance, HitAlbedo, HitNormal) + uint Hit = 9*4+4 = 40 bytes.
    // Attributes: float2 Barycentrics = 8 bytes.
    D3D12_RAYTRACING_SHADER_CONFIG  sc{ 40, 8 };
    D3D12_RAYTRACING_PIPELINE_CONFIG pc{ 1 };     // max recursion depth = 1
    D3D12_GLOBAL_ROOT_SIGNATURE      grs{ mGlobalRS.Get() };

    D3D12_STATE_SUBOBJECT subs[5] =
    {
        { D3D12_STATE_SUBOBJECT_TYPE_DXIL_LIBRARY,               &lib },
        { D3D12_STATE_SUBOBJECT_TYPE_HIT_GROUP,                  &hg  },
        { D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_SHADER_CONFIG,   &sc  },
        { D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_PIPELINE_CONFIG, &pc  },
        { D3D12_STATE_SUBOBJECT_TYPE_GLOBAL_ROOT_SIGNATURE,      &grs },
    };
    D3D12_STATE_OBJECT_DESC soDesc{ D3D12_STATE_OBJECT_TYPE_RAYTRACING_PIPELINE, 5, subs };
    if (FAILED(mDevice5->CreateStateObject(&soDesc, IID_PPV_ARGS(&mStateObject))))
    { mLastError = "RtGI: CreateStateObject failed."; return false; }

    return true;
}

bool RtGlobalIllumination::CreateShaderTable()
{
    // Each entry = shader identifier (D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES = 32 bytes)
    // padded up to D3D12_RAYTRACING_SHADER_RECORD_BYTE_ALIGNMENT (64 bytes).
    mShaderTableEntrySize =
        (D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES + D3D12_RAYTRACING_SHADER_RECORD_BYTE_ALIGNMENT - 1)
        & ~static_cast<UINT64>(D3D12_RAYTRACING_SHADER_RECORD_BYTE_ALIGNMENT - 1);
    mShaderTableSize = 3 * mShaderTableEntrySize; // RayGen + Miss + HitGroup

    if (!CreateUploadBuf(mDevice5.Get(), mShaderTableSize, mShaderTable))
    { mLastError = "RtGI: failed to allocate shader table."; return false; }

    ComPtr<ID3D12StateObjectProperties> prop;
    if (FAILED(mStateObject->QueryInterface(IID_PPV_ARGS(&prop))))
    { mLastError = "RtGI: ID3D12StateObjectProperties unavailable."; return false; }

    uint8_t* p = nullptr;
    mShaderTable->Map(0, nullptr, reinterpret_cast<void**>(&p));
    memcpy(p,                            prop->GetShaderIdentifier(kRayGenName),    D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES);
    memcpy(p + mShaderTableEntrySize,    prop->GetShaderIdentifier(kMissName),      D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES);
    memcpy(p + 2*mShaderTableEntrySize,  prop->GetShaderIdentifier(kHitGroupName),  D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES);
    mShaderTable->Unmap(0, nullptr);
    return true;
}

bool RtGlobalIllumination::CreateConstantBuffer()
{
    if (!CreateUploadBuf(mDevice5.Get(), sizeof(GiConstants), mConstantBuffer))
    { mLastError = "RtGI: failed to allocate constant buffer."; return false; }
    mConstantBuffer->Map(0, nullptr, reinterpret_cast<void**>(&mMappedCB));
    return true;
}
