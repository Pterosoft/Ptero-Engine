bool RtAmbientOcclusion::Initialize(UINT width, UINT height)
{
    if (width == 0 || height == 0)
        return false;

    mLastError.clear();
    try
    {
        if (!mIsInitialized)
        {
            if (!CreateRootSignature()) return false;
            if (!CreatePipelines())    return false;
        }

        if (!mIsInitialized || width != mWidth || height != mHeight)
        {
            mWidth  = width;
            mHeight = height;
            if (!CreateResolutionBuffers()) return false;
            if (!CreateDescriptors())       return false;
            mFrameIndex = 0;
        }

        mIsInitialized = true;
        return true;
    }
    catch (const std::exception& ex)
    {
        mLastError  = std::string("RtAmbientOcclusion::Initialize: ") + ex.what();
        mInitFailed = true;
        return false;
    }
}

bool RtAmbientOcclusion::EnsureSize(UINT width, UINT height)
{
    if (width == mWidth && height == mHeight)
        return true;
    return Initialize(width, height);
}

void RtAmbientOcclusion::Shutdown()
{
    if (mMappedCb && mConstantBuffer)
    {
        mConstantBuffer->Unmap(0, nullptr);
        mMappedCb = nullptr;
    }
    mConstantBuffer.Reset();
    mRawAOBuffer.Reset();
    mAccumBuffer.Reset();
    mOutputBuffer.Reset();
    mPrevNormalDepthBuffer.Reset();
    mRootSignature.Reset();
    mPSO_RayGen.Reset();
    mPSO_Temporal.Reset();
    mPSO_Spatial.Reset();
    mPSO_CopyHistory.Reset();
    mIsInitialized         = false;
    mDescriptorsAllocated  = false;
}

void RtAmbientOcclusion::Dispatch(
    ID3D12GraphicsCommandList4*  cmdList,
    D3D12_GPU_DESCRIPTOR_HANDLE  gbufferNormalSrv,
    D3D12_GPU_DESCRIPTOR_HANDLE  tlasSrv,
    const RtAOSettings&          settings,
    const float                  viewProjInv[16],
    const float                  currViewProj[16],
    const float                  prevViewProj[16],
    const float                  cameraPos[3])
{
    UploadConstants(settings, viewProjInv, currViewProj, prevViewProj, cameraPos);

    const UINT gx = (mWidth  + kGroupSize - 1) / kGroupSize;
    const UINT gy = (mHeight + kGroupSize - 1) / kGroupSize;

    cmdList->SetComputeRootSignature(mRootSignature.Get());
    cmdList->SetComputeRootConstantBufferView(0, mConstantBuffer->GetGPUVirtualAddress());

    auto UavBarrier = [&](ID3D12Resource* r) {
        auto b = CD3DX12_RESOURCE_BARRIER::UAV(r);
        cmdList->ResourceBarrier(1, &b);
    };
    auto ToSrv = [&](ID3D12Resource* r) {
        auto b = CD3DX12_RESOURCE_BARRIER::Transition(
            r, D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
        cmdList->ResourceBarrier(1, &b);
    };
    auto ToUav = [&](ID3D12Resource* r) {
        auto b = CD3DX12_RESOURCE_BARRIER::Transition(
            r, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
            D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
        cmdList->ResourceBarrier(1, &b);
    };

    // ── Pass 0 – RayGen ──────────────────────────────────────────────────
    // Inputs:  t0=GBufferNormal   t1=TLAS
    // Output:  u0=RawAO (UAV)
    cmdList->SetPipelineState(mPSO_RayGen.Get());
    cmdList->SetComputeRootDescriptorTable(1, gbufferNormalSrv);
    cmdList->SetComputeRootDescriptorTable(2, tlasSrv);
    cmdList->SetComputeRootDescriptorTable(4, mRawAOUavGpu);
    cmdList->Dispatch(gx, gy, 1);

    UavBarrier(mRawAOBuffer.Get());

    // Transition RawAO UAV → SRV so Temporal can read it.
    ToSrv(mRawAOBuffer.Get());

    // ── Pass 1 – Temporal accumulation ───────────────────────────────────
    // Inputs:  t0=RawAO (SRV)     t1=AccumHistory (SRV)  t2=GBufferNormalDepth (SRV) t3=PrevNormalDepth (SRV)
    // Output:  u0=AccumWrite (UAV)
    cmdList->SetPipelineState(mPSO_Temporal.Get());
    cmdList->SetComputeRootDescriptorTable(1, mRawAOSrvGpu);
    cmdList->SetComputeRootDescriptorTable(2, mAccumHistorySrvGpu);
    cmdList->SetComputeRootDescriptorTable(3, gbufferNormalSrv);
    cmdList->SetComputeRootDescriptorTable(4, mPrevNormalDepthSrvGpu);
    cmdList->SetComputeRootDescriptorTable(5, mAccumUavGpu);
    cmdList->Dispatch(gx, gy, 1);

    UavBarrier(mAccumBuffer.Get());

    // Restore RawAO to UAV state for next frame's Pass 0 write.
    ToUav(mRawAOBuffer.Get());

    // Transition AccumBuffer UAV → SRV so Spatial can read it.
    ToSrv(mAccumBuffer.Get());

    // ── Pass 2 – Spatial bilateral filter ────────────────────────────────
    // Inputs:  t0=AccumAO (SRV)   t1=GBufferNormal (SRV)
    // Output:  u0=Output (UAV)
    ToUav(mOutputBuffer.Get());

    cmdList->SetPipelineState(mPSO_Spatial.Get());
    cmdList->SetComputeRootDescriptorTable(1, mAccumSrvGpu);
    cmdList->SetComputeRootDescriptorTable(2, gbufferNormalSrv);
    cmdList->SetComputeRootDescriptorTable(5, mOutputUavGpu);
    cmdList->Dispatch(gx, gy, 1);

    UavBarrier(mOutputBuffer.Get());

    // Transition Output UAV → non-pixel SRV so the deferred lighting pass can read it.
    ToSrv(mOutputBuffer.Get());

    // ── Pass 3 – Cache current-frame normal/depth for next frame validation ──
    ToUav(mPrevNormalDepthBuffer.Get());

    cmdList->SetPipelineState(mPSO_CopyHistory.Get());
    cmdList->SetComputeRootDescriptorTable(1, gbufferNormalSrv);
    cmdList->SetComputeRootDescriptorTable(5, mPrevNormalDepthUavGpu);
    cmdList->Dispatch(gx, gy, 1);

    UavBarrier(mPrevNormalDepthBuffer.Get());
    ToSrv(mPrevNormalDepthBuffer.Get());

    // Ping-pong the temporal buffers so this frame becomes next frame's history.
    std::swap(mAccumBuffer, mAccumHistoryBuffer);
    std::swap(mAccumSrvCpu, mAccumHistorySrvCpu);
    std::swap(mAccumSrvGpu, mAccumHistorySrvGpu);
    std::swap(mAccumUavCpu, mAccumHistoryUavCpu);
    std::swap(mAccumUavGpu, mAccumHistoryUavGpu);

    // The recycled write buffer was read as history this frame, so return it to UAV state.
    ToUav(mAccumBuffer.Get());

    ++mFrameIndex;
}

