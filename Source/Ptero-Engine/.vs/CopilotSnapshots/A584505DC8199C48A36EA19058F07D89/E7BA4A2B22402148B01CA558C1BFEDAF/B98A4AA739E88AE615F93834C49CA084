// RtAmbientOcclusion.cpp
// Ray Traced Ambient Occlusion renderer.
//
// Root signature layout (shared across all passes):
    //   param 0  – inline CBV  b0  (RtAOConstants, 256 bytes)
//   param 1  – SRV table   t0  (pass-specific input A: GBuffer normal / raw AO / accum AO)
//   param 2  – SRV table   t1  (pass-specific input B: TLAS / accum history / GBuffer)
//   param 3  – SRV table   t2  (temporal pass current-frame GBuffer normal+depth)
//   param 4  – SRV table   t3  (temporal pass previous-frame normal+depth)
//   param 5  – UAV table   u0  (pass-specific output)
//
// Per-frame pass sequence (8×8 thread groups, same as RTGI):
//   Pass 0  RayGen    t0=GBufferNormal  t1=TLAS        u0=RawAO
//   Pass 1  Temporal  t0=RawAO          t1=AccumHistory u0=AccumWrite
//   Pass 2  Spatial   t0=AccumWrite     t1=GBufferNormal u0=Output
//   Pass 3  CopyHist  t0=GBufferNormal  u0=PrevNormalDepth

#include "pch.h"
#include "RtAmbientOcclusion.h"

#include <algorithm>
#include <cstring>
#include <stdexcept>
#include <filesystem>

using Microsoft::WRL::ComPtr;

// ---- Context helpers declared in DX12Context.cpp -----------------------
extern "C"
{
    ID3D12Device* __stdcall DX12Context_GetDevice();
    ID3D12DescriptorHeap* __stdcall DX12Context_GetSrvDescriptorHeap();
    bool __stdcall DX12Context_AllocateSrvDescriptor(
        D3D12_CPU_DESCRIPTOR_HANDLE* cpuHandle,
        D3D12_GPU_DESCRIPTOR_HANDLE* gpuHandle);
}

// ---- Shader paths ------------------------------------------------------
static const wchar_t* kShaderRayGen   = L"Data/Shaders/RtAO_RayGen.hlsl";
static const wchar_t* kShaderTemporal = L"Data/Shaders/RtAO_Temporal.hlsl";
static const wchar_t* kShaderSpatial  = L"Data/Shaders/RtAO_Spatial.hlsl";
static const wchar_t* kShaderCopyHist = L"Data/Shaders/RtAO_CopyHistory.hlsl";

namespace
{
    constexpr DXGI_FORMAT kAOFormat  = DXGI_FORMAT_R16_FLOAT;
    constexpr DXGI_FORMAT kNormalDepthHistoryFormat = DXGI_FORMAT_R16G16B16A16_FLOAT;
    constexpr UINT        kGroupSize = 8; // must match [numthreads(8,8,1)] in HLSL

    bool AllocDesc(D3D12_CPU_DESCRIPTOR_HANDLE& cpu, D3D12_GPU_DESCRIPTOR_HANDLE& gpu, std::string& err)
    {
        if (!DX12Context_AllocateSrvDescriptor(&cpu, &gpu))
        {
            err = "RtAmbientOcclusion: ran out of SRV descriptor heap slots.";
            return false;
        }
        return true;
    }

    ComPtr<ID3D12Resource> MakeR16FTexture(
        ID3D12Device* dev,
        UINT w,
        UINT h,
        D3D12_RESOURCE_STATES initialState,
        LPCWSTR name)
    {
        D3D12_HEAP_PROPERTIES heap{};
        heap.Type = D3D12_HEAP_TYPE_DEFAULT;
        heap.CreationNodeMask = 1;
        heap.VisibleNodeMask  = 1;

        D3D12_RESOURCE_DESC desc{};
        desc.Dimension        = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
        desc.Width            = w;
        desc.Height           = h;
        desc.DepthOrArraySize = 1;
        desc.MipLevels        = 1;
        desc.Format           = kAOFormat;
        desc.SampleDesc.Count = 1;
        desc.Layout           = D3D12_TEXTURE_LAYOUT_UNKNOWN;
        desc.Flags            = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;

        ComPtr<ID3D12Resource> res;
        DX12_THROW_IF_FAILED(dev->CreateCommittedResource(
            &heap, D3D12_HEAP_FLAG_NONE, &desc,
            initialState, nullptr,
            IID_PPV_ARGS(&res)));
        res->SetName(name);
        return res;
    }

    ComPtr<ID3D12Resource> MakeTexture2D(
        ID3D12Device* dev,
        UINT w,
        UINT h,
        DXGI_FORMAT format,
        D3D12_RESOURCE_STATES initialState,
        LPCWSTR name)
    {
        D3D12_HEAP_PROPERTIES heap{};
        heap.Type = D3D12_HEAP_TYPE_DEFAULT;
        heap.CreationNodeMask = 1;
        heap.VisibleNodeMask = 1;

        D3D12_RESOURCE_DESC desc{};
        desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
        desc.Width = w;
        desc.Height = h;
        desc.DepthOrArraySize = 1;
        desc.MipLevels = 1;
        desc.Format = format;
        desc.SampleDesc.Count = 1;
        desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
        desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;

        ComPtr<ID3D12Resource> res;
        DX12_THROW_IF_FAILED(dev->CreateCommittedResource(
            &heap, D3D12_HEAP_FLAG_NONE, &desc,
            initialState, nullptr,
            IID_PPV_ARGS(&res)));
        res->SetName(name);
        return res;
    }

    ComPtr<ID3D12Resource> MakeUploadCB(ID3D12Device* dev, UINT64 size, void** outMapped)
    {
        D3D12_HEAP_PROPERTIES heap{};
        heap.Type = D3D12_HEAP_TYPE_UPLOAD;
        heap.CreationNodeMask = 1;
        heap.VisibleNodeMask  = 1;

        D3D12_RESOURCE_DESC desc{};
        desc.Dimension        = D3D12_RESOURCE_DIMENSION_BUFFER;
        desc.Width            = size;
        desc.Height           = 1;
        desc.DepthOrArraySize = 1;
        desc.MipLevels        = 1;
        desc.Format           = DXGI_FORMAT_UNKNOWN;
        desc.SampleDesc.Count = 1;
        desc.Layout           = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;

        ComPtr<ID3D12Resource> res;
        DX12_THROW_IF_FAILED(dev->CreateCommittedResource(
            &heap, D3D12_HEAP_FLAG_NONE, &desc,
            D3D12_RESOURCE_STATE_GENERIC_READ, nullptr,
            IID_PPV_ARGS(&res)));
        DX12_THROW_IF_FAILED(res->Map(0, nullptr, outMapped));
        res->SetName(L"RTAO_ConstantBuffer");
        return res;
    }

    bool CompilePSO(
        ID3D12Device*                dev,
        ID3D12RootSignature*         rootSig,
        const wchar_t*               filePath,
        const wchar_t*               entry,
        ComPtr<ID3D12PipelineState>& outPSO,
        std::string&                 err)
    {
        ShaderCompileRequest req{};
        req.FilePath      = filePath;
        req.EntryPoint    = entry;
        req.TargetProfile = L"cs_6_5";
        req.Stage         = ShaderStage::Compute;

        DX12Shader shader;
        if (!shader.Compile(req))
        {
            err = std::string("RtAmbientOcclusion: shader compile failed ('")
                + (shader.GetLastErrorMessage() ? shader.GetLastErrorMessage() : "?") + "')";
            return false;
        }

        D3D12_COMPUTE_PIPELINE_STATE_DESC psoDesc{};
        psoDesc.pRootSignature = rootSig;
        psoDesc.CS             = shader.GetBytecode();
        if (FAILED(dev->CreateComputePipelineState(&psoDesc, IID_PPV_ARGS(&outPSO))))
        {
            err = "RtAmbientOcclusion: CreateComputePipelineState failed.";
            return false;
        }
        return true;
    }
} // namespace

