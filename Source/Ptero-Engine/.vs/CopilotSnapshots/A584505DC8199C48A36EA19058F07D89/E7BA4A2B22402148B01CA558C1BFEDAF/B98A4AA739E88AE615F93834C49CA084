bool RtAmbientOcclusion::CreateRootSignature()
{
    ID3D12Device* dev = DX12Context_GetDevice();
    if (!dev)
    {
        mLastError = "RtAmbientOcclusion: no D3D12 device.";
        return false;
    }

    // Slot 0: inline CBV  b0
    // Slot 1: SRV table   t0 (1 descriptor)
    // Slot 2: SRV table   t1 (1 descriptor)
    // Slot 3: SRV table   t2 (1 descriptor)
    // Slot 4: SRV table   t3 (1 descriptor)
    // Slot 5: UAV table   u0 (1 descriptor)
    D3D12_DESCRIPTOR_RANGE srvRange0{ D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 0, 0, 0 };
    D3D12_DESCRIPTOR_RANGE srvRange1{ D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 1, 0, 0 };
    D3D12_DESCRIPTOR_RANGE srvRange2{ D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 2, 0, 0 };
    D3D12_DESCRIPTOR_RANGE srvRange3{ D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 3, 0, 0 };
    D3D12_DESCRIPTOR_RANGE uavRange0{ D3D12_DESCRIPTOR_RANGE_TYPE_UAV, 1, 0, 0, 0 };

    D3D12_ROOT_PARAMETER params[6]{};
    // param 0 – CBV
    params[0].ParameterType             = D3D12_ROOT_PARAMETER_TYPE_CBV;
    params[0].Descriptor.ShaderRegister = 0;
    params[0].Descriptor.RegisterSpace  = 0;
    params[0].ShaderVisibility          = D3D12_SHADER_VISIBILITY_ALL;
    // param 1 – SRV table (t0)
    params[1].ParameterType                       = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
    params[1].DescriptorTable.NumDescriptorRanges = 1;
    params[1].DescriptorTable.pDescriptorRanges   = &srvRange0;
    params[1].ShaderVisibility                    = D3D12_SHADER_VISIBILITY_ALL;
    // param 2 – SRV table (t1)
    params[2].ParameterType                       = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
    params[2].DescriptorTable.NumDescriptorRanges = 1;
    params[2].DescriptorTable.pDescriptorRanges   = &srvRange1;
    params[2].ShaderVisibility                    = D3D12_SHADER_VISIBILITY_ALL;
    // param 3 – SRV table (t2)
    params[3].ParameterType                       = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
    params[3].DescriptorTable.NumDescriptorRanges = 1;
    params[3].DescriptorTable.pDescriptorRanges   = &srvRange2;
    params[3].ShaderVisibility                    = D3D12_SHADER_VISIBILITY_ALL;
    // param 4 – SRV table (t3)
    params[4].ParameterType                       = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
    params[4].DescriptorTable.NumDescriptorRanges = 1;
    params[4].DescriptorTable.pDescriptorRanges   = &srvRange3;
    params[4].ShaderVisibility                    = D3D12_SHADER_VISIBILITY_ALL;
    // param 5 – UAV table (u0)
    params[5].ParameterType                       = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
    params[5].DescriptorTable.NumDescriptorRanges = 1;
    params[5].DescriptorTable.pDescriptorRanges   = &uavRange0;
    params[5].ShaderVisibility                    = D3D12_SHADER_VISIBILITY_ALL;

    D3D12_ROOT_SIGNATURE_DESC rsDesc{};
    rsDesc.NumParameters     = 6;
    rsDesc.pParameters       = params;
    rsDesc.Flags             = D3D12_ROOT_SIGNATURE_FLAG_NONE;

    ComPtr<ID3DBlob> serialised, errors;
    if (FAILED(D3D12SerializeRootSignature(&rsDesc, D3D_ROOT_SIGNATURE_VERSION_1_0,
        &serialised, &errors)))
    {
        mLastError = "RtAmbientOcclusion: D3D12SerializeRootSignature failed.";
        return false;
    }

    if (FAILED(dev->CreateRootSignature(0, serialised->GetBufferPointer(),
        serialised->GetBufferSize(), IID_PPV_ARGS(&mRootSignature))))
    {
        mLastError = "RtAmbientOcclusion: CreateRootSignature failed.";
        return false;
    }
    mRootSignature->SetName(L"RTAO_RootSignature");
    return true;
}

bool RtAmbientOcclusion::CreatePipelines()
{
    ID3D12Device* dev = DX12Context_GetDevice();

    if (!CompilePSO(dev, mRootSignature.Get(), kShaderRayGen,   L"main", mPSO_RayGen,   mLastError)) return false;
    if (!CompilePSO(dev, mRootSignature.Get(), kShaderTemporal, L"main", mPSO_Temporal, mLastError)) return false;
    if (!CompilePSO(dev, mRootSignature.Get(), kShaderSpatial,  L"main", mPSO_Spatial,  mLastError)) return false;
    if (!CompilePSO(dev, mRootSignature.Get(), kShaderCopyHist, L"main", mPSO_CopyHistory, mLastError)) return false;
    return true;
}

bool RtAmbientOcclusion::CreateResolutionBuffers()
{
    ID3D12Device* dev = DX12Context_GetDevice();

    // Release previous resolution-dependent resources.
    mRawAOBuffer.Reset();
    mAccumBuffer.Reset();
    mAccumHistoryBuffer.Reset();
    mPrevNormalDepthBuffer.Reset();
    mOutputBuffer.Reset();
    if (mMappedCb && mConstantBuffer)
    {
        mConstantBuffer->Unmap(0, nullptr);
        mMappedCb = nullptr;
    }
    mConstantBuffer.Reset();

    mRawAOBuffer        = MakeR16FTexture(dev, mWidth, mHeight, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, L"RTAO_RawAO");
    mAccumBuffer        = MakeR16FTexture(dev, mWidth, mHeight, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, L"RTAO_AccumWrite");
    mAccumHistoryBuffer = MakeR16FTexture(dev, mWidth, mHeight, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, L"RTAO_AccumHistory");
    mPrevNormalDepthBuffer = MakeTexture2D(dev, mWidth, mHeight, kNormalDepthHistoryFormat, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, L"RTAO_PrevNormalDepth");
    mOutputBuffer       = MakeR16FTexture(dev, mWidth, mHeight, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, L"RTAO_Output");
    mConstantBuffer = MakeUploadCB(dev, sizeof(RtAOConstants), &mMappedCb);
    return true;
}

bool RtAmbientOcclusion::CreateDescriptors()
{
    ID3D12Device* dev = DX12Context_GetDevice();
    const UINT srvSize = dev->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);

    // Allocate 10 descriptor slots: SRV+UAV for RawAO, AccumWrite, AccumHistory, PrevNormalDepth, and Output.
    if (!mDescriptorsAllocated)
    {
        if (!AllocDesc(mRawAOSrvCpu,  mRawAOSrvGpu,  mLastError)) return false;
        if (!AllocDesc(mRawAOUavCpu,  mRawAOUavGpu,  mLastError)) return false;
        if (!AllocDesc(mAccumSrvCpu,  mAccumSrvGpu,  mLastError)) return false;
        if (!AllocDesc(mAccumUavCpu,  mAccumUavGpu,  mLastError)) return false;
        if (!AllocDesc(mAccumHistorySrvCpu,  mAccumHistorySrvGpu,  mLastError)) return false;
        if (!AllocDesc(mAccumHistoryUavCpu,  mAccumHistoryUavGpu,  mLastError)) return false;
        if (!AllocDesc(mPrevNormalDepthSrvCpu,  mPrevNormalDepthSrvGpu,  mLastError)) return false;
        if (!AllocDesc(mPrevNormalDepthUavCpu,  mPrevNormalDepthUavGpu,  mLastError)) return false;
        if (!AllocDesc(mOutputSrvCpu, mOutputSrvGpu, mLastError)) return false;
        if (!AllocDesc(mOutputUavCpu, mOutputUavGpu, mLastError)) return false;
        mDescriptorsAllocated = true;
    }

    auto MakeSrv = [&](ID3D12Resource* res, D3D12_CPU_DESCRIPTOR_HANDLE cpu)
    {
        D3D12_SHADER_RESOURCE_VIEW_DESC d{};
        d.Format                  = kAOFormat;
        d.ViewDimension           = D3D12_SRV_DIMENSION_TEXTURE2D;
        d.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
        d.Texture2D.MipLevels     = 1;
        dev->CreateShaderResourceView(res, &d, cpu);
    };

    auto MakeUav = [&](ID3D12Resource* res, D3D12_CPU_DESCRIPTOR_HANDLE cpu)
    {
        D3D12_UNORDERED_ACCESS_VIEW_DESC d{};
        d.Format        = kAOFormat;
        d.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
        dev->CreateUnorderedAccessView(res, nullptr, &d, cpu);
    };

    auto MakeNormalDepthSrv = [&](ID3D12Resource* res, D3D12_CPU_DESCRIPTOR_HANDLE cpu)
    {
        D3D12_SHADER_RESOURCE_VIEW_DESC d{};
        d.Format                  = kNormalDepthHistoryFormat;
        d.ViewDimension           = D3D12_SRV_DIMENSION_TEXTURE2D;
        d.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
        d.Texture2D.MipLevels     = 1;
        dev->CreateShaderResourceView(res, &d, cpu);
    };

    auto MakeNormalDepthUav = [&](ID3D12Resource* res, D3D12_CPU_DESCRIPTOR_HANDLE cpu)
    {
        D3D12_UNORDERED_ACCESS_VIEW_DESC d{};
        d.Format        = kNormalDepthHistoryFormat;
        d.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
        dev->CreateUnorderedAccessView(res, nullptr, &d, cpu);
    };

    MakeSrv(mRawAOBuffer.Get(),  mRawAOSrvCpu);
    MakeUav(mRawAOBuffer.Get(),  mRawAOUavCpu);
    MakeSrv(mAccumBuffer.Get(),  mAccumSrvCpu);
    MakeUav(mAccumBuffer.Get(),  mAccumUavCpu);
    MakeSrv(mAccumHistoryBuffer.Get(),  mAccumHistorySrvCpu);
    MakeUav(mAccumHistoryBuffer.Get(),  mAccumHistoryUavCpu);
    MakeNormalDepthSrv(mPrevNormalDepthBuffer.Get(),  mPrevNormalDepthSrvCpu);
    MakeNormalDepthUav(mPrevNormalDepthBuffer.Get(),  mPrevNormalDepthUavCpu);
    MakeSrv(mOutputBuffer.Get(), mOutputSrvCpu);
    MakeUav(mOutputBuffer.Get(), mOutputUavCpu);
    return true;
}

void RtAmbientOcclusion::UploadConstants(
    const RtAOSettings& s,
    const float viewProjInv[16],
    const float currViewProj[16],
    const float prevViewProj[16],
    const float cameraPos[3])
{
    RtAOConstants cb{};
    cb.FrameWidth        = mWidth;
    cb.FrameHeight       = mHeight;
    cb.FrameIndex        = mFrameIndex;
    cb.RaysPerPixel      = static_cast<uint32_t>((std::max)(1, s.RaysPerPixel));
    cb.MaxRayLength      = s.MaxRayLength;
    cb.RayBias           = s.RayBias;
    cb.AOPower           = s.AOPower;
    cb.AccumulationBlend = s.AccumulationBlend;
    cb.DenoiseSharpness  = s.DenoiseSharpness;
    cb.DebugView         = s.DebugView;
    cb.Intensity         = s.Intensity;
    std::memcpy(cb.ViewProjInv, viewProjInv, 16 * sizeof(float));
    std::memcpy(cb.CurrViewProj, currViewProj, 16 * sizeof(float));
    std::memcpy(cb.PrevViewProj, prevViewProj, 16 * sizeof(float));
    std::memcpy(cb.CameraPos,   cameraPos,   3  * sizeof(float));
    std::memcpy(mMappedCb, &cb, sizeof(cb));
}
