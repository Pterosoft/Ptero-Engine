// SharcGI.hlsl
// DXR Global Illumination using NVIDIA SHARC (Spatial Hash Radiance Cache).
//
// Frame flow:
//   1. RayGen shader fires one ray per G-Buffer pixel from world positions
//      reconstructed from the depth buffer.
//   2. On each hit, the closest-hit shader looks up cached irradiance from
//      the SHARC resolved buffer, or falls back to a direct-lighting estimate,
//      and accumulates that radiance back into the SHARC hash grid.
//   3. The miss shader contributes sky radiance to SHARC entries near the
//      camera horizon and writes zero to the screen-space GI output on a miss.
//   4. After all rays finish the RayGen shader writes the screen-space GI
//      result to the output UAV for the deferred-lighting pass to consume.
//   5. A separate compute dispatch (SharcResolve.hlsl) ages and resolves
//      all SHARC hash entries so they are ready for the next frame's queries.
//
// Compile as: dxc -T lib_6_3 SharcGI.hlsl

#pragma pack_matrix(row_major)

#define SHARC_RADIANCE_SCALE 1e3f
#include "SharcCommon.h"

// ---------------------------------------------------------------------------
// Per-frame constant buffer
// ---------------------------------------------------------------------------
struct PointLightGpu
{
    float3 Position;
    float  Radius;
    float3 Color;
    float  InvRadiusSq;
};

cbuffer SharcGiConstants : register(b0)
{
    float4x4  gInvViewProj;          // inverse jittered view-projection (row-major, pre-transposed)
    float3    gCameraPos;     float  _c0;
    float3    gSunDir;        float  _c1;   // direction FROM sun toward scene
    float3    gSunColor;      float  _c2;
    float3    gSkyAmbient;    float  _c3;
    float     gMaxRayDist;
    int       gBounceCount;
    int       gRaysPerPixel;
    float     gAccumAlpha;
    int       gFrameIndex;
    int       gSkylightOnMiss;
    int       gNumPointLights;
    int       gResetAccumulation;
    // SHARC grid parameters
    float     gSharcSceneScale;
    int       gSharcAccumFrames;
    float     gSharcRoughnessThreshold;
    int       gSharcDownscaleFactor;
    // Lighting extras
    float     gSaturation;
    int       gDebugAlbedoOnly;
    float2    _cPad;
    // Point lights follow
    PointLightGpu gPointLights[16];
};

// ---------------------------------------------------------------------------
// Resource bindings
// ---------------------------------------------------------------------------
// G-Buffer inputs (space 0)
Texture2D<float4>  gGBufferNormal   : register(t0);   // encoded world normal
Texture2D<float>   gDepthBuffer     : register(t1);   // scene depth
Texture2D<float4>  gHistory         : register(t2);   // previous-frame GI accumulation
RaytracingAccelerationStructure gTlas : register(t3);
// RT geometry buffers
struct RtVertexGpu { float3 Position; float _p0; float3 Normal; float _p1; float2 TexCoord; float2 _p2; };
StructuredBuffer<RtVertexGpu>  gRtVertices  : register(t4);
ByteAddressBuffer               gRtIndices   : register(t5);
struct RtInstanceGpu { uint VertexOffset; uint IndexOffset; uint AlbedoSrvLo; uint AlbedoSrvHi; };
StructuredBuffer<RtInstanceGpu> gRtInstances : register(t6);
Texture2D<float4>   gPrimaryAlbedo  : register(t7);   // G-Buffer albedo for first hit

// Output UAVs (space 0)
RWTexture2D<float4>  gAccumOutput    : register(u0);  // screen-space GI result

// SHARC hash-grid UAVs (space 1)
RWStructuredBuffer<uint64_t>               u_SharcHashEntries    : register(u0, space1);
RWStructuredBuffer<SharcAccumulationData>  u_SharcAccumBuffer    : register(u1, space1);
RWStructuredBuffer<SharcPackedData>        u_SharcResolvedBuffer : register(u2, space1);

// Per-instance albedo textures (local root signature)
Texture2D<float4>   gHitAlbedoTexture : register(t8, space0);

SamplerState gAlbedoSampler : register(s0);

// ---------------------------------------------------------------------------
// Utility: reconstruct world position from screen UV + depth
// ---------------------------------------------------------------------------
float3 ReconstructWorldPos(float2 uv, float depth)
{
    float4 ndc = float4(uv.x * 2.0f - 1.0f, 1.0f - uv.y * 2.0f, depth, 1.0f);
    float4 w   = mul(ndc, gInvViewProj);
    return w.xyz / w.w;
}

// ---------------------------------------------------------------------------
// PRNG helpers
// ---------------------------------------------------------------------------
uint WangHash(uint s) { s=(s^61u)^(s>>16u); s*=9u; s^=(s>>4u); s*=0x27D4EB2Du; s^=(s>>15u); return s; }
float UintToFloat01(uint x) { return (float)(x & 0x00FFFFFFu) * (1.0f / (float)0x01000000u); }

float2 SampleHalton(uint idx)
{
    // Base-2 radical inverse
    uint bits = idx;
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    float r2 = (float)bits * 2.3283064365386963e-10f;
    // Base-3 radical inverse
    float r3 = 0.0f; float base3 = 1.0f / 3.0f; uint n = idx;
    while (n > 0u) { r3 += (float)(n % 3u) * base3; base3 /= 3.0f; n /= 3u; }
    return float2(r2, r3);
}

float3 CosineSampleHemisphere(float3 N, float2 xi)
{
    float3 up = (abs(N.z) < 0.999f) ? float3(0,0,1) : float3(1,0,0);
    float3 T  = normalize(cross(up, N));
    float3 B  = cross(N, T);
    float r   = sqrt(xi.x);
    float phi = 6.28318530718f * xi.y;
    return normalize(T * (r * cos(phi)) + B * (r * sin(phi)) + N * sqrt(max(0.0f, 1.0f - xi.x)));
}

float3 FaceForward(float3 N, float3 incident)
{
    return (dot(N, incident) > 0.0f) ? -N : N;
}

// ---------------------------------------------------------------------------
// Ray payload
// ---------------------------------------------------------------------------
struct GiPayload
{
    float3 Radiance;
    float3 HitAlbedo;
    float3 HitNormal;
    float3 HitWorldPos;
    uint   Hit;
};

struct ShadowPayload
{
    float Visibility; // 1 = unoccluded, 0 = shadowed
};

struct TriAttributes { float2 Barycentrics; };

// ---------------------------------------------------------------------------
// Shading helpers
// ---------------------------------------------------------------------------
float3 ShadeDirectSun(float3 hitPos, float3 N, float3 albedo,
                      float3 sunDir, float3 sunColor)
{
    float3 L = -sunDir; // sunDir points FROM sun TOWARD scene; flip for lighting
    float NdotL = saturate(dot(N, L));
    if (NdotL <= 0.0f) return float3(0,0,0);

    // Cast a shadow ray toward the sun
    RayDesc shadowRay;
    shadowRay.Origin    = hitPos + N * 0.002f;
    shadowRay.Direction = L;
    shadowRay.TMin      = 0.001f;
    shadowRay.TMax      = gMaxRayDist;

    ShadowPayload shadowPayload;
    shadowPayload.Visibility = 1.0f;
    TraceRay(gTlas,
        RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER,
        0xFF, 1, 0, 1, shadowRay, shadowPayload);

    return albedo * sunColor * NdotL * shadowPayload.Visibility * (1.0f / 3.14159265f);
}

float3 ShadePointLights(float3 hitPos, float3 N, float3 albedo)
{
    float3 result = float3(0,0,0);
    for (int i = 0; i < gNumPointLights; ++i)
    {
        float3 toLight = gPointLights[i].Position - hitPos;
        float  dist2   = dot(toLight, toLight);
        if (dist2 < 1e-6f) continue;
        float  dist    = sqrt(dist2);
        float3 L       = toLight / dist;
        float  NdotL   = saturate(dot(N, L));
        if (NdotL <= 0.0f) continue;
        float  atten   = saturate(1.0f - dist2 * gPointLights[i].InvRadiusSq);
        atten *= atten;
        result += albedo * gPointLights[i].Color * NdotL * atten * (1.0f / 3.14159265f);
    }
    return result;
}

// ---------------------------------------------------------------------------
// Closest-hit shader
// ---------------------------------------------------------------------------
[shader("closesthit")]
void ClosestHit(inout GiPayload payload, in TriAttributes attr)
{
    payload.Hit = 1u;

    RtInstanceGpu inst   = gRtInstances[InstanceID()];
    uint triBase         = inst.IndexOffset + PrimitiveIndex() * 3u;
    uint i0 = gRtIndices.Load(triBase * 4u);
    uint i1 = gRtIndices.Load(triBase * 4u + 4u);
    uint i2 = gRtIndices.Load(triBase * 4u + 8u);

    RtVertexGpu v0 = gRtVertices[i0];
    RtVertexGpu v1 = gRtVertices[i1];
    RtVertexGpu v2 = gRtVertices[i2];

    float2 bary = attr.Barycentrics;
    float3 N    = normalize(v0.Normal * (1.0f - bary.x - bary.y) +
                            v1.Normal * bary.x +
                            v2.Normal * bary.y);
    float2 uv   = v0.TexCoord * (1.0f - bary.x - bary.y) +
                  v1.TexCoord * bary.x +
                  v2.TexCoord * bary.y;

    float3 worldPos = v0.Position * (1.0f - bary.x - bary.y) +
                      v1.Position * bary.x +
                      v2.Position * bary.y;

    // Face-forward normal so back-faces are shaded correctly
    N = FaceForward(N, WorldRayDirection());

    // Sample albedo texture (bound via local root signature)
    float3 albedo = gHitAlbedoTexture.SampleLevel(gAlbedoSampler, uv, 0.0f).rgb;
    albedo = saturate(albedo);

    // Apply saturation
    float lum = dot(albedo, float3(0.2126f, 0.7152f, 0.0722f));
    albedo = lerp(float3(lum, lum, lum), albedo, gSaturation);

    payload.HitAlbedo   = albedo;
    payload.HitNormal   = N;
    payload.HitWorldPos = worldPos;

    // Direct lighting estimate for this hit point (used as SHARC update radiance)
    float3 directLit = ShadeDirectSun(worldPos, N, albedo, gSunDir, gSunColor)
                     + ShadePointLights(worldPos, N, albedo);

    // Query SHARC cache for indirect radiance at this hit point
    SharcParameters sharcParams;
    sharcParams.gridParameters.cameraPosition = gCameraPos;
    sharcParams.gridParameters.sceneScale     = gSharcSceneScale;
    sharcParams.gridParameters.logarithmBase  = SHARC_GRID_LOGARITHM_BASE;
    sharcParams.gridParameters.levelBias      = SHARC_GRID_LEVEL_BIAS;
    sharcParams.hashMapData.capacity          = (1u << SHARC_CAPACITY_LOG2);
    sharcParams.hashMapData.hashEntriesBuffer = u_SharcHashEntries;
    sharcParams.accumulationBuffer            = u_SharcAccumBuffer;
    sharcParams.resolvedBuffer                = u_SharcResolvedBuffer;
    sharcParams.radianceScale                 = SHARC_RADIANCE_SCALE;

    float3 cachedIndirect = float3(0,0,0);
    bool   hadCachedGI    = SharcGetCachedRadiance(worldPos, sharcParams, cachedIndirect);

    // Outgoing radiance toward the ray origin = direct + cached indirect
    float3 outRadiance = directLit + (hadCachedGI ? cachedIndirect * albedo : float3(0,0,0));

    // Feed back direct lighting into SHARC so subsequent bounces can query it
    SharcUpdateEntry(worldPos, directLit, sharcParams);

    payload.Radiance = outRadiance;
}

// ---------------------------------------------------------------------------
// Miss shaders
// ---------------------------------------------------------------------------
[shader("miss")]
void Miss(inout GiPayload payload)
{
    payload.Hit = 0u;
    // Return sky radiance only for secondary bounces inside the SHARC cache update path
    // (closest-hit fires secondary rays that can miss geometry). For the screen-space raygen
    // path the raygen shader handles misses itself without calling this shader's result,
    // but we still provide it so secondary-bounce queries inside ShadeDirectSun can see sky.
    payload.Radiance = (gSkylightOnMiss != 0) ? gSkyAmbient : float3(0.0f, 0.0f, 0.0f);
}

[shader("miss")]
void ShadowMiss(inout ShadowPayload payload)
{
    payload.Visibility = 1.0f;
}

// ---------------------------------------------------------------------------
// Ray-generation shader
// ---------------------------------------------------------------------------
[shader("raygeneration")]
void RayGen()
{
    uint2 launchIdx  = DispatchRaysIndex().xy;
    uint2 launchDims = DispatchRaysDimensions().xy;

    // Downscale: only fire rays for pixels whose coordinates are on the grid.
    // Other pixels copy from their nearest neighbour via temporal accumulation.
    // This dramatically reduces ray count without eliminating the accum texture write.
    int ds = max(1, gSharcDownscaleFactor);
    if (ds > 1 && ((int(launchIdx.x) % ds) != 0 || (int(launchIdx.y) % ds) != 0))
        return;

    float2 uv = (float2(launchIdx) + 0.5f) / float2(launchDims);

    // Read G-Buffer depth
    float depth = gDepthBuffer.Load(int3(launchIdx, 0)).r;
    if (depth >= 1.0f)
    {
        // Sky pixel — no GI contribution
        if (gResetAccumulation != 0)
            gAccumOutput[launchIdx] = float4(0, 0, 0, 0);
        return;
    }

    float3 worldPos = ReconstructWorldPos(uv, depth);

    // Read G-Buffer normal
    float4 normalSample = gGBufferNormal.Load(int3(launchIdx, 0));
    float3 N = normalize(normalSample.xyz * 2.0f - 1.0f);

    // Read primary albedo
    float3 primaryAlbedo = gPrimaryAlbedo.Load(int3(launchIdx, 0)).rgb;
    primaryAlbedo = saturate(primaryAlbedo);

    // Apply saturation to primary albedo
    float lum = dot(primaryAlbedo, float3(0.2126f, 0.7152f, 0.0722f));
    primaryAlbedo = lerp(float3(lum, lum, lum), primaryAlbedo, gSaturation);

    if (gDebugAlbedoOnly != 0)
    {
        gAccumOutput[launchIdx] = float4(primaryAlbedo, 1.0f);
        return;
    }

    // Use the known constant capacity for the SHARC hash map.
    uint sharcCapacity = (1u << SHARC_CAPACITY_LOG2);

    SharcParameters sharcParams;
    sharcParams.gridParameters.cameraPosition = gCameraPos;
    sharcParams.gridParameters.sceneScale     = gSharcSceneScale;
    sharcParams.gridParameters.logarithmBase  = SHARC_GRID_LOGARITHM_BASE;
    sharcParams.gridParameters.levelBias      = SHARC_GRID_LEVEL_BIAS;
    sharcParams.hashMapData.capacity          = max(1u, sharcCapacity);
    sharcParams.hashMapData.hashEntriesBuffer = u_SharcHashEntries;
    sharcParams.accumulationBuffer            = u_SharcAccumBuffer;
    sharcParams.resolvedBuffer                = u_SharcResolvedBuffer;
    sharcParams.radianceScale                 = SHARC_RADIANCE_SCALE;

    // Accumulate GI radiance over gRaysPerPixel samples.
    float3 giAccum = float3(0, 0, 0);

    for (int s = 0; s < gRaysPerPixel; ++s)
    {
        // Build a per-sample seed from frame index, pixel, and sample index.
        uint seed = WangHash((uint)(gFrameIndex * 65537 + launchIdx.y * launchDims.x + launchIdx.x) ^ (uint)(s * 1234567));
        float2 xi = frac(SampleHalton((uint)(gFrameIndex * gRaysPerPixel + s))
                        + float2(UintToFloat01(seed), UintToFloat01(WangHash(seed))));

        float3 rayDir = CosineSampleHemisphere(N, xi);

        // Offset ray origin slightly above the surface to prevent self-intersection.
        float3 rayOrigin = worldPos + N * 0.003f;

        // First attempt: query SHARC for cached indirect radiance at the primary surface.
        // If a valid cache entry exists we can skip the ray and use the cached value.
        float3 cachedRadiance = float3(0,0,0);
        bool hadCache = SharcGetCachedRadiance(worldPos, sharcParams, cachedRadiance);

        float3 sampleRadiance = float3(0,0,0);
        if (hadCache)
        {
            // Use cached value modulated by primary albedo and cosine weight.
            sampleRadiance = cachedRadiance * primaryAlbedo;
        }
        else
        {
            // No cache hit — fire a ray to gather direct lighting and populate SHARC.
            RayDesc ray;
            ray.Origin    = rayOrigin;
            ray.Direction = rayDir;
            ray.TMin      = 0.001f;
            ray.TMax      = gMaxRayDist;

            GiPayload payload;
            payload.Radiance   = float3(0,0,0);
            payload.HitAlbedo  = float3(0,0,0);
            payload.HitNormal  = float3(0,0,0);
            payload.HitWorldPos= float3(0,0,0);
            payload.Hit        = 0u;

            TraceRay(gTlas, RAY_FLAG_NONE, 0xFF, 0, 0, 0, ray, payload);

            if (payload.Hit != 0u)
            {
                // Store the gathered radiance back into SHARC at the primary hit position.
                SharcUpdateEntry(worldPos, payload.Radiance, sharcParams);
                sampleRadiance = payload.Radiance * primaryAlbedo;
            }
            // NOTE: Do NOT add sky ambient here on a miss – the deferred lighting pass
            // already applies gSkyAmbient as a hemisphere ambient term to every surface.
            // Adding it here too would cause a heavy blue double-contribution.
        }

        giAccum += sampleRadiance;
    }

    float3 giResult = giAccum / (float)max(gRaysPerPixel, 1);

    // Temporal accumulation with history buffer.
    float3 history   = gHistory.Load(int3(launchIdx, 0)).rgb;
    float  alpha     = gAccumAlpha;
    if (gResetAccumulation != 0) alpha = 1.0f; // full overwrite on camera move/reset

    float3 blended = lerp(history, giResult, alpha);

    gAccumOutput[launchIdx] = float4(blended, 1.0f);
}
