    constexpr UINT AlignUp(UINT value, UINT alignment)
    {
        return (value + alignment - 1u) & ~(alignment - 1u);
    }

    // ---------------------------------------------------------------------------
    // GPU buffer creation helpers
    // ---------------------------------------------------------------------------

    bool CreateGpuBuffer(ID3D12Device* dev, UINT64 size,
        D3D12_RESOURCE_FLAGS flags, D3D12_RESOURCE_STATES state,
        ComPtr<ID3D12Resource>& out)
    {
        D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
        D3D12_RESOURCE_DESC d{};
        d.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
        d.Width = size; d.Height = 1; d.DepthOrArraySize = 1; d.MipLevels = 1;
        d.Format = DXGI_FORMAT_UNKNOWN; d.SampleDesc.Count = 1;
        d.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; d.Flags = flags;
        return SUCCEEDED(dev->CreateCommittedResource(
            &hp, D3D12_HEAP_FLAG_NONE, &d, state, nullptr, IID_PPV_ARGS(&out)));
    }

    bool CreateUploadBuf(ID3D12Device* dev, UINT64 size, ComPtr<ID3D12Resource>& out)
    {
        D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
        D3D12_RESOURCE_DESC d{};
        d.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
        d.Width = size; d.Height = 1; d.DepthOrArraySize = 1; d.MipLevels = 1;
        d.Format = DXGI_FORMAT_UNKNOWN; d.SampleDesc.Count = 1;
        d.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; d.Flags = D3D12_RESOURCE_FLAG_NONE;
        return SUCCEEDED(dev->CreateCommittedResource(
            &hp, D3D12_HEAP_FLAG_NONE, &d, D3D12_RESOURCE_STATE_GENERIC_READ,
            nullptr, IID_PPV_ARGS(&out)));
    }

    bool CreateRgba16Tex(ID3D12Device* dev, UINT w, UINT h,
        D3D12_RESOURCE_FLAGS flags, D3D12_RESOURCE_STATES state,
        ComPtr<ID3D12Resource>& out)
    {
        D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
        D3D12_RESOURCE_DESC d{};
        d.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
        d.Width = w; d.Height = h; d.DepthOrArraySize = 1; d.MipLevels = 1;
        d.Format = DXGI_FORMAT_R16G16B16A16_FLOAT; d.SampleDesc.Count = 1;
        d.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN; d.Flags = flags;
        return SUCCEEDED(dev->CreateCommittedResource(
            &hp, D3D12_HEAP_FLAG_NONE, &d, state, nullptr, IID_PPV_ARGS(&out)));
    }

    // ---------------------------------------------------------------------------
    // Material albedo loading (same as old RtGlobalIllumination)
    // ---------------------------------------------------------------------------
    std::string ResolveDataPath(const std::string& relPath, const std::string& near)
    {
        if (relPath.empty()) return {};
        namespace fs = std::filesystem;
        fs::path current = fs::path(near).parent_path();
        while (!current.empty())
        {
            fs::path candidate = current.parent_path() / "Data" / relPath;
            if (fs::exists(candidate)) return candidate.string();
            candidate = current / relPath;
            if (current.filename() == "Data" && fs::exists(candidate))
                return candidate.string();
            const auto parent = current.parent_path();
            if (parent == current) break;
            current = parent;
        }
        return {};
    }

    struct MaterialAlbedoBinding
    {
        std::string AbsolutePath;
        D3D12_GPU_DESCRIPTOR_HANDLE GpuHandle{};
    };

    MaterialAlbedoBinding LoadMaterialAlbedoBinding(
        TextureManager& textureManager, const std::string& materialPath)
    {
        MaterialAlbedoBinding result{};
        if (materialPath.empty()) return result;
        try
        {
            std::ifstream f{ materialPath };
            if (!f.is_open()) return result;
            nlohmann::json j;
            f >> j;

            const auto tryNode = [&](const nlohmann::json& node) -> bool
            {
                auto texIt = node.find("textures");
                if (texIt == node.end()) return false;
                auto bcIt = texIt->find("baseColor");
                if (bcIt == texIt->end()) return false;
                const std::string relPath = bcIt->get<std::string>();
                if (relPath.empty()) return false;
                const std::string absPath = ResolveDataPath(relPath, materialPath);
                if (absPath.empty()) return false;
                if (auto gpuTex = textureManager.LoadDDS(absPath))
                {
                    result.AbsolutePath = absPath;
                    result.GpuHandle    = gpuTex->GpuHandle;
                    return true;
                }
                return false;
            };

            const std::string type = j.value("type", std::string{});
            if (type == "MultiMaterial")
            {
                auto subMatsIt = j.find("subMaterials");
                if (subMatsIt != j.end() && subMatsIt->is_array())
                {
                    for (const auto& sub : *subMatsIt)
                        if (tryNode(sub)) break;
                }
            }
            else
            {
                tryNode(j);
            }
        }
        catch (...) {}
        return result;
    }
} // anonymous namespace

