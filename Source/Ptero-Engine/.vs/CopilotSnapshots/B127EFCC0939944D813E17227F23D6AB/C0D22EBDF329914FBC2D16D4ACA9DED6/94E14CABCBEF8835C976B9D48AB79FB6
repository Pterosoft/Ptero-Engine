bool SharcGlobalIllumination::Initialize(UINT width, UINT height)
{
    mLastError.clear();
    mIsInitialized = false;
    OutputDebugStringA("SharcGI::Initialize - CheckDxrSupport\n");
    if (!CheckDxrSupport())           { mInitFailed = true; return false; }
    OutputDebugStringA("SharcGI::Initialize - CreateOutputTextures\n");
    if (!CreateOutputTextures(width, height)) { mInitFailed = true; return false; }
    OutputDebugStringA("SharcGI::Initialize - CreateSharcBuffers\n");
    if (!CreateSharcBuffers())        { mInitFailed = true; return false; }
    OutputDebugStringA("SharcGI::Initialize - CreateConstantBuffers\n");
    if (!CreateConstantBuffers())     { mInitFailed = true; return false; }
    OutputDebugStringA("SharcGI::Initialize - CreateDxrPipeline\n");
    if (!CreateDxrPipeline())         { mInitFailed = true; return false; }
    OutputDebugStringA("SharcGI::Initialize - CreateShaderTable\n");
    if (!CreateShaderTable())         { mInitFailed = true; return false; }
    OutputDebugStringA("SharcGI::Initialize - CreateResolvePipeline\n");
    if (!CreateResolvePipeline())     { mInitFailed = true; return false; }
    OutputDebugStringA("SharcGI::Initialize - SUCCESS\n");
    mInitFailed    = false;
    mIsInitialized = true;
    return true;
}

bool SharcGlobalIllumination::EnsureSize(UINT width, UINT height)
{
    if (width == mWidth && height == mHeight) return true;
    return CreateOutputTextures(width, height);
}

bool SharcGlobalIllumination::AllocateSrv(
    D3D12_CPU_DESCRIPTOR_HANDLE* cpu, D3D12_GPU_DESCRIPTOR_HANDLE* gpu)
{
    return DX12Context_AllocateSrvDescriptor(cpu, gpu);
}

bool SharcGlobalIllumination::CheckDxrSupport()
{
    ID3D12Device* device = DX12Context_GetDevice();
    if (!device) { mLastError = "SharcGI: DX12 device not available."; return false; }
    if (FAILED(device->QueryInterface(IID_PPV_ARGS(&mDevice5))))
    {
        mLastError = "SharcGI: ID3D12Device5 not supported.";
        return false;
    }
    D3D12_FEATURE_DATA_D3D12_OPTIONS5 opts5{};
    if (FAILED(device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS5, &opts5, sizeof(opts5))) ||
        opts5.RaytracingTier == D3D12_RAYTRACING_TIER_NOT_SUPPORTED)
    {
        mLastError = "SharcGI: DXR Tier 1.0 not supported on this GPU.";
        mDevice5.Reset();
        return false;
    }
    return true;
}

bool SharcGlobalIllumination::CreateOutputTextures(UINT width, UINT height)
{
    mWidth = width; mHeight = height;
    ID3D12Device* dev = mDevice5.Get();

    // Screen-space GI accumulation texture (UAV + SRV).
    // Created in PIXEL_SHADER_RESOURCE so the Dispatch() transition
    // (PSR → UAV at the top of every frame) is valid on the very first call.
    mAccumOutput.Reset();
    if (!CreateRgba16Tex(dev, width, height,
        D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
        D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, mAccumOutput))
    { mLastError = "SharcGI: failed to create accum texture."; return false; }

    // History for temporal blending
    mHistoryOutput.Reset();
    if (!CreateRgba16Tex(dev, width, height,
        D3D12_RESOURCE_FLAG_NONE,
        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, mHistoryOutput))
    { mLastError = "SharcGI: failed to create history texture."; return false; }

    // Allocate descriptors (only once — AllocateSrv cannot be called twice for the same slot)
    if (mAccumUavCpu.ptr == 0 && !AllocateSrv(&mAccumUavCpu, &mAccumUavGpu)) { mLastError = "SharcGI: descriptor OOM (accum UAV)"; return false; }
    if (mAccumSrvCpu.ptr == 0 && !AllocateSrv(&mAccumSrvCpu, &mAccumSrvGpu)) { mLastError = "SharcGI: descriptor OOM (accum SRV)"; return false; }
    if (mHistorySrvCpu.ptr == 0 && !AllocateSrv(&mHistorySrvCpu, &mHistorySrvGpu)) { mLastError = "SharcGI: descriptor OOM (history SRV)"; return false; }

    // (Re-)create descriptor views each time the texture is resized
    D3D12_UNORDERED_ACCESS_VIEW_DESC uavDesc{};
    uavDesc.Format        = DXGI_FORMAT_R16G16B16A16_FLOAT;
    uavDesc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
    dev->CreateUnorderedAccessView(mAccumOutput.Get(), nullptr, &uavDesc, mAccumUavCpu);

    D3D12_SHADER_RESOURCE_VIEW_DESC srvDesc{};
    srvDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
    srvDesc.Format                  = DXGI_FORMAT_R16G16B16A16_FLOAT;
    srvDesc.ViewDimension           = D3D12_SRV_DIMENSION_TEXTURE2D;
    srvDesc.Texture2D.MipLevels     = 1;
    dev->CreateShaderResourceView(mAccumOutput.Get(), &srvDesc, mAccumSrvCpu);
    dev->CreateShaderResourceView(mHistoryOutput.Get(), &srvDesc, mHistorySrvCpu);

    // Mark that accum/history need to be cleared on the first Dispatch after (re-)creation.
    mNeedsFirstFrameClear = true;

    return true;
}

bool SharcGlobalIllumination::CreateSharcBuffers()
{
    ID3D12Device* dev = mDevice5.Get();

    // Hash entries: uint64 per slot
    const UINT64 hashSize = (UINT64)kSharcCapacity * sizeof(uint64_t);
    if (!CreateGpuBuffer(dev, hashSize,
        D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
        D3D12_RESOURCE_STATE_COMMON, mSharcHashEntries))
    { mLastError = "SharcGI: failed to create SHARC hash entries buffer."; return false; }

    // Accumulation buffer: 4 * int32 per slot (R, G, B, SampleCount)
    const UINT64 accumSize = (UINT64)kSharcCapacity * 16u; // sizeof(SharcAccumulationData) = 16
    if (!CreateGpuBuffer(dev, accumSize,
        D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
        D3D12_RESOURCE_STATE_COMMON, mSharcAccumBuffer))
    { mLastError = "SharcGI: failed to create SHARC accumulation buffer."; return false; }

    // Resolved buffer: 2 * uint32 per slot (packed radiance)
    const UINT64 resolvedSize = (UINT64)kSharcCapacity * 8u; // sizeof(SharcPackedData) = 8
    if (!CreateGpuBuffer(dev, resolvedSize,
        D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
        D3D12_RESOURCE_STATE_COMMON, mSharcResolvedBuffer))
    { mLastError = "SharcGI: failed to create SHARC resolved buffer."; return false; }

    // Allocate UAV descriptors
    if (mSharcHashUavCpu.ptr == 0 && !AllocateSrv(&mSharcHashUavCpu, &mSharcHashUavGpu))       { mLastError = "SharcGI: descriptor OOM (SHARC hash)";    return false; }
    if (mSharcAccumUavCpu.ptr == 0 && !AllocateSrv(&mSharcAccumUavCpu, &mSharcAccumUavGpu))     { mLastError = "SharcGI: descriptor OOM (SHARC accum)";   return false; }
    if (mSharcResolvedUavCpu.ptr == 0 && !AllocateSrv(&mSharcResolvedUavCpu, &mSharcResolvedUavGpu)) { mLastError = "SharcGI: descriptor OOM (SHARC resolved)"; return false; }

    // Hash entries UAV (raw uint64 — use R32_UINT structured view with stride = 8 won't work;
    // use a raw byte-address UAV instead and handle 64-bit in the shader via InterlockedCompareExchange)
    D3D12_UNORDERED_ACCESS_VIEW_DESC hashUav{};
    hashUav.Format                      = DXGI_FORMAT_UNKNOWN;
    hashUav.ViewDimension               = D3D12_UAV_DIMENSION_BUFFER;
    hashUav.Buffer.FirstElement         = 0;
    hashUav.Buffer.NumElements          = kSharcCapacity;
    hashUav.Buffer.StructureByteStride  = sizeof(uint64_t); // 8
    hashUav.Buffer.Flags                = D3D12_BUFFER_UAV_FLAG_NONE;
    dev->CreateUnorderedAccessView(mSharcHashEntries.Get(), nullptr, &hashUav, mSharcHashUavCpu);

    // Accumulation buffer UAV (structured: 16 bytes per element)
    D3D12_UNORDERED_ACCESS_VIEW_DESC accumUav{};
    accumUav.Format                     = DXGI_FORMAT_UNKNOWN;
    accumUav.ViewDimension              = D3D12_UAV_DIMENSION_BUFFER;
    accumUav.Buffer.FirstElement        = 0;
    accumUav.Buffer.NumElements         = kSharcCapacity;
    accumUav.Buffer.StructureByteStride = 16u; // sizeof(SharcAccumulationData)
    accumUav.Buffer.Flags               = D3D12_BUFFER_UAV_FLAG_NONE;
    dev->CreateUnorderedAccessView(mSharcAccumBuffer.Get(), nullptr, &accumUav, mSharcAccumUavCpu);

    // Resolved buffer UAV (structured: 8 bytes per element)
    D3D12_UNORDERED_ACCESS_VIEW_DESC resolvedUav{};
    resolvedUav.Format                     = DXGI_FORMAT_UNKNOWN;
    resolvedUav.ViewDimension              = D3D12_UAV_DIMENSION_BUFFER;
    resolvedUav.Buffer.FirstElement        = 0;
    resolvedUav.Buffer.NumElements         = kSharcCapacity;
    resolvedUav.Buffer.StructureByteStride = 8u; // sizeof(SharcPackedData)
    resolvedUav.Buffer.Flags               = D3D12_BUFFER_UAV_FLAG_NONE;
    dev->CreateUnorderedAccessView(mSharcResolvedBuffer.Get(), nullptr, &resolvedUav, mSharcResolvedUavCpu);

    return true;
}

bool SharcGlobalIllumination::CreateTlasBuffers(UINT maxInstances)
{
    mTlasMaxInstances = maxInstances;
    if (!CreateUploadBuf(mDevice5.Get(),
        (UINT64)maxInstances * sizeof(D3D12_RAYTRACING_INSTANCE_DESC),
        mInstanceDescBuffer))
    { mLastError = "SharcGI: failed to allocate instance desc buffer."; return false; }
    return true;
}

bool SharcGlobalIllumination::EnsureRtGeometryBuffers(UINT vertexCount, UINT indexCount, UINT instanceCount)
{
    const UINT reqVerts     = (std::max)(vertexCount,   1u);
    const UINT reqIndices   = (std::max)(indexCount,    1u);
    const UINT reqInstances = (std::max)(instanceCount, 1u);
    bool rebuildVertSrv = false, rebuildIdxSrv = false, rebuildInstSrv = false;

    if (!mRtVertexBuffer || mRtVertexCapacity < reqVerts)
    {
        mRtVertexBuffer.Reset();
        mRtVertexCapacity = AlignUp(reqVerts * 2u + 64u, 256u);
        if (!CreateUploadBuf(mDevice5.Get(), (UINT64)mRtVertexCapacity * sizeof(RtVertexGpu), mRtVertexBuffer))
        { mLastError = "SharcGI: RT vertex buffer alloc failed."; return false; }
        rebuildVertSrv = true;
    }

    if (!mRtIndexBuffer || mRtIndexCapacity < reqIndices)
    {
        mRtIndexBuffer.Reset();
        mRtIndexCapacity = AlignUp(reqIndices * 2u + 256u, 512u);
        if (!CreateUploadBuf(mDevice5.Get(), (UINT64)mRtIndexCapacity * sizeof(uint32_t), mRtIndexBuffer))
        { mLastError = "SharcGI: RT index buffer alloc failed."; return false; }
        rebuildIdxSrv = true;
    }

    if (!mRtInstanceBuffer || mRtInstanceCapacity < reqInstances)
    {
        mRtInstanceBuffer.Reset();
        mRtInstanceCapacity = AlignUp(reqInstances * 2u + 16u, 64u);
        if (!CreateUploadBuf(mDevice5.Get(), (UINT64)mRtInstanceCapacity * sizeof(RtInstanceGpu), mRtInstanceBuffer))
        { mLastError = "SharcGI: RT instance buffer alloc failed."; return false; }
        rebuildInstSrv = true;
    }

    ID3D12Device* dev = mDevice5.Get();

    // Allocate SRV descriptors the first time only
    if (mRtVertexSrvCpu.ptr == 0 && !AllocateSrv(&mRtVertexSrvCpu, &mRtVertexSrvGpu))     { mLastError = "SharcGI: descriptor OOM (RT vertex)";   return false; }
    if (mRtIndexSrvCpu.ptr == 0 && !AllocateSrv(&mRtIndexSrvCpu, &mRtIndexSrvGpu))         { mLastError = "SharcGI: descriptor OOM (RT index)";    return false; }
    if (mRtInstanceSrvCpu.ptr == 0 && !AllocateSrv(&mRtInstanceSrvCpu, &mRtInstanceSrvGpu)){ mLastError = "SharcGI: descriptor OOM (RT instance)"; return false; }

    if (dev && rebuildVertSrv && mRtVertexSrvCpu.ptr != 0)
    {
        D3D12_SHADER_RESOURCE_VIEW_DESC d{};
        d.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
        d.Format = DXGI_FORMAT_UNKNOWN;
        d.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
        d.Buffer.NumElements = mRtVertexCapacity;
        d.Buffer.StructureByteStride = sizeof(RtVertexGpu);
        dev->CreateShaderResourceView(mRtVertexBuffer.Get(), &d, mRtVertexSrvCpu);
    }

    if (dev && rebuildIdxSrv && mRtIndexSrvCpu.ptr != 0)
    {
        D3D12_SHADER_RESOURCE_VIEW_DESC d{};
        d.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
        d.Format = DXGI_FORMAT_R32_TYPELESS;
        d.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
        d.Buffer.NumElements = mRtIndexCapacity;
        d.Buffer.Flags = D3D12_BUFFER_SRV_FLAG_RAW;
        dev->CreateShaderResourceView(mRtIndexBuffer.Get(), &d, mRtIndexSrvCpu);
    }

    if (dev && rebuildInstSrv && mRtInstanceSrvCpu.ptr != 0)
    {
        D3D12_SHADER_RESOURCE_VIEW_DESC d{};
        d.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
        d.Format = DXGI_FORMAT_UNKNOWN;
        d.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
        d.Buffer.NumElements = mRtInstanceCapacity;
        d.Buffer.StructureByteStride = sizeof(RtInstanceGpu);
        dev->CreateShaderResourceView(mRtInstanceBuffer.Get(), &d, mRtInstanceSrvCpu);
    }

    return true;
}

// ---------------------------------------------------------------------------
// BuildTlas
// ---------------------------------------------------------------------------
void SharcGlobalIllumination::BuildTlas(
    ID3D12GraphicsCommandList4* cmdList4,
    const std::vector<Entity>&  entities)
{
    if (!mIsInitialized || !mDevice5) return;
    mTlasBuiltThisFrame = false;

    std::vector<D3D12_RAYTRACING_INSTANCE_DESC> instanceDescs;
    std::vector<RtVertexGpu>   rtVertices;
    std::vector<uint32_t>      rtIndices;
    std::vector<RtInstanceGpu> rtInstances;
    std::vector<D3D12_GPU_DESCRIPTOR_HANDLE> hitGroupAlbedoSrvs;
    bool anyNewBlas = false;

    for (size_t i = 0; i < entities.size(); ++i)
    {
        const Entity& entity = entities[i];
        if (!entity.HasMeshComponent() || !entity.Mesh.has_value() || !entity.Mesh->MeshAsset) continue;

        const Mesh* mesh    = entity.Mesh->MeshAsset.get();
        const void* meshKey = mesh;

        if (mBlasCache.find(meshKey) == mBlasCache.end())
        {
            const auto& verts   = mesh->GetVertices();
            const auto& indices = mesh->GetIndices();
            if (verts.empty() || indices.empty()) continue;

            const UINT64 vbSize = verts.size()   * sizeof(Vertex);
            const UINT64 ibSize = indices.size()  * sizeof(uint32_t);

            ComPtr<ID3D12Resource> vbUp, ibUp;
            if (!CreateUploadBuf(mDevice5.Get(), vbSize, vbUp)) continue;
            if (!CreateUploadBuf(mDevice5.Get(), ibSize, ibUp)) continue;

            void* m = nullptr;
            if (FAILED(vbUp->Map(0, nullptr, &m)) || !m) continue;
            memcpy(m, verts.data(), vbSize); vbUp->Unmap(0, nullptr); m = nullptr;
            if (FAILED(ibUp->Map(0, nullptr, &m)) || !m) continue;
            memcpy(m, indices.data(), ibSize); ibUp->Unmap(0, nullptr);

            BlasEntry& e = mBlasCache[meshKey];

            D3D12_RAYTRACING_GEOMETRY_DESC geom{};
            geom.Type  = D3D12_RAYTRACING_GEOMETRY_TYPE_TRIANGLES;
            geom.Flags = D3D12_RAYTRACING_GEOMETRY_FLAG_OPAQUE;
            geom.Triangles.VertexBuffer.StartAddress  = vbUp->GetGPUVirtualAddress();
            geom.Triangles.VertexBuffer.StrideInBytes = sizeof(Vertex);
            geom.Triangles.VertexFormat               = DXGI_FORMAT_R32G32B32_FLOAT;
            geom.Triangles.VertexCount                = static_cast<UINT>(verts.size());
            geom.Triangles.IndexBuffer                = ibUp->GetGPUVirtualAddress();
            geom.Triangles.IndexFormat                = DXGI_FORMAT_R32_UINT;
            geom.Triangles.IndexCount                 = static_cast<UINT>(indices.size());

            D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS inp{};
            inp.Type           = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL;
            inp.Flags          = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE;
            inp.NumDescs       = 1;
            inp.DescsLayout    = D3D12_ELEMENTS_LAYOUT_ARRAY;
            inp.pGeometryDescs = &geom;

            D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO pre{};
            mDevice5->GetRaytracingAccelerationStructurePrebuildInfo(&inp, &pre);

            if (!CreateGpuBuffer(mDevice5.Get(), pre.ScratchDataSizeInBytes,
                D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON, e.Scratch)) continue;
            if (!CreateGpuBuffer(mDevice5.Get(), pre.ResultDataMaxSizeInBytes,
                D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
                D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE, e.Result)) continue;

            D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC bd{};
            bd.Inputs = inp;
            bd.DestAccelerationStructureData    = e.Result->GetGPUVirtualAddress();
            bd.ScratchAccelerationStructureData = e.Scratch->GetGPUVirtualAddress();
            cmdList4->BuildRaytracingAccelerationStructure(&bd, 0, nullptr);

            D3D12_RESOURCE_BARRIER uavB = CD3DX12_RESOURCE_BARRIER::UAV(e.Result.Get());
            cmdList4->ResourceBarrier(1, &uavB);

            mPendingUploads.push_back(std::move(vbUp));
            mPendingUploads.push_back(std::move(ibUp));
            anyNewBlas = true;
            mRtGeometryDirty = true;
        }

        const auto it = mBlasCache.find(meshKey);
        if (it == mBlasCache.end() || !it->second.Result) continue;

        XMFLOAT4X4 w4;
        XMStoreFloat4x4(&w4, XMMatrixTranspose(entity.Transform.GetTransform()));

        if (mRtGeometryDirty)
        {
            // Store vertices directly (one entry per unique vertex in the mesh).
            // Store indices as per-instance-local values into the vertex sub-array.
            // The shader uses inst.VertexOffset + localIndex to fetch the right vertex.
            const UINT vertexOffset = static_cast<UINT>(rtVertices.size());
            const UINT indexOffset  = static_cast<UINT>(rtIndices.size());

            const auto& verts   = mesh->GetVertices();
            const auto& indices = mesh->GetIndices();
            rtVertices.reserve(rtVertices.size() + verts.size());
            rtIndices.reserve(rtIndices.size() + indices.size());

            const std::string& matPath = entity.Mesh.has_value() ? entity.Mesh->MaterialPath : std::string{};
            const MaterialAlbedoBinding mat = LoadMaterialAlbedoBinding(mTextureManager, matPath);
            const D3D12_GPU_DESCRIPTOR_HANDLE albedoSrv =
                (mat.GpuHandle.ptr != 0) ? mat.GpuHandle : mNullAlbedoSrvGpu;

            // Copy unique vertices (object-space; the shader transforms them to world-space).
            for (const Vertex& v : verts)
            {
                RtVertexGpu gv{};
                gv.Position = v.Position;
                gv.Normal   = v.Normal;
                gv.TexCoord = v.TexCoord;
                rtVertices.push_back(gv);
            }

            // Store per-instance-local indices (0-based into this mesh's vertex slice).
            for (uint32_t idx : indices)
                rtIndices.push_back(idx);

            RtInstanceGpu rtInst{};
            rtInst.VertexOffset = vertexOffset;
            rtInst.IndexOffset  = indexOffset;
            rtInst.AlbedoSrvLo  = static_cast<uint32_t>(albedoSrv.ptr & 0xFFFFFFFFull);
            rtInst.AlbedoSrvHi  = static_cast<uint32_t>(albedoSrv.ptr >> 32);
            rtInstances.push_back(rtInst);
            hitGroupAlbedoSrvs.push_back(albedoSrv);
            // Record this instance's hit group index so subsequent frames
            // can rebuild the shader table in the same order.
            mInstanceHitGroupIndex[meshKey] = static_cast<UINT>(hitGroupAlbedoSrvs.size() - 1u);
        }
        else
        {
            // Geometry is already cached — look up the albedo SRV from the stored index.
            auto hgIt = mInstanceHitGroupIndex.find(meshKey);
            const D3D12_GPU_DESCRIPTOR_HANDLE albedoSrv =
                (hgIt != mInstanceHitGroupIndex.end() && mCachedHitGroupSrvs.size() > hgIt->second)
                ? mCachedHitGroupSrvs[hgIt->second] : mNullAlbedoSrvGpu;
            hitGroupAlbedoSrvs.push_back(albedoSrv);
        }

        D3D12_RAYTRACING_INSTANCE_DESC inst{};
        inst.Transform[0][0] = w4._11; inst.Transform[0][1] = w4._12; inst.Transform[0][2] = w4._13; inst.Transform[0][3] = w4._14;
        inst.Transform[1][0] = w4._21; inst.Transform[1][1] = w4._22; inst.Transform[1][2] = w4._23; inst.Transform[1][3] = w4._24;
        inst.Transform[2][0] = w4._31; inst.Transform[2][1] = w4._32; inst.Transform[2][2] = w4._33; inst.Transform[2][3] = w4._34;
        inst.InstanceID                          = static_cast<UINT>(instanceDescs.size());
        inst.InstanceMask                        = 0xFF;
        // InstanceContributionToHitGroupIndex is the index into the hit-group shader table records.
        // It must match the order in which hitGroupAlbedoSrvs is populated above.
        inst.InstanceContributionToHitGroupIndex = static_cast<UINT>(hitGroupAlbedoSrvs.size() - 1u);
        inst.Flags                               = D3D12_RAYTRACING_INSTANCE_FLAG_NONE;
        inst.AccelerationStructure               = it->second.Result->GetGPUVirtualAddress();
        instanceDescs.push_back(inst);
    }

    // Always rebuild the shader table so hit-group records stay consistent
    // with the current frame's instance list (even when geometry hasn't changed).
    if (!hitGroupAlbedoSrvs.empty())
    {
        mCachedHitGroupSrvs = hitGroupAlbedoSrvs;
        if (!CreateShaderTable(hitGroupAlbedoSrvs)) return;
    }

    if (instanceDescs.empty()) return;

    if (mRtGeometryDirty || anyNewBlas)
    {
        if (!EnsureRtGeometryBuffers(
            static_cast<UINT>(rtVertices.size()),
            static_cast<UINT>(rtIndices.size()),
            static_cast<UINT>(rtInstances.size()))) return;

        void* mappedV = nullptr;
        if (FAILED(mRtVertexBuffer->Map(0, nullptr, &mappedV)) || !mappedV) { mLastError = "SharcGI: vertex buffer map failed."; return; }
        memcpy(mappedV, rtVertices.data(), rtVertices.size() * sizeof(RtVertexGpu));
        mRtVertexBuffer->Unmap(0, nullptr);

        void* mappedI = nullptr;
        if (FAILED(mRtIndexBuffer->Map(0, nullptr, &mappedI)) || !mappedI) { mLastError = "SharcGI: index buffer map failed."; return; }
        memcpy(mappedI, rtIndices.data(), rtIndices.size() * sizeof(uint32_t));
        mRtIndexBuffer->Unmap(0, nullptr);

        void* mappedInst = nullptr;
        if (FAILED(mRtInstanceBuffer->Map(0, nullptr, &mappedInst)) || !mappedInst) { mLastError = "SharcGI: instance buffer map failed."; return; }
        memcpy(mappedInst, rtInstances.data(), rtInstances.size() * sizeof(RtInstanceGpu));
        mRtInstanceBuffer->Unmap(0, nullptr);

        mRtGeometryDirty = false;
    }

    const UINT numInst = static_cast<UINT>(instanceDescs.size());
    const UINT64 requiredSize = (UINT64)numInst * sizeof(D3D12_RAYTRACING_INSTANCE_DESC);
    if (numInst > mTlasMaxInstances || !mInstanceDescBuffer ||
        mInstanceDescBuffer->GetDesc().Width < requiredSize)
    {
        if (!CreateTlasBuffers(numInst * 2 + 8)) return;
    }

    void* mapped = nullptr;
    if (FAILED(mInstanceDescBuffer->Map(0, nullptr, &mapped)) || !mapped)
    { mLastError = "SharcGI: failed to map TLAS instance buffer."; return; }
    memcpy(mapped, instanceDescs.data(), numInst * sizeof(D3D12_RAYTRACING_INSTANCE_DESC));
    mInstanceDescBuffer->Unmap(0, nullptr);

    D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS tlasInp{};
    tlasInp.Type          = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL;
    tlasInp.Flags         = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE;
    tlasInp.NumDescs      = numInst;
    tlasInp.DescsLayout   = D3D12_ELEMENTS_LAYOUT_ARRAY;
    tlasInp.InstanceDescs = mInstanceDescBuffer->GetGPUVirtualAddress();

    D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO tlasPre{};
    mDevice5->GetRaytracingAccelerationStructurePrebuildInfo(&tlasInp, &tlasPre);

    if (!mTlasBuffer || mTlasBuffer->GetDesc().Width < tlasPre.ResultDataMaxSizeInBytes)
    {
        mTlasBuffer.Reset();
        if (!CreateGpuBuffer(mDevice5.Get(), tlasPre.ResultDataMaxSizeInBytes,
            D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
            D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE, mTlasBuffer)) return;
    }
    if (!mTlasScratch || mTlasScratch->GetDesc().Width < tlasPre.ScratchDataSizeInBytes)
    {
        mTlasScratch.Reset();
        if (!CreateGpuBuffer(mDevice5.Get(), tlasPre.ScratchDataSizeInBytes,
            D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
            D3D12_RESOURCE_STATE_COMMON, mTlasScratch)) return;
    }

    D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC tlasDesc{};
    tlasDesc.Inputs                           = tlasInp;
    tlasDesc.DestAccelerationStructureData    = mTlasBuffer->GetGPUVirtualAddress();
    tlasDesc.ScratchAccelerationStructureData = mTlasScratch->GetGPUVirtualAddress();
    cmdList4->BuildRaytracingAccelerationStructure(&tlasDesc, 0, nullptr);

    D3D12_RESOURCE_BARRIER uav = CD3DX12_RESOURCE_BARRIER::UAV(mTlasBuffer.Get());
    cmdList4->ResourceBarrier(1, &uav);
    mTlasBuiltThisFrame = true;
}

// ---------------------------------------------------------------------------
// Dispatch
// ---------------------------------------------------------------------------
void SharcGlobalIllumination::Dispatch(
    ID3D12GraphicsCommandList4*  cmdList4,
    D3D12_GPU_DESCRIPTOR_HANDLE  gbufferNormalSrv,
    D3D12_GPU_DESCRIPTOR_HANDLE  depthSrv,
    D3D12_GPU_DESCRIPTOR_HANDLE  gbufferAlbedoSrv,
    const SharcGiSettings&       settings,
    const XMFLOAT4X4&            reconstructionInvViewProj,
    const XMFLOAT4X4&            stableInvViewProj,
    const XMFLOAT3&              cameraPos,
    const XMFLOAT3&              sunDir,
    const XMFLOAT3&              sunColor,
    const XMFLOAT3&              skyAmbient,
    const PointLightGpu*         pointLights,
    int                          numPointLights)
{
    if (!mIsInitialized || !mTlasBuiltThisFrame || !mDxrStateObject) return;

    // D3D12 committed resources are zero-initialized by the spec, so no explicit
    // first-frame clear is needed.  (A previous version called ClearUnorderedAccessViewFloat
    // here, but that API requires the CPU handle to come from a non-shader-visible heap;
    // passing a shader-visible handle caused a TDR / GPU freeze on first enable.)
    mNeedsFirstFrameClear = false;

    // Camera-move detection
    const float dx = cameraPos.x - mPrevCameraPos.x;
    const float dy = cameraPos.y - mPrevCameraPos.y;
    const float dz = cameraPos.z - mPrevCameraPos.z;
    bool cameraMoved = (dx*dx + dy*dy + dz*dz) > 1e-8f;
    if (!cameraMoved)
    {
        const float* a = reinterpret_cast<const float*>(&mPrevStableInvViewProj);
        const float* b = reinterpret_cast<const float*>(&stableInvViewProj);
        for (int i = 0; i < 16; ++i)
            if (fabsf(a[i] - b[i]) > 1e-5f) { cameraMoved = true; break; }
    }
    XMFLOAT3 prevCameraPos = mPrevCameraPos;
    mPrevCameraPos         = cameraPos;
    mPrevStableInvViewProj = stableInvViewProj;

    if (cameraMoved) mFramesSinceReset = 0;
    else             mFramesSinceReset = (std::min)(mFramesSinceReset + 1u, 64u);

    int effectiveRaysPerPixel = settings.RaysPerPixel;
    if (cameraMoved) effectiveRaysPerPixel = (std::max)(effectiveRaysPerPixel, 4);

    float effectiveAlpha = settings.AccumulationAlpha;

    // --------------- Update DXR constant buffer ---------------
    mMappedDxrCB->InvViewProj             = reconstructionInvViewProj;
    mMappedDxrCB->CameraPos               = cameraPos;
    mMappedDxrCB->SunDir                  = sunDir;
    mMappedDxrCB->SunColor                = sunColor;
    mMappedDxrCB->SkyAmbient              = skyAmbient;
    mMappedDxrCB->MaxRayDist              = settings.MaxRayDistance;
    mMappedDxrCB->BounceCount             = settings.BounceCount;
    mMappedDxrCB->RaysPerPixel            = effectiveRaysPerPixel;
    mMappedDxrCB->AccumAlpha              = effectiveAlpha;
    mMappedDxrCB->FrameIndex              = static_cast<int>(mFrameIndex);
    mMappedDxrCB->SkylightOnMiss          = settings.SkylightOnMiss ? 1 : 0;
    mMappedDxrCB->NumPointLights          = (std::min)(numPointLights, kMaxPointLights);
    mMappedDxrCB->ResetAccumulation       = cameraMoved ? 1 : 0;
    mMappedDxrCB->SharcSceneScale         = settings.SharcSceneScale;
    mMappedDxrCB->SharcAccumFrames        = settings.SharcAccumFrames;
    mMappedDxrCB->SharcRoughnessThreshold = settings.SharcRoughnessThreshold;
    mMappedDxrCB->SharcDownscaleFactor    = settings.SharcDownscaleFactor;
    mMappedDxrCB->Saturation              = settings.GiSaturation;
    mMappedDxrCB->DebugAlbedoOnly         = settings.DebugAlbedoOnly ? 1 : 0;
    const int nLights = (std::min)(numPointLights, kMaxPointLights);
    for (int i = 0; i < nLights; ++i) mMappedDxrCB->PointLights[i] = pointLights[i];

    if (cameraMoved) { mFrameIndex = 0; } else { ++mFrameIndex; }

    // --------------- Transition accum texture to UAV ---------------
    D3D12_RESOURCE_BARRIER toUav = CD3DX12_RESOURCE_BARRIER::Transition(
        mAccumOutput.Get(),
        D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
        D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
    cmdList4->ResourceBarrier(1, &toUav);

    // --------------- DXR dispatch ---------------
    // Bind the shader-visible descriptor heap — required before any descriptor
    // table root parameters, especially for DXR.  Missing this causes a TDR freeze.
    ID3D12DescriptorHeap* heaps[] = { DX12Context_GetSrvDescriptorHeap() };
    cmdList4->SetDescriptorHeaps(1, heaps);

    cmdList4->SetPipelineState1(mDxrStateObject.Get());
    cmdList4->SetComputeRootSignature(mDxrGlobalRS.Get());

    // Root parameter layout (matches CreateDxrPipeline):
    //  [0]  b0     DXR CB (CBV)
    //  [1]  t0     GBuffer normal (SRV table)
    //  [2]  t1     depth (SRV table)
    //  [3]  t2     history (SRV table)
    //  [4]  t3     TLAS (inline SRV)
    //  [5]  u0     accum output UAV (table)
    //  [6]  t4     RT vertices (SRV table)
    //  [7]  t5     RT indices (SRV table)
    //  [8]  t6     RT instances (SRV table)
    //  [9]  t7     primary albedo (SRV table)
    //  [10] u0 s1  SHARC hash entries UAV (table)
    //  [11] u1 s1  SHARC accum UAV (table)
    //  [12] u2 s1  SHARC resolved UAV (table)
    cmdList4->SetComputeRootConstantBufferView(0, mDxrCB->GetGPUVirtualAddress());
    cmdList4->SetComputeRootDescriptorTable(1,  gbufferNormalSrv);
    cmdList4->SetComputeRootDescriptorTable(2,  depthSrv);
    cmdList4->SetComputeRootDescriptorTable(3,  mHistorySrvGpu);
    cmdList4->SetComputeRootShaderResourceView(4, mTlasBuffer->GetGPUVirtualAddress());
    cmdList4->SetComputeRootDescriptorTable(5,  mAccumUavGpu);
    cmdList4->SetComputeRootDescriptorTable(6,  mRtVertexSrvGpu);
    cmdList4->SetComputeRootDescriptorTable(7,  mRtIndexSrvGpu);
    cmdList4->SetComputeRootDescriptorTable(8,  mRtInstanceSrvGpu);
    cmdList4->SetComputeRootDescriptorTable(9,  gbufferAlbedoSrv);
    cmdList4->SetComputeRootDescriptorTable(10, mSharcHashUavGpu);
    cmdList4->SetComputeRootDescriptorTable(11, mSharcAccumUavGpu);
    cmdList4->SetComputeRootDescriptorTable(12, mSharcResolvedUavGpu);

    D3D12_DISPATCH_RAYS_DESC dr{};
    // Dispatch at full resolution – the raygen shader skips pixels based on
    // gSharcDownscaleFactor to reduce cost while keeping the output texture
    // at the deferred-lighting resolution so it can be bilinearly upsampled.
    dr.Width  = mWidth;
    dr.Height = mHeight;
    dr.Depth  = 1;
    const UINT64 base = mShaderTable->GetGPUVirtualAddress();
    dr.RayGenerationShaderRecord = { base,                          mShaderTableEntrySize };
    dr.MissShaderTable           = { base + mShaderTableEntrySize,  mShaderTableEntrySize * 2, mShaderTableEntrySize };
    dr.HitGroupTable             = { base + 3*mShaderTableEntrySize,mShaderTableEntrySize * mHitGroupRecordCount, mShaderTableEntrySize };
    cmdList4->DispatchRays(&dr);

    // UAV barrier on SHARC buffers before the resolve compute
    D3D12_RESOURCE_BARRIER sharcUavs[3] =
    {
        CD3DX12_RESOURCE_BARRIER::UAV(mSharcHashEntries.Get()),
        CD3DX12_RESOURCE_BARRIER::UAV(mSharcAccumBuffer.Get()),
        CD3DX12_RESOURCE_BARRIER::UAV(mSharcResolvedBuffer.Get()),
    };
    cmdList4->ResourceBarrier(3, sharcUavs);

    // --------------- SHARC resolve compute pass ---------------
    mMappedResolveCB->AccumFrameNum    = settings.SharcAccumFrames;
    mMappedResolveCB->StaleFrameNum    = 64;
    mMappedResolveCB->CameraPosPrev    = prevCameraPos;
    mMappedResolveCB->CameraPosCur     = cameraPos;
    mMappedResolveCB->FrameIndex       = mFrameIndex;
    mMappedResolveCB->Capacity         = kSharcCapacity;

    cmdList4->SetPipelineState(mResolvePSO.Get());
    cmdList4->SetComputeRootSignature(mResolveRS.Get());
    // Re-bind descriptor heap for the compute resolve pass (SetDescriptorHeaps
    // state is reset when SetPipelineState is called on some drivers).
    cmdList4->SetDescriptorHeaps(1, heaps);
    // Resolve RS: [0] CBV b0, [1] u0 hash, [2] u1 accum, [3] u2 resolved
    cmdList4->SetComputeRootConstantBufferView(0, mResolveCB->GetGPUVirtualAddress());
    cmdList4->SetComputeRootDescriptorTable(1, mSharcHashUavGpu);
    cmdList4->SetComputeRootDescriptorTable(2, mSharcAccumUavGpu);
    cmdList4->SetComputeRootDescriptorTable(3, mSharcResolvedUavGpu);

    const UINT resolveGroups = (kSharcCapacity + 255u) / 256u;
    cmdList4->Dispatch(resolveGroups, 1, 1);

    // UAV barrier to ensure resolve writes are visible to next frame's reads
    D3D12_RESOURCE_BARRIER resolveUavs[3] =
    {
        CD3DX12_RESOURCE_BARRIER::UAV(mSharcHashEntries.Get()),
        CD3DX12_RESOURCE_BARRIER::UAV(mSharcAccumBuffer.Get()),
        CD3DX12_RESOURCE_BARRIER::UAV(mSharcResolvedBuffer.Get()),
    };
    cmdList4->ResourceBarrier(3, resolveUavs);

    // --------------- Copy accum -> history; transition accum to SRV ---------------
    D3D12_RESOURCE_BARRIER accumUav2 = CD3DX12_RESOURCE_BARRIER::UAV(mAccumOutput.Get());
    cmdList4->ResourceBarrier(1, &accumUav2);

    D3D12_RESOURCE_BARRIER histToDest = CD3DX12_RESOURCE_BARRIER::Transition(
        mHistoryOutput.Get(),
        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
        D3D12_RESOURCE_STATE_COPY_DEST);
    cmdList4->ResourceBarrier(1, &histToDest);

    D3D12_RESOURCE_BARRIER accumToSrc = CD3DX12_RESOURCE_BARRIER::Transition(
        mAccumOutput.Get(),
        D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
        D3D12_RESOURCE_STATE_COPY_SOURCE);
    cmdList4->ResourceBarrier(1, &accumToSrc);

    cmdList4->CopyResource(mHistoryOutput.Get(), mAccumOutput.Get());

    D3D12_RESOURCE_BARRIER toSrv[2] =
    {
        CD3DX12_RESOURCE_BARRIER::Transition(mAccumOutput.Get(),
            D3D12_RESOURCE_STATE_COPY_SOURCE,
            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE),
        CD3DX12_RESOURCE_BARRIER::Transition(mHistoryOutput.Get(),
            D3D12_RESOURCE_STATE_COPY_DEST,
            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE),
    };
    cmdList4->ResourceBarrier(2, toSrv);
}

// ---------------------------------------------------------------------------
// Shutdown
// ---------------------------------------------------------------------------
void SharcGlobalIllumination::Shutdown()
{
    if (mDxrCB && mMappedDxrCB)        { mDxrCB->Unmap(0, nullptr);    mMappedDxrCB    = nullptr; }
    if (mResolveCB && mMappedResolveCB) { mResolveCB->Unmap(0, nullptr); mMappedResolveCB = nullptr; }
    mDxrCB.Reset();
    mResolveCB.Reset();
    mDxrStateObject.Reset();
    mDxrGlobalRS.Reset();
    mDxrHitGroupLocalRS.Reset();
    mResolveRS.Reset();
    mResolvePSO.Reset();
    mShaderTable.Reset();
    mTlasBuffer.Reset();
    mTlasScratch.Reset();
    mInstanceDescBuffer.Reset();
    mBlasCache.clear();
    mAccumOutput.Reset();
    mHistoryOutput.Reset();
    mSharcHashEntries.Reset();
    mSharcAccumBuffer.Reset();
    mSharcResolvedBuffer.Reset();
    mRtVertexBuffer.Reset();
    mRtIndexBuffer.Reset();
    mRtInstanceBuffer.Reset();
    mDevice5.Reset();
    mIsInitialized = false;
}

// ---------------------------------------------------------------------------
// CreateDxrPipeline
// ---------------------------------------------------------------------------
bool SharcGlobalIllumination::CreateDxrPipeline()
{
    ID3D12Device* device = mDevice5.Get();

    // Global root signature
    // Slots: [0] CBV b0, [1-3] SRVs (normal,depth,history), [4] TLAS inline SRV,
    //        [5] UAV accum, [6-8] RT geometry SRVs, [9] primary albedo SRV,
    //        [10-12] SHARC UAVs
    {
        D3D12_DESCRIPTOR_RANGE dtNorm{}, dtDepth{}, dtHist{}, dtAccum{};
        D3D12_DESCRIPTOR_RANGE dtVerts{}, dtIdx{}, dtInst{}, dtAlbedo{};
        D3D12_DESCRIPTOR_RANGE dtSharcHash{}, dtSharcAccum{}, dtSharcResolved{};

        auto mkSrvRange = [](D3D12_DESCRIPTOR_RANGE& r, UINT reg) {
            r.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
            r.NumDescriptors = 1; r.BaseShaderRegister = reg; r.RegisterSpace = 0;
            r.OffsetInDescriptorsFromTableStart = 0;
        };
        auto mkUavRange = [](D3D12_DESCRIPTOR_RANGE& r, UINT reg, UINT space = 0) {
            r.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
            r.NumDescriptors = 1; r.BaseShaderRegister = reg; r.RegisterSpace = space;
            r.OffsetInDescriptorsFromTableStart = 0;
        };

        mkSrvRange(dtNorm,  0);
        mkSrvRange(dtDepth, 1);
        mkSrvRange(dtHist,  2);
        mkSrvRange(dtVerts, 4);
        mkSrvRange(dtIdx,   5);
        mkSrvRange(dtInst,  6);
        mkSrvRange(dtAlbedo,7);
        mkUavRange(dtAccum, 0, 0);
        mkUavRange(dtSharcHash,     0, 1);
        mkUavRange(dtSharcAccum,    1, 1);
        mkUavRange(dtSharcResolved, 2, 1);

        D3D12_ROOT_PARAMETER p[13]{};
        auto mkTable = [](D3D12_ROOT_PARAMETER& par, D3D12_DESCRIPTOR_RANGE* r) {
            par.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
            par.DescriptorTable = { 1, r };
            par.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        };
        p[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
        p[0].Descriptor.ShaderRegister = 0; p[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        mkTable(p[1],  &dtNorm);
        mkTable(p[2],  &dtDepth);
        mkTable(p[3],  &dtHist);
        p[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
        p[4].Descriptor.ShaderRegister = 3; p[4].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        mkTable(p[5],  &dtAccum);
        mkTable(p[6],  &dtVerts);
        mkTable(p[7],  &dtIdx);
        mkTable(p[8],  &dtInst);
        mkTable(p[9],  &dtAlbedo);
        mkTable(p[10], &dtSharcHash);
        mkTable(p[11], &dtSharcAccum);
        mkTable(p[12], &dtSharcResolved);

        D3D12_STATIC_SAMPLER_DESC sampler{};
        sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
        sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_WRAP;
        sampler.ShaderRegister = 0; sampler.RegisterSpace = 0;
        sampler.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;

        D3D12_ROOT_SIGNATURE_DESC rsDesc{};
        rsDesc.NumParameters = 13;
        rsDesc.pParameters   = p;
        rsDesc.NumStaticSamplers = 1;
        rsDesc.pStaticSamplers   = &sampler;
        rsDesc.Flags = D3D12_ROOT_SIGNATURE_FLAG_NONE;

        ComPtr<ID3DBlob> blob, err;
        if (FAILED(D3D12SerializeRootSignature(&rsDesc, D3D_ROOT_SIGNATURE_VERSION_1, &blob, &err)))
        {
            mLastError = "SharcGI: DXR root sig serialization failed.";
            if (err) OutputDebugStringA(static_cast<const char*>(err->GetBufferPointer()));
            return false;
        }
        if (FAILED(device->CreateRootSignature(0, blob->GetBufferPointer(), blob->GetBufferSize(),
            IID_PPV_ARGS(&mDxrGlobalRS))))
        { mLastError = "SharcGI: CreateRootSignature failed."; return false; }
    }

    // Local root signature for per-instance hit-group albedo texture
    {
        D3D12_DESCRIPTOR_RANGE localAlbedo{};
        localAlbedo.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
        localAlbedo.NumDescriptors = 1;
        localAlbedo.BaseShaderRegister = 8; // t8 space0
        localAlbedo.RegisterSpace = 0;

        D3D12_ROOT_PARAMETER lp{};
        lp.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
        lp.DescriptorTable = { 1, &localAlbedo };
        lp.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;

        D3D12_ROOT_SIGNATURE_DESC lrsDesc{};
        lrsDesc.NumParameters = 1;
        lrsDesc.pParameters  = &lp;
        lrsDesc.Flags = D3D12_ROOT_SIGNATURE_FLAG_LOCAL_ROOT_SIGNATURE;

        ComPtr<ID3DBlob> lBlob, lErr;
        if (FAILED(D3D12SerializeRootSignature(&lrsDesc, D3D_ROOT_SIGNATURE_VERSION_1, &lBlob, &lErr)))
        {
            mLastError = "SharcGI: local root sig serialization failed.";
            if (lErr) OutputDebugStringA(static_cast<const char*>(lErr->GetBufferPointer()));
            return false;
        }
        if (FAILED(device->CreateRootSignature(0, lBlob->GetBufferPointer(), lBlob->GetBufferSize(),
            IID_PPV_ARGS(&mDxrHitGroupLocalRS))))
        { mLastError = "SharcGI: CreateRootSignature (local) failed."; return false; }
    }

    // Compile SharcGI.hlsl as a DXR library (lib_6_6 required for 64-bit atomics used by SHARC)
    DX12Shader sharcGiLib;
    const ShaderCompileRequest req
    {
        L"Shaders\\SharcGI.hlsl",
        L"",
        L"lib_6_6",
        ShaderStage::Compute
    };
    if (!sharcGiLib.Compile(req))
    {
        mLastError = std::string("SharcGI: failed to compile SharcGI.hlsl: ")
            + (sharcGiLib.GetLastErrorMessage() ? sharcGiLib.GetLastErrorMessage() : "unknown error");
        return false;
    }
    const D3D12_SHADER_BYTECODE libBC = sharcGiLib.GetBytecode();

    D3D12_EXPORT_DESC exports[4] =
    {
        { kRayGenName,     nullptr, D3D12_EXPORT_FLAG_NONE },
        { kClosestHitName, nullptr, D3D12_EXPORT_FLAG_NONE },
        { kMissName,       nullptr, D3D12_EXPORT_FLAG_NONE },
        { kShadowMissName, nullptr, D3D12_EXPORT_FLAG_NONE },
    };
    D3D12_DXIL_LIBRARY_DESC lib{ libBC, 4, exports };

    D3D12_HIT_GROUP_DESC hg{};
    hg.HitGroupExport         = kHitGroupName;
    hg.Type                   = D3D12_HIT_GROUP_TYPE_TRIANGLES;
    hg.ClosestHitShaderImport = kClosestHitName;

    D3D12_LOCAL_ROOT_SIGNATURE lrs{ mDxrHitGroupLocalRS.Get() };
    LPCWSTR hitExports[] = { kHitGroupName };
    D3D12_SUBOBJECT_TO_EXPORTS_ASSOCIATION lrsAssoc{};
    lrsAssoc.NumExports = 1;
    lrsAssoc.pExports   = hitExports;

    // Payload: float3 Radiance + float3 HitAlbedo + float3 HitNormal + float3 HitWorldPos + uint Hit
    //          = 4 * 12 + 4 = 52 bytes.  Attributes: float2 = 8 bytes.  Max recursion 2.
    D3D12_RAYTRACING_SHADER_CONFIG  sc{ 52, 8 };
    D3D12_RAYTRACING_PIPELINE_CONFIG pc{ 2 };
    D3D12_GLOBAL_ROOT_SIGNATURE      grs{ mDxrGlobalRS.Get() };

    D3D12_STATE_SUBOBJECT subs[7] =
    {
        { D3D12_STATE_SUBOBJECT_TYPE_DXIL_LIBRARY,               &lib },
        { D3D12_STATE_SUBOBJECT_TYPE_HIT_GROUP,                  &hg  },
        { D3D12_STATE_SUBOBJECT_TYPE_LOCAL_ROOT_SIGNATURE,       &lrs },
        { D3D12_STATE_SUBOBJECT_TYPE_SUBOBJECT_TO_EXPORTS_ASSOCIATION, &lrsAssoc },
        { D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_SHADER_CONFIG,   &sc  },
        { D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_PIPELINE_CONFIG, &pc  },
        { D3D12_STATE_SUBOBJECT_TYPE_GLOBAL_ROOT_SIGNATURE,      &grs },
    };
    lrsAssoc.pSubobjectToAssociate = &subs[2];
    D3D12_STATE_OBJECT_DESC soDesc{ D3D12_STATE_OBJECT_TYPE_RAYTRACING_PIPELINE, 7, subs };
    if (FAILED(mDevice5->CreateStateObject(&soDesc, IID_PPV_ARGS(&mDxrStateObject))))
    { mLastError = "SharcGI: CreateStateObject failed."; return false; }

    return true;
}

// ---------------------------------------------------------------------------
// CreateShaderTable
// ---------------------------------------------------------------------------
bool SharcGlobalIllumination::CreateShaderTable(
    const std::vector<D3D12_GPU_DESCRIPTOR_HANDLE>& hitGroupAlbedoSrvs)
{
    const UINT hitCount = hitGroupAlbedoSrvs.empty() ? 1u : static_cast<UINT>(hitGroupAlbedoSrvs.size());
    const UINT shaderIdSize      = D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES;
    const UINT localRootArgSize  = sizeof(D3D12_GPU_DESCRIPTOR_HANDLE);
    mShaderTableEntrySize =
        (shaderIdSize + localRootArgSize + D3D12_RAYTRACING_SHADER_RECORD_BYTE_ALIGNMENT - 1)
        & ~static_cast<UINT64>(D3D12_RAYTRACING_SHADER_RECORD_BYTE_ALIGNMENT - 1);
    mHitGroupRecordCount = hitCount;
    mShaderTableSize = (3 + hitCount) * mShaderTableEntrySize;

    if (!CreateUploadBuf(mDevice5.Get(), mShaderTableSize, mShaderTable))
    { mLastError = "SharcGI: failed to allocate shader table."; return false; }

    ComPtr<ID3D12StateObjectProperties> prop;
    if (FAILED(mDxrStateObject->QueryInterface(IID_PPV_ARGS(&prop))))
    { mLastError = "SharcGI: no StateObjectProperties."; return false; }

    uint8_t* p = nullptr;
    mShaderTable->Map(0, nullptr, reinterpret_cast<void**>(&p));
    memcpy(p,                           prop->GetShaderIdentifier(kRayGenName),     D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES);
    memcpy(p + mShaderTableEntrySize,   prop->GetShaderIdentifier(kMissName),       D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES);
    memcpy(p + 2*mShaderTableEntrySize, prop->GetShaderIdentifier(kShadowMissName), D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES);
    for (UINT i = 0; i < hitCount; ++i)
    {
        uint8_t* hitRec = p + (3 + i) * mShaderTableEntrySize;
        memcpy(hitRec, prop->GetShaderIdentifier(kHitGroupName), D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES);
        const D3D12_GPU_DESCRIPTOR_HANDLE albedoSrv =
            hitGroupAlbedoSrvs.empty() ? mNullAlbedoSrvGpu : hitGroupAlbedoSrvs[i];
        memcpy(hitRec + D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES, &albedoSrv, sizeof(albedoSrv));
    }
    mShaderTable->Unmap(0, nullptr);
    return true;
}

// ---------------------------------------------------------------------------
// CreateConstantBuffers
// ---------------------------------------------------------------------------
bool SharcGlobalIllumination::CreateConstantBuffers()
{
    if (!CreateUploadBuf(mDevice5.Get(), sizeof(SharcGiCB), mDxrCB))
    { mLastError = "SharcGI: failed to allocate DXR CB."; return false; }
    mDxrCB->Map(0, nullptr, reinterpret_cast<void**>(&mMappedDxrCB));

    if (!CreateUploadBuf(mDevice5.Get(), sizeof(SharcResolveCB), mResolveCB))
    { mLastError = "SharcGI: failed to allocate resolve CB."; return false; }
    mResolveCB->Map(0, nullptr, reinterpret_cast<void**>(&mMappedResolveCB));

    // Allocate a null/white albedo SRV for instances without textures
    if (!AllocateSrv(&mNullAlbedoSrvCpu, &mNullAlbedoSrvGpu))
    { mLastError = "SharcGI: descriptor OOM (null albedo)."; return false; }
    // Create a null SRV (null descriptor)
    D3D12_SHADER_RESOURCE_VIEW_DESC nullDesc{};
    nullDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
    nullDesc.Format                  = DXGI_FORMAT_R8G8B8A8_UNORM;
    nullDesc.ViewDimension           = D3D12_SRV_DIMENSION_TEXTURE2D;
    nullDesc.Texture2D.MipLevels     = 1;
    mDevice5->CreateShaderResourceView(nullptr, &nullDesc, mNullAlbedoSrvCpu);

    return true;
}

// ---------------------------------------------------------------------------
// CreateResolvePipeline — compile SharcResolve.hlsl as a compute shader
// ---------------------------------------------------------------------------
bool SharcGlobalIllumination::CreateResolvePipeline()
{
    ID3D12Device* device = mDevice5.Get();

    // Root signature: [0] CBV b0, [1] u0 hash, [2] u1 accum, [3] u2 resolved
    {
        D3D12_DESCRIPTOR_RANGE rHash{}, rAccum{}, rResolved{};
        rHash.RangeType = rAccum.RangeType = rResolved.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
        rHash.NumDescriptors = rAccum.NumDescriptors = rResolved.NumDescriptors = 1;
        rHash.BaseShaderRegister    = 0;
        rAccum.BaseShaderRegister   = 1;
        rResolved.BaseShaderRegister = 2;
        rHash.RegisterSpace = rAccum.RegisterSpace = rResolved.RegisterSpace = 0;
        rHash.OffsetInDescriptorsFromTableStart = 0;
        rAccum.OffsetInDescriptorsFromTableStart = 0;
        rResolved.OffsetInDescriptorsFromTableStart = 0;

        D3D12_ROOT_PARAMETER p[4]{};
        p[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
        p[0].Descriptor.ShaderRegister = 0; p[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        p[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
        p[1].DescriptorTable = { 1, &rHash };    p[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        p[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
        p[2].DescriptorTable = { 1, &rAccum };   p[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        p[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
        p[3].DescriptorTable = { 1, &rResolved }; p[3].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;

        D3D12_ROOT_SIGNATURE_DESC rsDesc{};
        rsDesc.NumParameters = 4; rsDesc.pParameters = p;
        rsDesc.Flags = D3D12_ROOT_SIGNATURE_FLAG_NONE;

        ComPtr<ID3DBlob> blob, err;
        if (FAILED(D3D12SerializeRootSignature(&rsDesc, D3D_ROOT_SIGNATURE_VERSION_1, &blob, &err)))
        {
            mLastError = "SharcGI: resolve root sig serialization failed.";
            if (err) OutputDebugStringA(static_cast<const char*>(err->GetBufferPointer()));
            return false;
        }
        if (FAILED(device->CreateRootSignature(0, blob->GetBufferPointer(), blob->GetBufferSize(),
            IID_PPV_ARGS(&mResolveRS))))
        { mLastError = "SharcGI: CreateRootSignature (resolve) failed."; return false; }
    }

    // Compile the compute shader
    DX12Shader resolveCS;
    const ShaderCompileRequest req
    {
        L"Shaders\\SharcResolve.hlsl",
        L"SharcResolveCS",
        L"cs_6_6",
        ShaderStage::Compute
    };
    if (!resolveCS.Compile(req))
    {
        mLastError = std::string("SharcGI: failed to compile SharcResolve.hlsl: ")
            + (resolveCS.GetLastErrorMessage() ? resolveCS.GetLastErrorMessage() : "unknown error");
        return false;
    }

    D3D12_COMPUTE_PIPELINE_STATE_DESC psoDesc{};
    psoDesc.pRootSignature = mResolveRS.Get();
    psoDesc.CS             = resolveCS.GetBytecode();
    if (FAILED(device->CreateComputePipelineState(&psoDesc, IID_PPV_ARGS(&mResolvePSO))))
    { mLastError = "SharcGI: CreateComputePipelineState (resolve) failed."; return false; }

    return true;
}
