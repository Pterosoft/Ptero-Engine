                        gMaterialEditor.RemoveSubMaterial(gSelectedSubMaterialIndex);
                        // Clamp selection to valid range after removal
                        const int newCount = static_cast<int>(multiMat.SubMaterials.size());
                        if (gSelectedSubMaterialIndex >= newCount)
                        {
                            gSelectedSubMaterialIndex = newCount - 1;
                        }
                    }
                    ImGui::EndDisabled();

                    // Sub-material list box – each row shows "Mat ID X – Name"
                    if (ImGui::BeginChild("SubMatList", ImVec2(subMatListWidth, 0.0f), true))
                    {
                        for (int i = 0; i < static_cast<int>(multiMat.SubMaterials.size()); ++i)
                        {
                            char label[128];
                            std::snprintf(label, sizeof(label), "ID %d – %s", i, multiMat.SubMaterials[i].Name.c_str());
                            if (ImGui::Selectable(label, gSelectedSubMaterialIndex == i))
                            {
                                gSelectedSubMaterialIndex = i;
                            }
                        }

                        if (multiMat.SubMaterials.empty())
                        {
                            ImGui::TextDisabled("No sub-materials.\nClick '+ Add'.");
                        }
                    }
                    ImGui::EndChild();

                    ImGui::EndGroup();

                    ImGui::SameLine();

                    // Right panel: properties of the selected sub-material
                    ImGui::BeginGroup();
                    if (gSelectedSubMaterialIndex >= 0 &&
                        gSelectedSubMaterialIndex < static_cast<int>(multiMat.SubMaterials.size()))
                    {
                        MaterialDefinition& subMat = multiMat.SubMaterials[gSelectedSubMaterialIndex];

                        ImGui::TextDisabled("Material ID: %d  (matches FBX material slot)", gSelectedSubMaterialIndex);

                        // Sub-material name – use a per-index buffer via InputText with a PushID
                        ImGui::PushID(gSelectedSubMaterialIndex);
                        char subNameBuf[256];
                        strcpy_s(subNameBuf, subMat.Name.c_str());
                        if (ImGui::InputText("Sub-Material Name", subNameBuf, IM_ARRAYSIZE(subNameBuf)))
                        {
                            subMat.Name = subNameBuf;
                        }

                        ImGui::ColorEdit4("Base Color Tint", subMat.BaseColorTint.data());
                        ImGui::ColorEdit3("Emissive Color", subMat.EmissiveColor.data());
                        ImGui::SliderFloat("Metallic Factor", &subMat.MetallicFactor, 0.0f, 1.0f);
                        ImGui::SliderFloat("Roughness Factor", &subMat.RoughnessFactor, 0.0f, 1.0f);
                        ImGui::SliderFloat("Normal Scale", &subMat.NormalScale, 0.0f, 4.0f);
                        ImGui::SliderFloat("AO Strength", &subMat.AmbientOcclusionStrength, 0.0f, 4.0f);
                        ImGui::SliderFloat("Height Scale", &subMat.HeightScale, 0.0f, 1.0f);
                        ImGui::SliderFloat("Opacity", &subMat.Opacity, 0.0f, 1.0f);
                        ImGui::SliderFloat("Alpha Cutoff", &subMat.AlphaCutoff, 0.0f, 1.0f);
                        ImGui::Checkbox("Double Sided", &subMat.IsDoubleSided);
                        ImGui::Checkbox("Alpha Cutout", &subMat.UseAlphaCutout);
                        ImGui::Checkbox("Transparent Blend", &subMat.UseTransparentBlend);
                        ImGui::Checkbox("Decal Material", &subMat.IsDecalMaterial);

                        const auto drawSubTexField = [&](const char* label, const MaterialTextureSlot slot)
                        {
                            std::string& path = subMat.Textures.GetTexturePath(slot);
                            ImGui::PushID(label);
                            ImGui::TextUnformatted(label);
                            ImGui::SameLine(160.0f);
                            ImGui::TextWrapped("%s", path.empty() ? "<none>" : path.c_str());
                            if (ImGui::Button("Browse..."))
                            {
                                gMaterialEditor.BrowseForSubMaterialTexture(windowHandle, gSelectedSubMaterialIndex, slot);
                            }
                            ImGui::SameLine();
                            if (ImGui::Button("Clear"))
                            {
                                path.clear();
                            }
                            ImGui::PopID();
                        };

                        ImGui::Separator();
                        ImGui::TextUnformatted("Textures");
                        drawSubTexField("Base Color", MaterialTextureSlot::BaseColor);
                        drawSubTexField("Normal", MaterialTextureSlot::Normal);
                        drawSubTexField("Metallic", MaterialTextureSlot::Metallic);
                        drawSubTexField("Roughness", MaterialTextureSlot::Roughness);
                        drawSubTexField("Metallic Roughness", MaterialTextureSlot::MetallicRoughness);
                        drawSubTexField("Ambient Occlusion", MaterialTextureSlot::AmbientOcclusion);
                        drawSubTexField("Emissive", MaterialTextureSlot::Emissive);
                        drawSubTexField("Height", MaterialTextureSlot::Height);
                        drawSubTexField("Opacity", MaterialTextureSlot::Opacity);

                        ImGui::PopID();
                    }
                    else
                    {
                        ImGui::TextDisabled("Select a sub-material from the list on the left,\nor click '+ Add' to create one.");
                    }
                    ImGui::EndGroup();

                    ImGui::Separator();

                    // Multi-material library list (Data/MultiMaterials/)
                    const std::vector<std::filesystem::path> availableMultiMats = gMaterialEditor.FindAvailableMultiMaterials();
                    ImGui::TextUnformatted("Multi-Material Library");
                    if (availableMultiMats.empty())
                    {
                        ImGui::TextDisabled("No saved multi-materials found under Data/MultiMaterials.");
                    }
                    else
                    {
                        if (ImGui::BeginChild("MultiMatLibrary", ImVec2(0.0f, 100.0f), true))
                        {
                            for (const std::filesystem::path& mmPath : availableMultiMats)
                            {
                                const std::string itemLabel = mmPath.filename().string();
                                if (ImGui::Selectable(itemLabel.c_str(), gMaterialEditor.GetCurrentMultiMaterialPath() == mmPath))
                                {
                                    if (gMaterialEditor.LoadMultiMaterialFromFile(mmPath))
                                    {
                                        gSelectedSubMaterialIndex = -1;
                                        RefreshMultiMaterialNameBuffer();
                                    }
                                }
                            }
                        }
                        ImGui::EndChild();
                    }

                    if (!gMaterialEditor.GetCurrentMultiMaterialPath().empty())
                    {
                        ImGui::TextWrapped("Current File: %s", gMaterialEditor.GetCurrentMultiMaterialPath().string().c_str());
                    }

                    if (!gMaterialEditor.GetLastErrorMessage().empty())
                    {
                        ImGui::TextWrapped("Status: %s", gMaterialEditor.GetLastErrorMessage().c_str());
                    }

                    ImGui::EndTabItem();
                }

                ImGui::EndTabBar();
            }
        }
        ImGui::End();
    }

    if (gShowAssetBrowserWindow)
    {
        RefreshAssetBrowserState();
        ImGui::Begin("Asset Browser", &gShowAssetBrowserWindow, ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse);

        if (gOpenRenamePopup)
        {
            ImGui::OpenPopup("Rename Asset");
            gOpenRenamePopup = false;
        }

        if (gOpenNewFolderPopup)
        {
            ImGui::OpenPopup("Create Folder");
            gOpenNewFolderPopup = false;
        }

        const bool hasSelectedAsset = !gSelectedAssetRelativePath.empty();
        const bool selectedAssetIsGeometry = hasSelectedAsset && IsGeometryAssetPath(gSelectedAssetRelativePath);
        const bool canPaste = gClipboardHasValue;

        // The toolbar keeps common content-browser actions visible, similar to the asset views used by large game editors.
        if (ImGui::Button("Import FBX"))
        {
            if (PromptForAndImportFbx(windowHandle, gSelectedFolderRelativePath))
            {
                RefreshAssetBrowserState();
            }
        }

        ImGui::SameLine();
        if (ImGui::Button("Import Texture"))
        {
            if (PromptForAndImportTexture(windowHandle, gSelectedFolderRelativePath))
            {
                RefreshAssetBrowserState();
            }
        }

        ImGui::SameLine();
        if (ImGui::Button("New Folder"))
        {
            BeginCreateFolder();
        }

        ImGui::SameLine();
        ImGui::BeginDisabled(!hasSelectedAsset);
        if (ImGui::Button("Rename"))
        {
            BeginRenameSelectedAsset();
        }
        ImGui::EndDisabled();

        ImGui::SameLine();
        ImGui::BeginDisabled(!hasSelectedAsset);
        if (ImGui::Button("Copy"))
        {
            CopySelectedAssetToClipboard();
        }
        ImGui::EndDisabled();

        ImGui::SameLine();
        ImGui::BeginDisabled(!canPaste);
        if (ImGui::Button("Paste"))
        {
            PasteClipboardIntoSelectedFolder();
            RefreshAssetBrowserState();
        }
        ImGui::EndDisabled();

        ImGui::SameLine();
        ImGui::BeginDisabled(!hasSelectedAsset);
        if (ImGui::Button("Remove"))
        {
            DeleteSelectedAsset();
            RefreshAssetBrowserState();
        }
        ImGui::EndDisabled();

        ImGui::SameLine();
        ImGui::BeginDisabled(!selectedAssetIsGeometry);
        if (ImGui::Button("Generate LODs"))
        {
            RegenerateSelectedGeometryLods(editor);
            RefreshAssetBrowserState();
        }
        ImGui::EndDisabled();

        ImGui::SameLine();
        if (ImGui::Button("Refresh"))
        {
            InvalidateAssetBrowserDirectoryCache();
            RefreshAssetBrowserState();
        }

        ImGui::Separator();
        ImGui::TextWrapped("Data Folder: %s", gDataDirectoryDisplay.c_str());
        ImGui::TextWrapped(
            "Current Folder: %s",
            gSelectedFolderRelativePath.empty() ? "Data" : gSelectedFolderRelativePath.c_str());
        ImGui::Separator();

        if (gHasAssetActionResult)
        {
            const ImVec4 statusColor = gLastAssetActionSucceeded
                ? ImVec4(0.35f, 0.85f, 0.45f, 1.0f)
                : ImVec4(0.90f, 0.45f, 0.35f, 1.0f);
            ImGui::TextColored(statusColor, "%s", gAssetStatusMessage.c_str());
        }
        else
        {
            ImGui::TextWrapped("%s", gAssetStatusMessage.c_str());
        }

        if (ImGui::BeginPopupModal("Rename Asset", nullptr, ImGuiWindowFlags_AlwaysAutoResize))
        {
            ImGui::InputText("New Name", gRenameBuffer, IM_ARRAYSIZE(gRenameBuffer));

            if (ImGui::Button("Apply"))
            {
                if (RenameSelectedAsset())
                {
                    RefreshAssetBrowserState();
                    ImGui::CloseCurrentPopup();
                }
            }

            ImGui::SameLine();
            if (ImGui::Button("Cancel"))
            {
                ImGui::CloseCurrentPopup();
            }

            ImGui::EndPopup();
        }

        if (ImGui::BeginPopupModal("Create Folder", nullptr, ImGuiWindowFlags_AlwaysAutoResize))
        {
            ImGui::InputText("Folder Name", gNewFolderBuffer, IM_ARRAYSIZE(gNewFolderBuffer));

            if (ImGui::Button("Create"))
            {
                if (CreateFolderInSelectedFolder())
                {
                    RefreshAssetBrowserState();
                    ImGui::CloseCurrentPopup();
                }
            }

            ImGui::SameLine();
            if (ImGui::Button("Cancel"))
            {
                ImGui::CloseCurrentPopup();
            }

            ImGui::EndPopup();
        }

        // Open the import progress modal whenever a batch import starts.
        if (gTextureImport.Running.load() || gTextureImport.Done.load() > 0)
        {
            ImGui::OpenPopup("Importing Textures...");
        }

        ImGui::SetNextWindowSize(ImVec2(760.0f, 420.0f), ImGuiCond_Appearing);
        ImGui::SetNextWindowSizeConstraints(ImVec2(560.0f, 260.0f), ImVec2(FLT_MAX, FLT_MAX));
        if (ImGui::BeginPopupModal("Importing Textures...", nullptr, ImGuiWindowFlags_None))
        {
            const int total = gTextureImport.Total.load();
            const int done  = gTextureImport.Done.load();
            const bool running = gTextureImport.Running.load();
            std::string currentFile;
            {
                std::lock_guard<std::mutex> lock(gTextureImport.LogMutex);
                currentFile = gTextureImport.CurrentFile;
            }

            float fraction = (total > 0) ? (static_cast<float>(done) / static_cast<float>(total)) : 0.0f;
            if (running && total > 0)
            {
                fraction = (std::max)(fraction, 0.02f);
            }
            char progressLabel[64];
            _snprintf_s(progressLabel, _TRUNCATE, "%d / %d", done, total);
            ImGui::ProgressBar(fraction, ImVec2(-FLT_MIN, 0.0f), progressLabel);

            if (running)
            {
                if (!currentFile.empty())
                {
                    ImGui::TextWrapped("Processing: %s", currentFile.c_str());
                }
                else
                {
                    ImGui::TextUnformatted("Preparing import...");
                }

                if (done == 0)
                {
                    ImGui::TextWrapped("The first texture is still being compressed. Large 4K imports can take a bit before the first file completes.");
                }
            }
            else
            {
                ImGui::TextUnformatted("Import complete.");
            }

            // Scrollable log of per-file results.
            ImGui::Separator();
            const float footerHeight = ImGui::GetFrameHeightWithSpacing() + ImGui::GetStyle().ItemSpacing.y;
            ImGui::BeginChild("ImportLog", ImVec2(0.0f, -footerHeight), true);
            {
                std::lock_guard<std::mutex> lock(gTextureImport.LogMutex);
                for (const std::string& line : gTextureImport.Log)
                {
                    const bool isError = line.size() >= 3 && line.substr(0, 3) == "ERR";
                    if (isError)
                    {
                        ImGui::TextColored(ImVec4(0.9f, 0.4f, 0.3f, 1.0f), "%s", line.c_str());
                    }
                    else
                    {
                        ImGui::TextColored(ImVec4(0.35f, 0.85f, 0.45f, 1.0f), "%s", line.c_str());
                    }
                }
                // Auto-scroll to the bottom.
                if (ImGui::GetScrollY() >= ImGui::GetScrollMaxY())
                {
                    ImGui::SetScrollHereY(1.0f);
                }
            }
            ImGui::EndChild();

            // Only allow closing once the thread is done.
            ImGui::BeginDisabled(running);
            if (ImGui::Button("Close"))
            {
                // Reset so the modal won't reopen next frame.
                gTextureImport.Total.store(0);
                gTextureImport.Done.store(0);
                {
                    std::lock_guard<std::mutex> lock(gTextureImport.LogMutex);
                    gTextureImport.Log.clear();
                    gTextureImport.CurrentFile.clear();
                }
                RefreshAssetBrowserState();
                ImGui::CloseCurrentPopup();
            }
            ImGui::EndDisabled();

            ImGui::EndPopup();
        }

        ImGui::Separator();

        const float folderPaneWidth = 240.0f;
        if (ImGui::BeginChild("AssetFolders", ImVec2(folderPaneWidth, 0.0f), true))
        {
            RenderFolderTreeNode({});
        }
        ImGui::EndChild();

        ImGui::SameLine();

        if (ImGui::BeginChild("AssetContents", ImVec2(0.0f, 0.0f), true))
        {
            const std::vector<AssetBrowserItem>& items = CollectFolderItems(gSelectedFolderRelativePath);
            if (items.empty())
            {
                ImGui::TextUnformatted("This folder is empty.");
            }
            else
            {
                for (const AssetBrowserItem& item : items)
                {
                    const std::string itemLabel = std::string(item.IsDirectory ? "[Folder] " : "[File] ") + item.Name;
                    if (ImGui::Selectable(itemLabel.c_str(), gSelectedAssetRelativePath == item.RelativePath))
                    {
                        gSelectedAssetRelativePath = item.RelativePath;
                    }

                    if (ImGui::IsItemHovered() && ImGui::IsMouseDoubleClicked(ImGuiMouseButton_Left) && item.IsDirectory)
                    {
                        SelectFolder(item.RelativePath);
                    }

                    if (ImGui::BeginPopupContextItem(item.RelativePath.c_str()))
                    {
                        gSelectedAssetRelativePath = item.RelativePath;

                        if (item.IsDirectory && ImGui::MenuItem("Open"))
                        {
                            SelectFolder(item.RelativePath);
                        }

                        if (item.IsDirectory && ImGui::MenuItem("Import FBX Here..."))
                        {
                            SelectFolder(item.RelativePath);
                            PromptForAndImportFbx(windowHandle, item.RelativePath);
                            RefreshAssetBrowserState();
                        }

                        if (item.IsDirectory && ImGui::MenuItem("Import Texture Here..."))
                        {
                            SelectFolder(item.RelativePath);
                            PromptForAndImportTexture(windowHandle, item.RelativePath);
                            RefreshAssetBrowserState();
                        }

                        if (ImGui::MenuItem("Rename"))
                        {
                            BeginRenameSelectedAsset();
                        }

                        if (ImGui::MenuItem("Copy"))
                        {
                            CopySelectedAssetToClipboard();
                        }

                        if (!item.IsDirectory && IsGeometryAssetPath(item.RelativePath) && ImGui::MenuItem("Generate LODs"))
                        {
                            RegenerateSelectedGeometryLods(editor);
                            RefreshAssetBrowserState();
                        }

                        if (ImGui::MenuItem("Remove"))
                        {
                            DeleteSelectedAsset();
                            RefreshAssetBrowserState();
                        }

                        ImGui::EndPopup();
                    }
                }
            }

            if (ImGui::BeginPopupContextWindow("AssetBrowserBackgroundContext", ImGuiPopupFlags_NoOpenOverItems | ImGuiPopupFlags_MouseButtonRight))
            {
                if (ImGui::MenuItem("Import FBX Here..."))
                {
                    PromptForAndImportFbx(windowHandle, gSelectedFolderRelativePath);
                    RefreshAssetBrowserState();
                }

                if (ImGui::MenuItem("Import Texture Here..."))
                {
                    PromptForAndImportTexture(windowHandle, gSelectedFolderRelativePath);
                    RefreshAssetBrowserState();
                }

                if (ImGui::MenuItem("New Folder"))
                {
                    BeginCreateFolder();
                }

                ImGui::BeginDisabled(!canPaste);
                if (ImGui::MenuItem("Paste"))
                {
                    PasteClipboardIntoSelectedFolder();
                    RefreshAssetBrowserState();
                }
                ImGui::EndDisabled();

                ImGui::EndPopup();
            }
        }
        ImGui::EndChild();
        ImGui::End();
    }

    if (gShowAboutWindow)
    {
        ImGui::Begin("About Ptero Editor", &gShowAboutWindow, ImGuiWindowFlags_AlwaysAutoResize);
        ImGui::TextUnformatted("Ptero Editor");
        ImGui::Separator();
        ImGui::TextUnformatted("Rendering backend: Dear ImGui + DirectX 12");
        ImGui::TextUnformatted("Menu implementation is split into its own source file.");
        ImGui::End();
    }

    // -----------------------------------------------------------------------
    // G-Buffer / RT Debug window
    // Displays each G-Buffer layer and the RT GI accumulation texture as a
    // tiled image grid so rendering issues can be diagnosed visually.
    // -----------------------------------------------------------------------
    if (gShowGBufferDebugWindow && gbufferTextureIds != nullptr)
    {
        // Force the window large enough for all 5 tiles every time it is opened
        // so that stale imgui.ini sizes from earlier sessions don't cut off tiles.
        ImGui::SetNextWindowSize(ImVec2(900.0f, 980.0f), ImGuiCond_Appearing);
        if (ImGui::Begin("G-Buffer / RT Debug", &gShowGBufferDebugWindow))
        {
            // Each tile shows a label, then the texture scaled to fit two columns.
            const float padding    = 8.0f;
            const float tileWidth  = (ImGui::GetContentRegionAvail().x - padding) * 0.5f;
            const float tileHeight = tileWidth * (9.0f / 16.0f); // 16:9 aspect

            // Order tiles so the most diagnostic ones appear first (top-left).
            struct Tile { const char* label; ImTextureID id; };
            Tile tiles[] =
            {
                { "RT GI Accumulation (RGB)",              gbufferTextureIds->GiAccum  },
                { "Albedo (RGB)",                          gbufferTextureIds->Albedo   },
                { "World Normal (RGB)",                    gbufferTextureIds->Normal   },
                { "Material (R=Roughness, G=Metallic, B=AO)", gbufferTextureIds->Material },
                { "Depth (reversed preview of scene depth)",  gbufferTextureIds->Depth    },
                { "Point Shadow Array (slice 0 view)",       gbufferTextureIds->PointShadowArray },
            };

            for (int i = 0; i < static_cast<int>(std::size(tiles)); ++i)
            {
                // Two columns: even indices go left, odd indices go right (SameLine).
                if (i > 0 && (i % 2) == 1)
                    ImGui::SameLine(tileWidth + padding);

                ImGui::BeginGroup();
                ImGui::TextUnformatted(tiles[i].label);
                if (tiles[i].id != ImTextureID_Invalid)
                    ImGui::Image(tiles[i].id, ImVec2(tileWidth, tileHeight));
                else
                    ImGui::TextDisabled("(not available)");
                ImGui::EndGroup();
            }
        }
        ImGui::End();
    }
}