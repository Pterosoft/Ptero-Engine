        // -------------------------------------------------------------------
        if (rtgiSettings != nullptr)
        {
            if (ImGui::CollapsingHeader("Luna Global Illumination", ImGuiTreeNodeFlags_DefaultOpen))
            {
                if (ImGui::Button("Revert All##rtgi"))
                {
                    *rtgiSettings = defaultRtgiSettings;
                }
                ImGui::Checkbox("Enable RTGI##rtgi", &rtgiSettings->Enabled);
                ImGui::SetItemTooltip("Enable custom ReSTIR GI ray-traced global illumination.");

                // Show any runtime error (e.g. shader compile failure) in red.
                if (sceneStatusMessage && sceneStatusMessage[0] != '\0')
                {
                    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 0.3f, 0.3f, 1.0f));
                    ImGui::TextWrapped("Error: %s", sceneStatusMessage);
                    ImGui::PopStyleColor();
                }

                if (rtgiSettings->Enabled)
                {
                    ImGui::Separator();
                    ImGui::TextDisabled("Denoiser");

                    ImGui::Checkbox("Use NVIDIA NRD##rtgi", &rtgiSettings->UseNrdDenoiser);
                    ImGui::SetItemTooltip("Use NVIDIA NRD RELAX diffuse denoising for the RTGI result.");

                    // --- Ray generation ---
                    ImGui::Separator();
                    ImGui::TextDisabled("Ray Generation");

                    SliderIntWithInput("Rays Per Pixel##rtgi", &rtgiSettings->RaysPerPixel, 1, 8);
                    ImGui::SetItemTooltip("Number of GI rays fired per pixel each frame. Higher = better quality, lower performance.");
                    SliderIntWithInput("Max Bounces##rtgi", &rtgiSettings->MaxBounces, 1, 4);
                    ImGui::SetItemTooltip("Maximum indirect bounce depth for GI rays.");
                    ImGui::Checkbox("Next Event Estimation##rtgi", &rtgiSettings->NextEventEstimation);
                    ImGui::SetItemTooltip("Trace a shadow ray from the secondary hit toward the sun to explicitly estimate direct lighting in the GI path.");

                    // --- Firefly suppression ---
                    ImGui::Separator();
                    ImGui::TextDisabled("Firefly Suppression");

                    SliderFloatWithInput("Radiance Clamp##rtgi", &rtgiSettings->RadianceClamp, 0.0f, 50.0f, "%.1f");
                    ImGui::SetItemTooltip("Clamp incoming radiance to this value to suppress fireflies. Set to 0 to disable.");

                    // --- Temporal accumulation denoiser ---
                    ImGui::Separator();
                    ImGui::TextDisabled("Temporal Accumulation");

                    SliderFloatWithInput("Accumulation Blend##rtgi", &rtgiSettings->AccumulationBlend, 0.01f, 1.0f, "%.2f");
                    ImGui::SetItemTooltip("Blend factor between current frame (1.0) and accumulated history (0.0). Lower = smoother but ghosts on motion.");

                    if (rtgiSettings->UseNrdDenoiser)
                    {
                        ImGui::Separator();
                        ImGui::TextDisabled("NRD RELAX");

                        SliderFloatWithInput("Max Accumulation Time##rtgi_nrd", &rtgiSettings->NrdMaxAccumulationTime, 0.01f, 5.0f, "%.2f s");
                        ImGui::SetItemTooltip("How long NRD is allowed to accumulate diffuse history. Higher values can reduce motion artifacts but respond more slowly to lighting changes.");
                        SliderFloatWithInput("Disocclusion Threshold##rtgi_nrd", &rtgiSettings->NrdDisocclusionThreshold, 0.001f, 0.5f, "%.3f", 0.001f, 0.01f);
                        ImGui::SetItemTooltip("Depth-based history rejection threshold used by NRD. Higher values can stabilize camera motion but may preserve more history across edges.");
                        SliderIntWithInput("A-Trous Iterations##rtgi_nrd", &rtgiSettings->NrdAtrousIterations, 2, 8);
                        ImGui::SetItemTooltip("Number of RELAX wavelet filter iterations.");
                        SliderFloatWithInput("Sharpen##rtgi_nrd", &rtgiSettings->NrdSharpenAmount, 0.0f, 1.5f, "%.2f");
                        ImGui::SetItemTooltip("Applies a lightweight post-denoise sharpen to recover lost detail. Higher values can help with softness but may re-introduce noise halos.");
                    }

                    // --- Output ---
                    ImGui::Separator();
                    ImGui::TextDisabled("Output");

                    SliderFloatWithInput("GI Intensity##rtgi", &rtgiSettings->GiIntensity, 0.0f, 4.0f, "%.2f");
                    ImGui::SetItemTooltip("Multiplier applied to the RTGI output before compositing. 1.0 = physically correct.");
                    SliderFloatWithInput("Color Leak Intensity##rtgi", &rtgiSettings->ColorLeakIntensity, 0.0f, 16.0f, "%.2f");
                    ImGui::SetItemTooltip("Boosts bounced material tinting for stronger color bleed. 1.0 = physically based transport.");

                    // --- Specular Reflections ---
                    ImGui::Separator();
                    ImGui::TextDisabled("Specular Reflections");

                    ImGui::Checkbox("Enable Specular##rtgi", &rtgiSettings->SpecularEnabled);
                    ImGui::SetItemTooltip("Ray-traced GGX specular reflections composited on top of the deferred lighting pass.");
                    if (rtgiSettings->SpecularEnabled)
                    {
                        SliderFloatWithInput("Roughness Threshold##rtgi", &rtgiSettings->SpecularRoughnessThreshold, 0.0f, 1.0f, "%.2f");
                        ImGui::SetItemTooltip("Surfaces with perceptual roughness above this value skip the specular ray.");
                        SliderFloatWithInput("Specular Intensity##rtgi", &rtgiSettings->SpecularIntensity, 0.0f, 4.0f, "%.2f");
                        ImGui::SetItemTooltip("Intensity multiplier for ray-traced specular reflections.");
                    }

                    // --- Debug ---
                    ImGui::Separator();
                    ImGui::TextDisabled("Debug");

                    const char* debugModes[] = { "Final Lit", "Raw GI Radiance", "GI Luminance", "Specular Reflections" };
                    ImGui::Combo("Debug View##rtgi", &rtgiSettings->DebugView, debugModes, IM_ARRAYSIZE(debugModes));
                    ImGui::SetItemTooltip("Overlay mode for inspecting intermediate RTGI data.");
                }
            }
        }

        // -------------------------------------------------------------------
        // Radiance Probes – world-space irradiance SH probe grid
        // -------------------------------------------------------------------
        if (probeSettings != nullptr)
        {
            if (ImGui::CollapsingHeader("Radiance Probes"))
            {
                static RadianceProbeSettings defaultProbeSettings{};
                if (ImGui::Button("Revert All##probe"))
