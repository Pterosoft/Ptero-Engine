void RenderEditorMainMenu(
    HWND windowHandle,
    void* editor,
    ImTextureID sceneTextureId,
    const char* sceneStatusMessage,
    const char* statisticsText,
    float* cameraSpeed,
    bool* gridEnabled,
    bool* showStatistics,
    bool* showViewportPlacementIcons,
    bool* showComponentsPanel,
    bool* showLevelExplorerPanel,
    bool* showPropertiesPanel)
{
    UNREFERENCED_PARAMETER(sceneTextureId);
    UNREFERENCED_PARAMETER(sceneStatusMessage);
    UNREFERENCED_PARAMETER(statisticsText);

    Editor* editorInstance = static_cast<Editor*>(editor);

    if (ImGui::BeginMainMenuBar())
    {
        if (ImGui::BeginMenu("File"))
        {
            if (editorInstance != nullptr && ImGui::MenuItem("Open..."))
            {
                if (PromptForSceneOpenPath(windowHandle, gSceneFileBuffer, static_cast<DWORD>(std::size(gSceneFileBuffer))))
                {
                    editorInstance->LoadSceneFromFile(gSceneFileBuffer);
                }
            }

            if (editorInstance != nullptr && ImGui::MenuItem("Save"))
            {
                if (!editorInstance->GetCurrentSceneFilePath().empty())
                {
                    editorInstance->SaveSceneToFile(editorInstance->GetCurrentSceneFilePath());
                }
                else if (PromptForSceneSavePath(windowHandle, gSceneFileBuffer, static_cast<DWORD>(std::size(gSceneFileBuffer))))
                {
                    editorInstance->SaveSceneToFile(gSceneFileBuffer);
                }
            }

            if (editorInstance != nullptr && ImGui::MenuItem("Save As..."))
            {
                if (!editorInstance->GetCurrentSceneFilePath().empty())
                {
                    strcpy_s(gSceneFileBuffer, editorInstance->GetCurrentSceneFilePath().c_str());
                }

                if (PromptForSceneSavePath(windowHandle, gSceneFileBuffer, static_cast<DWORD>(std::size(gSceneFileBuffer))))
                {
                    editorInstance->SaveSceneToFile(gSceneFileBuffer);
                }
            }

            ImGui::Separator();
            if (ImGui::MenuItem("Exit"))
            {
                PostMessage(windowHandle, WM_CLOSE, 0, 0);
            }

            ImGui::EndMenu();
        }

        if (ImGui::BeginMenu("Windows"))
        {
            if (ImGui::MenuItem("Scene Settings..."))
            {
                gShowSceneSettingsWindow = true;
            }

            if (ImGui::MenuItem("Material Editor..."))
            {
                gShowMaterialEditorWindow = true;
                RefreshMaterialNameBuffer();
            }

            if (showComponentsPanel != nullptr)
            {
                ImGui::MenuItem("Components", nullptr, showComponentsPanel);
            }

            if (showLevelExplorerPanel != nullptr)
            {
                ImGui::MenuItem("Level Explorer", nullptr, showLevelExplorerPanel);
            }

            if (showPropertiesPanel != nullptr)
            {
                ImGui::MenuItem("Properties", nullptr, showPropertiesPanel);
            }

            if (ImGui::MenuItem("Asset Browser..."))
            {
                gShowAssetBrowserWindow = true;
                RefreshAssetBrowserState();
            }

            ImGui::EndMenu();
        }

        if (ImGui::BeginMenu("Help"))
        {
            if (ImGui::MenuItem("About Ptero Editor"))
            {
                gShowAboutWindow = true;
            }

            ImGui::EndMenu();
        }

        ImGui::EndMainMenuBar();
    }

    if (gShowImGuiDemoWindow)
    {
        ImGui::ShowDemoWindow(&gShowImGuiDemoWindow);
    }

    if (gShowSceneSettingsWindow)
    {
        ImGui::Begin("Scene Settings", &gShowSceneSettingsWindow, ImGuiWindowFlags_AlwaysAutoResize);

        if (cameraSpeed != nullptr)
        {
            // Expose the camera speed directly in the editor so movement tuning does not require a rebuild.
            ImGui::SliderFloat("Camera Speed", cameraSpeed, 0.0f, 50.0f, "%.2f");
        }

        if (gridEnabled != nullptr)
        {
            // Let the user hide the reference grid without changing the renderer's geometry setup.
            ImGui::Checkbox("Show Grid", gridEnabled);
        }

        if (showStatistics != nullptr)
        {
            // Keep the statistics toggle in scene settings so the viewport overlay can be disabled without code changes.
            ImGui::Checkbox("Show Renderer Statistics", showStatistics);
        }

        if (showViewportPlacementIcons != nullptr)
        {
            // Let the user hide the placement markers when they want an unobstructed view of the scene.
            ImGui::Checkbox("Show Geometry Placement Icons", showViewportPlacementIcons);
        }

        ImGui::End();
    }

    if (gShowMaterialEditorWindow)
    {
        ImGui::SetNextWindowSize(ImVec2(560.0f, 720.0f), ImGuiCond_FirstUseEver);
        if (ImGui::Begin("Material Editor", &gShowMaterialEditorWindow))
        {
            MaterialDefinition& materialDefinition = gMaterialEditor.GetCurrentMaterial();
            if (gMaterialNameBuffer[0] == '\0')
            {
                RefreshMaterialNameBuffer();
            }

            if (ImGui::Button("New"))
            {
                gMaterialEditor.NewMaterial();
                RefreshMaterialNameBuffer();
            }

            ImGui::SameLine();
            if (ImGui::Button("Open..."))
            {
                if (gMaterialEditor.OpenMaterialWithDialog(windowHandle))
                {
                    RefreshMaterialNameBuffer();
                }
            }

            ImGui::SameLine();
            if (ImGui::Button("Save"))
            {
                materialDefinition.Name = gMaterialNameBuffer;
                gMaterialEditor.SaveCurrentMaterial();
                RefreshMaterialNameBuffer();
            }

            ImGui::SameLine();
            if (ImGui::Button("Save As..."))
            {
                materialDefinition.Name = gMaterialNameBuffer;
                if (gMaterialEditor.SaveMaterialWithDialog(windowHandle))
                {
                    RefreshMaterialNameBuffer();
                }
            }

            ImGui::Separator();
            ImGui::InputText("Material Name", gMaterialNameBuffer, IM_ARRAYSIZE(gMaterialNameBuffer));
            materialDefinition.Name = gMaterialNameBuffer;

            ImGui::ColorEdit4("Base Color Tint", materialDefinition.BaseColorTint.data());
            ImGui::ColorEdit3("Emissive Color", materialDefinition.EmissiveColor.data());
            ImGui::SliderFloat("Metallic Factor", &materialDefinition.MetallicFactor, 0.0f, 1.0f);
            ImGui::SliderFloat("Roughness Factor", &materialDefinition.RoughnessFactor, 0.0f, 1.0f);
            ImGui::SliderFloat("Normal Scale", &materialDefinition.NormalScale, 0.0f, 4.0f);
            ImGui::SliderFloat("Ambient Occlusion Strength", &materialDefinition.AmbientOcclusionStrength, 0.0f, 4.0f);
            ImGui::SliderFloat("Height Scale", &materialDefinition.HeightScale, 0.0f, 1.0f);
            ImGui::SliderFloat("Opacity", &materialDefinition.Opacity, 0.0f, 1.0f);
            ImGui::SliderFloat("Alpha Cutoff", &materialDefinition.AlphaCutoff, 0.0f, 1.0f);
            ImGui::Checkbox("Double Sided", &materialDefinition.IsDoubleSided);
            ImGui::Checkbox("Use Alpha Cutout", &materialDefinition.UseAlphaCutout);
            ImGui::Checkbox("Use Transparent Blend", &materialDefinition.UseTransparentBlend);

            const auto drawTextureField = [&](const char* label, const MaterialTextureSlot textureSlot)
            {
                std::string& texturePath = materialDefinition.Textures.GetTexturePath(textureSlot);
                ImGui::PushID(label);
                ImGui::TextUnformatted(label);
                ImGui::SameLine(180.0f);
                ImGui::TextWrapped("%s", texturePath.empty() ? "<none>" : texturePath.c_str());
                if (ImGui::Button("Browse..."))
                {
                    gMaterialEditor.BrowseForTexture(windowHandle, textureSlot);
                }
                ImGui::SameLine();
                if (ImGui::Button("Clear"))
                {
                    texturePath.clear();
                }
                ImGui::PopID();
            };

            ImGui::Separator();
            ImGui::TextUnformatted("Textures");
            drawTextureField("Base Color", MaterialTextureSlot::BaseColor);
            drawTextureField("Normal", MaterialTextureSlot::Normal);
            drawTextureField("Metallic", MaterialTextureSlot::Metallic);
            drawTextureField("Roughness", MaterialTextureSlot::Roughness);
            drawTextureField("Metallic Roughness", MaterialTextureSlot::MetallicRoughness);
            drawTextureField("Ambient Occlusion", MaterialTextureSlot::AmbientOcclusion);
            drawTextureField("Emissive", MaterialTextureSlot::Emissive);
            drawTextureField("Height", MaterialTextureSlot::Height);
            drawTextureField("Opacity", MaterialTextureSlot::Opacity);

            ImGui::Separator();
            const std::vector<std::filesystem::path> availableMaterials = gMaterialEditor.FindAvailableMaterials();
            ImGui::TextUnformatted("Material Library");
            if (availableMaterials.empty())
            {
                ImGui::TextDisabled("No saved materials found under Data/Materials.");
            }
            else if (ImGui::BeginChild("MaterialLibrary", ImVec2(0.0f, 180.0f), true))
            {
                for (const std::filesystem::path& materialPath : availableMaterials)
                {
                    const std::string itemLabel = materialPath.filename().string();
                    if (ImGui::Selectable(itemLabel.c_str(), gMaterialEditor.GetCurrentMaterialPath() == materialPath))
                    {
                        if (gMaterialEditor.LoadMaterialFromFile(materialPath))
                        {
                            RefreshMaterialNameBuffer();
                        }
                    }
                }
                ImGui::EndChild();
            }

            if (!gMaterialEditor.GetCurrentMaterialPath().empty())
            {
                ImGui::TextWrapped("Current File: %s", gMaterialEditor.GetCurrentMaterialPath().string().c_str());
            }

            if (!gMaterialEditor.GetLastErrorMessage().empty())
            {
                ImGui::TextWrapped("Status: %s", gMaterialEditor.GetLastErrorMessage().c_str());
            }
        }
        ImGui::End();
    }

    if (gShowAssetBrowserWindow)
    {
        RefreshAssetBrowserState();
        ImGui::Begin("Asset Browser", &gShowAssetBrowserWindow, ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse);

        if (gOpenRenamePopup)
        {
            ImGui::OpenPopup("Rename Asset");
            gOpenRenamePopup = false;
        }

        if (gOpenNewFolderPopup)
        {
            ImGui::OpenPopup("Create Folder");
            gOpenNewFolderPopup = false;
        }

        const bool hasSelectedAsset = !gSelectedAssetRelativePath.empty();
        const bool canPaste = gClipboardHasValue;

        // The toolbar keeps common content-browser actions visible, similar to the asset views used by large game editors.
        if (ImGui::Button("Import FBX"))
        {
            if (PromptForAndImportFbx(windowHandle, gSelectedFolderRelativePath))
            {
                RefreshAssetBrowserState();
            }
        }

        ImGui::SameLine();
        if (ImGui::Button("New Folder"))
        {
            BeginCreateFolder();
        }

        ImGui::SameLine();
        ImGui::BeginDisabled(!hasSelectedAsset);
        if (ImGui::Button("Rename"))
        {
            BeginRenameSelectedAsset();
        }
        ImGui::EndDisabled();

        ImGui::SameLine();
        ImGui::BeginDisabled(!hasSelectedAsset);
        if (ImGui::Button("Copy"))
        {
            CopySelectedAssetToClipboard();
        }
        ImGui::EndDisabled();

        ImGui::SameLine();
        ImGui::BeginDisabled(!canPaste);
        if (ImGui::Button("Paste"))
        {
            PasteClipboardIntoSelectedFolder();
            RefreshAssetBrowserState();
        }
        ImGui::EndDisabled();

        ImGui::SameLine();
        ImGui::BeginDisabled(!hasSelectedAsset);
        if (ImGui::Button("Remove"))
        {
            DeleteSelectedAsset();
            RefreshAssetBrowserState();
        }
        ImGui::EndDisabled();

        ImGui::SameLine();
        if (ImGui::Button("Refresh"))
        {
            RefreshAssetBrowserState();
        }

        ImGui::Separator();
        ImGui::TextWrapped("Data Folder: %s", gDataDirectoryDisplay.c_str());
        ImGui::TextWrapped(
            "Current Folder: %s",
            gSelectedFolderRelativePath.empty() ? "Data" : gSelectedFolderRelativePath.c_str());
        ImGui::Separator();

        if (gHasAssetActionResult)
        {
            const ImVec4 statusColor = gLastAssetActionSucceeded
                ? ImVec4(0.35f, 0.85f, 0.45f, 1.0f)
                : ImVec4(0.90f, 0.45f, 0.35f, 1.0f);
            ImGui::TextColored(statusColor, "%s", gAssetStatusMessage.c_str());
        }
        else
        {
            ImGui::TextWrapped("%s", gAssetStatusMessage.c_str());
        }

        if (ImGui::BeginPopupModal("Rename Asset", nullptr, ImGuiWindowFlags_AlwaysAutoResize))
        {
            ImGui::InputText("New Name", gRenameBuffer, IM_ARRAYSIZE(gRenameBuffer));

            if (ImGui::Button("Apply"))
            {
                if (RenameSelectedAsset())
                {
                    RefreshAssetBrowserState();
                    ImGui::CloseCurrentPopup();
                }
            }

            ImGui::SameLine();
            if (ImGui::Button("Cancel"))
            {
                ImGui::CloseCurrentPopup();
            }

            ImGui::EndPopup();
        }

        if (ImGui::BeginPopupModal("Create Folder", nullptr, ImGuiWindowFlags_AlwaysAutoResize))
        {
            ImGui::InputText("Folder Name", gNewFolderBuffer, IM_ARRAYSIZE(gNewFolderBuffer));

            if (ImGui::Button("Create"))
            {
                if (CreateFolderInSelectedFolder())
                {
                    RefreshAssetBrowserState();
                    ImGui::CloseCurrentPopup();
                }
            }

            ImGui::SameLine();
            if (ImGui::Button("Cancel"))
            {
                ImGui::CloseCurrentPopup();
            }

            ImGui::EndPopup();
        }

        ImGui::Separator();

        const float folderPaneWidth = 240.0f;
        if (ImGui::BeginChild("AssetFolders", ImVec2(folderPaneWidth, 0.0f), true))
        {
            RenderFolderTreeNode({});
        }
        ImGui::EndChild();

        ImGui::SameLine();

        if (ImGui::BeginChild("AssetContents", ImVec2(0.0f, 0.0f), true))
        {
            const std::vector<AssetBrowserItem> items = CollectFolderItems(gSelectedFolderRelativePath);
            if (items.empty())
            {
                ImGui::TextUnformatted("This folder is empty.");
            }
            else
            {
                for (const AssetBrowserItem& item : items)
                {
                    const std::string itemLabel = std::string(item.IsDirectory ? "[Folder] " : "[File] ") + item.Name;
                    if (ImGui::Selectable(itemLabel.c_str(), gSelectedAssetRelativePath == item.RelativePath))
                    {
                        gSelectedAssetRelativePath = item.RelativePath;
                    }

                    if (ImGui::IsItemHovered() && ImGui::IsMouseDoubleClicked(ImGuiMouseButton_Left) && item.IsDirectory)
                    {
                        SelectFolder(item.RelativePath);
                    }

                    if (ImGui::BeginPopupContextItem(item.RelativePath.c_str()))
                    {
                        gSelectedAssetRelativePath = item.RelativePath;

                        if (item.IsDirectory && ImGui::MenuItem("Open"))
                        {
                            SelectFolder(item.RelativePath);
                        }

                        if (item.IsDirectory && ImGui::MenuItem("Import FBX Here..."))
                        {
                            SelectFolder(item.RelativePath);
                            PromptForAndImportFbx(windowHandle, item.RelativePath);
                            RefreshAssetBrowserState();
                        }

                        if (ImGui::MenuItem("Rename"))
                        {
                            BeginRenameSelectedAsset();
                        }

                        if (ImGui::MenuItem("Copy"))
                        {
                            CopySelectedAssetToClipboard();
                        }

                        if (ImGui::MenuItem("Remove"))
                        {
                            DeleteSelectedAsset();
                            RefreshAssetBrowserState();
                        }

                        ImGui::EndPopup();
                    }
                }
            }

            if (ImGui::BeginPopupContextWindow("AssetBrowserBackgroundContext", ImGuiPopupFlags_NoOpenOverItems | ImGuiPopupFlags_MouseButtonRight))
            {
                if (ImGui::MenuItem("Import FBX Here..."))
                {
                    PromptForAndImportFbx(windowHandle, gSelectedFolderRelativePath);
                    RefreshAssetBrowserState();
                }

                if (ImGui::MenuItem("New Folder"))
                {
                    BeginCreateFolder();
                }

                ImGui::BeginDisabled(!canPaste);
                if (ImGui::MenuItem("Paste"))
                {
                    PasteClipboardIntoSelectedFolder();
                    RefreshAssetBrowserState();
                }
                ImGui::EndDisabled();

                ImGui::EndPopup();
            }
        }
        ImGui::EndChild();
        ImGui::End();
    }

    if (gShowAboutWindow)
    {
        ImGui::Begin("About Ptero Editor", &gShowAboutWindow, ImGuiWindowFlags_AlwaysAutoResize);
        ImGui::TextUnformatted("Ptero Editor");
        ImGui::Separator();
        ImGui::TextUnformatted("Rendering backend: Dear ImGui + DirectX 12");
        ImGui::TextUnformatted("Menu implementation is split into its own source file.");
        ImGui::End();
    }
}
