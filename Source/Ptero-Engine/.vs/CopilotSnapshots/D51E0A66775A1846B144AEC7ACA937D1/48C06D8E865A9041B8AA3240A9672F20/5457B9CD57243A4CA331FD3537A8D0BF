    struct DecodedImageData
    {
        std::vector<std::uint8_t> Pixels;
        UINT Width = 0;
        UINT Height = 0;
    };

    std::filesystem::path FindNamedFile(const wchar_t* fileName)
    {
        wchar_t executablePath[MAX_PATH] = {};
        if (GetModuleFileNameW(nullptr, executablePath, static_cast<DWORD>(std::size(executablePath))) == 0)
        {
            return {};
        }

        std::filesystem::path currentPath = std::filesystem::path(executablePath).parent_path();
        while (!currentPath.empty())
        {
            std::error_code iteratorError;
            for (std::filesystem::recursive_directory_iterator it(
                     currentPath,
                     std::filesystem::directory_options::skip_permission_denied,
                     iteratorError),
                 end;
                 it != end && !iteratorError;
                 it.increment(iteratorError))
            {
                std::error_code statusError;
                if (!it->is_regular_file(statusError) || statusError)
                {
                    continue;
                }

                if (_wcsicmp(it->path().filename().c_str(), fileName) == 0)
                {
                    return it->path();
                }
            }

            const std::filesystem::path parentPath = currentPath.parent_path();
            if (parentPath == currentPath)
            {
                break;
            }

            currentPath = parentPath;
        }

        return {};
    }

    bool LoadDecodedImage(const std::filesystem::path& imagePath, DecodedImageData& outImageData, std::string& outErrorMessage)
    {
        const HRESULT initializeResult = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
        const bool shouldUninitialize = SUCCEEDED(initializeResult);

        ComPtr<IWICImagingFactory> imagingFactory;
        HRESULT hr = CoCreateInstance(
            CLSID_WICImagingFactory,
            nullptr,
            CLSCTX_INPROC_SERVER,
            IID_PPV_ARGS(&imagingFactory));
        if (FAILED(hr))
        {
            outErrorMessage = "Failed to create the WIC imaging factory for Geometry.png.";
            if (shouldUninitialize)
            {
                CoUninitialize();
            }
            return false;
        }

        ComPtr<IWICBitmapDecoder> decoder;
        hr = imagingFactory->CreateDecoderFromFilename(
            imagePath.c_str(),
            nullptr,
            GENERIC_READ,
            WICDecodeMetadataCacheOnDemand,
            &decoder);
        if (FAILED(hr))
        {
            outErrorMessage = "Failed to open Geometry.png with WIC.";
            if (shouldUninitialize)
            {
                CoUninitialize();
            }
            return false;
        }

        ComPtr<IWICBitmapFrameDecode> frame;
        hr = decoder->GetFrame(0, &frame);
        if (FAILED(hr))
        {
            outErrorMessage = "Failed to read the first frame from Geometry.png.";
            if (shouldUninitialize)
            {
                CoUninitialize();
            }
            return false;
        }

        ComPtr<IWICFormatConverter> converter;
        hr = imagingFactory->CreateFormatConverter(&converter);
        if (FAILED(hr))
        {
            outErrorMessage = "Failed to create the WIC format converter for Geometry.png.";
            if (shouldUninitialize)
            {
                CoUninitialize();
            }
            return false;
        }

        hr = converter->Initialize(
            frame.Get(),
            GUID_WICPixelFormat32bppRGBA,
            WICBitmapDitherTypeNone,
            nullptr,
            0.0,
            WICBitmapPaletteTypeCustom);
        if (FAILED(hr))
        {
            outErrorMessage = "Failed to convert Geometry.png into RGBA8 pixel data.";
            if (shouldUninitialize)
            {
                CoUninitialize();
            }
            return false;
        }

        hr = converter->GetSize(&outImageData.Width, &outImageData.Height);
        if (FAILED(hr) || outImageData.Width == 0 || outImageData.Height == 0)
        {
            outErrorMessage = "Geometry.png did not report a valid image size.";
            if (shouldUninitialize)
            {
                CoUninitialize();
            }
            return false;
        }

        const UINT bytesPerPixel = 4;
        const UINT rowPitch = outImageData.Width * bytesPerPixel;
        outImageData.Pixels.resize(static_cast<size_t>(rowPitch) * static_cast<size_t>(outImageData.Height));

        hr = converter->CopyPixels(nullptr, rowPitch, static_cast<UINT>(outImageData.Pixels.size()), outImageData.Pixels.data());
        if (FAILED(hr))
        {
            outErrorMessage = "Failed to copy Geometry.png pixels out of WIC.";
            if (shouldUninitialize)
            {
                CoUninitialize();
            }
            return false;
        }

        // Release all WIC COM objects before CoUninitialize so their final Release() calls do not
        // execute after WindowsCodecs.dll has already been unloaded for this apartment.
        converter.Reset();
        frame.Reset();
        decoder.Reset();
        imagingFactory.Reset();

        if (shouldUninitialize)
        {
            CoUninitialize();
        }

        return true;
    }

    XMFLOAT3 QuaternionToEulerRadians(FXMVECTOR quaternion)
    {
        XMFLOAT4 rotation{};
        XMStoreFloat4(&rotation, quaternion);

        const float sinPitchCosYaw = 2.0f * ((rotation.w * rotation.x) + (rotation.y * rotation.z));
        const float cosPitchCosYaw = 1.0f - (2.0f * ((rotation.x * rotation.x) + (rotation.y * rotation.y)));
        const float pitch = std::atan2(sinPitchCosYaw, cosPitchCosYaw);

        const float sinYaw = 2.0f * ((rotation.w * rotation.y) - (rotation.z * rotation.x));
        const float yaw = std::abs(sinYaw) >= 1.0f
            ? std::copysign(XM_PIDIV2, sinYaw)
            : std::asin(sinYaw);

        const float sinRollCosYaw = 2.0f * ((rotation.w * rotation.z) + (rotation.x * rotation.y));
        const float cosRollCosYaw = 1.0f - (2.0f * ((rotation.y * rotation.y) + (rotation.z * rotation.z)));
        const float roll = std::atan2(sinRollCosYaw, cosRollCosYaw);

        return XMFLOAT3(pitch, yaw, roll);
    }

    struct SelectionRect
    {
        ImVec2 Min{};
        ImVec2 Max{};

        bool Contains(const ImVec2& point) const
        {
            return point.x >= Min.x && point.x <= Max.x && point.y >= Min.y && point.y <= Max.y;
        }
    };

    SelectionRect MakeSelectionRect(const ImVec2& startPoint, const ImVec2& endPoint)
    {
        return SelectionRect{
            ImVec2((std::min)(startPoint.x, endPoint.x), (std::min)(startPoint.y, endPoint.y)),
            ImVec2((std::max)(startPoint.x, endPoint.x), (std::max)(startPoint.y, endPoint.y)) };
    }

