bool Editor::Initialize(ID3D12GraphicsCommandList* commandList)
{
    if (mGeometryIconLoadAttempted)
    {
        return true;
    }

    mGeometryIconLoadAttempted = true;

    const bool geometryIconLoaded = LoadGeometryIcon(commandList);
    LoadIconTexture(L"Select.png", mSelectIcon, nullptr, commandList);
    LoadIconTexture(L"Move.png", mMoveIcon, nullptr, commandList);
    LoadIconTexture(L"Rotate.png", mRotateIcon, nullptr, commandList);
    LoadIconTexture(L"Scale.png", mScaleIcon, nullptr, commandList);
    return geometryIconLoaded;
}

void Editor::Shutdown()
{
    ReleaseIconTexture(mGeometryIcon);
    ReleaseIconTexture(mSelectIcon);
    ReleaseIconTexture(mMoveIcon);
    ReleaseIconTexture(mRotateIcon);
    ReleaseIconTexture(mScaleIcon);
    mGeometryIconLoadAttempted = false;
    mGeometryIconStatus.clear();
}

void Editor::Draw(
    D3D12_GPU_DESCRIPTOR_HANDLE sceneTextureHandle,
    const EditorCamera& camera,
    const char* sceneStatusMessage,
    const char* statisticsText,
    bool showStatistics)
{
    mSceneStatusMessage = sceneStatusMessage;
    mViewportStatisticsText = statisticsText;
    mShowViewportStatistics = showStatistics;

    const ImGuiViewport* mainViewport = ImGui::GetMainViewport();
    ImGui::SetNextWindowPos(
        ImVec2(mainViewport->WorkPos.x, mainViewport->WorkPos.y),
        ImGuiCond_Always);
    ImGui::SetNextWindowSize(
        ImVec2(mainViewport->WorkSize.x, mainViewport->WorkSize.y),
        ImGuiCond_Always);
    DrawViewport(sceneTextureHandle, camera, GetSelectedEntity());

    DrawComponentsPanel();
    DrawLevelExplorerPanel();

    ImGui::SetNextWindowPos(ImVec2(270.0f, 30.0f), ImGuiCond_FirstUseEver);
    ImGui::SetNextWindowSize(ImVec2(120.0f, 36.0f), ImGuiCond_FirstUseEver);
    if (ImGui::Begin("Toolbar", nullptr, ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse))
    {
        // Fall back to the geometry icon only if one of the dedicated toolbar icons is unavailable.
        DrawToolbar(
            mSelectIcon.GpuHandle.ptr != 0 ? mSelectIcon.GpuHandle : mGeometryIcon.GpuHandle,
            mMoveIcon.GpuHandle.ptr != 0 ? mMoveIcon.GpuHandle : mGeometryIcon.GpuHandle,
            mRotateIcon.GpuHandle.ptr != 0 ? mRotateIcon.GpuHandle : mGeometryIcon.GpuHandle,
            mScaleIcon.GpuHandle.ptr != 0 ? mScaleIcon.GpuHandle : mGeometryIcon.GpuHandle);
    }
    ImGui::End();

    ImGui::SetNextWindowPos(ImVec2(1200.0f, 30.0f), ImGuiCond_FirstUseEver);
    ImGui::SetNextWindowSize(ImVec2(320.0f, 480.0f), ImGuiCond_FirstUseEver);
    DrawPropertiesPanel(GetSelectedEntity());
}

void Editor::DrawToolbar(
    D3D12_GPU_DESCRIPTOR_HANDLE selectIcon,
    D3D12_GPU_DESCRIPTOR_HANDLE moveIcon,
    D3D12_GPU_DESCRIPTOR_HANDLE rotateIcon,
    D3D12_GPU_DESCRIPTOR_HANDLE scaleIcon)
{
    const ImVec2 buttonSize(20.0f, 20.0f);
    const ImVec4 highlightedButtonColor(0.25f, 0.45f, 0.75f, 1.0f);
    const ImVec4 highlightedHoveredColor(0.30f, 0.50f, 0.82f, 1.0f);
    const ImVec4 highlightedActiveColor(0.22f, 0.40f, 0.68f, 1.0f);

    const auto drawToolButton = [this, buttonSize, highlightedButtonColor, highlightedHoveredColor, highlightedActiveColor](
        const char* buttonId,
        const char* fallbackLabel,
        const char* tooltip,
        D3D12_GPU_DESCRIPTOR_HANDLE iconHandle,
        const GizmoType gizmoType)
    {
        const bool isActive = mActiveGizmo == gizmoType;
        if (isActive)
        {
            ImGui::PushStyleColor(ImGuiCol_Button, highlightedButtonColor);
            ImGui::PushStyleColor(ImGuiCol_ButtonHovered, highlightedHoveredColor);
            ImGui::PushStyleColor(ImGuiCol_ButtonActive, highlightedActiveColor);
        }

        if (ImGui::ImageButton(buttonId, TextureIdFromHandle(iconHandle), buttonSize))
        {
            // Match the palette behavior by letting the active tool toggle itself off when clicked again.
            mActiveGizmo = isActive ? GizmoType::None : gizmoType;
        }

        if (iconHandle.ptr == 0)
        {
            const ImVec2 rectMin = ImGui::GetItemRectMin();
            const ImVec2 rectMax = ImGui::GetItemRectMax();
            const ImVec2 labelSize = ImGui::CalcTextSize(fallbackLabel);
            ImGui::GetWindowDrawList()->AddText(
                ImVec2(
                    rectMin.x + ((rectMax.x - rectMin.x) - labelSize.x) * 0.5f,
                    rectMin.y + ((rectMax.y - rectMin.y) - labelSize.y) * 0.5f),
                IM_COL32(240, 240, 240, 255),
                fallbackLabel);
        }

        if (ImGui::IsItemHovered())
        {
            ImGui::SetTooltip("%s", tooltip);
        }

        if (isActive)
        {
            ImGui::PopStyleColor(3);
        }
    };

    drawToolButton("##ToolbarSelect", "S", "Select", selectIcon, GizmoType::None);
    ImGui::SameLine();
    drawToolButton("##ToolbarMove", "T", "Translate", moveIcon, GizmoType::Translate);
    ImGui::SameLine();
    drawToolButton("##ToolbarRotate", "R", "Rotate", rotateIcon, GizmoType::Rotate);
    ImGui::SameLine();
    drawToolButton("##ToolbarScale", "Sc", "Scale", scaleIcon, GizmoType::Scale);
}

void Editor::DrawPropertiesPanel(Entity* selectedEntity)
{
    if (!ImGui::Begin("Properties"))
    {
        ImGui::End();
        return;
    }

    if (selectedEntity == nullptr)
    {
        ImGui::End();
        return;
    }

    ImGui::Text("Entity: %s", selectedEntity->Name.c_str());
    ImGui::Separator();

    if (ImGui::CollapsingHeader("TransformComponent", ImGuiTreeNodeFlags_DefaultOpen))
    {
        // DragFloat3 keeps the component editing path lightweight while still exposing precise transform tweaks.
        ImGui::DragFloat3("Position", &selectedEntity->Transform.Position.x, 0.1f);
        ImGui::DragFloat3("Rotation", &selectedEntity->Transform.Rotation.x, 0.05f);
        ImGui::DragFloat3("Scale", &selectedEntity->Transform.Scale.x, 0.05f);
    }

    if (selectedEntity->HasMeshComponent()
        && ImGui::CollapsingHeader("MeshComponent", ImGuiTreeNodeFlags_DefaultOpen))
    {
        ImGui::TextUnformatted(selectedEntity->Mesh->MeshAsset ? "Mesh loaded." : "Mesh not loaded.");
    }

    ImGui::Separator();
    if (ImGui::Button("Add Component"))
    {
        ImGui::OpenPopup("AddComponentPopup");
    }

    if (ImGui::BeginPopup("AddComponentPopup"))
    {
        if (!selectedEntity->HasMeshComponent())
        {
            if (ImGui::MenuItem("MeshComponent"))
            {
                selectedEntity->AddMeshComponent();
            }
        }
        else
        {
            ImGui::TextDisabled("MeshComponent already added.");
        }

        ImGui::EndPopup();
    }

    ImGui::End();
}

void Editor::DrawViewport(
    D3D12_GPU_DESCRIPTOR_HANDLE sceneTextureHandle,
    const EditorCamera& camera,
    Entity* selectedEntity)
{
    // Keep the main viewport static so the scene remains anchored while the tool panels can move around it.
    if (!ImGui::Begin(
        "Viewport",
        nullptr,
        ImGuiWindowFlags_NoCollapse
        | ImGuiWindowFlags_NoMove
        | ImGuiWindowFlags_NoResize
        | ImGuiWindowFlags_NoBringToFrontOnFocus))
    {
        ImGui::End();
        return;
    }

    const ImVec2 viewportOrigin = ImGui::GetCursorScreenPos();
    const ImVec2 viewportSize = ImGui::GetContentRegionAvail();
    bool viewportHovered = false;
    if (sceneTextureHandle.ptr != 0 && viewportSize.x > 1.0f && viewportSize.y > 1.0f)
    {
        ImGui::Image(TextureIdFromHandle(sceneTextureHandle), viewportSize);
        viewportHovered = ImGui::IsItemHovered();
        DrawViewportStatisticsOverlay();

        DrawViewportPlacementIcons(viewportOrigin, viewportSize, camera);
        DrawManualGizmoPivot(viewportOrigin, viewportSize, camera, selectedEntity);

        HandleViewportInteraction(viewportOrigin, viewportSize, camera, viewportHovered);
        HandleManualGizmoInteraction(viewportOrigin, viewportSize, camera, viewportHovered, selectedEntity);
    }
    else
    {
        ImGui::TextUnformatted("Scene render target is not ready yet.");
        if (mSceneStatusMessage != nullptr && mSceneStatusMessage[0] != '\0')
        {
            ImGui::Separator();
            ImGui::TextWrapped("%s", mSceneStatusMessage);
        }
    }

    if (PT_EDITOR_HAS_IMGUIZMO && selectedEntity != nullptr && mActiveGizmo != GizmoType::None && viewportSize.x > 1.0f && viewportSize.y > 1.0f)
    {
        ImGuizmo::BeginFrame();
        ImGuizmo::SetOrthographic(false);
        ImGuizmo::SetDrawlist();
        ImGuizmo::SetRect(viewportOrigin.x, viewportOrigin.y, viewportSize.x, viewportSize.y);

        XMFLOAT4X4 viewMatrix{};
        XMFLOAT4X4 projectionMatrix{};
        XMFLOAT4X4 worldMatrix{};

        // ImGuizmo expects float arrays, so the DirectXMath matrices are copied into float4x4 storage before editing.
        XMStoreFloat4x4(&viewMatrix, XMMatrixTranspose(camera.GetViewMatrixZUp()));
        XMStoreFloat4x4(&projectionMatrix, XMMatrixTranspose(camera.GetProjectionMatrix()));
        XMStoreFloat4x4(&worldMatrix, XMMatrixTranspose(selectedEntity->Transform.GetTransform()));

        ImGuizmo::OPERATION operation = ImGuizmo::TRANSLATE;
        switch (mActiveGizmo)
        {
        case GizmoType::Translate:
            operation = ImGuizmo::TRANSLATE;
            break;
        case GizmoType::Rotate:
            operation = ImGuizmo::ROTATE;
            break;
        case GizmoType::Scale:
            operation = ImGuizmo::SCALE;
            break;
        case GizmoType::None:
        default:
            break;
        }

        ImGuizmo::Manipulate(
            &viewMatrix.m[0][0],
            &projectionMatrix.m[0][0],
            operation,
            ImGuizmo::WORLD,
            &worldMatrix.m[0][0]);

        if (ImGuizmo::IsUsing())
        {
            const XMMATRIX manipulatedWorld = XMMatrixTranspose(XMLoadFloat4x4(&worldMatrix));
            XMVECTOR scale{};
            XMVECTOR rotationQuaternion{};
            XMVECTOR translation{};
            if (XMMatrixDecompose(&scale, &rotationQuaternion, &translation, manipulatedWorld))
            {
                XMStoreFloat3(&selectedEntity->Transform.Position, translation);
                XMStoreFloat3(&selectedEntity->Transform.Scale, scale);
                selectedEntity->Transform.Rotation = QuaternionToEulerRadians(rotationQuaternion);
            }
        }
    }

    ImGui::End();
}

void Editor::DrawManualGizmoPivot(const ImVec2& viewportOrigin, const ImVec2& viewportSize, const EditorCamera& camera, const Entity* selectedEntity) const
{
#if PT_EDITOR_HAS_IMGUIZMO
    UNREFERENCED_PARAMETER(viewportOrigin);
    UNREFERENCED_PARAMETER(viewportSize);
    UNREFERENCED_PARAMETER(camera);
    UNREFERENCED_PARAMETER(selectedEntity);
#else
    if (selectedEntity == nullptr || mActiveGizmo == GizmoType::None)
    {
        return;
    }

    ImVec2 pivotScreenPosition{};
    if (!TryProjectWorldToViewport(selectedEntity->Transform.Position, viewportOrigin, viewportSize, camera, pivotScreenPosition))
    {
        return;
    }

    ImDrawList* drawList = ImGui::GetWindowDrawList();
    const float axisExtent = 34.0f;
    const ImU32 xAxisColor = IM_COL32(220, 80, 80, 255);
    const ImU32 yAxisColor = IM_COL32(80, 220, 120, 255);
    const ImU32 pivotColor = IM_COL32(250, 220, 110, 255);

    // Draw a visible pivot/axis handle at the selected component so move, rotate, and scale still expose a grab point.
    drawList->AddLine(
        ImVec2(pivotScreenPosition.x - axisExtent, pivotScreenPosition.y),
        ImVec2(pivotScreenPosition.x + axisExtent, pivotScreenPosition.y),
        xAxisColor,
        3.0f);
    drawList->AddLine(
        ImVec2(pivotScreenPosition.x, pivotScreenPosition.y - axisExtent),
        ImVec2(pivotScreenPosition.x, pivotScreenPosition.y + axisExtent),
        yAxisColor,
        3.0f);
    drawList->AddCircleFilled(pivotScreenPosition, 10.0f, pivotColor);

    if (mActiveGizmo == GizmoType::Rotate)
    {
        drawList->AddCircle(pivotScreenPosition, 30.0f, pivotColor, 32, 2.0f);
    }
    else if (mActiveGizmo == GizmoType::Scale)
    {
        drawList->AddRect(
            ImVec2(pivotScreenPosition.x - 14.0f, pivotScreenPosition.y - 14.0f),
            ImVec2(pivotScreenPosition.x + 14.0f, pivotScreenPosition.y + 14.0f),
            pivotColor,
            0.0f,
            0,
            2.0f);
    }
#endif
}

void Editor::DrawViewportPlacementIcons(const ImVec2& viewportOrigin, const ImVec2& viewportSize, const EditorCamera& camera) const
{
    ImDrawList* drawList = ImGui::GetWindowDrawList();
    if (mShowViewportPlacementIcons && mGeometryIcon.GpuHandle.ptr != 0)
    {
        const float iconHalfExtent = 10.0f;
        for (size_t entityIndex = 0; entityIndex < mEntities.size(); ++entityIndex)
        {
            ImVec2 screenPosition{};
            if (!TryProjectWorldToViewport(mEntities[entityIndex].Transform.Position, viewportOrigin, viewportSize, camera, screenPosition))
            {
                continue;
            }

            const ImVec2 iconMin(screenPosition.x - iconHalfExtent, screenPosition.y - iconHalfExtent);
            const ImVec2 iconMax(screenPosition.x + iconHalfExtent, screenPosition.y + iconHalfExtent);
            drawList->AddImage(TextureIdFromHandle(mGeometryIcon.GpuHandle), iconMin, iconMax);

            if (!mGeometryPrototypeSelected && mSelectedEntityIndex == static_cast<int>(entityIndex))
            {
                // Outline the selected placement marker so the current transform target is obvious in the viewport.
                drawList->AddRect(iconMin, iconMax, IM_COL32(77, 144, 255, 255), 3.0f, 0, 2.0f);
            }
        }
    }

    if (mViewportSelection.IsDragging)
    {
        const SelectionRect selectionRect = MakeSelectionRect(mViewportSelection.Start, mViewportSelection.Current);
        drawList->AddRectFilled(selectionRect.Min, selectionRect.Max, IM_COL32(77, 144, 255, 40));
        drawList->AddRect(selectionRect.Min, selectionRect.Max, IM_COL32(77, 144, 255, 220), 0.0f, 0, 1.5f);
    }
}

bool Editor::TryProjectWorldToViewport(
    const XMFLOAT3& worldPosition,
    const ImVec2& viewportOrigin,
    const ImVec2& viewportSize,
    const EditorCamera& camera,
    ImVec2& outScreenPosition) const
{
    const XMVECTOR world = XMVectorSet(worldPosition.x, worldPosition.y, worldPosition.z, 1.0f);
    const XMMATRIX viewProjection = camera.GetViewMatrixZUp() * camera.GetProjectionMatrix();
    const XMVECTOR projected = XMVector4Transform(world, viewProjection);
    const float clipW = XMVectorGetW(projected);
    if (clipW <= 0.0f)
    {
        return false;
    }

    const XMVECTOR ndc = XMVectorScale(projected, 1.0f / clipW);
    const float ndcX = XMVectorGetX(ndc);
    const float ndcY = XMVectorGetY(ndc);
    const float ndcZ = XMVectorGetZ(ndc);
    if (ndcZ < 0.0f || ndcZ > 1.0f)
    {
        return false;
    }

    outScreenPosition.x = viewportOrigin.x + ((ndcX * 0.5f) + 0.5f) * viewportSize.x;
    outScreenPosition.y = viewportOrigin.y + ((-ndcY * 0.5f) + 0.5f) * viewportSize.y;
    return true;
}

bool Editor::TryGetViewportWorldPositionOnGrid(
    const ImVec2& mousePosition,
    const ImVec2& viewportOrigin,
    const ImVec2& viewportSize,
    const EditorCamera& camera,
    XMFLOAT3& outWorldPosition) const
{
    if (viewportSize.x <= 1.0f || viewportSize.y <= 1.0f)
    {
        return false;
    }

    const float normalizedX = ((mousePosition.x - viewportOrigin.x) / viewportSize.x) * 2.0f - 1.0f;
    const float normalizedY = 1.0f - (((mousePosition.y - viewportOrigin.y) / viewportSize.y) * 2.0f);
    const XMVECTOR nearPoint = XMVectorSet(normalizedX, normalizedY, 0.0f, 1.0f);
    const XMVECTOR farPoint = XMVectorSet(normalizedX, normalizedY, 1.0f, 1.0f);

    const XMMATRIX inverseViewProjection = XMMatrixInverse(nullptr, camera.GetViewMatrixZUp() * camera.GetProjectionMatrix());
    const XMVECTOR worldNear = XMVector3TransformCoord(nearPoint, inverseViewProjection);
    const XMVECTOR worldFar = XMVector3TransformCoord(farPoint, inverseViewProjection);
    const XMVECTOR rayDirection = XMVector3Normalize(XMVectorSubtract(worldFar, worldNear));

    const float directionZ = XMVectorGetZ(rayDirection);
    if (std::abs(directionZ) < 0.0001f)
    {
        return false;
    }

    const float hitDistance = -XMVectorGetZ(worldNear) / directionZ;
    if (hitDistance < 0.0f)
    {
        return false;
    }

    const XMVECTOR worldHit = XMVectorAdd(worldNear, XMVectorScale(rayDirection, hitDistance));
    XMStoreFloat3(&outWorldPosition, worldHit);
    outWorldPosition.z = 0.0f;
    return true;
}

void Editor::HandleViewportInteraction(
    const ImVec2& viewportOrigin,
    const ImVec2& viewportSize,
    const EditorCamera& camera,
    bool viewportHovered)
{
    ImGuiIO& io = ImGui::GetIO();
    if (mGeometryPrototypeSelected)
    {
        if (viewportHovered && ImGui::IsMouseClicked(ImGuiMouseButton_Left) && !ImGuizmo::IsUsing())
        {
            XMFLOAT3 worldPosition{};
            if (TryGetViewportWorldPositionOnGrid(io.MousePos, viewportOrigin, viewportSize, camera, worldPosition))
            {
                // Geometry palette placement always snaps the new component onto the ground plane by forcing Z to the grid height.
                CreateGeometryInstanceAt(worldPosition);
            }
        }

        return;
    }

    if (mActiveGizmo != GizmoType::None)
    {
        return;
    }

    if (viewportHovered && ImGui::IsMouseClicked(ImGuiMouseButton_Left) && !ImGuizmo::IsUsing())
    {
        mViewportSelection.IsDragging = true;
        mViewportSelection.Start = io.MousePos;
        mViewportSelection.Current = io.MousePos;
    }

    if (mViewportSelection.IsDragging)
    {
        mViewportSelection.Current = io.MousePos;
        if (!ImGui::IsMouseDown(ImGuiMouseButton_Left))
        {
            FinishViewportSelection(viewportOrigin, viewportSize, camera);
        }
    }
}

void Editor::HandleManualGizmoInteraction(
    const ImVec2& viewportOrigin,
    const ImVec2& viewportSize,
    const EditorCamera& camera,
    bool viewportHovered,
    Entity* selectedEntity)
{
#if PT_EDITOR_HAS_IMGUIZMO
    UNREFERENCED_PARAMETER(viewportOrigin);
    UNREFERENCED_PARAMETER(viewportSize);
    UNREFERENCED_PARAMETER(camera);
    UNREFERENCED_PARAMETER(viewportHovered);
    UNREFERENCED_PARAMETER(selectedEntity);
#else
    if (selectedEntity == nullptr || mActiveGizmo == GizmoType::None)
    {
        if (!ImGui::IsMouseDown(ImGuiMouseButton_Left))
        {
            mManualGizmo = {};
        }

        return;
    }

    ImGuiIO& io = ImGui::GetIO();
    ImVec2 selectedEntityScreenPosition{};
    const bool hasProjectedSelection = TryProjectWorldToViewport(
        selectedEntity->Transform.Position,
        viewportOrigin,
        viewportSize,
        camera,
        selectedEntityScreenPosition);

    if (!mManualGizmo.IsActive)
    {
        if (viewportHovered && ImGui::IsMouseClicked(ImGuiMouseButton_Left) && hasProjectedSelection)
        {
            const float deltaX = io.MousePos.x - selectedEntityScreenPosition.x;
            const float deltaY = io.MousePos.y - selectedEntityScreenPosition.y;
            if ((deltaX * deltaX) + (deltaY * deltaY) <= (18.0f * 18.0f))
            {
                // The fallback manipulator uses the visible pivot handle as its grab point so transforms remain usable without ImGuizmo.
                mManualGizmo.IsActive = true;
                mManualGizmo.StartMouse = io.MousePos;
                mManualGizmo.StartPosition = selectedEntity->Transform.Position;
                mManualGizmo.StartRotation = selectedEntity->Transform.Rotation;
                mManualGizmo.StartScale = selectedEntity->Transform.Scale;
            }
        }

        return;
    }

    if (!ImGui::IsMouseDown(ImGuiMouseButton_Left))
    {
        mManualGizmo = {};
        return;
    }

    switch (mActiveGizmo)
    {
    case GizmoType::Translate:
    {
        XMFLOAT3 worldPositionOnGrid{};
        if (TryGetViewportWorldPositionOnGrid(io.MousePos, viewportOrigin, viewportSize, camera, worldPositionOnGrid))
        {
            selectedEntity->Transform.Position.x = worldPositionOnGrid.x;
            selectedEntity->Transform.Position.y = worldPositionOnGrid.y;
            selectedEntity->Transform.Position.z = mManualGizmo.StartPosition.z;
        }
        break;
    }
    case GizmoType::Rotate:
    {
        const float mouseDeltaX = io.MousePos.x - mManualGizmo.StartMouse.x;
        selectedEntity->Transform.Rotation.z = mManualGizmo.StartRotation.z + (mouseDeltaX * 0.01f);
        break;
    }
    case GizmoType::Scale:
    {
        const float mouseDeltaX = io.MousePos.x - mManualGizmo.StartMouse.x;
        const float uniformScale = (std::max)(0.1f, mManualGizmo.StartScale.x + (mouseDeltaX * 0.01f));
        selectedEntity->Transform.Scale = XMFLOAT3(uniformScale, uniformScale, uniformScale);
        break;
    }
    case GizmoType::None:
    default:
        break;
    }
#endif
}

void Editor::FinishViewportSelection(const ImVec2& viewportOrigin, const ImVec2& viewportSize, const EditorCamera& camera)
{
    const SelectionRect selectionRect = MakeSelectionRect(mViewportSelection.Start, mViewportSelection.Current);
    const float dragDistanceX = mViewportSelection.Current.x - mViewportSelection.Start.x;
    const float dragDistanceY = mViewportSelection.Current.y - mViewportSelection.Start.y;
    const bool isClickSelection = (dragDistanceX * dragDistanceX) + (dragDistanceY * dragDistanceY) < 16.0f;

    int matchedEntityIndex = -1;
    float bestDistanceMetric = FLT_MAX;
    for (size_t entityIndex = 0; entityIndex < mEntities.size(); ++entityIndex)
    {
        ImVec2 screenPosition{};
        if (!TryProjectWorldToViewport(mEntities[entityIndex].Transform.Position, viewportOrigin, viewportSize, camera, screenPosition))
        {
            continue;
        }

        if (isClickSelection)
        {
            const float deltaX = screenPosition.x - mViewportSelection.Current.x;
            const float deltaY = screenPosition.y - mViewportSelection.Current.y;
            const float distanceSquared = (deltaX * deltaX) + (deltaY * deltaY);
            if (distanceSquared <= 400.0f && distanceSquared < bestDistanceMetric)
            {
                bestDistanceMetric = distanceSquared;
                matchedEntityIndex = static_cast<int>(entityIndex);
            }
        }
        else if (selectionRect.Contains(screenPosition))
        {
            const float deltaX = screenPosition.x - ((selectionRect.Min.x + selectionRect.Max.x) * 0.5f);
            const float deltaY = screenPosition.y - ((selectionRect.Min.y + selectionRect.Max.y) * 0.5f);
            const float distanceSquared = (deltaX * deltaX) + (deltaY * deltaY);
            if (distanceSquared < bestDistanceMetric)
            {
                // Keep single-selection semantics by choosing the icon closest to the marquee center.
                bestDistanceMetric = distanceSquared;
                matchedEntityIndex = static_cast<int>(entityIndex);
            }
        }
    }

    if (matchedEntityIndex >= 0)
    {
        // Clicking the currently selected entity again clears it, matching the toggle behavior used elsewhere in the editor.
        if (isClickSelection && matchedEntityIndex == mSelectedEntityIndex)
        {
            matchedEntityIndex = -1;
        }
    }

    mGeometryPrototypeSelected = false;
    mSelectedEntityIndex = matchedEntityIndex;

    mViewportSelection = {};
}

void Editor::CreateGeometryInstanceAt(const XMFLOAT3& worldPosition)
{
    Entity geometryEntity;
    geometryEntity.Name = std::string("Geometry ") + std::to_string(mNextGeometryInstanceId++);
    geometryEntity.Transform.Position = worldPosition;
    geometryEntity.Transform.Scale = XMFLOAT3(1.0f, 1.0f, 1.0f);

    mEntities.push_back(std::move(geometryEntity));
}

Entity* Editor::GetSelectedEntity()
{
    if (mGeometryPrototypeSelected)
    {
        return nullptr;
    }

    if (mSelectedEntityIndex < 0 || mSelectedEntityIndex >= static_cast<int>(mEntities.size()))
    {
        return nullptr;
    }

    return &mEntities[static_cast<size_t>(mSelectedEntityIndex)];
}

void Editor::DrawComponentsPanel()
{
    ImGui::SetNextWindowPos(ImVec2(10.0f, 30.0f), ImGuiCond_FirstUseEver);
    ImGui::SetNextWindowSize(ImVec2(250.0f, 170.0f), ImGuiCond_FirstUseEver);

    if (!ImGui::Begin("Components"))
    {
        ImGui::End();
        return;
    }

    if (!mGeometryIconStatus.empty())
    {
        ImGui::TextWrapped("%s", mGeometryIconStatus.c_str());
        ImGui::Separator();
    }

    if (mGeometryIcon.GpuHandle.ptr != 0)
    {
        ImGui::Image(TextureIdFromHandle(mGeometryIcon.GpuHandle), ImVec2(18.0f, 18.0f));
        ImGui::SameLine();
    }

    const bool geometryPaletteSelected = mGeometryPrototypeSelected;
    if (ImGui::Selectable("Geometry", geometryPaletteSelected))
    {
        // The geometry palette entry behaves like a tool: clicking it again deselects placement mode.
        if (geometryPaletteSelected)
        {
            mGeometryPrototypeSelected = false;
        }
        else
        {
            mGeometryPrototypeSelected = true;
        }

        mSelectedEntityIndex = -1;
    }

    ImGui::Separator();
    ImGui::TextWrapped("Select Geometry to arm viewport placement. Placed items appear in Level Explorer.");

    ImGui::End();
}

void Editor::DrawLevelExplorerPanel()
{
    ImGui::SetNextWindowPos(ImVec2(10.0f, 210.0f), ImGuiCond_FirstUseEver);
    ImGui::SetNextWindowSize(ImVec2(250.0f, 400.0f), ImGuiCond_FirstUseEver);

    if (!ImGui::Begin("Level Explorer"))
    {
        ImGui::End();
        return;
    }

    if (mEntities.empty())
    {
        ImGui::TextDisabled("No placed components yet.");
        ImGui::End();
        return;
    }

    for (size_t entityIndex = 0; entityIndex < mEntities.size(); ++entityIndex)
    {
        Entity& entity = mEntities[entityIndex];
        ImGui::PushID(static_cast<int>(entityIndex));

        if (mGeometryIcon.GpuHandle.ptr != 0)
        {
            ImGui::Image(TextureIdFromHandle(mGeometryIcon.GpuHandle), ImVec2(18.0f, 18.0f));
            ImGui::SameLine();
        }

        const bool isSelected = !mGeometryPrototypeSelected && mSelectedEntityIndex == static_cast<int>(entityIndex);
        if (ImGui::Selectable(entity.Name.c_str(), isSelected))
        {
            // Mirroring the toolbar toggle behavior lets the user clear the current entity selection by clicking it again.
            if (isSelected)
            {
                mSelectedEntityIndex = -1;
            }
            else
            {
                mSelectedEntityIndex = static_cast<int>(entityIndex);
            }

            mGeometryPrototypeSelected = false;
        }

        ImGui::PopID();
    }

    ImGui::End();
}

bool Editor::LoadGeometryIcon(ID3D12GraphicsCommandList* commandList)
{
    return LoadIconTexture(L"Geometry.png", mGeometryIcon, &mGeometryIconStatus, commandList);
}

bool Editor::LoadIconTexture(
    const wchar_t* fileName,
    IconTexture& iconTexture,
    std::string* statusMessage,
    ID3D12GraphicsCommandList* commandList)
{
    const std::string iconFileName = std::filesystem::path(fileName).filename().string();

    ID3D12Device* device = DX12Context_GetDevice();
    if (!(device && commandList))
    {
        if (statusMessage != nullptr)
        {
            *statusMessage = iconFileName + " will load after the DX12 device and command list are ready.";
        }
        return false;
    }

    const std::filesystem::path iconPath = FindNamedFile(fileName);
    if (iconPath.empty())
    {
        if (statusMessage != nullptr)
        {
            *statusMessage = "Could not find " + iconFileName + " in the workspace.";
        }
        return false;
    }

    DecodedImageData imageData;
    std::string imageLoadStatus;
    if (!LoadDecodedImage(iconPath, imageData, imageLoadStatus))
    {
        if (statusMessage != nullptr)
        {
            *statusMessage = imageLoadStatus;
        }
        return false;
    }

    if (!DX12Context_AllocateSrvDescriptor(&iconTexture.CpuHandle, &iconTexture.GpuHandle))
    {
        if (statusMessage != nullptr)
        {
            *statusMessage = "Failed to allocate a shader-visible descriptor for the requested icon texture.";
        }
        return false;
    }

    D3D12_RESOURCE_DESC textureDesc{};
    textureDesc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
    textureDesc.Alignment = 0;
    textureDesc.Width = imageData.Width;
    textureDesc.Height = imageData.Height;
    textureDesc.DepthOrArraySize = 1;
    textureDesc.MipLevels = 1;
    textureDesc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
    textureDesc.SampleDesc.Count = 1;
    textureDesc.SampleDesc.Quality = 0;
    textureDesc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
    textureDesc.Flags = D3D12_RESOURCE_FLAG_NONE;

    D3D12_HEAP_PROPERTIES defaultHeapProperties{};
    defaultHeapProperties.Type = D3D12_HEAP_TYPE_DEFAULT;
    defaultHeapProperties.CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_UNKNOWN;
    defaultHeapProperties.MemoryPoolPreference = D3D12_MEMORY_POOL_UNKNOWN;
    defaultHeapProperties.CreationNodeMask = 1;
    defaultHeapProperties.VisibleNodeMask = 1;
    DX12_THROW_IF_FAILED(device->CreateCommittedResource(
        &defaultHeapProperties,
        D3D12_HEAP_FLAG_NONE,
        &textureDesc,
        D3D12_RESOURCE_STATE_COPY_DEST,
        nullptr,
        IID_PPV_ARGS(&iconTexture.Texture)));

    D3D12_PLACED_SUBRESOURCE_FOOTPRINT placedSubresourceFootprint{};
    UINT numRows = 0;
    UINT64 rowSizeInBytes = 0;
    UINT64 uploadBufferSize = 0;
    device->GetCopyableFootprints(
        &textureDesc,
        0,
        1,
        0,
        &placedSubresourceFootprint,
        &numRows,
        &rowSizeInBytes,
        &uploadBufferSize);

    D3D12_HEAP_PROPERTIES uploadHeapProperties{};
    uploadHeapProperties.Type = D3D12_HEAP_TYPE_UPLOAD;
    uploadHeapProperties.CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_UNKNOWN;
    uploadHeapProperties.MemoryPoolPreference = D3D12_MEMORY_POOL_UNKNOWN;
    uploadHeapProperties.CreationNodeMask = 1;
    uploadHeapProperties.VisibleNodeMask = 1;

    D3D12_RESOURCE_DESC uploadBufferDesc{};
    uploadBufferDesc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
    uploadBufferDesc.Alignment = 0;
    uploadBufferDesc.Width = uploadBufferSize;
    uploadBufferDesc.Height = 1;
    uploadBufferDesc.DepthOrArraySize = 1;
    uploadBufferDesc.MipLevels = 1;
    uploadBufferDesc.Format = DXGI_FORMAT_UNKNOWN;
    uploadBufferDesc.SampleDesc.Count = 1;
    uploadBufferDesc.SampleDesc.Quality = 0;
    uploadBufferDesc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
    uploadBufferDesc.Flags = D3D12_RESOURCE_FLAG_NONE;
    DX12_THROW_IF_FAILED(device->CreateCommittedResource(
        &uploadHeapProperties,
        D3D12_HEAP_FLAG_NONE,
        &uploadBufferDesc,
        D3D12_RESOURCE_STATE_GENERIC_READ,
        nullptr,
        IID_PPV_ARGS(&iconTexture.Upload)));

    void* mappedTextureData = nullptr;
    DX12_THROW_IF_FAILED(iconTexture.Upload->Map(0, nullptr, &mappedTextureData));

    const UINT sourceRowPitch = imageData.Width * 4u;
    for (UINT rowIndex = 0; rowIndex < numRows; ++rowIndex)
    {
        std::memcpy(
            static_cast<std::uint8_t*>(mappedTextureData)
                + placedSubresourceFootprint.Offset
                + (static_cast<size_t>(rowIndex) * static_cast<size_t>(placedSubresourceFootprint.Footprint.RowPitch)),
            imageData.Pixels.data() + (static_cast<size_t>(rowIndex) * static_cast<size_t>(sourceRowPitch)),
            sourceRowPitch);
    }

    iconTexture.Upload->Unmap(0, nullptr);

    D3D12_TEXTURE_COPY_LOCATION destinationLocation{};
    destinationLocation.pResource = iconTexture.Texture.Get();
    destinationLocation.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
    destinationLocation.SubresourceIndex = 0;

    D3D12_TEXTURE_COPY_LOCATION sourceLocation{};
    sourceLocation.pResource = iconTexture.Upload.Get();
    sourceLocation.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
    sourceLocation.PlacedFootprint = placedSubresourceFootprint;
    commandList->CopyTextureRegion(&destinationLocation, 0, 0, 0, &sourceLocation, nullptr);

    const auto toShaderResource = CD3DX12_RESOURCE_BARRIER::Transition(
        iconTexture.Texture.Get(),
        D3D12_RESOURCE_STATE_COPY_DEST,
        D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
    commandList->ResourceBarrier(1, &toShaderResource);

    D3D12_SHADER_RESOURCE_VIEW_DESC srvDesc{};
    srvDesc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
    srvDesc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
    srvDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
    srvDesc.Texture2D.MipLevels = 1;
    device->CreateShaderResourceView(iconTexture.Texture.Get(), &srvDesc, iconTexture.CpuHandle);

    if (statusMessage != nullptr)
    {
        *statusMessage = std::string("Loaded ") + iconPath.filename().string() + " from " + iconPath.string();
    }

    return true;
}

void Editor::ReleaseIconTexture(IconTexture& iconTexture)
{
    iconTexture.Texture.Reset();
    iconTexture.Upload.Reset();
    iconTexture.CpuHandle = {};
    iconTexture.GpuHandle = {};
}

void Editor::DrawViewportStatisticsOverlay() const
{
    if (!(mShowViewportStatistics && mViewportStatisticsText != nullptr && mViewportStatisticsText[0] != '\0'))
    {
        return;
    }

    const ImVec2 textSize = ImGui::CalcTextSize(mViewportStatisticsText);
    const ImVec2 textPadding(10.0f, 8.0f);
    const ImVec2 overlayMin(ImGui::GetItemRectMin().x + 12.0f, ImGui::GetItemRectMin().y + 12.0f);
    const ImVec2 overlayMax(
        overlayMin.x + textSize.x + (textPadding.x * 2.0f),
        overlayMin.y + textSize.y + (textPadding.y * 2.0f));

    ImDrawList* drawList = ImGui::GetWindowDrawList();
    drawList->AddRectFilled(overlayMin, overlayMax, IM_COL32(12, 18, 28, 210), 6.0f);
    drawList->AddText(
        ImVec2(overlayMin.x + textPadding.x, overlayMin.y + textPadding.y),
        IM_COL32(235, 240, 248, 255),
        mViewportStatisticsText);
}

ImTextureID Editor::TextureIdFromHandle(D3D12_GPU_DESCRIPTOR_HANDLE handle)
{
    return handle.ptr == 0 ? ImTextureID_Invalid : (ImTextureID)(handle.ptr);
}
