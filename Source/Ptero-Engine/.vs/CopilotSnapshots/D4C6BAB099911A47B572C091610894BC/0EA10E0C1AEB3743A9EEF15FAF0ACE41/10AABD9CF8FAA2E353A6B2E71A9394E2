    constexpr uint32_t kRtMaterialFlagAlphaCutout = 1u;
    constexpr uint32_t kRtMaterialFlagDoubleSided = 2u;
    constexpr uint32_t kInvalidRtTextureIndex = 0xffffffffu;

    std::array<float, 3> ToRgbArray(float r, float g, float b)
    {
        return { r, g, b };
    }

    // RGBA16F format used for all intermediate and output textures.
    constexpr DXGI_FORMAT kGIFormat = DXGI_FORMAT_R16G16B16A16_FLOAT;

    // Thread group size for all RTGI compute passes (matches [numthreads(8,8,1)] in HLSL).
    constexpr UINT kGroupSizeX = 8;
    constexpr UINT kGroupSizeY = 8;

    // Allocate a shader-visible SRV/UAV descriptor from the shared heap.
    // Returns false and records an error on failure.
    bool AllocDescriptor(D3D12_CPU_DESCRIPTOR_HANDLE& outCpu, D3D12_GPU_DESCRIPTOR_HANDLE& outGpu, std::string& errOut)
    {
        if (!DX12Context_AllocateSrvDescriptor(&outCpu, &outGpu))
        {
            errOut = "RtGlobalIllumination: ran out of SRV descriptor heap slots.";
            return false;
        }
        return true;
    }

    // Helper: create a DEFAULT-heap resource buffer for reservoir data.
    ComPtr<ID3D12Resource> MakeStructuredBuffer(ID3D12Device* device, UINT64 byteSize, LPCWSTR name)
    {
        D3D12_HEAP_PROPERTIES heap{};
        heap.Type = D3D12_HEAP_TYPE_DEFAULT;
        heap.CreationNodeMask = 1;
        heap.VisibleNodeMask = 1;

        D3D12_RESOURCE_DESC desc{};
        desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
        desc.Alignment = 0;
        desc.Width = byteSize;
        desc.Height = 1;
        desc.DepthOrArraySize = 1;
        desc.MipLevels = 1;
        desc.Format = DXGI_FORMAT_UNKNOWN;
        desc.SampleDesc.Count = 1;
        desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
        // Buffers need both SRV and UAV access.
        desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;

        ComPtr<ID3D12Resource> resource;
        DX12_THROW_IF_FAILED(device->CreateCommittedResource(
            &heap, D3D12_HEAP_FLAG_NONE, &desc,
            D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
            IID_PPV_ARGS(&resource)));
        resource->SetName(name);
        return resource;
    }

    // Helper: create a DEFAULT-heap RGBA16F Texture2D with UAV support.
    ComPtr<ID3D12Resource> MakeTexture2D(ID3D12Device* device, UINT width, UINT height, LPCWSTR name)
    {
        D3D12_HEAP_PROPERTIES heap{};
        heap.Type = D3D12_HEAP_TYPE_DEFAULT;
        heap.CreationNodeMask = 1;
        heap.VisibleNodeMask = 1;

        D3D12_RESOURCE_DESC desc{};
        desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
        desc.Width = width;
        desc.Height = height;
        desc.DepthOrArraySize = 1;
        desc.MipLevels = 1;
        desc.Format = kGIFormat;
        desc.SampleDesc.Count = 1;
        desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
        desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;

        ComPtr<ID3D12Resource> resource;
        DX12_THROW_IF_FAILED(device->CreateCommittedResource(
            &heap, D3D12_HEAP_FLAG_NONE, &desc,
            D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
            IID_PPV_ARGS(&resource)));
        resource->SetName(name);
        return resource;
    }

    // Helper: create an UPLOAD constant buffer, persistently mapped.
    ComPtr<ID3D12Resource> MakeConstantBuffer(ID3D12Device* device, UINT64 size, void** outMapped)
    {
        D3D12_HEAP_PROPERTIES heap{};
        heap.Type = D3D12_HEAP_TYPE_UPLOAD;
        heap.CreationNodeMask = 1;
        heap.VisibleNodeMask = 1;

        D3D12_RESOURCE_DESC desc{};
        desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
        desc.Width = size;
        desc.Height = 1;
        desc.DepthOrArraySize = 1;
        desc.MipLevels = 1;
        desc.Format = DXGI_FORMAT_UNKNOWN;
        desc.SampleDesc.Count = 1;
        desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;

        ComPtr<ID3D12Resource> resource;
        DX12_THROW_IF_FAILED(device->CreateCommittedResource(
            &heap, D3D12_HEAP_FLAG_NONE, &desc,
            D3D12_RESOURCE_STATE_GENERIC_READ, nullptr,
            IID_PPV_ARGS(&resource)));
        DX12_THROW_IF_FAILED(resource->Map(0, nullptr, outMapped));
        resource->SetName(L"RTGI_ConstantBuffer");
        return resource;
    }

    uint32_t RegisterRtMaterialTexture(
        TextureManager& textureManager,
        std::unordered_map<std::string, uint32_t>& textureIndices,
        uint32_t& textureCount,
        const std::string& texturePath)
    {
        if (texturePath.empty())
            return kInvalidRtTextureIndex;

        if (const auto existing = textureIndices.find(texturePath); existing != textureIndices.end())
            return existing->second;

        if (textureCount >= RtGlobalIllumination::kMaxRtMaterialTextures)
            return kInvalidRtTextureIndex;

        if (!textureManager.LoadDDS(texturePath))
            return kInvalidRtTextureIndex;

        const uint32_t index = textureCount++;
        textureIndices.emplace(texturePath, index);
        return index;
    }

    // Compile a compute shader and fill outPSO.  Returns false and writes errOut on failure.
    bool CompileAndCreatePSO(
        ID3D12Device* device,
        ID3D12RootSignature* rootSig,
        const wchar_t* shaderFile,
        const wchar_t* entryPoint,
        ComPtr<ID3D12PipelineState>& outPSO,
        std::string& errOut)
    {
        ShaderCompileRequest req{};
        req.FilePath      = shaderFile;
        req.EntryPoint     = entryPoint;
        req.TargetProfile  = L"cs_6_5";
        req.Stage          = ShaderStage::Compute;

        DX12Shader shader;
        if (!shader.Compile(req))
        {
            errOut = std::string("RtGlobalIllumination: failed to compile '")
                   + (shader.GetLastErrorMessage() ? shader.GetLastErrorMessage() : "unknown error") + "'";
            return false;
        }

        D3D12_COMPUTE_PIPELINE_STATE_DESC psoDesc{};
        psoDesc.pRootSignature = rootSig;
        psoDesc.CS = shader.GetBytecode();

        if (FAILED(device->CreateComputePipelineState(&psoDesc, IID_PPV_ARGS(&outPSO))))
        {
            errOut = "RtGlobalIllumination: CreateComputePipelineState failed.";
            return false;
        }
        return true;
    }

    // Bind a descriptor table (GPU handle at slot descriptorIdx inside the given heap).
    void SetTable(
        ID3D12GraphicsCommandList* cmdList,
        UINT rootParam,
        D3D12_GPU_DESCRIPTOR_HANDLE gpuHandle)
    {
        cmdList->SetComputeRootDescriptorTable(rootParam, gpuHandle);
    }

    std::filesystem::path FindProjectDataDirectory()
    {
        wchar_t executablePath[MAX_PATH] = {};
        const DWORD characterCount = GetModuleFileNameW(nullptr, executablePath, static_cast<DWORD>(std::size(executablePath)));
        if (characterCount == 0 || characterCount == std::size(executablePath))
            return {};

        std::filesystem::path currentPath = std::filesystem::path(executablePath).parent_path();
        while (!currentPath.empty())
        {
            const std::filesystem::path dataDirectory = currentPath / "Data";
            if (std::filesystem::exists(dataDirectory) && std::filesystem::is_directory(dataDirectory))
                return std::filesystem::weakly_canonical(dataDirectory);

            const std::filesystem::path parentPath = currentPath.parent_path();
            if (parentPath == currentPath)
                break;

            currentPath = parentPath;
        }

        return {};
    }

    std::array<float, 3> EstimateAverageTextureColor(const std::filesystem::path& texturePath)
    {
        if (texturePath.empty() || !std::filesystem::exists(texturePath))
            return ToRgbArray(1.0f, 1.0f, 1.0f);

        DirectX::ScratchImage image;
        DirectX::TexMetadata meta{};
        const std::wstring widePath = texturePath.wstring();
        std::wstring ext = texturePath.extension().wstring();
        std::transform(ext.begin(), ext.end(), ext.begin(), [](wchar_t c) { return static_cast<wchar_t>(std::towlower(c)); });

        HRESULT hr = S_OK;
        if (ext == L".dds")
            hr = DirectX::LoadFromDDSFile(widePath.c_str(), DirectX::DDS_FLAGS_NONE, &meta, image);
        else if (ext == L".tga")
            hr = DirectX::LoadFromTGAFile(widePath.c_str(), &meta, image);
        else if (ext == L".hdr")
            hr = DirectX::LoadFromHDRFile(widePath.c_str(), &meta, image);
        else
            hr = DirectX::LoadFromWICFile(widePath.c_str(), DirectX::WIC_FLAGS_NONE, &meta, image);

        if (FAILED(hr))
            return ToRgbArray(1.0f, 1.0f, 1.0f);

        if (DirectX::IsCompressed(meta.format))
        {
            DirectX::ScratchImage decompressed;
            hr = DirectX::Decompress(image.GetImages(), image.GetImageCount(), meta, DXGI_FORMAT_UNKNOWN, decompressed);
            if (FAILED(hr))
                return ToRgbArray(1.0f, 1.0f, 1.0f);
            image = std::move(decompressed);
            meta = image.GetMetadata();
        }

        if (meta.format != DXGI_FORMAT_R8G8B8A8_UNORM && meta.format != DXGI_FORMAT_B8G8R8A8_UNORM)
        {
            DirectX::ScratchImage converted;
            hr = DirectX::Convert(image.GetImages(), image.GetImageCount(), meta,
                DXGI_FORMAT_R8G8B8A8_UNORM, DirectX::TEX_FILTER_DEFAULT,
                DirectX::TEX_THRESHOLD_DEFAULT, converted);
            if (FAILED(hr))
                return ToRgbArray(1.0f, 1.0f, 1.0f);
            image = std::move(converted);
            meta = image.GetMetadata();
        }

        const DirectX::Image* topMip = image.GetImage(0, 0, 0);
        if (!topMip || topMip->width == 0 || topMip->height == 0)
            return ToRgbArray(1.0f, 1.0f, 1.0f);

        double sumR = 0.0;
        double sumG = 0.0;
        double sumB = 0.0;
        for (size_t y = 0; y < topMip->height; ++y)
        {
            const uint8_t* row = topMip->pixels + y * topMip->rowPitch;
            for (size_t x = 0; x < topMip->width; ++x)
            {
                const uint8_t* texel = row + x * 4;
                sumR += texel[0];
                sumG += texel[1];
                sumB += texel[2];
            }
        }

        const double invCount = 1.0 / static_cast<double>(topMip->width * topMip->height * 255.0);
        return ToRgbArray(
            static_cast<float>(sumR * invCount),
            static_cast<float>(sumG * invCount),
            static_cast<float>(sumB * invCount));
    }

