bool RtGlobalIllumination::CreateGpuBuffer(ID3D12Device* dev, UINT64 size,
    D3D12_RESOURCE_FLAGS flags, D3D12_RESOURCE_STATES state,
    ComPtr<ID3D12Resource>& out)
{
    D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
    hp.CreationNodeMask = 1; hp.VisibleNodeMask = 1;
    D3D12_RESOURCE_DESC d{};
    d.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
    d.Width = size; d.Height = 1; d.DepthOrArraySize = 1; d.MipLevels = 1;
    d.Format = DXGI_FORMAT_UNKNOWN; d.SampleDesc.Count = 1;
    d.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; d.Flags = flags;
    return SUCCEEDED(dev->CreateCommittedResource(
        &hp, D3D12_HEAP_FLAG_NONE, &d, state, nullptr, IID_PPV_ARGS(&out)));
}

bool RtGlobalIllumination::CreateUploadBuf(ID3D12Device* dev, UINT64 size,
    ComPtr<ID3D12Resource>& out)
{
    D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
    hp.CreationNodeMask = 1; hp.VisibleNodeMask = 1;
    D3D12_RESOURCE_DESC d{};
    d.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
    d.Width = size; d.Height = 1; d.DepthOrArraySize = 1; d.MipLevels = 1;
    d.Format = DXGI_FORMAT_UNKNOWN; d.SampleDesc.Count = 1;
    d.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; d.Flags = D3D12_RESOURCE_FLAG_NONE;
    return SUCCEEDED(dev->CreateCommittedResource(
        &hp, D3D12_HEAP_FLAG_NONE, &d, D3D12_RESOURCE_STATE_GENERIC_READ,
        nullptr, IID_PPV_ARGS(&out)));
}

// -----------------------------------------------------------------------
// BuildTlas – build/update BLAS per unique mesh and assemble the TLAS.
// Must be called once per frame before Dispatch.
// -----------------------------------------------------------------------
void RtGlobalIllumination::BuildTlas(
    ID3D12GraphicsCommandList4* cmdList,
    const std::vector<Entity>&  entities)
{
    ID3D12Device* deviceRaw = DX12Context_GetDevice();
    if (!deviceRaw) return;

    // Need ID3D12Device5 for acceleration-structure APIs.
    ComPtr<ID3D12Device5> device;
    if (FAILED(deviceRaw->QueryInterface(IID_PPV_ARGS(&device)))) return;

    // Two-frame upload ring: advance the slot, then release the OLDEST uploads.
    // Slot [ringIdx]     = uploads being queued THIS frame.
    // Slot [ringIdx ^ 1] = uploads queued TWO frames ago — safe to release now
    //                      because the GPU finishes frame N-1 before we submit frame N+1.
    mUploadRingIdx ^= 1u;
    mPendingUploads[mUploadRingIdx].clear();

    // Rebuild per-instance info each frame (instance order can change).
    mCpuInstanceInfo.clear();
    mCpuMaterialRanges.clear();

    const auto loadBaseColorTintForMaterialSlot = [&](const std::string& materialPath, uint32_t materialId) -> std::array<float, 3>
    {
        if (materialPath.empty())
            return { 1.0f, 1.0f, 1.0f };

        const auto cacheIt = mMaterialAlbedoCache.find(materialPath);
        if (cacheIt != mMaterialAlbedoCache.end())
        {
            if (materialId < cacheIt->second.size())
                return cacheIt->second[materialId];
            if (!cacheIt->second.empty())
                return cacheIt->second.front();
            return { 1.0f, 1.0f, 1.0f };
        }

        const std::filesystem::path inputPath(materialPath);
        std::filesystem::path resolvedPath = inputPath;
        if (!inputPath.is_absolute())
        {
            const std::filesystem::path dataDirectory = FindProjectDataDirectory();
            if (!dataDirectory.empty())
                resolvedPath = dataDirectory / inputPath;
        }

        std::ifstream inputStream(resolvedPath);
        if (!inputStream)
            return { 1.0f, 1.0f, 1.0f };

        try
        {
            nlohmann::json materialJson;
            inputStream >> materialJson;

            std::vector<std::array<float, 3>> cachedColors;

            const auto readTint = [](const nlohmann::json& source) -> std::array<float, 3>
            {
                const auto tintIt = source.find("baseColorTint");
                if (tintIt == source.end() || !tintIt->is_array() || tintIt->size() < 3)
                    return { 1.0f, 1.0f, 1.0f };

                return {
                    tintIt->at(0).get<float>(),
                    tintIt->at(1).get<float>(),
                    tintIt->at(2).get<float>()
                };
            };

            const auto readAlbedo = [&](const nlohmann::json& source) -> std::array<float, 3>
            {
                std::array<float, 3> color = readTint(source);

                const auto texturesIt = source.find("textures");
                if (texturesIt == source.end() || !texturesIt->is_object())
                    return color;

                const auto baseColorIt = texturesIt->find("baseColor");
                if (baseColorIt == texturesIt->end() || !baseColorIt->is_string())
                    return color;

                const std::string texRel = baseColorIt->get<std::string>();
                if (texRel.empty())
                    return color;

                std::filesystem::path texPath(texRel);
                if (!texPath.is_absolute())
                {
                    const std::filesystem::path dataDirectory = FindProjectDataDirectory();
                    if (!dataDirectory.empty())
                        texPath = dataDirectory / texPath;
                }

                const auto avg = EstimateAverageTextureColor(texPath);
                color[0] *= avg[0];
                color[1] *= avg[1];
                color[2] *= avg[2];
                return color;
            };

            const auto typeIt = materialJson.find("type");
            const bool isMultiMaterial = typeIt != materialJson.end()
                && typeIt->is_string()
                && typeIt->get<std::string>() == "MultiMaterial";

            if (isMultiMaterial)
            {
                const auto subMaterialsIt = materialJson.find("subMaterials");
                if (subMaterialsIt != materialJson.end() && subMaterialsIt->is_array())
                {
                    cachedColors.reserve(subMaterialsIt->size());
                    for (const auto& subMaterial : *subMaterialsIt)
                        cachedColors.push_back(readAlbedo(subMaterial));

                    mMaterialAlbedoCache.emplace(materialPath, cachedColors);

                    if (materialId < subMaterialsIt->size())
                        return cachedColors[materialId];

                    if (!cachedColors.empty())
                        return cachedColors[0];
                }
            }

            cachedColors.push_back(readAlbedo(materialJson));
            mMaterialAlbedoCache.emplace(materialPath, cachedColors);
            return cachedColors[0];
        }
        catch (...)
        {
            return { 1.0f, 1.0f, 1.0f };
        }
    };

    std::vector<D3D12_RAYTRACING_INSTANCE_DESC> instanceDescs;

    for (const Entity& entity : entities)
    {
        if (!entity.HasMeshComponent() || !entity.Mesh.has_value() || !entity.Mesh->MeshAsset)
            continue;

        const Mesh* mesh    = entity.Mesh->MeshAsset.get();
        const void* meshKey = mesh;

        // Build a BLAS for this mesh if not already cached.
        if (mBlasCache.find(meshKey) == mBlasCache.end())
        {
            const auto& verts   = mesh->GetVertices();
            const auto& indices = mesh->GetIndices();
            if (verts.empty() || indices.empty()) continue;

            const UINT64 vbSize = verts.size()   * sizeof(Vertex);
            const UINT64 ibSize = indices.size()  * sizeof(uint32_t);

            ComPtr<ID3D12Resource> vbUp, ibUp;
            if (!CreateUploadBuf(device.Get(), vbSize, vbUp)) continue;
            if (!CreateUploadBuf(device.Get(), ibSize, ibUp)) continue;

            void* m = nullptr;
            vbUp->Map(0, nullptr, &m); std::memcpy(m, verts.data(),   vbSize); vbUp->Unmap(0, nullptr);
            ibUp->Map(0, nullptr, &m); std::memcpy(m, indices.data(), ibSize); ibUp->Unmap(0, nullptr);

            D3D12_RAYTRACING_GEOMETRY_DESC geom{};
            geom.Type  = D3D12_RAYTRACING_GEOMETRY_TYPE_TRIANGLES;
            geom.Flags = D3D12_RAYTRACING_GEOMETRY_FLAG_OPAQUE;
            geom.Triangles.VertexBuffer.StartAddress  = vbUp->GetGPUVirtualAddress();
            geom.Triangles.VertexBuffer.StrideInBytes = sizeof(Vertex);
            geom.Triangles.VertexFormat               = DXGI_FORMAT_R32G32B32_FLOAT; // Position is first member
            geom.Triangles.VertexCount                = static_cast<UINT>(verts.size());
            geom.Triangles.IndexBuffer                = ibUp->GetGPUVirtualAddress();
            geom.Triangles.IndexFormat                = DXGI_FORMAT_R32_UINT;
            geom.Triangles.IndexCount                 = static_cast<UINT>(indices.size());

            D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS inp{};
            inp.Type           = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL;
            inp.Flags          = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE;
            inp.NumDescs       = 1;
            inp.DescsLayout    = D3D12_ELEMENTS_LAYOUT_ARRAY;
            inp.pGeometryDescs = &geom;

            D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO pre{};
            device->GetRaytracingAccelerationStructurePrebuildInfo(&inp, &pre);

            BlasEntry& e = mBlasCache[meshKey];
            if (!CreateGpuBuffer(device.Get(), pre.ScratchDataSizeInBytes,
                D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON, e.Scratch)) continue;
            if (!CreateGpuBuffer(device.Get(), pre.ResultDataMaxSizeInBytes,
                D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
                D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE, e.Result)) continue;

            D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC bd{};
            bd.Inputs                           = inp;
            bd.DestAccelerationStructureData    = e.Result->GetGPUVirtualAddress();
            bd.ScratchAccelerationStructureData = e.Scratch->GetGPUVirtualAddress();
            cmdList->BuildRaytracingAccelerationStructure(&bd, 0, nullptr);

            auto uavB = CD3DX12_RESOURCE_BARRIER::UAV(e.Result.Get());
            cmdList->ResourceBarrier(1, &uavB);

            // Record this mesh's slice in the global geometry pools so the RayGen
            // shader can look up vertex normals by instance index.
            e.vertexOffset = static_cast<uint32_t>(mCpuVertices.size());
            e.indexOffset  = static_cast<uint32_t>(mCpuIndices.size());
            e.vertexCount  = static_cast<uint32_t>(verts.size());
            e.indexCount   = static_cast<uint32_t>(indices.size());

            for (const Vertex& v : verts)
            {
                GpuPackedVertex pv;
                pv.px = v.Position.x; pv.py = v.Position.y; pv.pz = v.Position.z;
                pv.nx = v.Normal.x;   pv.ny = v.Normal.y;   pv.nz = v.Normal.z;
                mCpuVertices.push_back(pv);
            }
            for (uint32_t idx : indices)
                mCpuIndices.push_back(idx);

            mGeometryDirty = true;

            mPendingUploads[mUploadRingIdx].push_back(std::move(vbUp));
            mPendingUploads[mUploadRingIdx].push_back(std::move(ibUp));
        }

        const auto it = mBlasCache.find(meshKey);
        if (it == mBlasCache.end() || !it->second.Result) continue;

        // Record per-instance info so the RayGen shader can look up normals by instance index.
        GpuInstanceInfo info{};
        info.vertexOffset = it->second.vertexOffset;
        info.indexOffset  = it->second.indexOffset;
        info.vertexCount  = it->second.vertexCount;
        info.indexCount   = it->second.indexCount;

        const size_t materialRangeStart = mCpuMaterialRanges.size();
        const auto& subMeshes = mesh->GetSubMeshes();
        if (!subMeshes.empty())
        {
            for (const SubMesh& subMesh : subMeshes)
            {
                if (subMesh.indexCount < 3)
                    continue;

                GpuMaterialRange range{};
                range.startPrimitive = subMesh.indexStart / 3u;
                range.primitiveCount = subMesh.indexCount / 3u;

                const auto tint = loadBaseColorTintForMaterialSlot(entity.Mesh->MaterialPath, subMesh.materialId);
                range.albedoR = tint[0];
                range.albedoG = tint[1];
                range.albedoB = tint[2];
                mCpuMaterialRanges.push_back(range);
            }
        }

        if (mCpuMaterialRanges.size() == materialRangeStart)
        {
            GpuMaterialRange range{};
            range.startPrimitive = 0;
            range.primitiveCount = info.indexCount / 3u;

            const auto tint = loadBaseColorTintForMaterialSlot(entity.Mesh->MaterialPath, 0);
            range.albedoR = tint[0];
            range.albedoG = tint[1];
            range.albedoB = tint[2];
            mCpuMaterialRanges.push_back(range);
        }

        info.materialRangeOffset = static_cast<uint32_t>(materialRangeStart);
        info.materialRangeCount  = static_cast<uint32_t>(mCpuMaterialRanges.size() - materialRangeStart);
        mCpuInstanceInfo.push_back(info);

        // Build instance transform (row-major 3x4).
        using namespace DirectX;
        XMFLOAT4X4 w4;
        XMStoreFloat4x4(&w4, XMMatrixTranspose(entity.Transform.GetTransform()));

        D3D12_RAYTRACING_INSTANCE_DESC inst{};
        inst.Transform[0][0] = w4._11; inst.Transform[0][1] = w4._12; inst.Transform[0][2] = w4._13; inst.Transform[0][3] = w4._14;
        inst.Transform[1][0] = w4._21; inst.Transform[1][1] = w4._22; inst.Transform[1][2] = w4._23; inst.Transform[1][3] = w4._24;
        inst.Transform[2][0] = w4._31; inst.Transform[2][1] = w4._32; inst.Transform[2][2] = w4._33; inst.Transform[2][3] = w4._34;
        inst.InstanceMask                    = 0xFF;
        inst.Flags                           = D3D12_RAYTRACING_INSTANCE_FLAG_NONE;
        inst.AccelerationStructure           = it->second.Result->GetGPUVirtualAddress();
        instanceDescs.push_back(inst);
    }

    if (instanceDescs.empty()) return;

    const UINT numInst    = static_cast<UINT>(instanceDescs.size());
    const UINT64 instSize = numInst * sizeof(D3D12_RAYTRACING_INSTANCE_DESC);

    // Grow instance upload buffer if needed.
    if (!mInstanceDescBuffer || mInstanceDescBuffer->GetDesc().Width < instSize)
    {
        mInstanceDescBuffer.Reset();
        CreateUploadBuf(device.Get(), instSize, mInstanceDescBuffer);
    }
    void* mapped = nullptr;
    if (FAILED(mInstanceDescBuffer->Map(0, nullptr, &mapped)) || !mapped) return;
    std::memcpy(mapped, instanceDescs.data(), instSize);
    mInstanceDescBuffer->Unmap(0, nullptr);

    D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS tlasInp{};
    tlasInp.Type          = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL;
    tlasInp.Flags         = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE;
    tlasInp.NumDescs      = numInst;
    tlasInp.DescsLayout   = D3D12_ELEMENTS_LAYOUT_ARRAY;
    tlasInp.InstanceDescs = mInstanceDescBuffer->GetGPUVirtualAddress();

    D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO tlasPre{};
    device->GetRaytracingAccelerationStructurePrebuildInfo(&tlasInp, &tlasPre);

    if (!mTlas || mTlas->GetDesc().Width < tlasPre.ResultDataMaxSizeInBytes)
    {
        mTlas.Reset();
        CreateGpuBuffer(device.Get(), tlasPre.ResultDataMaxSizeInBytes,
            D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
            D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE, mTlas);
    }
    if (!mTlasScratch || mTlasScratch->GetDesc().Width < tlasPre.ScratchDataSizeInBytes)
    {
        mTlasScratch.Reset();
        CreateGpuBuffer(device.Get(), tlasPre.ScratchDataSizeInBytes,
            D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON, mTlasScratch);
    }

    D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC tlasDesc{};
    tlasDesc.Inputs                           = tlasInp;
    tlasDesc.DestAccelerationStructureData    = mTlas->GetGPUVirtualAddress();
    tlasDesc.ScratchAccelerationStructureData = mTlasScratch->GetGPUVirtualAddress();
    cmdList->BuildRaytracingAccelerationStructure(&tlasDesc, 0, nullptr);

    auto uav = CD3DX12_RESOURCE_BARRIER::UAV(mTlas.Get());
    cmdList->ResourceBarrier(1, &uav);

    // Write the TLAS SRV into the allocated descriptor slot so the shader can bind it.
    D3D12_SHADER_RESOURCE_VIEW_DESC tlasSrv{};
    tlasSrv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
    tlasSrv.Format                  = DXGI_FORMAT_UNKNOWN;
    tlasSrv.ViewDimension           = D3D12_SRV_DIMENSION_RAYTRACING_ACCELERATION_STRUCTURE;
    tlasSrv.RaytracingAccelerationStructure.Location = mTlas->GetGPUVirtualAddress();
    device->CreateShaderResourceView(nullptr, &tlasSrv, mTlasSrvCpu);

    // -----------------------------------------------------------------------
    // Upload geometry pools (vertex, index, instance-info) to the GPU so the
    // RayGen shader can interpolate true per-vertex normals at secondary hits.
    //
    // All three buffers use the UPLOAD heap with persistent CPU mapping so we
    // can memcpy into them directly every frame without any resource-state
    // transitions.  The vertex/index buffers are only reallocated when the
    // CPU pool has grown.  The instance-info buffer is reallocated whenever
    // the instance count changes (it's small, so this is cheap).
    // -----------------------------------------------------------------------
    ID3D12Device* rawDevice = DX12Context_GetDevice();

    // Helper: (re)create an UPLOAD-heap structured buffer if it is missing or
    // too small, write its SRV descriptor, and memcpy the data into it.
    auto SyncUploadBuffer = [&](
        const void*             srcData,
        UINT64                  byteSize,
        UINT                    stride,
        ComPtr<ID3D12Resource>& gpuBuf,
        void**                  mappedPtr,
        D3D12_CPU_DESCRIPTOR_HANDLE srvCpu)
    {
        if (byteSize == 0) return;

        // Recreate if missing or undersized.
        if (!gpuBuf || gpuBuf->GetDesc().Width < byteSize)
        {
            if (gpuBuf && *mappedPtr)
                gpuBuf->Unmap(0, nullptr);
            gpuBuf.Reset();
            *mappedPtr = nullptr;

            CreateUploadBuf(rawDevice, byteSize, gpuBuf);
            gpuBuf->Map(0, nullptr, mappedPtr);

            // Write the SRV descriptor (only needed when the buffer is recreated).
            D3D12_SHADER_RESOURCE_VIEW_DESC srvDesc{};
            srvDesc.ViewDimension              = D3D12_SRV_DIMENSION_BUFFER;
            srvDesc.Shader4ComponentMapping    = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
            srvDesc.Format                     = DXGI_FORMAT_UNKNOWN;
            srvDesc.Buffer.StructureByteStride = stride;
            srvDesc.Buffer.NumElements         = static_cast<UINT>(byteSize / stride);
            rawDevice->CreateShaderResourceView(gpuBuf.Get(), &srvDesc, srvCpu);
        }

        // Copy data directly into the persistently-mapped buffer.
        std::memcpy(*mappedPtr, srcData, byteSize);
    };

    if (mGeometryDirty && !mCpuVertices.empty())
    {
        SyncUploadBuffer(
            mCpuVertices.data(),
            mCpuVertices.size() * sizeof(GpuPackedVertex),
            sizeof(GpuPackedVertex),
            mVertexBuffer,
            &mMappedVertices,
            mVertexSrvCpu);

        SyncUploadBuffer(
            mCpuIndices.data(),
            mCpuIndices.size() * sizeof(uint32_t),
            sizeof(uint32_t),
            mIndexBuffer,
            &mMappedIndices,
            mIndexSrvCpu);

        mGeometryDirty = false;
    }

    if (!mCpuInstanceInfo.empty())
    {
        SyncUploadBuffer(
            mCpuInstanceInfo.data(),
            mCpuInstanceInfo.size() * sizeof(GpuInstanceInfo),
            sizeof(GpuInstanceInfo),
            mInstanceInfoBuffer,
            &mMappedInstanceInfo,
            mInstanceInfoSrvCpu);
    }

    if (!mCpuMaterialRanges.empty())
    {
        SyncUploadBuffer(
            mCpuMaterialRanges.data(),
            mCpuMaterialRanges.size() * sizeof(GpuMaterialRange),
            sizeof(GpuMaterialRange),
            mMaterialRangeBuffer,
            &mMappedMaterialRanges,
            mMaterialRangeSrvCpu);
    }

    // Mark the TLAS as ready so Dispatch will submit the RayGen pass this frame.
    mTlasReady = true;
}
