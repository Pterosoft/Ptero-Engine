// RtGlobalIllumination.cpp
// Custom RTGI renderer with ReSTIR-style temporal and spatial reservoir resampling.
//
// Shader binding layout (all four passes share one root signature):
//   param 0  -  inline CBV  b0  (RtGIConstants, 256 bytes)
//   param 1  -  SRV table   t0  (pass-specific input A)
//   param 2  -  SRV table   t1  (pass-specific input B)
//   param 3  -  UAV table   u0  (pass-specific output A)
//   param 4  -  UAV table   u1  (pass-specific output B)
//
// Per-frame pass sequence:
//   Pass 0  RayGen    t0=Albedo       t1=NormalDepth   u0=Reservoir[write]  u1=Radiance
//   Pass 1  Temporal  t0=Reservoir[w] t1=Reservoir[r]  u0=Reservoir[tmp]    u1=Radiance
//   Pass 2  Spatial   t0=Reservoir[t] t1=NormalDepth   u0=Reservoir[write]  u1=Radiance
//   Pass 3  Composite t0=Radiance     t1=AccumHistory  u0=AccumWrite        u1=Output

