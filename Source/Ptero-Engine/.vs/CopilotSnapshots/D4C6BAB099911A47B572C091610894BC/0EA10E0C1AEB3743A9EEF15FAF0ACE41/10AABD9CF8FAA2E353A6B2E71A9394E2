bool RtGlobalIllumination::Initialize(UINT width, UINT height)
{
    if (width == 0 || height == 0)
        return false;

    mLastError.clear();
    try
    {
        if (!mIsInitialized)
        {
            if (!CreateRootSignature()) return false;
            if (!CreatePipelines())    return false;
        }

        if (!mIsInitialized || width != mWidth || height != mHeight)
        {
            // Set dimensions before CreateResolutionBuffers so helpers can use mWidth/mHeight.
            mWidth  = width;
            mHeight = height;
            if (!CreateResolutionBuffers()) return false;
            if (!CreateDescriptors()) return false;
            // (Re-)initialise NRD with the new resolution and texture pointers.
            if (!InitNrd()) return false;

            // Recreated RTGI buffers start without valid temporal history.
            mFrameIndex = 0;
            mReservoirWriteIdx = 0;
            mOutputBufferInSrvState = false;
        }

        mIsInitialized = true;
        return true;
    }
    catch (const std::exception& ex)
    {
        mLastError = std::string("RtGlobalIllumination::Initialize: ") + ex.what();
        mInitFailed = true;
        return false;
    }
}

bool RtGlobalIllumination::EnsureSize(UINT width, UINT height)
{
    if (width == mWidth && height == mHeight)
        return true;
    return Initialize(width, height);
}

void RtGlobalIllumination::Shutdown()
{
    if (mMappedCb && mConstantBuffer)
    {
        mConstantBuffer->Unmap(0, nullptr);
        mMappedCb = nullptr;
    }
    mConstantBuffer.Reset();
    mReservoirBuffer[0].Reset();
    mReservoirBuffer[1].Reset();
    mRadianceBuffer.Reset();
    mAccumBuffer.Reset();
    mOutputBuffer.Reset();
    mSpecularBuffer.Reset();
    // Unmap and release the persistently-mapped geometry buffers.
    if (mVertexBuffer     && mMappedVertices)     { mVertexBuffer->Unmap(0, nullptr);     mMappedVertices     = nullptr; }
    if (mIndexBuffer      && mMappedIndices)      { mIndexBuffer->Unmap(0, nullptr);      mMappedIndices      = nullptr; }
    if (mInstanceInfoBuffer && mMappedInstanceInfo) { mInstanceInfoBuffer->Unmap(0, nullptr); mMappedInstanceInfo = nullptr; }
    mVertexBuffer.Reset();
    mIndexBuffer.Reset();
    mInstanceInfoBuffer.Reset();
    mCpuVertices.clear();
    mCpuIndices.clear();
    mCpuInstanceInfo.clear();
    mGeometryDirty = false;
    mCpuUavHeap.Reset();
    mRootSignature.Reset();
    mPSO_RayGen.Reset();
    mPSO_Temporal.Reset();
    mPSO_Spatial.Reset();
    mPSO_Composite.Reset();
    // NRD path PSOs and root signature.
    mPSO_NrdPrepare.Reset();
    mPSO_NrdComposite.Reset();
    mRootSignatureNrd.Reset();
    // Specular reflection PSO and root signature.
    mPSO_Specular.Reset();
    mRootSignatureSpecular.Reset();
    // NRD input/output textures.
    mNrdDiffRadianceHitDist.Reset();
    mNrdMotionVectors.Reset();
    mNrdNormalRoughness.Reset();
    mNrdViewZ.Reset();
    mNrdOutDiff.Reset();
    // Shut down the NRD instance.
    mNrdDenoiser.Shutdown();
    mNrdDescriptorsAllocated = false;
    mIsInitialized = false;
    mDescriptorsAllocated = false;
    mTlasReady = false;
    mOutputBufferInSrvState = false;
    mSpecularBufferInSrvState = false;
    mUploadRingIdx = 0;
    mPendingUploads[0].clear();
    mPendingUploads[1].clear();
    mBlasCache.clear();
    mMaterialSlotCache.clear();
    mMaterialTextureIndices.clear();
    mMaterialTextureCount = 0;
    mBaseTextureTableCpu = {};
    mBaseTextureTableGpu = {};
    mOpacityTextureTableCpu = {};
    mOpacityTextureTableGpu = {};
    mMaterialTextureTableAllocated = false;
    mTlas.Reset();
    mTlasScratch.Reset();
    mInstanceDescBuffer.Reset();
}

