void RtGlobalIllumination::Dispatch(
    ID3D12GraphicsCommandList4*  cmdList,
    D3D12_GPU_DESCRIPTOR_HANDLE  gbufferAlbedoSrv,
    D3D12_GPU_DESCRIPTOR_HANDLE  gbufferNormalDepthSrv,
    D3D12_GPU_DESCRIPTOR_HANDLE  gbufferMaterialSrv,
    const RtGISettings&          settings,
    const float                  viewProjInv[16],
    const float                  currViewProj[16],
    const float                  prevViewProj[16],
    const float                  cameraPos[3],
    float sunDirX, float sunDirY, float sunDirZ,
    float sunR,    float sunG,    float sunB,
    float skyR,    float skyG,    float skyB,
    const float worldToViewMatrix[16],
    const float viewToClipMatrix[16],
    const float prevWorldToViewMatrix[16],
    const float prevViewToClipMatrix[16],
    const float cameraJitter[2],
    const float prevCameraJitter[2],
    float       timeDeltaMs)
{
    UploadConstants(settings, viewProjInv, currViewProj, prevViewProj, worldToViewMatrix, cameraPos,
        sunDirX, sunDirY, sunDirZ, sunR, sunG, sunB, skyR, skyG, skyB);

    // Thread group counts for the full frame.
    const UINT gx = (mWidth  + kGroupSizeX - 1) / kGroupSizeX;
    const UINT gy = (mHeight + kGroupSizeY - 1) / kGroupSizeY;

    // Current write and read reservoir indices (alternating each frame).
    const UINT writeIdx = mReservoirWriteIdx;
    const UINT readIdx  = 1u - writeIdx;

    cmdList->SetComputeRootSignature(mRootSignature.Get());
    cmdList->SetComputeRootConstantBufferView(0, mConstantBuffer->GetGPUVirtualAddress());

    // Helpers for common barrier patterns.
    auto UavBarrier = [&](ID3D12Resource* resource) {
        auto b = CD3DX12_RESOURCE_BARRIER::UAV(resource);
        cmdList->ResourceBarrier(1, &b);
    };
    auto ToSrv = [&](ID3D12Resource* resource) {
        auto b = CD3DX12_RESOURCE_BARRIER::Transition(
            resource, D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
        cmdList->ResourceBarrier(1, &b);
    };
    auto ToUav = [&](ID3D12Resource* resource) {
        auto b = CD3DX12_RESOURCE_BARRIER::Transition(
            resource, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
            D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
        cmdList->ResourceBarrier(1, &b);
    };

    // -----------------------------------------------------------------------
    // Pass 0 - RayGen: fire GI rays, write initial reservoirs + raw radiance.
    // Skipped if the TLAS has not been built yet (first frame / no geometry)
    // to prevent a null-acceleration-structure GPU hang.
    // -----------------------------------------------------------------------
    if (mTlasReady)
    {
        // reservoirBuffer[writeIdx] and mRadianceBuffer are written as UAVs — ensure UAV state.
        // (Already in UAV on first frame from resource creation; on later frames
        //  we transitioned them back to UAV at the end of temporal/spatial/composite.)

        cmdList->SetPipelineState(mPSO_RayGen.Get());
        SetTable(cmdList, 1, gbufferAlbedoSrv);
        SetTable(cmdList, 2, gbufferNormalDepthSrv);
        SetTable(cmdList, 3, mReservoirUavGpu[writeIdx]);
        SetTable(cmdList, 4, mRadianceUavGpu);
        SetTable(cmdList, 5, mTlasSrvGpu);
        SetTable(cmdList, 6, mVertexSrvGpu);
        SetTable(cmdList, 7, mIndexSrvGpu);
        SetTable(cmdList, 8, mInstanceInfoSrvGpu);
        cmdList->Dispatch(gx, gy, 1);

        UavBarrier(mReservoirBuffer[writeIdx].Get());
        UavBarrier(mRadianceBuffer.Get());
    }

    // -----------------------------------------------------------------------
    // Passes 1-3:  either NRD RELAX_DIFFUSE (recommended) or the legacy
    // ReSTIR temporal / spatial / EMA-composite path.
    // -----------------------------------------------------------------------
    const bool useNrd = settings.UseNrdDenoiser
                     && mNrdDenoiser.IsInitialized()
                     && worldToViewMatrix  != nullptr
                     && viewToClipMatrix   != nullptr
                     && prevWorldToViewMatrix != nullptr
                     && prevViewToClipMatrix  != nullptr;

    if (useNrd)
    {
        // ── NRD path ───────────────────────────────────────────────────────
        // The raw noisy GI in mRadianceBuffer was just written by RayGen.
        // We feed it through four NRD input textures, run NRD RELAX_DIFFUSE,
        // then composite the denoised result into mOutputBuffer.

        // Step A – transition mRadianceBuffer UAV → SRV so NrdPrepare can read it.
        ToSrv(mRadianceBuffer.Get());

        // Step B – NRD input textures were just written by NrdPrepare as UAVs.
        // NrdDenoiser will transition them internally as needed; no barriers required here.

        // Step C – run NrdPrepare
        // mNrdViewZ, mNrdMotionVectors.
        {
            cmdList->SetComputeRootSignature(mRootSignatureNrd.Get());
            cmdList->SetComputeRootConstantBufferView(0, mConstantBuffer->GetGPUVirtualAddress());
            cmdList->SetPipelineState(mPSO_NrdPrepare.Get());
            // param 1: t0 = albedo (not used but bound for root-sig completeness)
            SetTable(cmdList, 1, gbufferAlbedoSrv);
            // param 2: t1 = normalDepth G-buffer
            SetTable(cmdList, 2, gbufferNormalDepthSrv);
            // param 3: t2 = material G-buffer (roughness/metallic/AO)
            SetTable(cmdList, 3, gbufferMaterialSrv);
            // param 4: t3 = raw GI radiance from RayGen
            SetTable(cmdList, 4, mRadianceSrvGpu);
            // params 5-8: u0-u3 = NRD input textures
            SetTable(cmdList, 5, mNrdDiffRadianceUavGpu);
            SetTable(cmdList, 6, mNrdNormalRoughnessUavGpu);
            SetTable(cmdList, 7, mNrdViewZUavGpu);
            SetTable(cmdList, 8, mNrdMotionVectorsUavGpu);
            cmdList->Dispatch(gx, gy, 1);

            // UAV barriers after NrdPrepare so NRD can safely read these textures.
            D3D12_RESOURCE_BARRIER uavBarriers[4];
            uavBarriers[0] = CD3DX12_RESOURCE_BARRIER::UAV(mNrdDiffRadianceHitDist.Get());
            uavBarriers[1] = CD3DX12_RESOURCE_BARRIER::UAV(mNrdNormalRoughness.Get());
            uavBarriers[2] = CD3DX12_RESOURCE_BARRIER::UAV(mNrdViewZ.Get());
            uavBarriers[3] = CD3DX12_RESOURCE_BARRIER::UAV(mNrdMotionVectors.Get());
            cmdList->ResourceBarrier(4, uavBarriers);
        }

        // Step D – update NRD denoiser settings from RtGISettings.
        mNrdDenoiser.SetMaxAccumulationTime(settings.NrdMaxAccumulationTime, 60.0f);
        mNrdDenoiser.SetAtrousIterations(settings.NrdAtrousIterations);
        mNrdDenoiser.SetDisocclusionThreshold(settings.NrdDisocclusionThreshold);

        // Step E – run all NRD RELAX_DIFFUSE dispatches.
        // NRD will set its own pipeline/root-signature/descriptor-heap internally.
        const bool resetHistory = (mFrameIndex == 0);
        mNrdDenoiser.Denoise(
            cmdList,
            viewToClipMatrix,
            prevViewToClipMatrix,
            worldToViewMatrix,
            prevWorldToViewMatrix,
            cameraJitter,
            prevCameraJitter,
            mFrameIndex,
            resetHistory,
            timeDeltaMs);

        // After NRD, restore the engine descriptor heap so subsequent passes
        // (NrdComposite, deferred lighting) work normally.
        {
            ID3D12DescriptorHeap* heap = DX12Context_GetSrvDescriptorHeap();
            if (heap) cmdList->SetDescriptorHeaps(1, &heap);
        }

        // Step F – transition the NRD output to SRV and ensure mOutputBuffer is in UAV
        // state for the composite pass.
        {
            auto outDiffToSrv = CD3DX12_RESOURCE_BARRIER::Transition(
                mNrdOutDiff.Get(),
                D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
                D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
            cmdList->ResourceBarrier(1, &outDiffToSrv);

            if (mOutputBufferInSrvState)
            {
                auto outToUav = CD3DX12_RESOURCE_BARRIER::Transition(
                    mOutputBuffer.Get(),
                    D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
                    D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
                cmdList->ResourceBarrier(1, &outToUav);
                mOutputBufferInSrvState = false;
            }
        }

        // Step G – NrdComposite: unpack denoised radiance → mOutputBuffer.
        {
            cmdList->SetComputeRootSignature(mRootSignatureNrd.Get());
            cmdList->SetComputeRootConstantBufferView(0, mConstantBuffer->GetGPUVirtualAddress());
            cmdList->SetPipelineState(mPSO_NrdComposite.Get());
            SetTable(cmdList, 1, mNrdOutDiffSrvGpu);
            // param 5: u0 = final GI output
            SetTable(cmdList, 5, mOutputUavGpu);
            cmdList->Dispatch(gx, gy, 1);
            UavBarrier(mOutputBuffer.Get());

            auto outDiffToUav = CD3DX12_RESOURCE_BARRIER::Transition(
                mNrdOutDiff.Get(),
                D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
                D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
            cmdList->ResourceBarrier(1, &outDiffToUav);
        }

        // Restore mRadianceBuffer back to UAV for next frame's RayGen.
        ToUav(mRadianceBuffer.Get());
    }
    else
    {
        // ── Legacy ReSTIR path ─────────────────────────────────────────────
        // Restore the shared RTGI root signature that was set by RayGen.
        cmdList->SetComputeRootSignature(mRootSignature.Get());
        cmdList->SetComputeRootConstantBufferView(0, mConstantBuffer->GetGPUVirtualAddress());

        // Pass 1 - Temporal resampling
        if (settings.TemporalReuseEnabled)
        {
            ToSrv(mReservoirBuffer[writeIdx].Get());
            ToSrv(mReservoirBuffer[readIdx].Get());

            cmdList->SetPipelineState(mPSO_Temporal.Get());
            SetTable(cmdList, 1, mReservoirSrvGpu[writeIdx]);
            SetTable(cmdList, 2, mReservoirSrvGpu[readIdx]);
            SetTable(cmdList, 3, mReservoirUavGpu[readIdx]);
            SetTable(cmdList, 4, mRadianceUavGpu);

            ToUav(mReservoirBuffer[readIdx].Get());

            cmdList->Dispatch(gx, gy, 1);

            UavBarrier(mReservoirBuffer[readIdx].Get());
            UavBarrier(mRadianceBuffer.Get());

            ToUav(mReservoirBuffer[writeIdx].Get());
        }

        const UINT spatialReadIdx = settings.TemporalReuseEnabled ? readIdx : writeIdx;

        // Pass 2 - Spatial resampling
        if (settings.SpatialReuseEnabled)
        {
            const UINT spatialWriteIdx = 1u - spatialReadIdx;
            ToSrv(mReservoirBuffer[spatialReadIdx].Get());

            cmdList->SetPipelineState(mPSO_Spatial.Get());
            SetTable(cmdList, 1, mReservoirSrvGpu[spatialReadIdx]);
            SetTable(cmdList, 2, gbufferNormalDepthSrv);
            SetTable(cmdList, 3, mReservoirUavGpu[spatialWriteIdx]);
            SetTable(cmdList, 4, mRadianceUavGpu);
            cmdList->Dispatch(gx, gy, 1);

            UavBarrier(mReservoirBuffer[spatialWriteIdx].Get());
            UavBarrier(mRadianceBuffer.Get());

            ToUav(mReservoirBuffer[spatialReadIdx].Get());
        }

        // Pass 3 - Composite (EMA accumulation)
        if (mOutputBufferInSrvState)
        {
            auto toUav = CD3DX12_RESOURCE_BARRIER::Transition(
                mOutputBuffer.Get(),
                D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
                D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
            cmdList->ResourceBarrier(1, &toUav);
            mOutputBufferInSrvState = false;
        }

        ToSrv(mRadianceBuffer.Get());
        ToSrv(mAccumBuffer.Get());

        cmdList->SetPipelineState(mPSO_Composite.Get());
        SetTable(cmdList, 1, mRadianceSrvGpu);
        SetTable(cmdList, 2, mAccumSrvGpu);
        SetTable(cmdList, 3, mAccumUavGpu);
        SetTable(cmdList, 4, mOutputUavGpu);
        cmdList->Dispatch(gx, gy, 1);

        UavBarrier(mAccumBuffer.Get());
        UavBarrier(mOutputBuffer.Get());

        ToUav(mRadianceBuffer.Get());
        ToUav(mAccumBuffer.Get());
    }

    // Transition the output buffer from UAV to PIXEL_SHADER_RESOURCE so the
    // deferred lighting pass can sample it.
    if (!mOutputBufferInSrvState)
    {
        auto toSrv = CD3DX12_RESOURCE_BARRIER::Transition(
            mOutputBuffer.Get(),
            D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
        cmdList->ResourceBarrier(1, &toSrv);
        mOutputBufferInSrvState = true;
    }

    // ── Specular reflection pass ───────────────────────────────────────────
    // Run only when the TLAS is ready, specular is enabled, and the PSO compiled.
    if (mTlasReady && settings.SpecularEnabled && mPSO_Specular && mRootSignatureSpecular)
    {
        // Ensure specular buffer is in UAV state.
        if (mSpecularBufferInSrvState)
        {
            auto toUav = CD3DX12_RESOURCE_BARRIER::Transition(
                mSpecularBuffer.Get(),
                D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
                D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
            cmdList->ResourceBarrier(1, &toUav);
            mSpecularBufferInSrvState = false;
        }

        cmdList->SetComputeRootSignature(mRootSignatureSpecular.Get());
        cmdList->SetComputeRootConstantBufferView(0, mConstantBuffer->GetGPUVirtualAddress());
        SetTable(cmdList, 1, gbufferAlbedoSrv);
        SetTable(cmdList, 2, gbufferNormalDepthSrv);
        SetTable(cmdList, 3, mTlasSrvGpu);
        SetTable(cmdList, 4, mVertexSrvGpu);
        SetTable(cmdList, 5, mIndexSrvGpu);
        SetTable(cmdList, 6, mInstanceInfoSrvGpu);
        SetTable(cmdList, 7, gbufferMaterialSrv);
        SetTable(cmdList, 8, mMaterialRangeSrvGpu);
        SetTable(cmdList, 9, mSpecularUavGpu);
        SetTable(cmdList, 10, mSpecularUavGpu); // dummy u1 bound to same slot
        cmdList->SetPipelineState(mPSO_Specular.Get());
        cmdList->Dispatch(gx, gy, 1);
        UavBarrier(mSpecularBuffer.Get());

        // Transition specular buffer to SRV for the deferred lighting pass.
        auto toSrv = CD3DX12_RESOURCE_BARRIER::Transition(
            mSpecularBuffer.Get(),
            D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
        cmdList->ResourceBarrier(1, &toSrv);
        mSpecularBufferInSrvState = true;
    }
    else if (!mSpecularBufferInSrvState)
    {
        // Specular disabled – ensure buffer is in a known SRV state (GPU reads zero).
        auto toSrv = CD3DX12_RESOURCE_BARRIER::Transition(
            mSpecularBuffer.Get(),
            D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
        cmdList->ResourceBarrier(1, &toSrv);
        mSpecularBufferInSrvState = true;
    }

    // Advance ping-pong index for next frame.
    mReservoirWriteIdx = 1u - mReservoirWriteIdx;
    ++mFrameIndex;
}

