// ---------------------------------------------------------------------------
// DrawPropertiesPanel
// ---------------------------------------------------------------------------

void Editor::DrawPropertiesPanel(Entity* selectedEntity, AudioManager* audioManager)
{
    ImGui::SetNextWindowPos(ImVec2(1060.0f, 210.0f), ImGuiCond_Appearing);
    ImGui::SetNextWindowSize(ImVec2(240.0f, 320.0f), ImGuiCond_Appearing);
    if (!ImGui::Begin("Properties", &mShowPropertiesPanel,
        ImGuiWindowFlags_NoCollapse))
    {
        ImGui::End();
        return;
    }

    if (!selectedEntity)
    {
        ImGui::TextDisabled("No entity selected.");
        ImGui::End();
        return;
    }

    static char entityNameBuffer[256] = {};
    strcpy_s(entityNameBuffer, selectedEntity->Name.c_str());
    if (ImGui::InputText("Name", entityNameBuffer, IM_ARRAYSIZE(entityNameBuffer)))
    {
        selectedEntity->Name = entityNameBuffer;
        mSceneDirty = true;
    }

    ImGui::Separator();

    if (ImGui::CollapsingHeader("Transform", ImGuiTreeNodeFlags_DefaultOpen))
    {
        if (ImGui::DragFloat3("Position", &selectedEntity->Transform.Position.x, 0.01f))
            mSceneDirty = true;
        float rotationDegrees[3]
        {
            RadiansToDegrees(selectedEntity->Transform.Rotation.x),
            RadiansToDegrees(selectedEntity->Transform.Rotation.y),
            RadiansToDegrees(selectedEntity->Transform.Rotation.z)
        };
        if (ImGui::DragFloat3("Rotation", rotationDegrees, 0.5f))
        {
            selectedEntity->Transform.Rotation.x = DegreesToRadians(rotationDegrees[0]);
            selectedEntity->Transform.Rotation.y = DegreesToRadians(rotationDegrees[1]);
            selectedEntity->Transform.Rotation.z = DegreesToRadians(rotationDegrees[2]);
            mSceneDirty = true;
        }
        if (ImGui::DragFloat3("Scale",    &selectedEntity->Transform.Scale.x,    0.01f))
            mSceneDirty = true;
    }

    if (selectedEntity->PointLight.has_value())
    {
        if (ImGui::CollapsingHeader("Point Light", ImGuiTreeNodeFlags_DefaultOpen))
        {
            auto& pl = *selectedEntity->PointLight;
            if (ImGui::DragFloat("Intensity (lm)", &pl.IntensityLumens, 10.0f, 0.0f, 100000.0f)) mSceneDirty = true;
            if (ImGui::DragFloat("Radius",         &pl.Radius,          0.1f,  0.0f, 1000.0f)) mSceneDirty = true;
            float col[3] = { pl.ColorR, pl.ColorG, pl.ColorB };
            if (ImGui::ColorEdit3("Color##pl", col)) { pl.ColorR = col[0]; pl.ColorG = col[1]; pl.ColorB = col[2]; mSceneDirty = true; }
            if (ImGui::Checkbox("Cast Shadows##pl",          &pl.CastShadows)) mSceneDirty = true;
            if (ImGui::Checkbox("Affect Volumetric Fog##pl", &pl.AffectVolumetricFog)) mSceneDirty = true;
            if (ImGui::DragFloat("Falloff Exponent", &pl.FalloffExponent, 0.01f, 0.1f, 10.0f)) mSceneDirty = true;
            if (ImGui::DragFloat("Source Radius",    &pl.SourceRadius,    0.001f, 0.0f, 1.0f)) mSceneDirty = true;
            if (ImGui::Checkbox("Use Temperature",   &pl.UseTemperature)) mSceneDirty = true;
            if (pl.UseTemperature)
                if (ImGui::DragFloat("Temperature (K)", &pl.TemperatureKelvin, 100.0f, 1000.0f, 20000.0f)) mSceneDirty = true;
        }
    }

    if (selectedEntity->Mesh.has_value())
    {
        if (ImGui::CollapsingHeader("Mesh", ImGuiTreeNodeFlags_DefaultOpen))
        {
            MeshComponent& meshComponent = *selectedEntity->Mesh;

            ImGui::TextWrapped("Geometry: %s", meshComponent.MeshPath.empty() ? "(none)" : meshComponent.MeshPath.c_str());
            if (ImGui::Button("Select Geometry (.ptero)"))
            {
                std::string updatedMeshPath = meshComponent.MeshPath;
                if (PromptForDataFile(DX12Context_GetWindowHandle(), "Select Geometry", "Ptero Geometry\0*.ptero\0All Files\0*.*\0", updatedMeshPath))
                {
                    meshComponent.MeshPath = updatedMeshPath;
                    meshComponent.MeshAsset.reset();
                    mSceneDirty = true;

                    const std::string defaultMaterialPath = FindDefaultMaterialPathForMesh(meshComponent.MeshPath);
                    if (!defaultMaterialPath.empty())
                    {
                        meshComponent.MaterialPath = defaultMaterialPath;
                    }
                }
            }
            ImGui::SameLine();
            if (ImGui::Button("Clear Geometry"))
            {
                meshComponent.MeshPath.clear();
                meshComponent.MeshAsset.reset();
                mSceneDirty = true;
            }

            ImGui::Spacing();
            ImGui::TextWrapped("Material: %s", meshComponent.MaterialPath.empty() ? "(none)" : meshComponent.MaterialPath.c_str());
            if (ImGui::Button("Select Material"))
            {
                std::string updatedMaterialPath = meshComponent.MaterialPath;
                if (PromptForDataFile(DX12Context_GetWindowHandle(), "Select Material", "Material JSON\0*.json\0All Files\0*.*\0", updatedMaterialPath))
                {
                    meshComponent.MaterialPath = updatedMaterialPath;
                    mSceneDirty = true;
                }
            }
            ImGui::SameLine();
            if (ImGui::Button("Clear Material"))
            {
                meshComponent.MaterialPath.clear();
                mSceneDirty = true;
            }

            if (!meshComponent.MeshPath.empty())
            {
                const std::string defaultMaterialPath = FindDefaultMaterialPathForMesh(meshComponent.MeshPath);
                if (!defaultMaterialPath.empty() && meshComponent.MaterialPath != defaultMaterialPath)
                {
                    if (ImGui::Button("Use Geometry Default Material"))
                    {
                        meshComponent.MaterialPath = defaultMaterialPath;
                        mSceneDirty = true;
                    }
                }
            }
        }
    }

    if (selectedEntity->AudioEmitter.has_value())
    {
        if (ImGui::CollapsingHeader("Audio Emitter", ImGuiTreeNodeFlags_DefaultOpen))
        {
            auto& ae = *selectedEntity->AudioEmitter;
            static char epBuf[512];
            strncpy_s(epBuf, ae.EventPath.c_str(), sizeof(epBuf) - 1);
            if (ImGui::InputText("Event Path##ae", epBuf, sizeof(epBuf)))
            {
                ae.EventPath = epBuf;
                mSceneDirty = true;
            }

            if (audioManager != nullptr)
            {
                const std::vector<AudioEvent>& availableEvents = audioManager->GetEvents();
                if (!availableEvents.empty())
                {
                    int selectedEventIndex = -1;
                    for (int eventIndex = 0; eventIndex < static_cast<int>(availableEvents.size()); ++eventIndex)
                    {
                        if (availableEvents[eventIndex].Path == ae.EventPath)
                        {
                            selectedEventIndex = eventIndex;
                            break;
                        }
                    }

                    const char* previewValue = selectedEventIndex >= 0
                        ? availableEvents[selectedEventIndex].Path.c_str()
                        : (ae.EventPath.empty() ? "Select Event" : ae.EventPath.c_str());

                    if (ImGui::BeginCombo("Select Event##ae", previewValue))
                    {
                        for (int eventIndex = 0; eventIndex < static_cast<int>(availableEvents.size()); ++eventIndex)
                        {
                            const bool isSelected = (selectedEventIndex == eventIndex);
                            if (ImGui::Selectable(availableEvents[eventIndex].Path.c_str(), isSelected))
                            {
                                ae.EventPath = availableEvents[eventIndex].Path;
                                strcpy_s(epBuf, ae.EventPath.c_str());
                                mSceneDirty = true;
                            }

                            if (isSelected)
                                ImGui::SetItemDefaultFocus();
                        }

                        ImGui::EndCombo();
                    }
                }
                else
                {
                    const std::filesystem::path audioDataPath = audioManager->GetAudioDataPath();
                    if (!audioDataPath.empty())
                    {
                        ImGui::TextWrapped("No audio events loaded from %s", audioDataPath.string().c_str());
                    }
                    else
                    {
                        ImGui::TextDisabled("No audio events loaded.");
                    }
                }
            }

            if (ImGui::Checkbox("Auto Play##ae", &ae.AutoPlay))
                mSceneDirty = true;
        }
    }

    ImGui::End();
}

void Editor::DrawViewportResolutionWindow()
{
    if (!mShowViewportResolutionDialog)
        return;

    ImGui::SetNextWindowSize(ImVec2(320.0f, 0.0f), ImGuiCond_FirstUseEver);
    if (!ImGui::Begin("Viewport Resolution", &mShowViewportResolutionDialog, ImGuiWindowFlags_AlwaysAutoResize))
    {
        ImGui::End();
        return;
    }

    ImGui::InputInt("Width", &mViewportResolutionWidth);
    ImGui::InputInt("Height", &mViewportResolutionHeight);
    mViewportResolutionWidth = (std::max)(1, mViewportResolutionWidth);
    mViewportResolutionHeight = (std::max)(1, mViewportResolutionHeight);

    ImGui::SeparatorText("Presets");
    struct ResolutionPreset
    {
        const char* Label;
        int Width;
        int Height;
    };

    static constexpr ResolutionPreset presets[] =
    {
        { "1280 x 720", 1280, 720 },
        { "1600 x 900", 1600, 900 },
        { "1920 x 1080", 1920, 1080 },
        { "2560 x 1440", 2560, 1440 },
        { "3840 x 2160", 3840, 2160 }
    };

    for (int presetIndex = 0; presetIndex < static_cast<int>(std::size(presets)); ++presetIndex)
    {
        if (ImGui::Button(presets[presetIndex].Label, ImVec2(140.0f, 0.0f)))
        {
            mViewportResolutionWidth = presets[presetIndex].Width;
            mViewportResolutionHeight = presets[presetIndex].Height;
        }

        if ((presetIndex & 1) == 0 && presetIndex + 1 < static_cast<int>(std::size(presets)))
            ImGui::SameLine();
    }

    if (ImGui::Button("Window Resolution"))
    {
        UINT windowWidth = 0;
        UINT windowHeight = 0;
        if (DX12Context_GetRenderSize(&windowWidth, &windowHeight) && windowWidth > 0 && windowHeight > 0)
        {
            mViewportResolutionWidth = static_cast<int>(windowWidth);
            mViewportResolutionHeight = static_cast<int>(windowHeight);
        }
    }

    ImGui::Spacing();

    if (ImGui::Button("Apply"))
    {
        mRequestViewportResolutionChange = true;
        mShowViewportResolutionDialog = false;
    }

    ImGui::SameLine();
    if (ImGui::Button("Cancel"))
    {
        mShowViewportResolutionDialog = false;
    }

    ImGui::End();
}

void Editor::DrawScreenshotWindow()
{
    if (!mShowScreenshotDialog)
        return;

    ImGui::SetNextWindowSize(ImVec2(460.0f, 0.0f), ImGuiCond_FirstUseEver);
    if (!ImGui::Begin("Screenshot", &mShowScreenshotDialog, ImGuiWindowFlags_AlwaysAutoResize))
    {
        ImGui::End();
        return;
    }

    static char folderBuffer[MAX_PATH] = {};
    if (folderBuffer[0] == '\0')
    {
        const std::string defaultFolder = mScreenshotOutputFolder.empty() ? std::string("Screenshots") : mScreenshotOutputFolder;
        strcpy_s(folderBuffer, defaultFolder.c_str());
    }

    ImGui::InputText("Output Folder", folderBuffer, IM_ARRAYSIZE(folderBuffer));

    if (ImGui::Button("Capture"))
    {
        mScreenshotOutputFolder = folderBuffer;
        mRequestScreenshot = !mScreenshotOutputFolder.empty();
        mShowScreenshotDialog = false;
        folderBuffer[0] = '\0';
    }

    ImGui::SameLine();
    if (ImGui::Button("Cancel"))
    {
        mShowScreenshotDialog = false;
        folderBuffer[0] = '\0';
    }

    ImGui::End();
}

// ---------------------------------------------------------------------------
// DrawAudioManagerWindow
// ---------------------------------------------------------------------------

void Editor::DrawAudioManagerWindow(AudioManager* audioManager)
{
    if (!ImGui::Begin("Audio Manager", &mShowAudioManagerPanel))
    {
        ImGui::End();
        return;
    }

    if (!audioManager || !audioManager->IsInitialized())
    {
        ImGui::TextColored(ImVec4(1.0f, 0.4f, 0.4f, 1.0f), "Audio system not initialised.");
        ImGui::End();
        return;
    }

    // Summary line
    const auto& loadedBanks   = audioManager->GetLoadedBanks();
    const auto& bankFailures  = audioManager->GetBankLoadFailures();
    const auto& events        = audioManager->GetEvents();
    ImGui::TextDisabled("Loaded Banks: %d  |  Failed: %d  |  Events: %d",
                        static_cast<int>(loadedBanks.size()),
                        static_cast<int>(bankFailures.size()),
                        static_cast<int>(events.size()));
    ImGui::TextDisabled("Path: %s", audioManager->GetAudioDataPath().string().c_str());
    ImGui::Separator();

    // ---- HRTF Spatialization --------------------------------------------------
    if (ImGui::CollapsingHeader("HRTF Spatialization", ImGuiTreeNodeFlags_DefaultOpen))
    {
        bool hrtfEnabled = audioManager->IsHRTFEnabled();
        if (ImGui::Checkbox("Enable HRTF", &hrtfEnabled))
            audioManager->SetHRTFEnabled(hrtfEnabled);

        ImGui::SameLine();
        ImGui::TextDisabled("(?)");
        if (ImGui::IsItemHovered())
        {
            ImGui::BeginTooltip();
            ImGui::PushTextWrapPos(ImGui::GetFontSize() * 22.0f);
            ImGui::TextUnformatted(
                "Head-Related Transfer Function (HRTF) spatialization.\n"
                "Convolves mono audio sources with measured head-related\n"
                "impulse responses to produce binaural stereo output.\n\n"
                "Uses zero-allocation Overlap-Add FFT convolution.\n"
                "HRIR can be updated at runtime via AudioManager::GetHRTFNode().");
            ImGui::PopTextWrapPos();
            ImGui::EndTooltip();
        }

        if (hrtfEnabled)
        {
            HRTFSpatializationNode* node = audioManager->GetHRTFNode();
            if (node && node->IsInitialized())
            {
                ImGui::Spacing();
                ImGui::TextDisabled("Node active  |  crossfade on HRIR change: enabled");
            }
        }

        // ---- HRIR Database (MIT KEMAR) ----------------------------------------
        ImGui::Spacing();
        ImGui::Separator();
        ImGui::Text("HRIR Database (MIT KEMAR)");
        ImGui::Spacing();

        const HRIRDatabase* db = audioManager->GetHRIRDatabase();
        if (!db->IsLoaded())
        {
            ImGui::TextColored(ImVec4(1.0f, 0.8f, 0.2f, 1.0f), "Not loaded");
            ImGui::SameLine();
            if (ImGui::Button("Load KEMAR Dataset"))
            {
                std::filesystem::path hrtfPath =
                    std::filesystem::path(audioManager->GetAudioDataPath()).parent_path() / "HRTF";
                std::string err;
                if (!audioManager->LoadHRIRDatabase(hrtfPath, err))
                {
                    static std::string s_hrirError;
                    s_hrirError = err;
                    ImGui::OpenPopup("HRIRLoadError");
                }
            }
            if (ImGui::BeginPopupModal("HRIRLoadError", nullptr, ImGuiWindowFlags_AlwaysAutoResize))
            {
                static std::string s_hrirError;
                ImGui::TextColored(ImVec4(1, 0, 0, 1), "Failed to load HRIR database:");
                ImGui::TextWrapped("%s", s_hrirError.c_str());
                if (ImGui::Button("Close")) ImGui::CloseCurrentPopup();
                ImGui::EndPopup();
            }
        }
        else
        {
            ImGui::TextColored(ImVec4(0.3f, 1.0f, 0.3f, 1.0f), "Loaded  (%d measurements)",
                               db->EntryCount());
            ImGui::Spacing();

            float elev = audioManager->GetHRTFElevation();
            float azim = audioManager->GetHRTFAzimuth();
            bool dirChanged = false;
            dirChanged |= ImGui::SliderFloat("Elevation (deg)", &elev, -90.0f, 90.0f,  "%.1f");
            dirChanged |= ImGui::SliderFloat("Azimuth (deg)",   &azim,   0.0f, 360.0f, "%.1f");
            if (dirChanged)
                audioManager->SetHRTFDirection(elev, azim);

            ImGui::Spacing();
            ImGui::TextDisabled("Bilinear interpolation across KEMAR measurements.");
        }
    }

    ImGui::Separator();

    // ---- Loaded banks ---------------------------------------------------------
    if (ImGui::CollapsingHeader("Loaded Banks", ImGuiTreeNodeFlags_DefaultOpen))
    {
        if (loadedBanks.empty())
        {
            ImGui::TextDisabled("No banks loaded.");
        }
        else
        {
            for (const auto& bank : loadedBanks)
                ImGui::BulletText("%s", bank.c_str());
        }
    }

    // ---- Bank load failures ---------------------------------------------------
    if (!bankFailures.empty() && ImGui::CollapsingHeader("Bank Load Failures"))
    {
        for (const auto& fail : bankFailures)
            ImGui::TextColored(ImVec4(1, 0.4f, 0.4f, 1), "%s", fail.c_str());
    }

    // ---- Event list -----------------------------------------------------------
    if (ImGui::CollapsingHeader("Events", ImGuiTreeNodeFlags_DefaultOpen))
    {
        if (events.empty())
        {
            ImGui::TextDisabled("No FMOD events were discovered in the loaded banks.");
        }
        else
        {
            for (int i = 0; i < static_cast<int>(events.size()); ++i)
            {
                ImGui::PushID(i);
                ImGui::TextUnformatted(events[i].Path.c_str());
                ImGui::SameLine();
                if (ImGui::SmallButton("Play"))  audioManager->PlayEvent(i);
                ImGui::SameLine();
                if (ImGui::SmallButton("Stop"))  audioManager->StopEvent(i);
                ImGui::PopID();
            }
        }

        ImGui::Spacing();
        if (ImGui::Button("Stop All"))
            audioManager->StopAll();
    }

    ImGui::End();
}

// ---------------------------------------------------------------------------
// Draw (main entry called each frame by DX12RendererAPI)
// ---------------------------------------------------------------------------

void Editor::Draw(
    D3D12_GPU_DESCRIPTOR_HANDLE sceneTextureHandle,
    const EditorCamera& camera,
    const char* sceneStatusMessage,
    const char* statisticsText,
    bool showStatistics,
    AudioManager* audioManager)
{
    mSceneStatusMessage     = sceneStatusMessage;
    mViewportStatisticsText = statisticsText;
    if (!mViewportStatisticsInitialized)
    {
        mShowViewportStatistics = showStatistics;
        mViewportStatisticsInitialized = true;
    }

    UpdateSceneLoading();
    HandleKeyboardShortcuts();

    Entity* selectedEntity = GetSelectedEntity();

    DrawViewport(sceneTextureHandle, camera, selectedEntity);
    selectedEntity = GetSelectedEntity();
    DrawToolbar(mSelectIcon.GpuHandle, mMoveIcon.GpuHandle, mRotateIcon.GpuHandle, mScaleIcon.GpuHandle);

    if (mShowComponentsPanel)   DrawComponentsPanel();
    if (mShowLevelExplorerPanel) DrawLevelExplorerPanel();
    if (mShowPropertiesPanel)    DrawPropertiesPanel(selectedEntity, audioManager);
    if (mShowAudioManagerPanel)  DrawAudioManagerWindow(audioManager);
    DrawViewportResolutionWindow();
    DrawScreenshotWindow();

    DrawViewportStatisticsOverlay();
    DrawSceneLoadingOverlay();
}
