void Editor::DrawViewportPlacementIcons(
    const ImVec2& viewportOrigin,
    const ImVec2& viewportSize,
    const EditorCamera& camera)
{
    if (!mShowViewportPlacementIcons)
        return;

    ImDrawList* drawList = ImGui::GetWindowDrawList();
    const float iconSize = 54.0f;

    for (size_t i = 0; i < mEntities.size(); ++i)
    {
        ImVec2 screenPosition;
        if (!TryProjectWorldToViewport(mEntities[i].Transform.Position, viewportOrigin, viewportSize, camera, screenPosition))
            continue;

        const bool isSelected = IsEntitySelected(static_cast<int>(i));
        const ImU32 tintColor = isSelected ? IM_COL32(255, 245, 170, 255) : IM_COL32(255, 255, 255, 230);
        const ImVec2 iconMin = ImVec2(screenPosition.x - iconSize * 0.5f, screenPosition.y - iconSize * 0.5f);
        const ImVec2 iconMax = ImVec2(screenPosition.x + iconSize * 0.5f, screenPosition.y + iconSize * 0.5f);
        D3D12_GPU_DESCRIPTOR_HANDLE iconHandle{};

        if (mEntities[i].PointLight.has_value())
            iconHandle = mPointLightIcon.GpuHandle;
        else if (mEntities[i].AudioEmitter.has_value())
            iconHandle = mAudioEmitterIcon.GpuHandle;
        else
            iconHandle = mGeometryIcon.GpuHandle;

        if (iconHandle.ptr != 0)
        {
            drawList->AddImage(TextureIdFromHandle(iconHandle), iconMin, iconMax, ImVec2(0.0f, 0.0f), ImVec2(1.0f, 1.0f), tintColor);
        }
        else
        {
            drawList->AddRectFilled(iconMin, iconMax, IM_COL32(210, 95, 30, 220), 3.0f);
        }

        if (isSelected)
        {
            drawList->AddRect(iconMin, iconMax, IM_COL32(255, 230, 120, 255), 0.0f, 0, 2.0f);
        }
    }
}

void Editor::DrawManualGizmoPivot(
    const ImVec2& viewportOrigin,
    const ImVec2& viewportSize,
    const EditorCamera& camera,
    const Entity* selectedEntity) const
{
    if (!selectedEntity || mActiveGizmo == GizmoType::None) return;

    using namespace DirectX;

    auto projectAxisPoint = [&](const XMFLOAT3& point, ImVec2& screenPoint) -> bool
    {
        return TryProjectWorldToViewport(point, viewportOrigin, viewportSize, camera, screenPoint);
    };

    ImVec2 screenPos;
    if (TryProjectWorldToViewport(selectedEntity->Transform.Position, viewportOrigin, viewportSize, camera, screenPos))
    {
        ImDrawList* dl = ImGui::GetWindowDrawList();
        dl->AddCircleFilled(screenPos, 6.0f, IM_COL32(255, 200, 0, 230));
        dl->AddCircle(screenPos, 6.0f, IM_COL32(0, 0, 0, 220), 0, 2.0f);

        constexpr float desiredAxisScreenLength = 72.0f;
        const XMFLOAT3 origin = selectedEntity->Transform.Position;

        auto projectFixedScreenAxis = [&](const XMFLOAT3& axisWorldDirection, ImVec2& axisScreenEnd, float& axisWorldLength) -> bool
        {
            ImVec2 unitScreenEnd;
            if (!projectAxisPoint(
                    XMFLOAT3(origin.x + axisWorldDirection.x, origin.y + axisWorldDirection.y, origin.z + axisWorldDirection.z),
                    unitScreenEnd))
            {
                return false;
            }

            const ImVec2 unitScreenDirection(unitScreenEnd.x - screenPos.x, unitScreenEnd.y - screenPos.y);
            const float pixelsPerWorldUnit = std::sqrt(unitScreenDirection.x * unitScreenDirection.x + unitScreenDirection.y * unitScreenDirection.y);
            if (pixelsPerWorldUnit <= 0.0001f)
                return false;

            axisWorldLength = desiredAxisScreenLength / pixelsPerWorldUnit;
            return projectAxisPoint(
                XMFLOAT3(
                    origin.x + axisWorldDirection.x * axisWorldLength,
                    origin.y + axisWorldDirection.y * axisWorldLength,
                    origin.z + axisWorldDirection.z * axisWorldLength),
                axisScreenEnd);
        };

        ImVec2 xAxisScreen;
        ImVec2 yAxisScreen;
        ImVec2 zAxisScreen;
        float xAxisWorldLength = 0.0f;
        float yAxisWorldLength = 0.0f;
        float zAxisWorldLength = 0.0f;
        const bool hasXAxis = projectFixedScreenAxis(XMFLOAT3(1.0f, 0.0f, 0.0f), xAxisScreen, xAxisWorldLength);
        const bool hasYAxis = projectFixedScreenAxis(XMFLOAT3(0.0f, 0.0f, 1.0f), yAxisScreen, yAxisWorldLength);
        const bool hasZAxis = projectFixedScreenAxis(XMFLOAT3(0.0f, 1.0f, 0.0f), zAxisScreen, zAxisWorldLength);

        if (mActiveGizmo == GizmoType::Translate || mActiveGizmo == GizmoType::Scale)
        {
            auto drawArrowHead = [&](const ImVec2& start, const ImVec2& end, ImU32 color)
            {
                ImVec2 dir(end.x - start.x, end.y - start.y);
                const float len = std::sqrt(dir.x * dir.x + dir.y * dir.y);
                if (len <= 0.0001f)
                    return;

                dir.x /= len;
                dir.y /= len;
                const ImVec2 perp(-dir.y, dir.x);
                const float arrowSize = 8.0f;
                const ImVec2 left(end.x - dir.x * arrowSize + perp.x * (arrowSize * 0.5f), end.y - dir.y * arrowSize + perp.y * (arrowSize * 0.5f));
                const ImVec2 right(end.x - dir.x * arrowSize - perp.x * (arrowSize * 0.5f), end.y - dir.y * arrowSize - perp.y * (arrowSize * 0.5f));
                dl->AddTriangleFilled(end, left, right, color);
            };

            if (hasXAxis)
            {
                dl->AddLine(screenPos, xAxisScreen, IM_COL32(220, 70, 70, 255), 2.5f);
                drawArrowHead(screenPos, xAxisScreen, IM_COL32(220, 70, 70, 255));
            }
            if (hasYAxis)
            {
                dl->AddLine(screenPos, yAxisScreen, IM_COL32(80, 160, 255, 255), 2.5f);
                drawArrowHead(screenPos, yAxisScreen, IM_COL32(80, 160, 255, 255));
            }
            if (hasZAxis)
            {
                dl->AddLine(screenPos, zAxisScreen, IM_COL32(70, 220, 120, 255), 2.5f);
                drawArrowHead(screenPos, zAxisScreen, IM_COL32(70, 220, 120, 255));
            }

            const float planeHandleScale = 0.35f;
            if (hasXAxis && hasYAxis)
            {
                const ImVec2 xyA(screenPos.x + (xAxisScreen.x - screenPos.x) * planeHandleScale, screenPos.y + (xAxisScreen.y - screenPos.y) * planeHandleScale);
                const ImVec2 xyB(screenPos.x + (yAxisScreen.x - screenPos.x) * planeHandleScale, screenPos.y + (yAxisScreen.y - screenPos.y) * planeHandleScale);
                const ImVec2 xyC(xyA.x + (xyB.x - screenPos.x) * planeHandleScale, xyA.y + (xyB.y - screenPos.y) * planeHandleScale);
                dl->AddTriangleFilled(screenPos, xyA, xyC, IM_COL32(220, 150, 90, 60));
                dl->AddTriangle(screenPos, xyA, xyC, IM_COL32(220, 150, 90, 160), 1.5f);
            }

            if (hasXAxis && hasZAxis)
            {
                const ImVec2 xzA(screenPos.x + (xAxisScreen.x - screenPos.x) * planeHandleScale, screenPos.y + (xAxisScreen.y - screenPos.y) * planeHandleScale);
                const ImVec2 xzB(screenPos.x + (zAxisScreen.x - screenPos.x) * planeHandleScale, screenPos.y + (zAxisScreen.y - screenPos.y) * planeHandleScale);
                const ImVec2 xzC(xzA.x + (xzB.x - screenPos.x) * planeHandleScale, xzA.y + (xzB.y - screenPos.y) * planeHandleScale);
                dl->AddTriangleFilled(screenPos, xzA, xzC, IM_COL32(180, 120, 220, 60));
                dl->AddTriangle(screenPos, xzA, xzC, IM_COL32(180, 120, 220, 160), 1.5f);
            }

            if (hasYAxis && hasZAxis)
            {
                const ImVec2 yzA(screenPos.x + (yAxisScreen.x - screenPos.x) * planeHandleScale, screenPos.y + (yAxisScreen.y - screenPos.y) * planeHandleScale);
                const ImVec2 yzB(screenPos.x + (zAxisScreen.x - screenPos.x) * planeHandleScale, screenPos.y + (zAxisScreen.y - screenPos.y) * planeHandleScale);
                const ImVec2 yzC(yzA.x + (yzB.x - screenPos.x) * planeHandleScale, yzA.y + (yzB.y - screenPos.y) * planeHandleScale);
                dl->AddTriangleFilled(screenPos, yzA, yzC, IM_COL32(120, 200, 220, 60));
                dl->AddTriangle(screenPos, yzA, yzC, IM_COL32(120, 200, 220, 160), 1.5f);
            }
        }

        if (mActiveGizmo == GizmoType::Rotate)
        {
            auto drawProjectedRing = [&](const XMFLOAT3& axisA, float axisALength, const XMFLOAT3& axisB, float axisBLength, ImU32 color)
            {
                constexpr int segmentCount = 48;
                ImVec2 previousPoint{};
                bool hasPreviousPoint = false;

                for (int segmentIndex = 0; segmentIndex <= segmentCount; ++segmentIndex)
                {
                    const float angle = (XM_2PI * static_cast<float>(segmentIndex)) / static_cast<float>(segmentCount);
                    XMFLOAT3 ringPoint(
                        origin.x + axisA.x * std::cos(angle) * axisALength + axisB.x * std::sin(angle) * axisBLength,
                        origin.y + axisA.y * std::cos(angle) * axisALength + axisB.y * std::sin(angle) * axisBLength,
                        origin.z + axisA.z * std::cos(angle) * axisALength + axisB.z * std::sin(angle) * axisBLength);

                    ImVec2 projectedPoint;
                    if (projectAxisPoint(ringPoint, projectedPoint))
                    {
                        if (hasPreviousPoint)
                            dl->AddLine(previousPoint, projectedPoint, color, 2.0f);

                        previousPoint = projectedPoint;
                        hasPreviousPoint = true;
                    }
                    else
                    {
                        hasPreviousPoint = false;
                    }
                }
            };

            drawProjectedRing(XMFLOAT3(0.0f, 0.0f, 1.0f), yAxisWorldLength, XMFLOAT3(0.0f, 1.0f, 0.0f), zAxisWorldLength, IM_COL32(220, 70, 70, 220));
            drawProjectedRing(XMFLOAT3(1.0f, 0.0f, 0.0f), xAxisWorldLength, XMFLOAT3(0.0f, 0.0f, 1.0f), yAxisWorldLength, IM_COL32(70, 220, 120, 220));
            drawProjectedRing(XMFLOAT3(1.0f, 0.0f, 0.0f), xAxisWorldLength, XMFLOAT3(0.0f, 1.0f, 0.0f), zAxisWorldLength, IM_COL32(80, 160, 255, 255));
        }

        if (mActiveGizmo == GizmoType::Scale)
        {
            const float handleSize = 4.0f;
            if (hasXAxis)
                dl->AddRectFilled(ImVec2(xAxisScreen.x - handleSize, xAxisScreen.y - handleSize), ImVec2(xAxisScreen.x + handleSize, xAxisScreen.y + handleSize), IM_COL32(220, 70, 70, 255), 1.0f);
            if (hasYAxis)
                dl->AddRectFilled(ImVec2(yAxisScreen.x - handleSize, yAxisScreen.y - handleSize), ImVec2(yAxisScreen.x + handleSize, yAxisScreen.y + handleSize), IM_COL32(80, 160, 255, 255), 1.0f);
            if (hasZAxis)
                dl->AddRectFilled(ImVec2(zAxisScreen.x - handleSize, zAxisScreen.y - handleSize), ImVec2(zAxisScreen.x + handleSize, zAxisScreen.y + handleSize), IM_COL32(70, 220, 120, 255), 1.0f);
        }
    }
}

