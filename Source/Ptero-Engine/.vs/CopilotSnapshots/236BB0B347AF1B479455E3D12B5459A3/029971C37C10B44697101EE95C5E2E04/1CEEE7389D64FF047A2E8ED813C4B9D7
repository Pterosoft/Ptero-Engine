void Editor::DrawLevelExplorerPanel()
{
    if (!ImGui::Begin("Level Explorer", &mShowLevelExplorerPanel))
    {
        ImGui::End();
        return;
    }

    for (int i = 0; i < static_cast<int>(mEntities.size()); ++i)
