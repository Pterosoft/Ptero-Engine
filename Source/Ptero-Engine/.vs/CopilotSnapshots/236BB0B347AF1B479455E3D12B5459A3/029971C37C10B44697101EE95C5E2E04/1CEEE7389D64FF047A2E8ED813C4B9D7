void Editor::HandleKeyboardShortcuts()
{
    if (ImGui::GetIO().WantTextInput)
        return;

    ImGuiIO& io = ImGui::GetIO();
    HWND windowHandle = DX12Context_GetWindowHandle();

    if (io.KeyCtrl && ImGui::IsKeyPressed(ImGuiKey_N, false))
    {
        NewScene(windowHandle);
        return;
    }

    if (io.KeyCtrl && ImGui::IsKeyPressed(ImGuiKey_O, false))
    {
        OpenScene(windowHandle);
        return;
    }

    if (io.KeyCtrl && ImGui::IsKeyPressed(ImGuiKey_S, false))
    {
        SaveScene(windowHandle);
        return;
    }

    if (ImGui::IsKeyPressed(ImGuiKey_1, false))
        mActiveGizmo = GizmoType::None;

    if (ImGui::IsKeyPressed(ImGuiKey_2, false))
        mActiveGizmo = GizmoType::Translate;

    if (ImGui::IsKeyPressed(ImGuiKey_3, false))
        mActiveGizmo = GizmoType::Rotate;

    if (ImGui::IsKeyPressed(ImGuiKey_4, false))
        mActiveGizmo = GizmoType::Scale;

    if (ImGui::IsKeyPressed(ImGuiKey_Delete, false) && CanDeleteSelectedEntity())
        DeleteSelectedEntity();

    if (io.KeyCtrl && ImGui::IsKeyPressed(ImGuiKey_C, false) && CanCopySelectedEntity())
        CopySelectedEntity();

    if (io.KeyCtrl && ImGui::IsKeyPressed(ImGuiKey_V, false) && CanPasteEntity())
        PasteCopiedEntity();
}

