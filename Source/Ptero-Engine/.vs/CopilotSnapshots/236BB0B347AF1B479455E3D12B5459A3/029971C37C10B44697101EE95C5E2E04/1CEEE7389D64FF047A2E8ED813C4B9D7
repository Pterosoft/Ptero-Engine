        ImGui::TreeNodeEx(reinterpret_cast<void*>(static_cast<intptr_t>(i)), flags,
                          "%s", mEntities[i].Name.c_str());
        if (ImGui::IsItemClicked())
            mSelectedEntityIndex = i;
        ImGui::TreePop();
    }

    ImGui::End();
}

