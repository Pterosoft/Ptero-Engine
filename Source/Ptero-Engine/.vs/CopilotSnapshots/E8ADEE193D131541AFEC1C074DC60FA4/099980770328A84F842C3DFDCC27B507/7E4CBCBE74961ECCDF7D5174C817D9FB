bool RtGlobalIllumination::CreateRootSignature()
{
    ID3D12Device* device = DX12Context_GetDevice();
    if (!device) { mLastError = "RtGlobalIllumination: null device."; return false; }

    // Each of the five root parameters uses a single-descriptor range so any
    // single GPU handle can be bound per pass without re-creating root signatures.
    D3D12_DESCRIPTOR_RANGE srvA{}, srvB{}, uavA{}, uavB{};
    srvA.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;  srvA.NumDescriptors = 1; srvA.BaseShaderRegister = 0;
    srvB.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;  srvB.NumDescriptors = 1; srvB.BaseShaderRegister = 1;
    uavA.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;  uavA.NumDescriptors = 1; uavA.BaseShaderRegister = 0;
    uavB.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;  uavB.NumDescriptors = 1; uavB.BaseShaderRegister = 1;

    D3D12_ROOT_PARAMETER params[5]{};
    // param 0: inline CBV for RtGIConstants
    params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
    params[0].Descriptor.ShaderRegister = 0;
    params[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
    // param 1: t0 SRV table
    params[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
    params[1].DescriptorTable = { 1, &srvA };
    params[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
    // param 2: t1 SRV table
    params[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
    params[2].DescriptorTable = { 1, &srvB };
    params[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
    // param 3: u0 UAV table
    params[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
    params[3].DescriptorTable = { 1, &uavA };
    params[3].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
    // param 4: u1 UAV table
    params[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
    params[4].DescriptorTable = { 1, &uavB };
    params[4].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;

    D3D12_ROOT_SIGNATURE_DESC rsDesc{};
    rsDesc.NumParameters = 5;
    rsDesc.pParameters = params;
    rsDesc.Flags = D3D12_ROOT_SIGNATURE_FLAG_NONE;

    ComPtr<ID3DBlob> serialized, errors;
    if (FAILED(D3D12SerializeRootSignature(&rsDesc, D3D_ROOT_SIGNATURE_VERSION_1, &serialized, &errors)))
    {
        mLastError = "RtGlobalIllumination: failed to serialize root signature.";
        return false;
    }
    if (FAILED(device->CreateRootSignature(
            0, serialized->GetBufferPointer(), serialized->GetBufferSize(),
            IID_PPV_ARGS(&mRootSignature))))
    {
        mLastError = "RtGlobalIllumination: failed to create root signature.";
        return false;
    }
    return true;
}

bool RtGlobalIllumination::CreatePipelines()
{
    ID3D12Device* device = DX12Context_GetDevice();
    if (!device) return false;

    // Compile all four compute shaders from Data/Shaders/ (resolved by DX12ShaderCompiler).
    if (!CompileAndCreatePSO(device, mRootSignature.Get(),
            L"RtGI_RayGen.hlsl",    L"CSMain", mPSO_RayGen,    mLastError)) return false;
    if (!CompileAndCreatePSO(device, mRootSignature.Get(),
            L"RtGI_Temporal.hlsl",  L"CSMain", mPSO_Temporal,  mLastError)) return false;
    if (!CompileAndCreatePSO(device, mRootSignature.Get(),
            L"RtGI_Spatial.hlsl",   L"CSMain", mPSO_Spatial,   mLastError)) return false;
    if (!CompileAndCreatePSO(device, mRootSignature.Get(),
            L"RtGI_Composite.hlsl", L"CSMain", mPSO_Composite, mLastError)) return false;
    return true;
}

bool RtGlobalIllumination::CreateResolutionBuffers()
{
    ID3D12Device* device = DX12Context_GetDevice();
    if (!device) return false;

    const UINT64 pixelCount = static_cast<UINT64>(mWidth) * mHeight;
    const UINT64 reservoirBytes = pixelCount * sizeof(RtGIPackedReservoir);

    // Ping-pong structured buffers for reservoirs.
    mReservoirBuffer[0] = MakeStructuredBuffer(device, reservoirBytes, L"RTGI_Reservoir0");
    mReservoirBuffer[1] = MakeStructuredBuffer(device, reservoirBytes, L"RTGI_Reservoir1");

    // Intermediate radiance (written by RayGen/Temporal/Spatial, read by Composite).
    mRadianceBuffer = MakeTexture2D(device, mWidth, mHeight, L"RTGI_Radiance");

    // Temporal accumulation history (EMA running average).
    mAccumBuffer = MakeTexture2D(device, mWidth, mHeight, L"RTGI_AccumHistory");

    // Final composited output (read as SRV by the deferred lighting pass).
    mOutputBuffer = MakeTexture2D(device, mWidth, mHeight, L"RTGI_Output");

    // Constant buffer (256 bytes, persistently mapped).
    if (!mConstantBuffer)
    {
        mConstantBuffer = MakeConstantBuffer(device, sizeof(RtGIConstants), &mMappedCb);
    }

    // Small non-shader-visible heap for ClearUnorderedAccessView calls if needed later.
    if (!mCpuUavHeap)
    {
        D3D12_DESCRIPTOR_HEAP_DESC heapDesc{};
        heapDesc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
        heapDesc.NumDescriptors = 8;
        heapDesc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_NONE;
        DX12_THROW_IF_FAILED(device->CreateDescriptorHeap(&heapDesc, IID_PPV_ARGS(&mCpuUavHeap)));
    }

    return true;
}

bool RtGlobalIllumination::CreateDescriptors()
{
    ID3D12Device* device = DX12Context_GetDevice();
    if (!device) return false;

    const UINT stride = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
    const UINT pixelCount = mWidth * mHeight;

    // ---- Reservoir 0 ----
    if (!mDescriptorsAllocated)
    {
        // Allocate all shader-visible handles once; they remain stable because
        // we never free from the shared heap.
        if (!AllocDescriptor(mReservoirSrvCpu[0], mReservoirSrvGpu[0], mLastError)) return false;
        if (!AllocDescriptor(mReservoirUavCpu[0], mReservoirUavGpu[0], mLastError)) return false;
        if (!AllocDescriptor(mReservoirSrvCpu[1], mReservoirSrvGpu[1], mLastError)) return false;
        if (!AllocDescriptor(mReservoirUavCpu[1], mReservoirUavGpu[1], mLastError)) return false;
        if (!AllocDescriptor(mRadianceSrvCpu,     mRadianceSrvGpu,     mLastError)) return false;
        if (!AllocDescriptor(mRadianceUavCpu,     mRadianceUavGpu,     mLastError)) return false;
        if (!AllocDescriptor(mAccumSrvCpu,        mAccumSrvGpu,        mLastError)) return false;
        if (!AllocDescriptor(mAccumUavCpu,        mAccumUavGpu,        mLastError)) return false;
        if (!AllocDescriptor(mOutputSrvCpu,       mOutputSrvGpu,       mLastError)) return false;
        if (!AllocDescriptor(mOutputUavCpu,       mOutputUavGpu,       mLastError)) return false;
        mDescriptorsAllocated = true;
    }

    // ---- (Re-)fill descriptors with the new resources ----
    D3D12_SHADER_RESOURCE_VIEW_DESC srvDesc{};
    srvDesc.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
    srvDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
    srvDesc.Format = DXGI_FORMAT_UNKNOWN;
    srvDesc.Buffer.StructureByteStride = sizeof(RtGIPackedReservoir);
    srvDesc.Buffer.NumElements = pixelCount;

    D3D12_UNORDERED_ACCESS_VIEW_DESC uavDesc{};
    uavDesc.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
    uavDesc.Format = DXGI_FORMAT_UNKNOWN;
    uavDesc.Buffer.StructureByteStride = sizeof(RtGIPackedReservoir);
    uavDesc.Buffer.NumElements = pixelCount;

    for (int i = 0; i < 2; ++i)
    {
        device->CreateShaderResourceView(mReservoirBuffer[i].Get(), &srvDesc, mReservoirSrvCpu[i]);
        device->CreateUnorderedAccessView(mReservoirBuffer[i].Get(), nullptr, &uavDesc, mReservoirUavCpu[i]);
    }

    // Radiance texture SRV/UAV.
    D3D12_SHADER_RESOURCE_VIEW_DESC texSrv{};
    texSrv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
    texSrv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
    texSrv.Format = kGIFormat;
    texSrv.Texture2D.MipLevels = 1;

    D3D12_UNORDERED_ACCESS_VIEW_DESC texUav{};
    texUav.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
    texUav.Format = kGIFormat;

    device->CreateShaderResourceView(mRadianceBuffer.Get(),  &texSrv, mRadianceSrvCpu);
    device->CreateUnorderedAccessView(mRadianceBuffer.Get(), nullptr, &texUav, mRadianceUavCpu);

    device->CreateShaderResourceView(mAccumBuffer.Get(),     &texSrv, mAccumSrvCpu);
    device->CreateUnorderedAccessView(mAccumBuffer.Get(),    nullptr, &texUav, mAccumUavCpu);

    device->CreateShaderResourceView(mOutputBuffer.Get(),    &texSrv, mOutputSrvCpu);
    device->CreateUnorderedAccessView(mOutputBuffer.Get(),   nullptr, &texUav, mOutputUavCpu);

    return true;
}

void RtGlobalIllumination::UploadConstants(
    const RtGISettings& s,
    const float viewProjInv[16],
    const float prevViewProj[16],
    const float cameraPos[3])
{
    RtGIConstants cb{};
    cb.FrameWidth           = mWidth;
    cb.FrameHeight          = mHeight;
    cb.FrameIndex           = mFrameIndex;
    cb.RaysPerPixel         = static_cast<uint32_t>(s.RaysPerPixel);
    cb.MaxHistoryLength     = static_cast<uint32_t>(s.MaxHistoryLength);
    cb.SpatialSamples       = static_cast<uint32_t>(s.SpatialSamples);
    cb.SpatialRadius        = s.SpatialRadius;
    cb.DepthThreshold       = s.DepthThreshold;
    cb.NormalThreshold      = s.NormalThreshold;
    cb.RadianceClamp        = s.RadianceClamp;
    cb.AccumulationBlend    = s.AccumulationBlend;
    cb.MaxBounces           = s.MaxBounces;
    cb.DebugView            = s.DebugView ? 1 : 0;
    cb.TemporalReuseEnabled = s.TemporalReuseEnabled ? 1 : 0;
    cb.SpatialReuseEnabled  = s.SpatialReuseEnabled  ? 1 : 0;
    std::memcpy(cb.ViewProjInv,  viewProjInv,  sizeof(float) * 16);
    std::memcpy(cb.PrevViewProj, prevViewProj, sizeof(float) * 16);
    std::memcpy(cb.CameraPos,    cameraPos,    sizeof(float) * 3);
    std::memcpy(mMappedCb, &cb, sizeof(cb));
}
