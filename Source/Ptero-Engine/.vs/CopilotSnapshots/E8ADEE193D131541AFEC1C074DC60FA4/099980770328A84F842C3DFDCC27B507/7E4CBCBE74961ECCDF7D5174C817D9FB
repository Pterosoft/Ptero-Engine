bool RtGlobalIllumination::Initialize(UINT width, UINT height)
{
    if (width == 0 || height == 0)
        return false;

    mLastError.clear();
    try
    {
        if (!mIsInitialized)
        {
            if (!CreateRootSignature()) return false;
            if (!CreatePipelines())    return false;
        }

        if (!mIsInitialized || width != mWidth || height != mHeight)
        {
            // Set dimensions before CreateResolutionBuffers so helpers can use mWidth/mHeight.
            mWidth  = width;
            mHeight = height;
            if (!CreateResolutionBuffers()) return false;
            if (!CreateDescriptors()) return false;
        }

        mIsInitialized = true;
        return true;
    }
    catch (const std::exception& ex)
    {
        mLastError = std::string("RtGlobalIllumination::Initialize: ") + ex.what();
        mInitFailed = true;
        return false;
    }
}

bool RtGlobalIllumination::EnsureSize(UINT width, UINT height)
{
    if (width == mWidth && height == mHeight)
        return true;
    return Initialize(width, height);
}

void RtGlobalIllumination::Shutdown()
{
    if (mMappedCb && mConstantBuffer)
    {
        mConstantBuffer->Unmap(0, nullptr);
        mMappedCb = nullptr;
    }
    mConstantBuffer.Reset();
    mReservoirBuffer[0].Reset();
    mReservoirBuffer[1].Reset();
    mRadianceBuffer.Reset();
    mAccumBuffer.Reset();
    mOutputBuffer.Reset();
    mCpuUavHeap.Reset();
    mRootSignature.Reset();
    mPSO_RayGen.Reset();
    mPSO_Temporal.Reset();
    mPSO_Spatial.Reset();
    mPSO_Composite.Reset();
    mIsInitialized = false;
    mDescriptorsAllocated = false;
}

// -----------------------------------------------------------------------
// Dispatch
// -----------------------------------------------------------------------

void RtGlobalIllumination::Dispatch(
    ID3D12GraphicsCommandList4*  cmdList,
    D3D12_GPU_DESCRIPTOR_HANDLE  gbufferAlbedoSrv,
    D3D12_GPU_DESCRIPTOR_HANDLE  gbufferNormalDepthSrv,
    const RtGISettings&          settings,
    const float                  viewProjInv[16],
    const float                  prevViewProj[16],
    const float                  cameraPos[3])
{
    UploadConstants(settings, viewProjInv, prevViewProj, cameraPos);

    // Thread group counts for the full frame.
    const UINT gx = (mWidth  + kGroupSizeX - 1) / kGroupSizeX;
    const UINT gy = (mHeight + kGroupSizeY - 1) / kGroupSizeY;

    // Current write and read reservoir indices (alternating each frame).
    const UINT writeIdx = mReservoirWriteIdx;
    const UINT readIdx  = 1u - writeIdx;

    cmdList->SetComputeRootSignature(mRootSignature.Get());
    cmdList->SetComputeRootConstantBufferView(0, mConstantBuffer->GetGPUVirtualAddress());

    // ---- UAV barrier helper (inline lambda) --------------------------------
    auto UavBarrier = [&](ID3D12Resource* resource) {
        auto barrier = CD3DX12_RESOURCE_BARRIER::UAV(resource);
        cmdList->ResourceBarrier(1, &barrier);
    };

    // -----------------------------------------------------------------------
    // Pass 0 - RayGen: fire GI rays, write initial reservoirs + raw radiance
    //   t0 = Albedo G-Buffer SRV (from DeferredLightingPass)
    //   t1 = NormalDepth G-Buffer SRV
    //   u0 = write reservoir buffer
    //   u1 = radiance texture (UAV)
    // -----------------------------------------------------------------------
    cmdList->SetPipelineState(mPSO_RayGen.Get());
    SetTable(cmdList, 1, gbufferAlbedoSrv);
    SetTable(cmdList, 2, gbufferNormalDepthSrv);
    SetTable(cmdList, 3, mReservoirUavGpu[writeIdx]);
    SetTable(cmdList, 4, mRadianceUavGpu);
    cmdList->Dispatch(gx, gy, 1);

    UavBarrier(mReservoirBuffer[writeIdx].Get());
    UavBarrier(mRadianceBuffer.Get());

    // -----------------------------------------------------------------------
    // Pass 1 - Temporal resampling (ReSTIR temporal pass)
    //   t0 = current-frame reservoir (written by RayGen)
    //   t1 = previous-frame reservoir (from last frame's write buffer)
    //   u0 = temporal output reservoir (we use the read buffer as scratch)
    //   u1 = radiance texture (updated with temporally resampled radiance)
    // -----------------------------------------------------------------------
    if (settings.TemporalReuseEnabled)
    {
        cmdList->SetPipelineState(mPSO_Temporal.Get());
        SetTable(cmdList, 1, mReservoirSrvGpu[writeIdx]);
        SetTable(cmdList, 2, mReservoirSrvGpu[readIdx]);
        SetTable(cmdList, 3, mReservoirUavGpu[readIdx]);   // overwrite old read buffer with merged result
        SetTable(cmdList, 4, mRadianceUavGpu);
        cmdList->Dispatch(gx, gy, 1);

        UavBarrier(mReservoirBuffer[readIdx].Get());
        UavBarrier(mRadianceBuffer.Get());
    }

    // After temporal pass, the "merged" reservoir lives in readIdx buffer.
    // Spatial pass reads from it.
    const UINT spatialReadIdx = settings.TemporalReuseEnabled ? readIdx : writeIdx;

    // -----------------------------------------------------------------------
    // Pass 2 - Spatial resampling (ReSTIR spatial pass)
    //   t0 = merged reservoir (temporal output or raw if temporal disabled)
    //   t1 = NormalDepth G-Buffer (geometry similarity test)
    //   u0 = spatially resampled reservoir (write to the opposite buffer)
    //   u1 = radiance (updated with spatially resampled radiance)
    // -----------------------------------------------------------------------
    if (settings.SpatialReuseEnabled)
    {
        const UINT spatialWriteIdx = 1u - spatialReadIdx;
        cmdList->SetPipelineState(mPSO_Spatial.Get());
        SetTable(cmdList, 1, mReservoirSrvGpu[spatialReadIdx]);
        SetTable(cmdList, 2, gbufferNormalDepthSrv);
        SetTable(cmdList, 3, mReservoirUavGpu[spatialWriteIdx]);
        SetTable(cmdList, 4, mRadianceUavGpu);
        cmdList->Dispatch(gx, gy, 1);

        UavBarrier(mReservoirBuffer[spatialWriteIdx].Get());
        UavBarrier(mRadianceBuffer.Get());
    }

    // -----------------------------------------------------------------------
    // Pass 3 - Composite: temporal accumulation EMA + final output
    //   t0 = radiance texture (current frame ReSTIR output)
    //   t1 = accumulation history (previous frame EMA)
    //   u0 = updated accumulation buffer (write)
    //   u1 = final GI output (read by deferred lighting pass as t5)
    // -----------------------------------------------------------------------
    cmdList->SetPipelineState(mPSO_Composite.Get());
    SetTable(cmdList, 1, mRadianceSrvGpu);
    SetTable(cmdList, 2, mAccumSrvGpu);
    SetTable(cmdList, 3, mAccumUavGpu);
    SetTable(cmdList, 4, mOutputUavGpu);
    cmdList->Dispatch(gx, gy, 1);

    UavBarrier(mAccumBuffer.Get());
    UavBarrier(mOutputBuffer.Get());

    // Advance ping-pong index for next frame.
    mReservoirWriteIdx = 1u - mReservoirWriteIdx;
    ++mFrameIndex;
}

