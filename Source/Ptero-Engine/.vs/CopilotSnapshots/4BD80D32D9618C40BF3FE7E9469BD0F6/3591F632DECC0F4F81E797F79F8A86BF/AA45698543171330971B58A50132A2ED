    constexpr UINT AlignUp(UINT value, UINT alignment)
    {
        return (value + alignment - 1u) & ~(alignment - 1u);
    }

    // Load the pre-compiled DXIL library (RtGI.dxil) from the same directory
    // as this module.  The file is produced at build time by the custom build
    // step: dxc.exe -T lib_6_3 -Fo RtGI.dxil RtGI.hlsl
    std::vector<uint8_t> LoadPrecompiledDxil()
    {
        wchar_t mp[MAX_PATH]{};
        HMODULE hm = nullptr;
        GetModuleHandleExW(
            GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
            reinterpret_cast<LPCWSTR>(&LoadPrecompiledDxil), &hm);
        GetModuleFileNameW(hm, mp, MAX_PATH);
        namespace fs = std::filesystem;
        fs::path dxilPath = fs::path(mp).parent_path() / L"RtGI.dxil";

        std::ifstream f(dxilPath, std::ios::binary | std::ios::ate);
        if (!f.is_open())
            throw std::runtime_error("RtGI: could not open RtGI.dxil (expected next to Renderer_DX12.dll)");
        const auto size = static_cast<std::streamsize>(f.tellg());
        f.seekg(0);
        std::vector<uint8_t> buf(static_cast<size_t>(size));
        f.read(reinterpret_cast<char*>(buf.data()), size);
        return buf;
    }

    // Create a GPU-only (DEFAULT heap) buffer.
    bool CreateGpuBuffer(ID3D12Device* dev, UINT64 size,
        D3D12_RESOURCE_FLAGS flags, D3D12_RESOURCE_STATES state,
        ComPtr<ID3D12Resource>& out)
    {
        D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
        D3D12_RESOURCE_DESC d{};
        d.Dimension          = D3D12_RESOURCE_DIMENSION_BUFFER;
        d.Width              = size; d.Height = 1; d.DepthOrArraySize = 1; d.MipLevels = 1;
        d.Format             = DXGI_FORMAT_UNKNOWN; d.SampleDesc.Count = 1;
        d.Layout             = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; d.Flags = flags;
        return SUCCEEDED(dev->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &d, state, nullptr, IID_PPV_ARGS(&out)));
    }

    // Create a CPU-writable UPLOAD heap buffer.
    bool CreateUploadBuf(ID3D12Device* dev, UINT64 size, ComPtr<ID3D12Resource>& out)
    {
        D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
        D3D12_RESOURCE_DESC d{};
        d.Dimension          = D3D12_RESOURCE_DIMENSION_BUFFER;
        d.Width              = size; d.Height = 1; d.DepthOrArraySize = 1; d.MipLevels = 1;
        d.Format             = DXGI_FORMAT_UNKNOWN; d.SampleDesc.Count = 1;
        d.Layout             = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; d.Flags = D3D12_RESOURCE_FLAG_NONE;
        return SUCCEEDED(dev->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &d,
            D3D12_RESOURCE_STATE_GENERIC_READ, nullptr, IID_PPV_ARGS(&out)));
    }

    bool CreateReadbackBuffer(ID3D12Device* dev, UINT64 size, ComPtr<ID3D12Resource>& out)
    {
        D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_READBACK;
        D3D12_RESOURCE_DESC d{};
        d.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
        d.Width = size; d.Height = 1; d.DepthOrArraySize = 1; d.MipLevels = 1;
        d.Format = DXGI_FORMAT_UNKNOWN; d.SampleDesc.Count = 1;
        d.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; d.Flags = D3D12_RESOURCE_FLAG_NONE;
        return SUCCEEDED(dev->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &d,
            D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&out)));
    }

    // Create a RGBA16F 2-D texture.
    bool CreateRgba16Tex(ID3D12Device* dev, UINT w, UINT h,
        D3D12_RESOURCE_FLAGS flags, D3D12_RESOURCE_STATES state,
        ComPtr<ID3D12Resource>& out)
    {
        D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
        D3D12_RESOURCE_DESC d{};
        d.Dimension          = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
        d.Width              = w; d.Height = h; d.DepthOrArraySize = 1; d.MipLevels = 1;
        d.Format             = DXGI_FORMAT_R16G16B16A16_FLOAT; d.SampleDesc.Count = 1;
        d.Layout             = D3D12_TEXTURE_LAYOUT_UNKNOWN; d.Flags = flags;
        return SUCCEEDED(dev->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &d, state, nullptr, IID_PPV_ARGS(&out)));
    }
} // anonymous namespace

// ---------------------------------------------------------------------------
// File-local: compute the average base colour of a DDS texture by decoding
// the smallest mip level.  Supports BC1 (DXT1) and BC3 (DXT5) compressed
// formats, plus uncompressed R8G8B8A8 — which covers virtually all Sponza
// diffuse textures.  Returns {1,1,1,1} on failure.
// ---------------------------------------------------------------------------
static DirectX::XMFLOAT4 AverageDdsColor(const std::string& absPath)
{
    if (absPath.empty()) return { 1.f, 1.f, 1.f, 1.f };

    std::ifstream f(absPath, std::ios::binary | std::ios::ate);
    if (!f.is_open()) return { 1.f, 1.f, 1.f, 1.f };
    const auto fileSize = static_cast<size_t>(f.tellg());
    if (fileSize < 128) return { 1.f, 1.f, 1.f, 1.f };
    f.seekg(0);
    std::vector<uint8_t> buf(fileSize);
    f.read(reinterpret_cast<char*>(buf.data()), static_cast<std::streamsize>(fileSize));

    // Validate DDS magic.
    if (buf[0] != 'D' || buf[1] != 'D' || buf[2] != 'S' || buf[3] != ' ')
        return { 1.f, 1.f, 1.f, 1.f };

    const auto readU32 = [&](size_t off) -> uint32_t {
        return static_cast<uint32_t>(buf[off]) |
               (static_cast<uint32_t>(buf[off+1]) << 8) |
               (static_cast<uint32_t>(buf[off+2]) << 16) |
               (static_cast<uint32_t>(buf[off+3]) << 24);
    };

    const uint32_t width    = readU32(16);
    const uint32_t height   = readU32(12);
    const uint32_t mipCount = readU32(28);
    const uint32_t fourCC   = readU32(84); // DDPF_FOURCC at offset 84

    // Determine format: FourCC 'DXT1' = BC1, 'DXT3' = BC2, 'DXT5' = BC3
    const bool isBC1 = (fourCC == 0x31545844u); // 'DXT1'
    const bool isBC3 = (fourCC == 0x35545844u); // 'DXT5'
    const bool isBC2 = (fourCC == 0x33545844u); // 'DXT3'
    const uint32_t pixelFlags = readU32(80);     // DDPF flags
    const bool isUncompressed = !(pixelFlags & 0x4u); // no DDPF_FOURCC

    if (!isBC1 && !isBC2 && !isBC3 && !isUncompressed)
        return { 1.f, 1.f, 1.f, 1.f }; // unsupported format

    // Seek to the smallest mip by summing mip sizes.
    const uint32_t blockBytes = isBC1 ? 8u : 16u;
    size_t dataOffset = 128;
    uint32_t mw = width, mh = height;
    const uint32_t effectiveMips = (mipCount > 0) ? mipCount : 1u;
    for (uint32_t m = 0; m + 1 < effectiveMips; ++m)
    {
        size_t mipBytes = 0;
        if (isBC1 || isBC2 || isBC3)
        {
            const uint32_t bw = (std::max)(1u, (mw + 3u) / 4u);
            const uint32_t bh = (std::max)(1u, (mh + 3u) / 4u);
            mipBytes = static_cast<size_t>(bw) * bh * blockBytes;
        }
        else
        {
            // Assume RGBA8 / BGRA8 (4 bytes/pixel) for uncompressed.
            mipBytes = static_cast<size_t>(mw) * mh * 4;
        }
        dataOffset += mipBytes;
        mw = (std::max)(1u, mw / 2u);
        mh = (std::max)(1u, mh / 2u);
    }

    if (dataOffset >= fileSize) return { 1.f, 1.f, 1.f, 1.f };

    // Average all pixels / blocks in the smallest mip.
    float rSum = 0.f, gSum = 0.f, bSum = 0.f;
    uint32_t sampleCount = 0;

    if (isBC1 || isBC2 || isBC3)
    {
        // For BC1/BC2/BC3 we decode the two endpoint colors of every block and average them.
        const uint32_t bw = (std::max)(1u, (mw + 3u) / 4u);
        const uint32_t bh = (std::max)(1u, (mh + 3u) / 4u);
        const size_t numBlocks = static_cast<size_t>(bw) * bh;

        for (size_t b = 0; b < numBlocks; ++b)
        {
            // For BC3/BC2 the first 8 bytes are alpha/alpha-data; color block follows.
            size_t colorOff = dataOffset + b * blockBytes + (isBC1 ? 0 : 8);
            if (colorOff + 4 > fileSize) break;

            const uint16_t c0 = static_cast<uint16_t>(buf[colorOff]) |
                                (static_cast<uint16_t>(buf[colorOff+1]) << 8);
            const uint16_t c1 = static_cast<uint16_t>(buf[colorOff+2]) |
                                (static_cast<uint16_t>(buf[colorOff+3]) << 8);

            // Decode RGB565 -> linear float.
            // sRGB-to-linear approximation: (v/255)^2.2 ≈ (v/255)*(v/255) for a quick estimate.
            auto r565 = [](uint16_t c) -> float { return ((c >> 11) & 0x1Fu) / 31.f; };
            auto g565 = [](uint16_t c) -> float { return ((c >>  5) & 0x3Fu) / 63.f; };
            auto b565 = [](uint16_t c) -> float { return  (c        & 0x1Fu) / 31.f; };

            rSum += r565(c0) + r565(c1);
            gSum += g565(c0) + g565(c1);
            bSum += b565(c0) + b565(c1);
            sampleCount += 2;
        }
    }
    else
    {
        // Uncompressed: sample every pixel (assumed RGBA8 or BGRA8, 4 bytes each).
        const uint32_t pixelCount = (std::max)(1u, mw) * (std::max)(1u, mh);
        for (uint32_t p = 0; p < pixelCount; ++p)
        {
            size_t pOff = dataOffset + static_cast<size_t>(p) * 4;
            if (pOff + 3 >= fileSize) break;
            rSum += buf[pOff + 0] / 255.f;
            gSum += buf[pOff + 1] / 255.f;
            bSum += buf[pOff + 2] / 255.f;
            ++sampleCount;
        }
    }

    if (sampleCount == 0) return { 1.f, 1.f, 1.f, 1.f };
    const float inv = 1.f / static_cast<float>(sampleCount);
    return { rSum * inv, gSum * inv, bSum * inv, 1.f };
}

// ---------------------------------------------------------------------------
// File-local: load per-submesh base-color tints from a material JSON file.
// For each submesh materialId, reads the average colour from the base-color
// DDS texture (smallest mip decode).  Falls back to white if no texture path
// is present or the file cannot be opened.
// ---------------------------------------------------------------------------
static std::unordered_map<uint32_t, DirectX::XMFLOAT4>
LoadMaterialTints(const std::string& materialPath)
{
    std::unordered_map<uint32_t, DirectX::XMFLOAT4> result;
    if (materialPath.empty()) return result;

    // Resolve a Data-relative path string to an absolute path by walking up
    // from the given base file/directory to find the 'Data' folder.
    auto resolveDataPath = [](const std::string& relPath, const std::string& near) -> std::string
    {
        if (relPath.empty()) return {};
        namespace fs = std::filesystem;
        fs::path current = fs::path(near).parent_path();
        while (!current.empty())
        {
            fs::path candidate = current.parent_path() / "Data" / relPath;
            if (fs::exists(candidate)) return candidate.string();
            candidate = current / relPath;
            if (current.filename() == "Data" && fs::exists(candidate))
                return candidate.string();
            const auto parent = current.parent_path();
            if (parent == current) break;
            current = parent;
        }
        return {};
    };

    auto baseColorFromNode = [&](const nlohmann::json& node, uint32_t id)
    {
        auto texIt = node.find("textures");
        if (texIt == node.end()) return;
        auto bcIt = texIt->find("baseColor");
        if (bcIt == texIt->end()) return;
        const std::string relPath = bcIt->get<std::string>();
        if (relPath.empty()) return;
        const std::string absPath = resolveDataPath(relPath, materialPath);
        if (absPath.empty()) return;
        result[id] = AverageDdsColor(absPath);
    };

    try
    {
        std::ifstream f{ materialPath };
        if (!f.is_open()) return result;
        nlohmann::json j;
        f >> j;

        const std::string type = j.value("type", std::string{});
        if (type == "MultiMaterial")
        {
            auto subMatsIt = j.find("subMaterials");
            if (subMatsIt != j.end() && subMatsIt->is_array())
            {
                uint32_t id = 0;
                for (const auto& subMat : *subMatsIt)
                {
                    baseColorFromNode(subMat, id);
                    ++id;
                }
            }
        }
        else
        {
            baseColorFromNode(j, 0u);
        }
    }
    catch (...) {}

    return result;
}



// ---------------------------------------------------------------------------
// Public: Initialize
// ---------------------------------------------------------------------------
bool RtGlobalIllumination::Initialize(UINT width, UINT height)
{
    mLastError.clear();
    mIsInitialized = false;
    // Don't reset mInitFailed here so callers can still query the last error.
    OutputDebugStringA("RtGI::Initialize - CheckDxrSupport\n");
    if (!CheckDxrSupport())        { mInitFailed = true; return false; }
    OutputDebugStringA("RtGI::Initialize - CreateOutputTextures\n");
    if (!CreateOutputTextures(width, height)) { mInitFailed = true; return false; }
    OutputDebugStringA("RtGI::Initialize - CreateConstantBuffer\n");
    if (!CreateConstantBuffer())   { mInitFailed = true; return false; }
    OutputDebugStringA("RtGI::Initialize - CreateDxrPipeline\n");
    if (!CreateDxrPipeline())      { mInitFailed = true; return false; }
    OutputDebugStringA("RtGI::Initialize - CreateShaderTable\n");
    if (!CreateShaderTable())      { mInitFailed = true; return false; }
    OutputDebugStringA("RtGI::Initialize - SUCCESS\n");
    mInitFailed    = false;
    mIsInitialized = true;
    return true;
}

bool RtGlobalIllumination::EnsureSize(UINT width, UINT height)
{
    if (width == mWidth && height == mHeight) return true;
    return CreateOutputTextures(width, height);
}

bool RtGlobalIllumination::EnsureRtGeometryBuffers(UINT vertexCount, UINT indexCount, UINT instanceCount)
{
    const UINT requiredVertexCount = (std::max)(vertexCount, 1u);
    const UINT requiredIndexCount = (std::max)(indexCount, 1u);
    const UINT requiredInstanceCount = (std::max)(instanceCount, 1u);
    bool recreateVertexSrv = false;
    bool recreateIndexSrv = false;
    bool recreateInstanceSrv = false;

    if (!mRtVertexBuffer || mRtVertexCapacity < requiredVertexCount)
    {
        mRtVertexBuffer.Reset();
        mRtVertexCapacity = AlignUp(requiredVertexCount * 2u + 64u, 256u);
        if (!CreateUploadBuf(mDevice5.Get(), UINT64(mRtVertexCapacity) * sizeof(RtVertexGpu), mRtVertexBuffer))
        {
            mLastError = "RtGI: failed to allocate RT vertex buffer.";
            return false;
        }
        recreateVertexSrv = true;
    }

    if (!mRtIndexBuffer || mRtIndexCapacity < requiredIndexCount)
    {
        mRtIndexBuffer.Reset();
        mRtIndexCapacity = AlignUp(requiredIndexCount * 2u + 256u, 512u);
        if (!CreateUploadBuf(mDevice5.Get(), UINT64(mRtIndexCapacity) * sizeof(std::uint32_t), mRtIndexBuffer))
        {
            mLastError = "RtGI: failed to allocate RT index buffer.";
            return false;
        }
        recreateIndexSrv = true;
    }

    if (!mRtInstanceBuffer || mRtInstanceCapacity < requiredInstanceCount)
    {
        mRtInstanceBuffer.Reset();
        mRtInstanceCapacity = AlignUp(requiredInstanceCount * 2u + 16u, 64u);
        if (!CreateUploadBuf(mDevice5.Get(), UINT64(mRtInstanceCapacity) * sizeof(RtInstanceGpu), mRtInstanceBuffer))
        {
            mLastError = "RtGI: failed to allocate RT instance buffer.";
            return false;
        }
        recreateInstanceSrv = true;
    }

    ID3D12Device* dev = mDevice5.Get();
    if (dev && recreateVertexSrv && mRtVertexSrvCpu.ptr != 0)
    {
        D3D12_SHADER_RESOURCE_VIEW_DESC vertexSrvDesc{};
        vertexSrvDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
        vertexSrvDesc.Format = DXGI_FORMAT_UNKNOWN;
        vertexSrvDesc.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
        vertexSrvDesc.Buffer.FirstElement = 0;
        vertexSrvDesc.Buffer.NumElements = mRtVertexCapacity;
        vertexSrvDesc.Buffer.StructureByteStride = sizeof(RtVertexGpu);
        vertexSrvDesc.Buffer.Flags = D3D12_BUFFER_SRV_FLAG_NONE;
        dev->CreateShaderResourceView(mRtVertexBuffer.Get(), &vertexSrvDesc, mRtVertexSrvCpu);
    }

    if (dev && recreateIndexSrv && mRtIndexSrvCpu.ptr != 0)
    {
        D3D12_SHADER_RESOURCE_VIEW_DESC indexSrvDesc{};
        indexSrvDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
        indexSrvDesc.Format = DXGI_FORMAT_R32_TYPELESS;
        indexSrvDesc.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
        indexSrvDesc.Buffer.FirstElement = 0;
        indexSrvDesc.Buffer.NumElements = mRtIndexCapacity;
        indexSrvDesc.Buffer.StructureByteStride = 0;
        indexSrvDesc.Buffer.Flags = D3D12_BUFFER_SRV_FLAG_RAW;
        dev->CreateShaderResourceView(mRtIndexBuffer.Get(), &indexSrvDesc, mRtIndexSrvCpu);
    }

    if (dev && recreateInstanceSrv && mRtInstanceSrvCpu.ptr != 0)
    {
        D3D12_SHADER_RESOURCE_VIEW_DESC instanceSrvDesc{};
        instanceSrvDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
        instanceSrvDesc.Format = DXGI_FORMAT_UNKNOWN;
        instanceSrvDesc.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
        instanceSrvDesc.Buffer.FirstElement = 0;
        instanceSrvDesc.Buffer.NumElements = mRtInstanceCapacity;
        instanceSrvDesc.Buffer.StructureByteStride = sizeof(RtInstanceGpu);
        instanceSrvDesc.Buffer.Flags = D3D12_BUFFER_SRV_FLAG_NONE;
        dev->CreateShaderResourceView(mRtInstanceBuffer.Get(), &instanceSrvDesc, mRtInstanceSrvCpu);
    }

    return true;
}

// ---------------------------------------------------------------------------
// Public: BuildTlas
// Builds BLASes for any new mesh and rebuilds the TLAS from all current entities.
// ---------------------------------------------------------------------------
void RtGlobalIllumination::BuildTlas(
    ID3D12GraphicsCommandList4* cmdList4,
    const std::vector<Entity>&  entities)
{
    if (!mIsInitialized || !mDevice5) return;
    mTlasBuiltThisFrame = false;

    // Release any upload buffers from the previous frame now that the GPU is done with them.
    // (FlushPendingUploads() can also be called explicitly after a GPU fence wait.)
    mPendingUploads.clear();

    std::vector<D3D12_RAYTRACING_INSTANCE_DESC> instanceDescs;
    // Only rebuilt when a new BLAS is added (mRtGeometryDirty); otherwise the
    // existing upload buffers still hold valid data from the last dirty frame.
    std::vector<RtVertexGpu> rtVertices;
    std::vector<std::uint32_t> rtIndices;
    std::vector<RtInstanceGpu> rtInstances;
    bool anyNewBlas = false;

    for (std::size_t i = 0; i < entities.size(); ++i)
    {
        const Entity& entity = entities[i];
        if (!entity.HasMeshComponent() || !entity.Mesh.has_value() || !entity.Mesh->MeshAsset) continue;

        const Mesh* mesh    = entity.Mesh->MeshAsset.get();
        const void* meshKey = mesh;

        // Build a BLAS for this mesh if not already cached.
        if (mBlasCache.find(meshKey) == mBlasCache.end())
        {
            const auto& verts   = mesh->GetVertices();
            const auto& indices = mesh->GetIndices();
            if (verts.empty() || indices.empty()) continue;

            const UINT64 vbSize = verts.size()   * sizeof(Vertex);
            const UINT64 ibSize = indices.size()  * sizeof(uint32_t);

            // Upload geometry into temporary upload buffers for the AS build.
            ComPtr<ID3D12Resource> vbUp, ibUp;
            if (!CreateUploadBuf(mDevice5.Get(), vbSize, vbUp)) continue;
            if (!CreateUploadBuf(mDevice5.Get(), ibSize, ibUp)) continue;

            void* m = nullptr;
            if (FAILED(vbUp->Map(0, nullptr, &m)) || !m) continue;
            memcpy(m, verts.data(), vbSize); vbUp->Unmap(0, nullptr); m = nullptr;
            if (FAILED(ibUp->Map(0, nullptr, &m)) || !m) continue;
            memcpy(m, indices.data(), ibSize); ibUp->Unmap(0, nullptr);

            BlasEntry& e = mBlasCache[meshKey];

            D3D12_RAYTRACING_GEOMETRY_DESC geom{};
            geom.Type  = D3D12_RAYTRACING_GEOMETRY_TYPE_TRIANGLES;
            geom.Flags = D3D12_RAYTRACING_GEOMETRY_FLAG_OPAQUE;
            geom.Triangles.VertexBuffer.StartAddress  = vbUp->GetGPUVirtualAddress();
            geom.Triangles.VertexBuffer.StrideInBytes = sizeof(Vertex);
            geom.Triangles.VertexFormat               = DXGI_FORMAT_R32G32B32_FLOAT;
            geom.Triangles.VertexCount                = static_cast<UINT>(verts.size());
            geom.Triangles.IndexBuffer                = ibUp->GetGPUVirtualAddress();
            geom.Triangles.IndexFormat                = DXGI_FORMAT_R32_UINT;
            geom.Triangles.IndexCount                 = static_cast<UINT>(indices.size());

            D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS inp{};
            inp.Type           = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL;
            inp.Flags          = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE;
            inp.NumDescs       = 1;
            inp.DescsLayout    = D3D12_ELEMENTS_LAYOUT_ARRAY;
            inp.pGeometryDescs = &geom;

            D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO pre{};
            mDevice5->GetRaytracingAccelerationStructurePrebuildInfo(&inp, &pre);

            if (!CreateGpuBuffer(mDevice5.Get(), pre.ScratchDataSizeInBytes,
                D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON, e.Scratch)) continue;
            if (!CreateGpuBuffer(mDevice5.Get(), pre.ResultDataMaxSizeInBytes,
                D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
                D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE, e.Result)) continue;

            D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC bd{};
            bd.Inputs                           = inp;
            bd.DestAccelerationStructureData    = e.Result->GetGPUVirtualAddress();
            bd.ScratchAccelerationStructureData = e.Scratch->GetGPUVirtualAddress();
            cmdList4->BuildRaytracingAccelerationStructure(&bd, 0, nullptr);

            // UAV barrier to ensure the BLAS write is visible before the TLAS build.
            D3D12_RESOURCE_BARRIER uavB = CD3DX12_RESOURCE_BARRIER::UAV(e.Result.Get());
            cmdList4->ResourceBarrier(1, &uavB);

            // Keep the upload buffers alive until the GPU finishes this frame's BLAS builds.
            // They will be released at the start of the next BuildTlas() call.
            mPendingUploads.push_back(std::move(vbUp));
            mPendingUploads.push_back(std::move(ibUp));
            anyNewBlas = true;
            mRtGeometryDirty = true;
        }

        const auto it = mBlasCache.find(meshKey);
        if (it == mBlasCache.end() || !it->second.Result) continue;

        // Build a 3x4 row-major world transform for the instance descriptor.
        XMFLOAT4X4 w4;
        XMStoreFloat4x4(&w4, XMMatrixTranspose(entity.Transform.GetTransform()));

        // Only rebuild the RT geometry buffers when new BLASes were added.
        // On steady-state frames we still need the instance descriptors (transforms
        // can change) but the vertex/index/instance data stays the same.
        if (mRtGeometryDirty)
        {
            const UINT vertexOffset = static_cast<UINT>(rtVertices.size());
            const UINT indexOffset  = static_cast<UINT>(rtIndices.size());

            const auto& verts      = mesh->GetVertices();
            const auto& indices    = mesh->GetIndices();
            const auto& subMeshes  = mesh->GetSubMeshes();
            rtVertices.reserve(rtVertices.size() + verts.size());
            rtIndices.reserve(rtIndices.size() + indices.size());

            // Load per-submesh base-color tints from the material JSON so that
            // coloured surfaces (e.g. red curtains) tint the indirect light correctly.
            const std::string& matPath = entity.Mesh.has_value() ? entity.Mesh->MaterialPath : std::string{};
            const auto tintMap = LoadMaterialTints(matPath);

            // Build a per-vertex tint array from the submesh ranges.
            // Each submesh covers [indexStart, indexStart+indexCount) in the index buffer,
            // which maps to a subset of control-point vertices via those indices.
            // We use a per-vertex tint array (indexed by vertex position) derived from
            // the submesh that first references each vertex.
            std::vector<DirectX::XMFLOAT4> vertexTints(verts.size(), DirectX::XMFLOAT4{ 1.f, 1.f, 1.f, 1.f });
            if (!subMeshes.empty())
            {
                for (const SubMesh& sm : subMeshes)
                {
                    // Look up the tint for this material slot; fall back to white.
                    DirectX::XMFLOAT4 tint{ 1.f, 1.f, 1.f, 1.f };
                    auto tintIt = tintMap.find(sm.materialId);
                    if (tintIt != tintMap.end())
                        tint = tintIt->second;

                    // Tag every vertex referenced by this submesh's indices.
                    const UINT end = sm.indexStart + sm.indexCount;
                    for (UINT ii = sm.indexStart; ii < end && ii < static_cast<UINT>(indices.size()); ++ii)
                    {
                        const UINT vi = indices[ii];
                        if (vi < static_cast<UINT>(vertexTints.size()))
                            vertexTints[vi] = tint;
                    }
                }
            }
            else if (!tintMap.empty())
            {
                // Single-material: apply tint 0 to all vertices.
                auto tintIt = tintMap.find(0u);
                if (tintIt != tintMap.end())
                    std::fill(vertexTints.begin(), vertexTints.end(), tintIt->second);
            }

            for (std::size_t vi = 0; vi < verts.size(); ++vi)
            {
                const Vertex& v = verts[vi];
                RtVertexGpu gv{};
                gv.Position = v.Position;
                gv.Normal   = v.Normal;
                // Use material tint as the albedo for RT GI color bleeding.
                // This is the primary source of color since vertex colors are
                // not imported from the FBX asset pipeline.
                gv.Color    = vertexTints[vi];
                rtVertices.push_back(gv);
            }
            for (std::uint32_t idx : indices)
                rtIndices.push_back(idx + vertexOffset);

            RtInstanceGpu rtInst{};
            rtInst.VertexOffset = vertexOffset;
            rtInst.IndexOffset  = indexOffset;
            rtInstances.push_back(rtInst);
        }

        D3D12_RAYTRACING_INSTANCE_DESC inst{};
        memcpy(inst.Transform, &w4, sizeof(inst.Transform));
        inst.InstanceID                          = static_cast<UINT>(instanceDescs.size());
        inst.InstanceMask                        = 0xFF;
        inst.InstanceContributionToHitGroupIndex = 0;
        inst.Flags                               = D3D12_RAYTRACING_INSTANCE_FLAG_NONE;
        inst.AccelerationStructure               = it->second.Result->GetGPUVirtualAddress();
        instanceDescs.push_back(inst);
    }

    if (instanceDescs.empty()) return;

    // Only re-upload vertex/index/instance data when geometry actually changed.
    if (mRtGeometryDirty || anyNewBlas)
    {
        if (!EnsureRtGeometryBuffers(static_cast<UINT>(rtVertices.size()), static_cast<UINT>(rtIndices.size()), static_cast<UINT>(rtInstances.size())))
            return;

        void* mappedVertices = nullptr;
        if (FAILED(mRtVertexBuffer->Map(0, nullptr, &mappedVertices)) || !mappedVertices)
        { mLastError = "RtGI: failed to map RT vertex buffer."; return; }
        memcpy(mappedVertices, rtVertices.data(), rtVertices.size() * sizeof(RtVertexGpu));
        mRtVertexBuffer->Unmap(0, nullptr);

        void* mappedIndices = nullptr;
        if (FAILED(mRtIndexBuffer->Map(0, nullptr, &mappedIndices)) || !mappedIndices)
        { mLastError = "RtGI: failed to map RT index buffer."; return; }
        memcpy(mappedIndices, rtIndices.data(), rtIndices.size() * sizeof(std::uint32_t));
        mRtIndexBuffer->Unmap(0, nullptr);

        void* mappedInstances = nullptr;
        if (FAILED(mRtInstanceBuffer->Map(0, nullptr, &mappedInstances)) || !mappedInstances)
        { mLastError = "RtGI: failed to map RT instance buffer."; return; }
        memcpy(mappedInstances, rtInstances.data(), rtInstances.size() * sizeof(RtInstanceGpu));
        mRtInstanceBuffer->Unmap(0, nullptr);

        mRtGeometryDirty = false;
    }

    const UINT numInst = static_cast<UINT>(instanceDescs.size());
    const UINT64 requiredSize = numInst * sizeof(D3D12_RAYTRACING_INSTANCE_DESC);
    const bool bufferTooSmall = mInstanceDescBuffer &&
        mInstanceDescBuffer->GetDesc().Width < requiredSize;
    if (numInst > mTlasMaxInstances || !mInstanceDescBuffer || bufferTooSmall)
    {
        if (!CreateTlasBuffers(numInst * 2 + 8)) return;
    }

    // Upload instance descriptors.
    void* mapped = nullptr;
    if (FAILED(mInstanceDescBuffer->Map(0, nullptr, &mapped)) || !mapped)
    {
        mLastError = "RtGI: failed to map TLAS instance buffer.";
        return;
    }
    memcpy(mapped, instanceDescs.data(), numInst * sizeof(D3D12_RAYTRACING_INSTANCE_DESC));
    mInstanceDescBuffer->Unmap(0, nullptr);

    // Query TLAS prebuild info
    D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS tlasInp{};
    tlasInp.Type          = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL;
    tlasInp.Flags         = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE;
    tlasInp.NumDescs      = numInst;
    tlasInp.DescsLayout   = D3D12_ELEMENTS_LAYOUT_ARRAY;
    tlasInp.InstanceDescs = mInstanceDescBuffer->GetGPUVirtualAddress();

    D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO tlasPre{};
    mDevice5->GetRaytracingAccelerationStructurePrebuildInfo(&tlasInp, &tlasPre);

    if (!mTlasBuffer || mTlasBuffer->GetDesc().Width < tlasPre.ResultDataMaxSizeInBytes)
    {
        mTlasBuffer.Reset();
        if (!CreateGpuBuffer(mDevice5.Get(), tlasPre.ResultDataMaxSizeInBytes,
            D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
            D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE, mTlasBuffer)) return;
    }
    if (!mTlasScratch || mTlasScratch->GetDesc().Width < tlasPre.ScratchDataSizeInBytes)
    {
        mTlasScratch.Reset();
        if (!CreateGpuBuffer(mDevice5.Get(), tlasPre.ScratchDataSizeInBytes,
            D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
            D3D12_RESOURCE_STATE_COMMON, mTlasScratch)) return;
    }

    D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC tlasDesc{};
    tlasDesc.Inputs                           = tlasInp;
    tlasDesc.DestAccelerationStructureData    = mTlasBuffer->GetGPUVirtualAddress();
    tlasDesc.ScratchAccelerationStructureData = mTlasScratch->GetGPUVirtualAddress();
    cmdList4->BuildRaytracingAccelerationStructure(&tlasDesc, 0, nullptr);

    D3D12_RESOURCE_BARRIER uav = CD3DX12_RESOURCE_BARRIER::UAV(mTlasBuffer.Get());
    cmdList4->ResourceBarrier(1, &uav);
    mTlasBuiltThisFrame = true;
}

// ---------------------------------------------------------------------------
// Public: Dispatch
// ---------------------------------------------------------------------------
void RtGlobalIllumination::Dispatch(
    ID3D12GraphicsCommandList4*  cmdList4,
    D3D12_GPU_DESCRIPTOR_HANDLE  gbufferNormalSrv,
    D3D12_GPU_DESCRIPTOR_HANDLE  depthSrv,
    const RtGiSettings&          settings,
    const XMFLOAT4X4&            invViewProj,
    const XMFLOAT3&              cameraPos,
    const XMFLOAT3&              sunDir,
    const XMFLOAT3&              sunColor,
    const XMFLOAT3&              skyAmbient,
    const PointLightGpu*         pointLights,
    int                          numPointLights)
{
    if (!mIsInitialized || !mTlasBuiltThisFrame || !mStateObject || !mShaderTable)
    {
        if (!mIsInitialized)           OutputDebugStringA("RtGI::Dispatch skipped: not initialized\n");
        else if (!mTlasBuiltThisFrame) OutputDebugStringA("RtGI::Dispatch skipped: TLAS not built\n");
        else if (!mStateObject)        OutputDebugStringA("RtGI::Dispatch skipped: no state object\n");
        else if (!mShaderTable)        OutputDebugStringA("RtGI::Dispatch skipped: no shader table\n");
        return;
    }

    // Detect camera movement OR rotation and reset temporal accumulation to avoid ghosting.
    const float dx = cameraPos.x - mPrevCameraPos.x;
    const float dy = cameraPos.y - mPrevCameraPos.y;
    const float dz = cameraPos.z - mPrevCameraPos.z;
    bool cameraMoved = (dx*dx + dy*dy + dz*dz) > 1e-8f;
    // Also detect rotation by comparing invViewProj (view direction change).
    if (!cameraMoved)
    {
        const float* a = reinterpret_cast<const float*>(&mPrevInvViewProj);
        const float* b = reinterpret_cast<const float*>(&invViewProj);
        for (int i = 0; i < 16; ++i)
        {
            if (fabsf(a[i] - b[i]) > 1e-5f) { cameraMoved = true; break; }
        }
    }
    mPrevCameraPos   = cameraPos;
    mPrevInvViewProj = invViewProj;

    // Track frames since last reset so accumulation alpha can ramp up gradually,
    // avoiding the black-flash from writing a single noisy frame at full weight.
    if (cameraMoved)
        mFramesSinceReset = 0;
    else
        mFramesSinceReset = (std::min)(mFramesSinceReset + 1, 64);

    // Use the user's accumulation alpha directly.  There is no need to ramp it
    // because camera-move frames now bypass history entirely in the shader.
    float effectiveAlpha = settings.AccumulationAlpha;
    if (settings.DebugNoAccumulation) effectiveAlpha = 1.0f;

    // Update per-frame constants.
    mMappedCB->InvViewProj       = invViewProj;
    mMappedCB->CameraPos         = cameraPos;
    mMappedCB->SunDir            = sunDir;
    mMappedCB->SunColor          = sunColor;
    mMappedCB->SkyAmbient        = skyAmbient;
    mMappedCB->MaxRayDistance    = settings.MaxRayDistance;
    mMappedCB->BounceCount       = settings.BounceCount;
    // Use the user's rays-per-pixel setting unchanged; boosting it on motion
    // frames was killing performance without a visible quality benefit now that
    // camera-move frames skip the history blend instead of ghosting.
    mMappedCB->RaysPerPixel      = settings.RaysPerPixel;
    mMappedCB->AccumulationAlpha = effectiveAlpha;
    mMappedCB->FrameIndex        = static_cast<int>(mFrameIndex++);
    mMappedCB->SkylightOnMiss    = settings.SkylightOnMiss ? 1 : 0;
    mMappedCB->ResetAccumulation = cameraMoved ? 1 : 0;

    // Copy point lights into the constant buffer (clamped to kMaxPointLights).
    const int nLights = (std::min)(numPointLights, kMaxPointLights);
    mMappedCB->NumPointLights = nLights;
    for (int i = 0; i < nLights; ++i)
        mMappedCB->PointLights[i] = pointLights[i];

    // Transition raw output and accum textures to UAV state for writing.
    D3D12_RESOURCE_BARRIER toUav[2] =
    {
        CD3DX12_RESOURCE_BARRIER::Transition(mRawOutput.Get(),
            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS),
        CD3DX12_RESOURCE_BARRIER::Transition(mAccumOutput.Get(),
            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS),
    };
    cmdList4->ResourceBarrier(2, toUav);

    // Bind the DXR pipeline and global root signature.
    cmdList4->SetPipelineState1(mStateObject.Get());
    cmdList4->SetComputeRootSignature(mGlobalRS.Get());

    // Root parameter bindings (match CreateDxrPipeline layout):
    //  [0] b0 – GiConstants CBV
    //  [1] t0 – G-Buffer normal SRV table
    //  [2] t1 – depth SRV table
    //  [3] t2 – history SRV table
    //  [4] t3 – TLAS inline SRV (raw VA)
    //  [5] u0 – raw noisy UAV table
    //  [6] u1 – accumulation UAV table
    //  [7] t4 – RT vertex buffer SRV table
    //  [8] t5 – RT index buffer SRV table
    //  [9] t6 – RT instance buffer SRV table
    cmdList4->SetComputeRootConstantBufferView(0, mConstantBuffer->GetGPUVirtualAddress());
    cmdList4->SetComputeRootDescriptorTable(1, gbufferNormalSrv);
    cmdList4->SetComputeRootDescriptorTable(2, depthSrv);
    cmdList4->SetComputeRootDescriptorTable(3, mHistorySrvGpu);
    cmdList4->SetComputeRootShaderResourceView(4, mTlasBuffer->GetGPUVirtualAddress());
    cmdList4->SetComputeRootDescriptorTable(5, mRawUavGpu);
    cmdList4->SetComputeRootDescriptorTable(6, mAccumUavGpu);
    cmdList4->SetComputeRootDescriptorTable(7, mRtVertexSrvGpu);
    cmdList4->SetComputeRootDescriptorTable(8, mRtIndexSrvGpu);
    cmdList4->SetComputeRootDescriptorTable(9, mRtInstanceSrvGpu);

    // Build and submit the DispatchRays call.
    D3D12_DISPATCH_RAYS_DESC dr{};
    dr.Width  = mWidth;
    dr.Height = mHeight;
    dr.Depth  = 1;
    const UINT64 base = mShaderTable->GetGPUVirtualAddress();
    dr.RayGenerationShaderRecord = { base,                           mShaderTableEntrySize };
    dr.MissShaderTable           = { base + mShaderTableEntrySize,   mShaderTableEntrySize, mShaderTableEntrySize };
    dr.HitGroupTable             = { base + 2*mShaderTableEntrySize, mShaderTableEntrySize, mShaderTableEntrySize };
    cmdList4->DispatchRays(&dr);

    // Transition raw output back to non-pixel SRV.
    D3D12_RESOURCE_BARRIER rawBack = CD3DX12_RESOURCE_BARRIER::Transition(mRawOutput.Get(),
        D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
    cmdList4->ResourceBarrier(1, &rawBack);

    // UAV barrier to flush accum writes before copy.
    D3D12_RESOURCE_BARRIER accumUav = CD3DX12_RESOURCE_BARRIER::UAV(mAccumOutput.Get());
    cmdList4->ResourceBarrier(1, &accumUav);

    // Copy accum -> history for temporal blending next frame.
    D3D12_RESOURCE_BARRIER histToDest = CD3DX12_RESOURCE_BARRIER::Transition(mHistoryOutput.Get(),
        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COPY_DEST);
    cmdList4->ResourceBarrier(1, &histToDest);

    D3D12_RESOURCE_BARRIER accumToSrc = CD3DX12_RESOURCE_BARRIER::Transition(mAccumOutput.Get(),
        D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE);
    cmdList4->ResourceBarrier(1, &accumToSrc);

    cmdList4->CopyResource(mHistoryOutput.Get(), mAccumOutput.Get());

    // Transition accum to pixel SRV for DeferredLighting; history back to non-pixel SRV.
    D3D12_RESOURCE_BARRIER toSrv[2] =
    {
        CD3DX12_RESOURCE_BARRIER::Transition(mAccumOutput.Get(),
            D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE),
        CD3DX12_RESOURCE_BARRIER::Transition(mHistoryOutput.Get(),
            D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE),
    };
    cmdList4->ResourceBarrier(2, toSrv);
}

// ---------------------------------------------------------------------------
// Public: Shutdown
// ---------------------------------------------------------------------------
void RtGlobalIllumination::Shutdown()
{
    if (mConstantBuffer && mMappedCB)
    {
        mConstantBuffer->Unmap(0, nullptr);
        mMappedCB = nullptr;
    }
    mConstantBuffer.Reset();
    mShaderTable.Reset();
    mStateObject.Reset();
    mGlobalRS.Reset();
    mTlasBuffer.Reset();
    mTlasScratch.Reset();
    mInstanceDescBuffer.Reset();
    mBlasCache.clear();
    mRawOutput.Reset();
    mAccumOutput.Reset();
    mHistoryOutput.Reset();
    mRtVertexBuffer.Reset();
    mRtIndexBuffer.Reset();
    mRtInstanceBuffer.Reset();
    mDevice5.Reset();
    mIsInitialized = false;
}

// ---------------------------------------------------------------------------
// Private helpers
// ---------------------------------------------------------------------------

bool RtGlobalIllumination::AllocateSrv(
    D3D12_CPU_DESCRIPTOR_HANDLE* cpu, D3D12_GPU_DESCRIPTOR_HANDLE* gpu)
{
    return DX12Context_AllocateSrvDescriptor(cpu, gpu);
}

bool RtGlobalIllumination::CheckDxrSupport()
{
    ID3D12Device* device = DX12Context_GetDevice();
    if (!device) { mLastError = "RtGI: DX12 device not available."; return false; }

    if (FAILED(device->QueryInterface(IID_PPV_ARGS(&mDevice5))))
    {
        mLastError = "RtGI: ID3D12Device5 not supported (need a DXR-capable GPU on Windows 10 RS5+).";
        return false;
    }

    D3D12_FEATURE_DATA_D3D12_OPTIONS5 opts5{};
    if (FAILED(device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS5, &opts5, sizeof(opts5))) ||
        opts5.RaytracingTier == D3D12_RAYTRACING_TIER_NOT_SUPPORTED)
    {
        mLastError = "RtGI: DXR Tier 1.0 not supported on this GPU.";
        mDevice5.Reset();
        return false;
    }
    return true;
}

bool RtGlobalIllumination::CreateOutputTextures(UINT width, UINT height)
{
    mWidth = width; mHeight = height;
    ID3D12Device* dev = mDevice5.Get();

    // Raw noisy output written by RayGen, starts as non-pixel SRV.
    mRawOutput.Reset();
    if (!CreateRgba16Tex(dev, width, height,
        D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, mRawOutput))
    { mLastError = "RtGI: failed to create raw output texture."; return false; }

    // Temporally accumulated output, read by DeferredLighting as a pixel SRV.
    mAccumOutput.Reset();
    if (!CreateRgba16Tex(dev, width, height,
        D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
        D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, mAccumOutput))
    { mLastError = "RtGI: failed to create accum output texture."; return false; }

    // History texture for temporal blending (non-pixel SRV / copy dest).
    mHistoryOutput.Reset();
    if (!CreateRgba16Tex(dev, width, height,
        D3D12_RESOURCE_FLAG_NONE,
        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, mHistoryOutput))
    { mLastError = "RtGI: failed to create history texture."; return false; }

    // Allocate descriptors from the shared SRV/UAV heap.
    if (!AllocateSrv(&mRawUavCpu,    &mRawUavGpu))    { mLastError = "RtGI: out of descriptors (raw UAV).";   return false; }
    if (!AllocateSrv(&mAccumUavCpu,  &mAccumUavGpu))  { mLastError = "RtGI: out of descriptors (accum UAV)."; return false; }
    if (!AllocateSrv(&mAccumSrvCpu,  &mAccumSrvGpu))  { mLastError = "RtGI: out of descriptors (accum SRV)."; return false; }
    if (!AllocateSrv(&mHistorySrvCpu,&mHistorySrvGpu)){ mLastError = "RtGI: out of descriptors (hist SRV).";  return false; }
    if (!AllocateSrv(&mRtVertexSrvCpu,   &mRtVertexSrvGpu))   { mLastError = "RtGI: out of descriptors (RT vertex SRV).";   return false; }
    if (!AllocateSrv(&mRtIndexSrvCpu,    &mRtIndexSrvGpu))    { mLastError = "RtGI: out of descriptors (RT index SRV).";    return false; }
    if (!AllocateSrv(&mRtInstanceSrvCpu, &mRtInstanceSrvGpu)) { mLastError = "RtGI: out of descriptors (RT instance SRV)."; return false; }

    D3D12_UNORDERED_ACCESS_VIEW_DESC uavDesc{};
    uavDesc.Format        = DXGI_FORMAT_R16G16B16A16_FLOAT;
    uavDesc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
    dev->CreateUnorderedAccessView(mRawOutput.Get(),   nullptr, &uavDesc, mRawUavCpu);
    dev->CreateUnorderedAccessView(mAccumOutput.Get(), nullptr, &uavDesc, mAccumUavCpu);

    D3D12_SHADER_RESOURCE_VIEW_DESC srvDesc{};
    srvDesc.Format                  = DXGI_FORMAT_R16G16B16A16_FLOAT;
    srvDesc.ViewDimension           = D3D12_SRV_DIMENSION_TEXTURE2D;
    srvDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
    srvDesc.Texture2D.MipLevels     = 1;
    dev->CreateShaderResourceView(mAccumOutput.Get(),   &srvDesc, mAccumSrvCpu);
    dev->CreateShaderResourceView(mHistoryOutput.Get(), &srvDesc, mHistorySrvCpu);

    if (!EnsureRtGeometryBuffers(1, 1, 1))
        return false;

    D3D12_SHADER_RESOURCE_VIEW_DESC vertexSrvDesc{};
    vertexSrvDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
    vertexSrvDesc.Format = DXGI_FORMAT_UNKNOWN;
    vertexSrvDesc.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
    vertexSrvDesc.Buffer.FirstElement = 0;
    vertexSrvDesc.Buffer.NumElements = mRtVertexCapacity;
    vertexSrvDesc.Buffer.StructureByteStride = sizeof(RtVertexGpu);
    vertexSrvDesc.Buffer.Flags = D3D12_BUFFER_SRV_FLAG_NONE;
    dev->CreateShaderResourceView(mRtVertexBuffer.Get(), &vertexSrvDesc, mRtVertexSrvCpu);

    D3D12_SHADER_RESOURCE_VIEW_DESC indexSrvDesc{};
    indexSrvDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
    indexSrvDesc.Format = DXGI_FORMAT_R32_TYPELESS;
    indexSrvDesc.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
    indexSrvDesc.Buffer.FirstElement = 0;
    indexSrvDesc.Buffer.NumElements = mRtIndexCapacity;
    indexSrvDesc.Buffer.StructureByteStride = 0;
    indexSrvDesc.Buffer.Flags = D3D12_BUFFER_SRV_FLAG_RAW;
    dev->CreateShaderResourceView(mRtIndexBuffer.Get(), &indexSrvDesc, mRtIndexSrvCpu);

    D3D12_SHADER_RESOURCE_VIEW_DESC instanceSrvDesc{};
    instanceSrvDesc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
    instanceSrvDesc.Format = DXGI_FORMAT_UNKNOWN;
    instanceSrvDesc.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
    instanceSrvDesc.Buffer.FirstElement = 0;
    instanceSrvDesc.Buffer.NumElements = mRtInstanceCapacity;
    instanceSrvDesc.Buffer.StructureByteStride = sizeof(RtInstanceGpu);
    instanceSrvDesc.Buffer.Flags = D3D12_BUFFER_SRV_FLAG_NONE;
    dev->CreateShaderResourceView(mRtInstanceBuffer.Get(), &instanceSrvDesc, mRtInstanceSrvCpu);
    return true;
}

bool RtGlobalIllumination::CreateTlasBuffers(UINT maxInstances)
{
    mTlasMaxInstances = maxInstances;
    mInstanceDescBuffer.Reset();
    if (!CreateUploadBuf(mDevice5.Get(),
        maxInstances * sizeof(D3D12_RAYTRACING_INSTANCE_DESC), mInstanceDescBuffer))
    { mLastError = "RtGI: failed to allocate TLAS instance buffer."; return false; }
    return true;
}

bool RtGlobalIllumination::CreateDxrPipeline()
{
    OutputDebugStringA("RtGI::CreateDxrPipeline - start\n");
    ID3D12Device* device = mDevice5.Get();

    // Global root signature (version 1.0, compatible with all DXR-capable drivers).
    // Slots: [0] CBV b0, [1] SRV t0 normal, [2] SRV t1 depth, [3] SRV t2 history,
    //        [4] SRV t3 TLAS (inline), [5] UAV u0 raw, [6] UAV u1 accum,
    //        [7] SRV t4 RT vertices, [8] SRV t5 RT indices, [9] SRV t6 RT instances.
    {
        D3D12_DESCRIPTOR_RANGE dtNorm{}, dtDepth{}, dtHist{}, dtRaw{}, dtAccum{};
        D3D12_DESCRIPTOR_RANGE dtVertices{}, dtIndices{}, dtInstances{};
        dtNorm.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV; dtNorm.NumDescriptors = 1; dtNorm.BaseShaderRegister = 0;
        dtDepth.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV; dtDepth.NumDescriptors = 1; dtDepth.BaseShaderRegister = 1;
        dtHist.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV; dtHist.NumDescriptors = 1; dtHist.BaseShaderRegister = 2;
        dtRaw.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV; dtRaw.NumDescriptors = 1; dtRaw.BaseShaderRegister = 0;
        dtAccum.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV; dtAccum.NumDescriptors = 1; dtAccum.BaseShaderRegister = 1;
        dtVertices.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV; dtVertices.NumDescriptors = 1; dtVertices.BaseShaderRegister = 4;
        dtIndices.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV; dtIndices.NumDescriptors = 1; dtIndices.BaseShaderRegister = 5;
        dtInstances.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV; dtInstances.NumDescriptors = 1; dtInstances.BaseShaderRegister = 6;

        D3D12_ROOT_PARAMETER p[10]{};
        p[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV; p[0].Descriptor.ShaderRegister = 0; p[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        p[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; p[1].DescriptorTable = {1, &dtNorm};   p[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        p[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; p[2].DescriptorTable = {1, &dtDepth};  p[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        p[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; p[3].DescriptorTable = {1, &dtHist};   p[3].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        p[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; p[4].Descriptor.ShaderRegister = 3; p[4].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        p[5].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; p[5].DescriptorTable = {1, &dtRaw};    p[5].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        p[6].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; p[6].DescriptorTable = {1, &dtAccum};  p[6].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        p[7].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; p[7].DescriptorTable = {1, &dtVertices};  p[7].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        p[8].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; p[8].DescriptorTable = {1, &dtIndices};   p[8].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
        p[9].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; p[9].DescriptorTable = {1, &dtInstances}; p[9].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;

        D3D12_ROOT_SIGNATURE_DESC rsDesc{};
        rsDesc.NumParameters = 10;
        rsDesc.pParameters   = p;
        rsDesc.Flags         = D3D12_ROOT_SIGNATURE_FLAG_NONE;

        ComPtr<ID3DBlob> blob, err;
        if (FAILED(D3D12SerializeRootSignature(&rsDesc, D3D_ROOT_SIGNATURE_VERSION_1, &blob, &err)))
        {
            mLastError = "RtGI: root signature serialization failed.";
            if (err) OutputDebugStringA(static_cast<const char*>(err->GetBufferPointer()));
            return false;
        }
        if (FAILED(device->CreateRootSignature(0,
            blob->GetBufferPointer(), blob->GetBufferSize(), IID_PPV_ARGS(&mGlobalRS))))
        { mLastError = "RtGI: CreateRootSignature failed."; return false; }
    }
    OutputDebugStringA("RtGI::CreateDxrPipeline - root sig OK, compiling shader\n");

    // Load the pre-compiled DXIL library produced by the build-time custom build step.
    std::vector<uint8_t> dxil;
    try { dxil = LoadPrecompiledDxil(); }
    catch (const std::exception& ex)
    { mLastError = std::string("RtGI: failed to load RtGI.dxil: ") + ex.what(); return false; }
    OutputDebugStringA("RtGI::CreateDxrPipeline - shader loaded OK\n");

    const D3D12_SHADER_BYTECODE libBC{ dxil.data(), dxil.size() };

    D3D12_EXPORT_DESC exports[3] =
    {
        { kRayGenName,     nullptr, D3D12_EXPORT_FLAG_NONE },
        { kClosestHitName, nullptr, D3D12_EXPORT_FLAG_NONE },
        { kMissName,       nullptr, D3D12_EXPORT_FLAG_NONE },
    };
    D3D12_DXIL_LIBRARY_DESC lib{ libBC, 3, exports };

    D3D12_HIT_GROUP_DESC hg{};
    hg.HitGroupExport         = kHitGroupName;
    hg.Type                   = D3D12_HIT_GROUP_TYPE_TRIANGLES;
    hg.ClosestHitShaderImport = kClosestHitName;

    // Payload: float3 Radiance + float3 HitAlbedo + float3 HitNormal + float3 HitWorldPos + uint Hit
    //          = 4 * 12 + 4 = 52 bytes.
    // Attributes: float2 Barycentrics = 8 bytes.
    D3D12_RAYTRACING_SHADER_CONFIG  sc{ 52, 8 };
    D3D12_RAYTRACING_PIPELINE_CONFIG pc{ 1 };
    D3D12_GLOBAL_ROOT_SIGNATURE      grs{ mGlobalRS.Get() };

    D3D12_STATE_SUBOBJECT subs[5] =
    {
        { D3D12_STATE_SUBOBJECT_TYPE_DXIL_LIBRARY,               &lib },
        { D3D12_STATE_SUBOBJECT_TYPE_HIT_GROUP,                  &hg  },
        { D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_SHADER_CONFIG,   &sc  },
        { D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_PIPELINE_CONFIG, &pc  },
        { D3D12_STATE_SUBOBJECT_TYPE_GLOBAL_ROOT_SIGNATURE,      &grs },
    };
    D3D12_STATE_OBJECT_DESC soDesc{ D3D12_STATE_OBJECT_TYPE_RAYTRACING_PIPELINE, 5, subs };
    OutputDebugStringA("RtGI::CreateDxrPipeline - calling CreateStateObject\n");
    if (FAILED(mDevice5->CreateStateObject(&soDesc, IID_PPV_ARGS(&mStateObject))))
    { mLastError = "RtGI: CreateStateObject failed."; return false; }

    return true;
}

bool RtGlobalIllumination::CreateShaderTable()
{
    // Each entry = shader identifier (D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES = 32 bytes)
    // padded up to D3D12_RAYTRACING_SHADER_RECORD_BYTE_ALIGNMENT (64 bytes).
    mShaderTableEntrySize =
        (D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES + D3D12_RAYTRACING_SHADER_RECORD_BYTE_ALIGNMENT - 1)
        & ~static_cast<UINT64>(D3D12_RAYTRACING_SHADER_RECORD_BYTE_ALIGNMENT - 1);
    mShaderTableSize = 3 * mShaderTableEntrySize; // RayGen + Miss + HitGroup

    if (!CreateUploadBuf(mDevice5.Get(), mShaderTableSize, mShaderTable))
    { mLastError = "RtGI: failed to allocate shader table."; return false; }

    ComPtr<ID3D12StateObjectProperties> prop;
    if (FAILED(mStateObject->QueryInterface(IID_PPV_ARGS(&prop))))
    { mLastError = "RtGI: ID3D12StateObjectProperties unavailable."; return false; }

    uint8_t* p = nullptr;
    mShaderTable->Map(0, nullptr, reinterpret_cast<void**>(&p));
    memcpy(p,                            prop->GetShaderIdentifier(kRayGenName),    D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES);
    memcpy(p + mShaderTableEntrySize,    prop->GetShaderIdentifier(kMissName),      D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES);
    memcpy(p + 2*mShaderTableEntrySize,  prop->GetShaderIdentifier(kHitGroupName),  D3D12_SHADER_IDENTIFIER_SIZE_IN_BYTES);
    mShaderTable->Unmap(0, nullptr);
    return true;
}

bool RtGlobalIllumination::CreateConstantBuffer()
{
    if (!CreateUploadBuf(mDevice5.Get(), sizeof(GiConstants), mConstantBuffer))
    { mLastError = "RtGI: failed to allocate constant buffer."; return false; }
    mConstantBuffer->Map(0, nullptr, reinterpret_cast<void**>(&mMappedCB));
    return true;
}
