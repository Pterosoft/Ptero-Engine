{
    "Comments": [
        {
            "Color": 7020319,
            "Height": 420.0,
            "Id": 1,
            "Text": "Start: capture the mouse for looking (Set Control Settings > Capture mouse) and remember the field of view the zoom returns to",
            "Width": 1240.0,
            "X": -40.0,
            "Y": -80.0
        },
        {
            "Color": 1853996,
            "Height": 761.5663580246921,
            "Id": 4,
            "Text": "Character settings: edit the values on these nodes to tune movement, camera and controls",
            "Width": 1205.2391975308642,
            "X": 560.0,
            "Y": -1000.0
        },
        {
            "Color": 3106448,
            "Height": 1527.0061728395062,
            "Id": 13,
            "Text": "Every frame: WASD moves and the mouse looks. Crouch (Ctrl / C) and sprint (Shift) are held here unless Set Control Settings makes them toggles - the key presses below handle those",
            "Width": 1838.070987654321,
            "X": -40.0,
            "Y": 420.0
        },
        {
            "Color": 1853996,
            "Height": 300.0,
            "Id": 39,
            "Text": "Jump: press to jump, release early for a shorter hop",
            "Width": 640.0,
            "X": -40.0,
            "Y": 2020.0
        },
        {
            "Color": 4205146,
            "Height": 660.0,
            "Id": 44,
            "Text": "Crouch and sprint toggles: only when Set Control Settings makes them toggles",
            "Width": 1240.0,
            "X": -40.0,
            "Y": 2420.0
        },
        {
            "Color": 3025490,
            "Height": 420.0,
            "Id": 58,
            "Text": "Camera properties at runtime: hold the right mouse button to zoom to half the field of view",
            "Width": 940.0,
            "X": -40.0,
            "Y": 3220.0
        }
    ],
