/* Shared end-of-match theme. Load after farkle.rcss (fonts and base skins).
   Native RmlUi 6.3 only. No full-screen fill or scene/background texture. */
@spritesheet farkle-results {
    src: Textures/results-ornaments.png;
    result-crown: 35px 38px 665px 530px;
    result-lion: 743px 48px 502px 590px;
    result-tankard: 24px 675px 658px 490px;
    result-laurel-left: 688px 644px 278px 552px;
    result-laurel-right: 966px 644px 278px 552px;
}
.result-screen { background-color: #00000000; color: #261a10ff; }
.result-board { position: absolute; decorator: ninepatch(wood, wood-inner, 3.7vh); }
.board-shade { position: absolute; left: 2%; top: 3%; width: 96%; height: 94%; background-color: #0d0906a0; pointer-events: none; }
.result-screen .parchment { decorator: ninepatch(parchment, parchment-inner, 1.8vh); }
.result-masthead { position: absolute; text-align: center; pointer-events: none; }
.result-sign { position: absolute; left: 0; top: 0; width: 100%; height: 100%; decorator: image(sign); }
.result-title { position: absolute; width: 100%; font-family: "Grenze Gotisch"; font-size: 15.2vh; line-height: 1.06; color: #e9c17aff; font-effect: shadow(2px 3px #000000ee); }
.result-subtitle { position: absolute; left: 5%; width: 90%; font-family: "IM FELL English SC"; font-size: 1.9vh; line-height: 1.25; letter-spacing: 0.36vh; color: #efd094ff; }
.title-flourish { position: absolute; display: flex; align-items: center; justify-content: center; height: 2vh; left: 14%; width: 72%; }
.title-flourish span { display: block; height: 1px; background-color: #c79e5277; width: 36%; }
.title-flourish img { width: 1.8vh; height: 2.1vh; margin: 0 1.5vh; }
.result-name { font-family: "IM FELL English SC"; font-size: 4.1vh; line-height: 1.2; text-align: center; }
.result-score { font-family: "EB Garamond"; font-size: 9.8vh; line-height: 1.05; text-align: center; }
.result-score-rule { height: 1px; background-color: #6a4a2588; }
.result-flourish { display: flex; align-items: center; justify-content: center; height: 3vh; }
.result-flourish span { display: block; width: 34%; height: 1px; background-color: #77552e88; }
.result-flourish img { width: 2.2vh; height: 2.6vh; margin: 0 1.25vh; }
.summary-heading { font-family: "Pirata One"; font-size: 4vh; line-height: 1.15; font-weight: normal; text-align: center; }
.summary-row { display: flex; align-items: center; justify-content: space-between; height: 5.1vh; border-bottom: 1px #71502e77; font-size: 2.75vh; line-height: 1.1; }
.summary-row.last { border-bottom-width: 0; }
.summary-value { text-align: right; }
.summary-value.numeric { font-size: 3.5vh; }
.result-flavor { font-family: "Fondamento"; font-size: 2.8vh; line-height: 1.25; text-align: center; }
.result-actions { position: absolute; display: flex; justify-content: space-between; }
.result-action { position: relative; display: inline-block; width: 31.7%; height: 100%; decorator: image(button-paper); color: #261a10ff; font-family: "IM FELL English SC"; font-size: 3.05vh; line-height: 6.8vh; }
.result-action.result-primary { decorator: image(button-dark); color: #ffcf7bff; border: 1px #dba449ff; border-radius: 1vh; }
.result-action:hover, .result-action:focus { decorator: image(button-dark); color: #ffe7a9ff; border: 1px #eaba60ff; border-radius: 1vh; }
.result-action:active { color: #ffffffff; }
.result-action:disabled { opacity: 0.45; cursor: unavailable; tab-index: none; }
.button-fleur { position: absolute; top: 2.1vh; width: 2.05vh; height: 2.5vh; pointer-events: none; }
.leading { left: 7.5%; } .trailing { right: 7.5%; }
.button-chevron { position: absolute; top: 0; font-family: "EB Garamond"; font-size: 4.6vh; line-height: 6.5vh; pointer-events: none; }

/* Victory: wide triptych, player / match summary / opponent. */
.victory .result-board { left: 17.8%; top: 28.5%; width: 64.4%; height: 63.5%; }
.victory .result-masthead { left: 30.7%; top: 1.2%; width: 38.6%; height: 35.5%; }
.victory .result-title { top: 43%; font-size: 14.1vh; }
.victory .result-subtitle { bottom: 5.5%; }
.victory .title-flourish { bottom: 13%; }
.victory-laurel { position: absolute; top: 46%; width: 11%; height: 44%; }
.victory-laurel.left { left: 6%; }
.victory-laurel.right { right: 6%; }
.victory-columns { position: absolute; left: 2.6%; right: 2.6%; top: 9%; bottom: 21%; display: flex; }
.result-player, .result-opponent { position: relative; width: 28%; height: 100%; text-align: center; }
.result-summary { position: relative; width: 44%; height: 100%; }
.player-emblem { position: absolute; top: 4.5%; height: 9.8vh; width: 11vh; left: 31%; }
.lion-emblem { width: 9.2vh; left: 34%; }
.result-player .result-name, .result-opponent .result-name { position: absolute; top: 29%; left: 4%; width: 92%; }
.result-player .result-score-rule, .result-opponent .result-score-rule { position: absolute; top: 43%; left: 18%; width: 64%; }
.result-player .result-score, .result-opponent .result-score { position: absolute; top: 45.5%; left: 3%; width: 94%; }
.result-player .result-flourish, .result-opponent .result-flourish { position: absolute; top: 73%; left: 8%; width: 84%; }
.result-summary .summary-heading { position: absolute; top: 8%; left: 5%; width: 90%; }
.victory .summary-rows { position: absolute; top: 21%; left: 8%; width: 84%; border-top: 1px #75512988; }
.victory .summary-row { font-size: 2.55vh; height: 4.9vh; }
.victory .summary-value.numeric { font-size: 3.2vh; }
.summary-flourish { position: absolute; top: 56.5%; left: 5%; width: 90%; }
.tavern-engraving { position: absolute; top: 60.5%; left: 35%; width: 30%; height: 23%; }
.victory .result-flavor { position: absolute; bottom: 7%; left: 4%; width: 92%; font-size: 2.6vh; }
.bottom-flourish { position: absolute; bottom: 0.8%; left: 9%; width: 82%; height: 2.2vh; }
.bottom-flourish img { width: 1.7vh; height: 2vh; }
.victory .result-actions { left: 4%; right: 4%; bottom: 5.2%; height: 7.2vh; }

/* Defeat: compact vertical scorecard and inset summary. */
.defeat .result-board { left: 28.1%; top: 29.6%; width: 43.8%; height: 65%; }
.defeat .result-masthead { left: 33.7%; top: 0.7%; width: 32.6%; height: 33.4%; }
.defeat .result-title { top: 43%; color: #b65e40ff; font-size: 15vh; }
.defeat .result-subtitle { bottom: 1.8%; font-size: 1.75vh; letter-spacing: 0.33vh; }
.defeat .title-flourish { bottom: 10%; }
.defeat-scorecard { position: absolute; left: 4.7%; top: 8%; width: 90.6%; height: 29.6%; }
.defeat-player, .defeat-opponent { position: absolute; top: 0; width: 48%; height: 100%; }
.defeat-player { left: 1%; } .defeat-opponent { right: 1%; }
.defeat-scorecard .result-name { position: absolute; left: 0; top: 26%; width: 100%; font-size: 3.8vh; }
.defeat-scorecard .result-score { position: absolute; top: 48%; width: 100%; font-size: 8.5vh; }
.winner-crown { position: absolute; left: 41%; top: 3%; width: 5.2vh; height: 4vh; }
.scorecard-divider { position: absolute; left: 50%; top: 15%; height: 70%; border-left: 1px #76522b99; }
.scorecard-divider img { position: absolute; left: -1.2vh; top: 39%; width: 2.4vh; height: 2.8vh; }
.defeat-summary { position: absolute; left: 5.5%; right: 5.5%; top: 39%; bottom: 17%; }
.defeat-summary-heading { height: 5.8vh; display: flex; align-items: center; justify-content: center; color: #e6bf80ff; }
.defeat-summary-heading .summary-heading { margin: 0 1.8vh; font-size: 3.6vh; }
.defeat-summary-heading img { width: 2.1vh; height: 2.5vh; }
.heading-line { display: block; height: 1px; width: 12%; background-color: #b0844977; }
.defeat .summary-rows { margin: 0.2vh 3.2vh 0; padding: 0.9vh 2.4vh; decorator: ninepatch(parchment, parchment-inner, 1.1vh); }
.defeat .summary-row { height: 4.7vh; font-size: 2.65vh; }
.defeat .summary-key { width: 43%; }
.defeat .summary-value { width: 56%; text-align: left; }
.defeat .summary-value.numeric { font-size: 3.2vh; }
.defeat-flourish { margin-top: 0.7vh; }
.defeat-flourish span { background-color: #c79e5266; }
.defeat .result-flavor { margin-top: 0.4vh; color: #cfa976ff; font-size: 2.7vh; }
.defeat .result-actions { left: 3.8%; right: 3.8%; bottom: 5%; height: 6.9vh; }
.defeat .result-action { font-size: 2.8vh; }
.defeat .result-primary { decorator: image(button-paper); color: #35200fff; }
.defeat .result-primary:hover, .defeat .result-primary:focus { decorator: image(button-dark); color: #ffe7a9ff; }
